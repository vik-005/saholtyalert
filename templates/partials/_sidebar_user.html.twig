{# Bloc identité compact de la sidebar ; le profil et la déconnexion sont dans le menu du compte en haut. #}

<div class="sidebar-profile">
    <a href="{{ path('app_account_settings') }}" class="sidebar-profile-link" title="Consulter mon compte et mes préférences">
        <div class="profile-avatar">
            {% if app.user.photoProfil %}
                <img src="{{ path('app_account_photo', {v: app.user.photoProfil}) }}" alt="" class="user-avatar-image" width="40" height="40" decoding="async">
            {% else %}
                <i class="bi bi-person-fill" aria-hidden="true"></i>
            {% endif %}
        </div>
        <div class="profile-info">
            <span class="profile-name">{{ app.user.nomComplet }}</span>
            <span class="profile-role">{{ app.user.role.label() }}</span>
        </div>
    </a>
</div>
