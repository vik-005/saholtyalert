{% extends 'base.html.twig' %}
{% block title %}Carte des alertes — Afrique{% endblock %}
{% block header_title %}Carte des alertes{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
<style>
/* ── Layout plein-écran style Google Maps ── */
.carte-shell {
    display: grid;
    grid-template-columns: 340px 1fr;
    grid-template-rows: auto 1fr;
    height: calc(100vh - 64px);
    gap: 0;
    margin: -20px;
}
@media(max-width: 900px) {
    .carte-shell { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(380px, 54dvh) auto; min-height: 0; height: auto; }
    .carte-shell > aside { grid-row: 2; }
    .carte-shell > div { grid-row: 1; min-height: 0; }
    .carte-side  { height: auto; max-height: none; overflow: visible; border-right: 0; border-top: 1px solid var(--border); }
    #map { min-height: 0; height: 100%; }
}
@media(max-width: 560px) {
    .carte-shell { gap: 0; margin: -12px; grid-template-rows: minmax(340px, 56dvh) auto; }
    .carte-filters { padding: 10px 12px; }
    .carte-results { padding-top: 6px; }
    .pays-card { padding: 9px 12px; }
    .pays-card-nom { font-size: 12px; }
    .pays-card-iso { font-size: 9px; }
    .pays-badge-count { width: 30px; height: 30px; font-size: 11px; }
    .carte-shell .map-tools { top: 58px; right: 8px; left: auto; gap: 4px; padding: 5px; flex-wrap: nowrap; }
    .carte-shell .map-tools-count { display: none; }
    .carte-shell .map-tools button { width: 36px; height: 36px; justify-content: center; padding: 0; font-size: 0; }
    .carte-shell .map-tools button i { font-size: 15px; }
    .carte-shell .category-targets { top: 8px; left: 8px; right: auto; width: 190px; max-width: calc(100% - 160px); }
    .carte-shell .carte-legend { left: 8px; right: 8px; bottom: 10px; min-width: auto; max-width: calc(100% - 16px); padding: 8px 10px; }
    .carte-shell .carte-loading { left: 50%; }
}
/* ── Panneau gauche ── */
.carte-side {
    background: #ffffff;
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    overflow: hidden;
}
.carte-filters {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    max-height: calc(100vh - 170px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border2) transparent;
}
.carte-filters::-webkit-scrollbar { width: 5px; }
.carte-filters::-webkit-scrollbar-track { background: transparent; }
.carte-filters::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 5px; }
.carte-results {
    flex: 1; overflow-y: auto;
    padding: 8px 0;
}
@media(max-width: 900px) {
    .carte-side {
        height: auto;
        max-height: none;
        overflow: visible;
        border-right: 0;
        border-top: 1px solid var(--border);
    }
    .carte-filters {
        max-height: none;
        overflow: visible;
    }
    .carte-results {
        flex: none;
        overflow: visible;
    }
}
@media(max-width: 560px) {
    .carte-filters { padding: 10px 12px; }
}

.carte-market-dropdown {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
}
.carte-market-dropdown summary {
    min-height: 40px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    cursor: pointer;
    color: var(--text);
    font-size: 12px;
}
.carte-market-dropdown summary::-webkit-details-marker { display: none; }
.carte-market-dropdown summary::after {
    content: '';
    width: 7px;
    height: 7px;
    margin: -4px 2px 0 auto;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
    transition: transform .18s ease, margin .18s ease;
}
.carte-market-dropdown[open] summary::after {
    margin-top: 4px;
    transform: rotate(225deg);
}
.carte-market-summary-icon { color: var(--amber); }
.carte-market-summary-count {
    margin-left: auto;
    color: var(--muted);
    font-size: 10px;
}
.carte-market-dropdown[open] .carte-market-summary-count { margin-left: 0; }
.carte-market-options {
    max-height: 220px;
    overflow-y: auto;
    padding: 4px 8px 8px;
    border-top: 1px solid var(--border);
}
.carte-market-option {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px;
    border-radius: 6px;
    color: var(--text);
    font-size: 11px;
    cursor: pointer;
}
.carte-market-option:hover { background: var(--card2); }
.carte-market-option input {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--green);
    flex: 0 0 15px;
}
.carte-market-option span { min-width: 0; flex: 1; }
.carte-market-option small { color: var(--muted); font-size: 9px; }
@media(max-width: 900px) {
    .carte-market-options {
        max-height: none;
        overflow: visible;
    }
}

/* ── Carte ── */
#map {
    width: 100%; height: 100%;
    background: #edf1f3;
}
#map.map-dark-tiles .leaflet-tile-pane { filter: brightness(.68) saturate(.7) contrast(1.08); }
#map.map-tiles-unavailable::after {
    content: 'Fond cartographique indisponible - les donnees GEI restent accessibles dans le panneau';
    position: absolute; z-index: 1000; top: 12px; left: 50%; transform: translateX(-50%);
    max-width: calc(100% - 24px); padding: 7px 12px; border: 1px solid #f0c36d;
    border-radius: 6px; background: rgba(255, 248, 230, .96); color: #7a4d00;
    font-size: 11px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,.08);
}

/* ── Marqueurs — double dimension visuelle (priorité = fond, volume = taille/bordure) ── */
.z-marker {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    font-weight: 750; color: #26332e;
    cursor: pointer;
    transition: transform .15s;
    line-height: 1;
    border: 2px solid #fff;
    background: #fff;
    box-shadow: 0 1px 4px rgba(15, 23, 42, .2);
}
.z-marker:hover { transform: scale(1.08); }

.z-marker.critique { border-color: #b42318; }
.z-marker.eleve    { border-color: #c2410c; }
.z-marker.modere   { border-color: #a16207; }
.z-marker.faible   { border-color: #15803d; }

.z-marker.vol-faible,.z-marker.vol-modere,.z-marker.vol-eleve,.z-marker.vol-critique { border-width: 2px; }

/* ── Popup Leaflet — style GEI clair ── */
.leaflet-popup-content-wrapper {
    background: #ffffff !important;
    border: 1px solid var(--border) !important;
    border-radius: 10px !important;
    box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    padding: 0 !important;
    min-width: 260px;
}
.leaflet-popup-content  { margin: 0 !important; }
.leaflet-popup-tip-container { display: none; }
.popup-body  { padding: 14px 16px; }
.popup-title { font-size: 15px; font-weight: 800; color: var(--text); margin-bottom: 6px; }
.popup-total {
    font-size: 28px; font-weight: 900; color: #16856b;
    line-height: 1; display: inline-block;
}
.popup-total-label { font-size: 11px; color: var(--muted); margin-left: 6px; }
.popup-cats  { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px; }
.popup-cat   {
    font-size: 10.5px; padding: 2px 8px; border-radius: 99px;
    background: #f6faf8; color: var(--dim);
    border: 1px solid var(--border);
}
.popup-corridors { margin-top: 8px; }
.popup-corridor-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 4px; }
.popup-corridor   {
    font-size: 10.5px; padding: 2px 8px; border-radius: 99px;
    background: #e6f5ef; color: #16856b;
    border: 1px solid #b9e2d2;
}
.popup-btn   {
    display: block; text-align: center;
    padding: 8px; border-top: 1px solid var(--border);
    font-size: 12px; font-weight: 600; color: #16856b;
    text-decoration: none;
    transition: background .15s;
}
.popup-btn:hover { background: #e6f5ef; }
.map-tools {
    position: absolute; z-index: 1000; top: 14px; right: 14px;
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    padding: 7px; border: 1px solid rgba(148,163,184,.28); border-radius: 12px;
    background: rgba(255,255,255,.96); box-shadow: 0 5px 18px rgba(15,23,42,.15);
    backdrop-filter: blur(8px);
}
.map-tools-count { padding: 0 7px; color: #475569; font-size: 11px; font-weight: 700; }
.map-tools button {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px;
    border: 1px solid #dbe4ea; border-radius: 8px; background: #fff; color: #334155;
    font: inherit; font-size: 11px; font-weight: 700; cursor: pointer;
}
.map-tools button:hover, .map-tools button[aria-pressed="true"] {
    border-color: #16856b; background: #e9f6f1; color: #126b57;
}
.map-tools button:disabled { opacity: .45; cursor: not-allowed; }
.category-targets {
    position: absolute; z-index: 1000; top: 14px; left: 14px;
    width: min(290px, calc(100% - 28px));
    border: 1px solid rgba(148,163,184,.35); border-radius: 12px;
    background: rgba(255,255,255,.97); color: #334155;
    box-shadow: 0 5px 18px rgba(15,23,42,.14); backdrop-filter: blur(8px);
}
.category-targets summary {
    display: flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 12px;
    list-style: none; cursor: pointer; font-size: 11px; font-weight: 750;
}
.category-targets summary::-webkit-details-marker { display: none; }
.category-targets summary::after { content: '⌄'; margin-left: auto; color: #64748b; font-size: 16px; }
.category-targets[open] summary { border-bottom: 1px solid #e2e8f0; }
.category-targets[open] summary::after { content: '⌃'; }
.category-target-list { display: flex; flex-wrap: wrap; gap: 6px; max-height: 180px; overflow-y: auto; padding: 10px; }
.category-target {
    display: inline-flex; align-items: center; gap: 6px; max-width: 100%; min-height: 30px; padding: 5px 9px;
    border: 1px solid #dbe4ea; border-radius: 999px; background: #fff; color: #334155;
    font: inherit; font-size: 10px; font-weight: 650; cursor: pointer;
}
.category-target > span:nth-child(2) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.category-target:hover, .category-target[aria-pressed="true"] { border-color: #16856b; background: #e9f6f1; color: #126b57; }
.category-target-swatch { width: 9px; height: 9px; flex: 0 0 9px; border-radius: 50%; }
.category-target-count { color: #64748b; font-variant-numeric: tabular-nums; }
.category-target-note { margin: 0; padding: 0 10px 10px; color: #64748b; font-size: 9px; line-height: 1.4; }
.category-target-empty { padding: 8px 10px; color: #64748b; font-size: 10px; }
.target-zone { fill-opacity: .14; opacity: .48; }
.target-zone:hover { fill-opacity: .24; opacity: .8; }
.target-zone-tooltip { font-size: 10px; font-weight: 650; }
.route-arrow-icon { background: transparent; border: 0; }
.route-arrow-icon span {
    display: block; color: #126b57; font-size: 14px; line-height: 18px;
    text-shadow: 0 1px 2px rgba(255,255,255,.95); transform-origin: center;
}
body.dark .map-tools { background: rgba(15,23,42,.96); border-color: var(--border); }
body.dark .map-tools-count { color: var(--text); }
body.dark .map-tools button { background: var(--navy-800); border-color: var(--border); color: var(--text); }
body.dark .map-tools button:hover, body.dark .map-tools button[aria-pressed="true"] {
    background: rgba(22,133,107,.22); color: #6ee7b7;
}
body.dark .category-targets { background: rgba(15,23,42,.97); border-color: var(--border); color: var(--text); }
body.dark .category-targets[open] summary { border-bottom-color: var(--border); }
body.dark .category-targets summary::after,
body.dark .category-target-count,
body.dark .category-target-note,
body.dark .category-target-empty { color: var(--muted); }
body.dark .category-target { background: var(--navy-800); border-color: var(--border); color: var(--text); }
body.dark .category-target:hover,
body.dark .category-target[aria-pressed="true"] { background: rgba(22,133,107,.22); color: #6ee7b7; }

/* ── Panneau résultats ── */
.pays-card {
    padding: 10px 16px; border-bottom: 1px solid var(--border);
    cursor: pointer; transition: background .15s;
    display: flex; align-items: center; gap: 12px;
}
.pays-card:hover { background: #f6faf8; }
.pays-card.selected { background: #e6f5ef; border-left: 3px solid #16856b; }
.pays-badge-count {
    width: 36px; height: 36px; flex-shrink: 0;
    border-radius: 50%; display: grid; place-items: center;
    font-weight: 800; font-size: 13px; color: #fff;
}
.pays-card-info { flex: 1; min-width: 0; }
.pays-card-nom  { font-size: 13px; font-weight: 700; color: var(--text); }
.pays-card-iso  { font-size: 10.5px; font-mono font-bold; color: #16856b; }
.pays-card-cats { font-size: 10.5px; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── Barre de filtres ── */
.carte-filter-row { display: flex; flex-direction: column; gap: 8px; }

/* ── Légende ── */
.carte-legend {
    position: absolute; bottom: 24px; left: 12px;
    z-index: 1000;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 200px;
    max-width: 320px;
    box-shadow: 0 4px 16px rgba(0,0,0,.08);
}
.legend-label {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; color: var(--dim); font-weight: 600;
}
.legend-dot {
    display: inline-block;
    width: 12px; height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
}
.legend-toggle-btn {
    background: none; border: none; cursor: pointer;
    color: var(--muted); font-size: 11px; padding: 4px;
    border-radius: 4px; transition: all .2s;
}
.legend-toggle-btn:hover { color: #16856b; background: #f6faf8; }
#legendToggleIcon { transition: transform .2s; }
@media(max-width: 900px) {
    .carte-legend {
        left: 12px; bottom: 12px;
        max-width: calc(100% - 24px);
        min-width: auto;
    }
    .carte-legend #carteLegendBody {
        display: none;
    }
    .carte-legend.legend-expanded #carteLegendBody {
        display: block;
    }
}
@media(min-width: 901px) {
    .carte-legend #carteLegendBody {
        display: block !important;
    }
}

/* ── Spinner ── */
.carte-loading {
    position: absolute; top: 50%; left: calc(50% + 170px);
    transform: translate(-50%, -50%);
    z-index: 2000;
    display: none;
}
.carte-loading.visible { display: block; }

/* ── Dark mode support ── */
body.dark .carte-side { background: var(--navy-900); border-right-color: var(--border); }
body.dark .pays-card { border-bottom-color: var(--border); }
body.dark .pays-card:hover { background: var(--navy-800); }
body.dark .pays-card.selected { background: var(--navy-800); border-left-color: var(--amber); }
body.dark .pays-card-nom { color: var(--text); }
body.dark .pays-card-iso { color: var(--amber); }
body.dark .pays-card-cats { color: var(--muted); }
body.dark .carte-legend { background: var(--navy-900); border-color: var(--border); box-shadow: 0 4px 16px rgba(0,0,0,.4); }
body.dark .legend-toggle-btn:hover { color: var(--amber); background: rgba(255,255,255,.05); }
body.dark .carte-loading > div { background: var(--navy-900); border-color: var(--border); }
body.dark .leaflet-popup-content-wrapper { background: var(--navy-900) !important; border-color: var(--border) !important; }
body.dark .popup-title { color: var(--text); }
body.dark .popup-total { color: var(--amber); }
body.dark .popup-total-label { color: var(--muted); }
body.dark .popup-cat { background: var(--navy-800); color: var(--muted); border-color: var(--border); }
body.dark .popup-corridor { background: rgba(22,133,107,.15); color: var(--amber); border-color: rgba(22,133,107,.25); }
body.dark .popup-btn { color: var(--amber); border-top-color: var(--border); }
body.dark .popup-btn:hover { background: rgba(22,133,107,.1); }
</style>
{% endblock %}

{% block body %}
<div class="carte-shell">

    {# ── PANNEAU GAUCHE ── #}
    <aside class="carte-side">

        {# En-tête #}
        <div style="padding: 14px 16px; border-bottom: 1px solid var(--border);">
            <p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#16856b;">
                <i class="bi bi-map me-1.5"></i>Carte des alertes — Afrique
            </p>
            <div id="carteStats" style="display:flex;gap:14px;margin-top:8px;font-size:12px;color:var(--muted);">
                <span><span id="totalPays" class="font-700" style="color:var(--text)">{{ totalPays }}</span> pays</span>
                <span><span id="totalAlertes" class="font-700" style="color:#16856b">{{ totalAlertes }}</span> alertes</span>
            </div>
        </div>

        {# Filtres #}
        <div class="carte-filters">
            <form id="carteFiltersForm" class="carte-filter-row">

                <div>
                    <details class="carte-market-dropdown">
                        <summary>
                            <i class="bi bi-globe-africa carte-market-summary-icon" aria-hidden="true"></i>
                            <span>Marchés</span>
                            <span class="carte-market-summary-count" id="carteMarketSelectionCount">Tous les marchés</span>
                        </summary>
                        <div class="carte-market-options" id="fMarche">
                        {% for market in markets %}
                            <label class="carte-market-option">
                                <input type="checkbox" name="marche[]" value="{{ market.id }}"
                                    {% if filters.marche and (market.id in filters.marche) %}checked{% endif %}>
                                <span>{{ market.nom }}</span>
                                <small>{{ market.codeIso3 }}</small>
                            </label>
                        {% endfor %}
                        </div>
                    </details>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Catégorie de produit</label>
                    <select name="categorie" id="fCategorie" class="form-select" style="font-size:12px;">
                        <option value="">Toutes les catégories</option>
                        {% for cat in categories %}
                            <option value="{{ cat.libelle }}"
                                {% if filters.categorie == cat.libelle %}selected{% endif %}>
                                {{ cat.libelle }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Priorité</label>
                    <select name="priorite" id="fPriorite" class="form-select" style="font-size:12px;">
                        <option value="">Toutes les priorités</option>
                        {% for n in niveaux %}
                            <option value="{{ n.value }}"
                                {% if filters.priorite == n.value %}selected{% endif %}>
                                {{ n.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Statut</label>
                    <select name="statut" id="fStatut" class="form-select" style="font-size:12px;">
                        <option value="">Tous les statuts</option>
                        {% for s in statuts %}
                            <option value="{{ s.value }}"
                                {% if filters.statut == s.value %}selected{% endif %}>
                                {{ s.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Urgence</label>
                    <select name="urgence" id="fUrgence" class="form-select" style="font-size:12px;">
                        <option value="">Toutes</option>
                        {% for u in urgences %}
                            <option value="{{ u.value }}"
                                {% if filters.urgence == u.value %}selected{% endif %}>
                                {{ u.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Type d'alerte</label>
                    <select name="typeAlerte" id="fTypeAlerte" class="form-select" style="font-size:12px;">
                        <option value="">Tous</option>
                        {% for t in typeAlertes %}
                            <option value="{{ t.value }}"
                                {% if filters.typeAlerte == t.value %}selected{% endif %}>
                                {{ t.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
                    <div>
                        <label class="form-label" style="font-size:11px;">Score min</label>
                        <input type="number" name="scoreMin" id="fScoreMin" class="form-input" style="font-size:12px;"
                               min="0" max="25" placeholder="0" value="{{ filters.scoreMin|default('') }}">
                    </div>
                    <div>
                        <label class="form-label" style="font-size:11px;">Score max</label>
                        <input type="number" name="scoreMax" id="fScoreMax" class="form-input" style="font-size:12px;"
                               min="0" max="25" placeholder="25" value="{{ filters.scoreMax|default('') }}">
                    </div>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Origine</label>
                    <select name="origine" id="fOrigine" class="form-select" style="font-size:12px;">
                        <option value="">Toutes</option>
                        <option value="saisie_agent" {% if filters.origine == 'saisie_agent' %}selected{% endif %}>Saisie agent</option>
                        <option value="import_excel" {% if filters.origine == 'import_excel' %}selected{% endif %}>Import Excel</option>
                    </select>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
                    <div>
                        <label class="form-label" style="font-size:11px;">Du</label>
                        <input type="date" name="dateDebut" id="fDateDebut" class="form-input" style="font-size:12px;"
                               value="{{ filters.dateDebut|default('') }}">
                    </div>
                    <div>
                        <label class="form-label" style="font-size:11px;">Au</label>
                        <input type="date" name="dateFin" id="fDateFin" class="form-input" style="font-size:12px;"
                               value="{{ filters.dateFin|default('') }}">
                    </div>
                </div>

                <div style="display:flex;gap:6px;">
                    <button type="submit" class="db-btn db-btn-amber" style="flex:1;justify-content:center;font-size:12px;">
                        <i class="bi bi-search me-1"></i>Appliquer
                    </button>
                    <a href="{{ path('app_carte_index') }}" class="db-btn db-btn-ghost" style="font-size:12px;">
                        <i class="bi bi-arrow-clockwise-left"></i>
                    </a>
                </div>

            </form>
        </div>

        {# Liste des pays avec compteurs — triés par nombre d'alertes #}
        <div class="carte-results" id="paysListContainer">
            <div class="text-center py-8 text-slate-500 text-sm" id="paysListPlaceholder">
                <i class="bi bi-arrow-repeat bi-spin text-amber-400 bi-lg block mb-2"></i>
                Chargement des données…
            </div>
        </div>

    </aside>

    {# ── CARTE LEAFLET ── #}
    <div style="position:relative;display:flex;flex-direction:column;height:100%;">
        <div id="map" style="flex:1;width:100%;min-height:0;"></div>

        <div class="map-tools" role="group" aria-label="Outils de carte">
            <span class="map-tools-count" id="routeCount" aria-live="polite">0 parcours indicatif</span>
            <button type="button" id="routeToggle" aria-label="Afficher ou masquer les trajets indicatifs" title="Trajets indicatifs" aria-pressed="true" disabled>
                <i class="bi bi-bezier2"></i>Trajets indicatifs
            </button>
            <button type="button" id="routeFit" aria-label="Cadrer les trajets indicatifs" title="Voir les trajets" disabled>
                <i class="bi bi-arrows-fullscreen"></i>Voir les trajets
            </button>
            <button type="button" id="mapReset" aria-label="Recentrer la carte sur l'Afrique" title="Vue Afrique">
                <i class="bi bi-globe-africa"></i>Vue Afrique
            </button>
        </div>

        <details class="category-targets">
            <summary><i class="bi bi-bullseye" aria-hidden="true"></i>Zones par catégorie</summary>
            <div class="category-target-list" id="categoryTargetOptions">
                <div class="category-target-empty">Chargement des catégories…</div>
            </div>
            <p class="category-target-note">Zones indicatives agrégées par marché ; le halo n'est pas une frontière ni une localisation précise.</p>
        </details>

        {# Légende enrichie ── #}
        <div class="carte-legend" id="carteLegend">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <button onclick="toggleLegend()" style="display:flex;align-items:center;gap:4px;background:none;border:none;cursor:pointer;color:var(--text);font-size:11px;font-weight:700;padding:0">
                    <i class="bi bi-map me-1"></i>Légende
                </button>
                <button onclick="toggleLegend()" class="legend-toggle-btn" title="Réduire">
                    <i class="bi bi-chevron-down" id="legendToggleIcon"></i>
                </button>
            </div>
            <div id="carteLegendBody">
                <div style="margin-bottom:8px;padding-top:6px;border-top:1px solid var(--border);">
                    <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px;">Volume : taille du point</p>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#F9A825;font-size:9px"></i>1–5 alertes</span><br>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#F57C00;font-size:11px"></i>6–20 alertes</span><br>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#EF6C00;font-size:13px"></i>21–50 alertes</span><br>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#E65100;font-size:15px"></i>Plus de 50 alertes</span>
                </div>
                <div style="margin-bottom:8px;padding-top:6px;border-top:1px solid var(--border);">
                    <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px;">Priorité dominante (couleur du marqueur)</p>
                    <div style="display:flex;gap:10px;flex-wrap:wrap;">
                        <span class="legend-label"><span class="legend-dot" style="background:#ef4444"></span>Critique</span>
                        <span class="legend-label"><span class="legend-dot" style="background:#f97316"></span>Élevé</span>
                        <span class="legend-label"><span class="legend-dot" style="background:#f59e0b"></span>Modéré</span>
                        <span class="legend-label"><span class="legend-dot" style="background:#22c55e"></span>Faible</span>
                    </div>
                </div>
                <div id="legendActiveFilters" style="font-size:10px;color:var(--muted);border-top:1px solid var(--border);padding-top:6px;margin-top:2px">
                    <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:4px;">Filtres actifs</p>
                    <div id="legendFiltersList" style="display:flex;flex-wrap:wrap;gap:4px;">
                        {% if filters.marche is iterable and filters.marche %}
                            {% for mId in filters.marche %}
                                {% for m in markets %}
                                    {% if (m.id ~ '') == (mId ~ '') %}
                                        <span class="status-pill" style="font-size:9px">Marche : {{ m.nom }}</span>
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        {% endif %}
                        {% if filters.categorie %}  <span class="status-pill" style="font-size:9px">Cat : {{ filters.categorie }}</span>{% endif %}
                        {% if filters.priorite %}   <span class="status-pill" style="font-size:9px">Prio : {{ filters.priorite }}</span>{% endif %}
                        {% if filters.statut %}     <span class="status-pill" style="font-size:9px">Statut : {{ filters.statut }}</span>{% endif %}
                        {% if filters.urgence %}    <span class="status-pill" style="font-size:9px">Urgence : {{ filters.urgence }}</span>{% endif %}
                        {% if filters.typeAlerte %}<span class="status-pill" style="font-size:9px">Type : {{ filters.typeAlerte }}</span>{% endif %}
                        {% if filters.scoreMin or filters.scoreMax %}<span class="status-pill" style="font-size:9px">Score : {{ filters.scoreMin|default('0') }}-{{ filters.scoreMax|default('25') }}</span>{% endif %}
                        {% if filters.origine %}    <span class="status-pill" style="font-size:9px">Origine : {{ filters.origine }}</span>{% endif %}
                        {% if filters.dateDebut %}  <span class="status-pill" style="font-size:9px">Du {{ filters.dateDebut }}</span>{% endif %}
                        {% if filters.dateFin %}    <span class="status-pill" style="font-size:9px">Au {{ filters.dateFin }}</span>{% endif %}
                        {% if not filters.marche and not filters.categorie and not filters.priorite and not filters.statut and not filters.urgence and not filters.typeAlerte and not filters.scoreMin and not filters.scoreMax and not filters.origine and not filters.dateDebut and not filters.dateFin %}
                        <span style="color:var(--muted)">aucun filtre actif</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Spinner #}
        <div class="carte-loading" id="carteLoading">
            <div style="background:#ffffff;border:1px solid var(--border);border-radius:10px;padding:12px 20px;display:flex;align-items:center;gap:10px;">
                <i class="bi bi-arrow-repeat bi-spin" style="color:#16856b"></i>
                <span style="font-size:13px;color:var(--muted);">Chargement…</span>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
(function() {
    'use strict';

    let map, markersLayer, targetZonesLayer, routeLayer, currentTileLayer;
    let allZones = [];
    const marketInputs = document.querySelectorAll('#fMarche input[name="marche[]"]');
    const marketCount = document.getElementById('carteMarketSelectionCount');
    const AFRICA_BOUNDS = [[-37, -25], [38, 55]];
    const CATEGORY_COLORS = ['#0f766e', '#2563eb', '#7c3aed', '#d97706', '#be123c', '#0891b2', '#4d7c0f'];

    function updateMarketCount() {
        const selected = [...marketInputs].filter(input => input.checked).length;
        marketCount.textContent = selected ? `${selected} marché${selected > 1 ? 's' : ''} sélectionné${selected > 1 ? 's' : ''}` : 'Tous les marchés';
    }

    marketInputs.forEach(input => input.addEventListener('change', updateMarketCount));
    updateMarketCount();

    function categoryColor(value) {
        let hash = 0;
        for (const char of String(value || '')) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
        return CATEGORY_COLORS[hash % CATEGORY_COLORS.length];
    }

    function setTileLayer(isDark) {
        if (!map) return;
        const tileUrl = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
        const attr = '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors';
        document.getElementById('map')?.classList.toggle('map-dark-tiles', isDark);

        if (currentTileLayer && map.hasLayer(currentTileLayer)) {
            map.removeLayer(currentTileLayer);
        }
        currentTileLayer = L.tileLayer(tileUrl, {
            attribution: attr,
            maxZoom: 18,
        }).addTo(map);

        currentTileLayer.on('tileerror', () => document.getElementById('map')?.classList.add('map-tiles-unavailable'));
        currentTileLayer.on('load', () => document.getElementById('map')?.classList.remove('map-tiles-unavailable'));

        if (markersLayer && typeof markersLayer.bringToFront === 'function') {
            markersLayer.bringToFront();
        }
    }

    function destroyMap() {
        if (map) {
            try { map.remove(); } catch(e) {}
            map = null;
            markersLayer = null;
            targetZonesLayer = null;
            routeLayer = null;
            currentTileLayer = null;
        }
    }

    function initMap() {
        if (map) return;

        const isDark = document.body.classList.contains('dark') || localStorage.getItem('gei-dark') === '1';

        if (typeof L === 'undefined') {
            document.getElementById('map').innerHTML = '<div style="display:grid;place-items:center;height:100%;color:var(--muted);font-size:13px;text-align:center;padding:20px"><div><i class="bi bi-exclamation-triangle" style="font-size:32px;display:block;margin-bottom:10px"></i>Impossible de charger la carte.<br>Veuillez recharger la page.</div></div>';
            return;
        }

        map = L.map('map', {
            center: [5, 20],
            zoom: 4,
            minZoom: 2,
            maxZoom: 14,
            zoomControl: false,
        });

        L.control.zoom({ position: 'bottomright' }).addTo(map);

        markersLayer = L.layerGroup().addTo(map);
        targetZonesLayer = L.layerGroup().addTo(map);
        routeLayer = L.featureGroup().addTo(map);
        setTileLayer(isDark);

        map.fitBounds(AFRICA_BOUNDS, { padding: [10, 10] });

        setTimeout(() => { map.invalidateSize(); }, 100);
        setTimeout(() => { map.invalidateSize(); }, 500);

        loadZones();

        document.getElementById('carteFiltersForm').addEventListener('submit', e => {
            e.preventDefault();
            loadZones();
        });
        document.getElementById('routeToggle').addEventListener('click', toggleRoutes);
        document.getElementById('routeFit').addEventListener('click', fitRoutes);
        document.getElementById('mapReset').addEventListener('click', () => {
            map.fitBounds(AFRICA_BOUNDS, { padding: [20, 20] });
        });
    }

    // Mettre à jour les tiles lors du basculement mode nuit
    document.addEventListener('dark-mode-changed', (e) => {
        if (!map) return;
        const isDark = e.detail?.dark ?? (document.body.classList.contains('dark') || localStorage.getItem('gei-dark') === '1');
        setTileLayer(isDark);
    });

    window.addEventListener('resize', () => { if (map) map.invalidateSize(); });

    document.addEventListener('turbo:load', initMap);
    document.addEventListener('turbo:before-cache', destroyMap);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMap);
    } else {
        initMap();
    }

    function loadZones() {
        const loading = document.getElementById('carteLoading');
        loading.classList.add('visible');

        const params = new URLSearchParams();
        const form = document.getElementById('carteFiltersForm');
        new FormData(form).forEach((v, k) => { if (v) params.append(k, v); });

        // Mise à jour dynamique des badges de filtres dans la légende
        updateLegendFilters(params);

        fetch('/carte/api/zones?' + params.toString(), { credentials: 'same-origin' })
            .then(r => {
                if (!r.ok || r.redirected || !r.headers.get('content-type')?.includes('application/json')) {
                    throw new Error('La session a expiré ou les données cartographiques sont indisponibles.');
                }
                return r.json();
            })
            .then(zones => {
                allZones = zones;
                updateCategoryTargets(zones);
                renderMarkers(zones);
                renderSidePanel(zones);
                updateStats(zones);
                return fetch('/carte/api/parcours?' + params.toString(), { credentials: 'same-origin' })
                    .then(response => response.ok ? response.json() : [])
                    .then(routes => renderRoutes(routes));
            })
            .then(() => {
                history.replaceState(null, '', '/carte?' + params.toString());
            })
            .catch(error => {
                const container = document.getElementById('paysListContainer');
                if (container) {
                    container.innerHTML = `<div style="padding:28px 16px;text-align:center;color:var(--muted);font-size:12.5px;">
                        <i class="bi bi-exclamation-triangle text-amber-400" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                        <strong>Carte momentanément indisponible</strong><br>${escHtml(error.message)}<br>
                        <button type="button" class="db-btn db-btn-ghost db-btn-sm" style="margin-top:10px;" onclick="location.reload()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Recharger
                        </button>
                    </div>`;
                }
            })
            .finally(() => { loading.classList.remove('visible'); });
    }

    function updateLegendFilters(params) {
        const list = document.getElementById('legendFiltersList');
        if (!list) return;
        const chips = [];
        const marcheValues = params.getAll('marche[]');
        if (marcheValues.length > 0) {
            const chipMap = {
                '1': 'Bénin', '2': 'Togo', '3': 'Niger', '4': 'Mali',
                '5': 'Sénégal', '6': "Côte d'Ivoire", '7': 'Ghana',
                '8': 'Guinée', '9': 'Burkina Faso',
            };
            marcheValues.forEach(v => {
                chips.push(`Marche : ${escHtml(chipMap[v] || 'Marche ' + v)}`);
            });
        }
        if (params.get('categorie')) chips.push(`Cat : ${params.get('categorie')}`);
        if (params.get('priorite')) chips.push(`Prio : ${params.get('priorite')}`);
        if (params.get('statut')) chips.push(`Statut : ${params.get('statut')}`);
        if (params.get('urgence')) chips.push(`Urgence : ${params.get('urgence')}`);
        if (params.get('typeAlerte')) chips.push(`Type : ${params.get('typeAlerte')}`);
        if (params.get('scoreMin') || params.get('scoreMax')) chips.push(`Score : ${params.get('scoreMin') || '0'}-${params.get('scoreMax') || '25'}`);
        if (params.get('origine')) chips.push(`Origine : ${params.get('origine')}`);
        if (params.get('dateDebut')) chips.push(`Du ${params.get('dateDebut')}`);
        if (params.get('dateFin')) chips.push(`Au ${params.get('dateFin')}`);

        if (chips.length > 0) {
            list.innerHTML = chips.map(c => `<span class="status-pill" style="font-size:9px">${escHtml(c)}</span>`).join('');
        } else {
            list.innerHTML = '<span style="color:var(--muted)">aucun filtre actif</span>';
        }
    }

    function renderMarkers(zones) {
        markersLayer.clearLayers();
        targetZonesLayer.clearLayers();
        const bounds = [];

        zones.forEach(zone => {
            const count = parseInt(zone.alertCount) || 0;
            // RÈGLE STRICTE : les marchés avec 0 alerte disparaissent de la carte
            if (count <= 0) return;
            if (!zone.latitude || !zone.longitude) return;

            const lat = parseFloat(zone.latitude);
            const lng = parseFloat(zone.longitude);
            bounds.push([lat, lng]);

            const prio = zone.maxPriority || 'faible';
            const categories = Object.entries(zone.categories || {}).sort((a, b) => Number(b[1]) - Number(a[1]));
            const dominantCategory = categories[0]?.[0] || '';
            const targetColor = dominantCategory ? categoryColor(dominantCategory) : '#16856b';
            const targetRadius = Math.min(34, 13 + Math.sqrt(count) * 2.2);
            const targetZone = L.circleMarker([lat, lng], {
                radius: targetRadius,
                color: targetColor,
                weight: 1.5,
                fillColor: targetColor,
                opacity: 0.72,
                fillOpacity: 0.2,
                className: 'target-zone',
                interactive: false,
            }).addTo(targetZonesLayer);
            targetZone.bindTooltip(
                `${escHtml(zone.nom)} · ${count} alerte${count > 1 ? 's' : ''} · ${escHtml(dominantCategory ? categorieLabel(dominantCategory) : 'toutes catégories')}`,
                { className: 'target-zone-tooltip', direction: 'top', offset: [0, -targetRadius] }
            );

            // Double dimension visuelle :
            // 1) Taille et dégradé orange de bordure selon le volume
            let size = 30;
            let fontSize = 11;
            let volClass = 'vol-faible';
            if (count > 50) {
                size = 42;
                fontSize = 12;
                volClass = 'vol-critique';
            } else if (count > 20) {
                size = 38;
                fontSize = 12;
                volClass = 'vol-eleve';
            } else if (count > 5) {
                size = 34;
                fontSize = 12;
                volClass = 'vol-modere';
            }
            if (window.matchMedia('(max-width: 560px)').matches) {
                size = Math.round(size * 0.72);
                fontSize = Math.max(9, Math.round(fontSize * 0.85));
            }

            const label = count > 99 ? '99+' : String(count);

            const icon = L.divIcon({
                html: `<div class="z-marker ${prio} ${volClass}" style="width:${size}px;height:${size}px;font-size:${fontSize}px;" title="${escHtml(zone.nom)} : ${count} alerte(s) (Priorité : ${prio})">
                           ${label}
                       </div>`,
                className: '',
                iconSize:   [size, size],
                iconAnchor: [size / 2, size / 2],
                popupAnchor:[0, -(size / 2) - 4],
            });

            const marker = L.marker([lat, lng], { icon })
                .addTo(markersLayer);

            const cats = zone.categories || {};
            const catHtml = Object.entries(cats).slice(0, 5).map(([k, v]) => {
                const label = categorieLabel(k);
                return `<span class="popup-cat"><span class="category-target-swatch" style="background:${categoryColor(k)}"></span>${escHtml(label)} <strong>${v}</strong></span>`;
            }).join('');

            const corridors = zone.corridors || {};
            const corridorHtml = Object.entries(corridors).slice(0, 5).map(([k, v]) => {
                return `<span class="popup-corridor">${escHtml(k)} <strong>${v}</strong></span>`;
            }).join('');
            const corridorTitleHtml = Object.keys(corridors).length > 0
                ? `<div class="popup-corridors"><div class="popup-corridor-title">Corridors / Ports</div>${corridorHtml}</div>`
                : '';

            const popupHtml = `
                <div class="popup-body">
                    <div class="popup-title">
                        <span style="font-size:11px;font-family:monospace;color:#16856b;">${escHtml(zone.codeIso3)}</span>
                        ${escHtml(zone.nom)}
                    </div>
                    <div>
                        <span class="popup-total">${count}</span>
                        <span class="popup-total-label">alerte${count > 1 ? 's' : ''} filtrée${count > 1 ? 's' : ''}</span>
                    </div>
                    ${catHtml ? `<div class="popup-cats">${catHtml}</div>` : ''}
                    ${corridorTitleHtml}
                </div>
                <a class="popup-btn" href="#" onclick="loadAlertesList(${zone.id}, '${escHtml(zone.nom)}'); return false;">
                    <i class="bi bi-list me-1"></i>Voir les alertes
                </a>`;

            marker.bindPopup(popupHtml, { maxWidth: 300, className: '' });
            marker.on('click', () => highlightPaysCard(zone.id));
        });

        // ── Choroplèthe : polygones de zone par intensité d'alertes ──
        zones.forEach(zone => {
            const count = parseInt(zone.alertCount) || 0;
            if (!zone.polygonWkt || count <= 0) return;
            if (!zone.latitude || !zone.longitude) return;

            const coords = parseWKTPolygon(zone.polygonWkt);
            if (!coords || coords.length === 0) return;

            const dominantCategory = Object.entries(zone.categories || {}).sort((a, b) => Number(b[1]) - Number(a[1]))[0]?.[0];
            const fillColor = dominantCategory ? categoryColor(dominantCategory) : '#16856b';

            const polygon = L.polygon(coords, {
                fillColor: fillColor,
                color: fillColor,
                weight: 2,
                opacity: 0.8,
                fillOpacity: 0.18,
            }).addTo(markersLayer);

            polygon.bindPopup(
                `<strong>${escHtml(zone.nom)}</strong><br>Zone indicative — ${count} alerte${count > 1 ? 's' : ''}`
            );
        });

        targetZonesLayer.eachLayer(layer => {
            if (typeof layer.bringToBack === 'function') layer.bringToBack();
        });
        if (bounds.length > 0) {
            const africanBounds = bounds.filter(b => b[0] >= -37 && b[0] <= 38 && b[1] >= -25 && b[1] <= 55);
            if (africanBounds.length > 0) {
                map.fitBounds(africanBounds, { padding: [60, 60], maxZoom: 8 });
            }
        }
    }

    function renderRoutes(routes) {
        if (!routeLayer) return;
        routeLayer.clearLayers();
        const uniqueRoutes = new Map();
        routes.forEach(route => {
            const key = (route.markets || []).join('|');
            if (!uniqueRoutes.has(key)) {
                uniqueRoutes.set(key, { ...route, occurrences: 0 });
            }
            uniqueRoutes.get(key).occurrences += 1;
        });
        const validRoutes = [...uniqueRoutes.values()].filter(route => Array.isArray(route.points) && route.points.length > 1);
        validRoutes.forEach(route => {
            if (!Array.isArray(route.points) || route.points.length < 2) return;
            const line = L.polyline(route.points, {
                color: '#0f8069',
                weight: 4,
                opacity: 0.9,
                dashArray: '2 9',
                lineCap: 'round',
            }).addTo(routeLayer);
            line.bindTooltip(
                `<strong>Parcours indicatif</strong><br>${escHtml((route.markets || []).join(' → '))}<br><small>${route.occurrences} alerte(s)</small>`,
                { sticky: true }
            );
            route.points.forEach((point, index) => {
                L.circleMarker(point, {
                    radius: index === 0 ? 6 : 4,
                    color: '#fff',
                    weight: 2,
                    fillColor: '#0f8069',
                    fillOpacity: 1,
                }).bindTooltip(escHtml(route.markets[index] || 'Étape du parcours')).addTo(routeLayer);
            });
            for (let index = 0; index < route.points.length - 1; index++) {
                const start = map.latLngToLayerPoint(route.points[index]);
                const end = map.latLngToLayerPoint(route.points[index + 1]);
                const midpoint = map.layerPointToLatLng(start.add(end).divideBy(2));
                const angle = Math.atan2(end.y - start.y, end.x - start.x) * 180 / Math.PI;
                L.marker(midpoint, {
                    interactive: false,
                    icon: L.divIcon({
                        className: 'route-arrow-icon',
                        html: `<span style="transform:rotate(${angle}deg)">➜</span>`,
                        iconSize: [18, 18],
                        iconAnchor: [9, 9],
                    }),
                }).addTo(routeLayer);
            }
        });
        const count = validRoutes.length;
        const countLabel = document.getElementById('routeCount');
        const toggle = document.getElementById('routeToggle');
        const fit = document.getElementById('routeFit');
        if (countLabel) countLabel.textContent = `${count} parcours indicatif${count > 1 ? 's' : ''}`;
        if (toggle) toggle.disabled = count === 0;
        if (fit) fit.disabled = count === 0;
        if (toggle && count === 0) toggle.setAttribute('aria-pressed', 'false');
        if (count === 0 && map?.hasLayer(routeLayer)) map.removeLayer(routeLayer);
        if (count > 0 && toggle?.getAttribute('aria-pressed') !== 'false' && !map?.hasLayer(routeLayer)) {
            routeLayer.addTo(map);
            toggle.setAttribute('aria-pressed', 'true');
        }
    }

    function toggleRoutes() {
        if (!map || !routeLayer) return;
        const button = document.getElementById('routeToggle');
        const visible = button?.getAttribute('aria-pressed') === 'true';
        if (visible) {
            map.removeLayer(routeLayer);
            button.setAttribute('aria-pressed', 'false');
        } else {
            routeLayer.addTo(map);
            button.setAttribute('aria-pressed', 'true');
        }
    }

    function fitRoutes() {
        if (!map || !routeLayer?.getBounds().isValid()) return;
        map.fitBounds(routeLayer.getBounds(), { padding: [50, 50], maxZoom: 7 });
    }

    function renderSidePanel(zones) {
        const container = document.getElementById('paysListContainer');
        const sorted    = [...zones].sort((a, b) => b.alertCount - a.alertCount);
        const activeZones = sorted.filter(z => (parseInt(z.alertCount) || 0) > 0);

        if (activeZones.length === 0) {
            container.innerHTML = `<div style="padding:28px 16px;text-align:center;color:var(--muted);font-size:12.5px;">
                <i class="bi bi-funnel text-amber-400" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                <strong>Aucune alerte trouvée</strong><br>
                Aucun résultat pour les critères sélectionnés.<br>
                <a href="/carte" class="db-btn db-btn-ghost db-btn-sm" style="margin-top:10px;display:inline-flex;">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Réinitialiser les filtres
                </a>
            </div>`;
            return;
        }

        container.innerHTML = activeZones.map(zone => {
            const count = parseInt(zone.alertCount) || 0;
            const prio  = zone.maxPriority || 'faible';
            const cats  = zone.categories || {};
            const catList = Object.entries(cats).slice(0, 3)
                .map(([k, v]) => `${categorieLabel(k)} (${v})`).join(', ');
            const colors = { critique: '#ef4444', eleve: '#f97316', modere: '#f59e0b', faible: '#22c55e' };

            return `<div class="pays-card" id="pays-card-${zone.id}" onclick="focusZone(${zone.id}, ${zone.latitude}, ${zone.longitude})">
                <div class="pays-badge-count" style="background:${colors[prio] ?? '#64748b'}">${count > 99 ? '99+' : count}</div>
                <div class="pays-card-info">
                    <div style="display:flex;align-items:center;gap:6px;">
                        <span class="pays-card-iso">${escHtml(zone.codeIso3 ?? '')}</span>
                        <span class="pays-card-nom">${escHtml(zone.nom)}</span>
                    </div>
                    ${catList ? `<div class="pays-card-cats">${escHtml(catList)}</div>` : '<div class="pays-card-cats">Alertes actives</div>'}
                </div>
                <i class="bi bi-chevron-right pays-card-chevron"></i>
            </div>`;
        }).join('');
    }

    function updateStats(zones) {
        const activeZones = zones.filter(z => (parseInt(z.alertCount) || 0) > 0);
        const total = activeZones.reduce((s, z) => s + (parseInt(z.alertCount) || 0), 0);
        document.getElementById('totalPays').textContent    = activeZones.length;
        document.getElementById('totalAlertes').textContent = total;
    }

    function updateCategoryTargets(zones) {
        const container = document.getElementById('categoryTargetOptions');
        const select = document.getElementById('fCategorie');
        if (!container || !select) return;

        const counts = new Map();
        zones.forEach(zone => {
            Object.entries(zone.categories || {}).forEach(([category, count]) => {
                counts.set(category, (counts.get(category) || 0) + (Number(count) || 0));
            });
        });
        const selected = select.value;
        const entries = [...counts.entries()].sort((a, b) => b[1] - a[1]);
        const allCount = entries.reduce((sum, [, count]) => sum + count, 0);
        const options = [{
            value: '',
            label: 'Toutes',
            count: allCount,
            color: '#16856b',
        }, ...entries.map(([value, count]) => ({
            value,
            label: categorieLabel(value),
            count,
            color: categoryColor(value),
        }))];

        container.innerHTML = options.map(option => `
            <button type="button" class="category-target" data-category="${escHtml(option.value)}"
                    aria-pressed="${selected === option.value ? 'true' : 'false'}">
                <span class="category-target-swatch" style="background:${option.color}"></span>
                <span>${escHtml(option.label)}</span>
                <span class="category-target-count">${option.count}</span>
            </button>
        `).join('') || '<div class="category-target-empty">Aucune zone avec des alertes pour ces filtres.</div>';

        container.querySelectorAll('.category-target').forEach(button => {
            button.addEventListener('click', () => {
                const value = button.dataset.category || '';
                if (value && ![...select.options].some(option => option.value === value)) {
                    select.add(new Option(categorieLabel(value), value));
                }
                select.value = value;
                loadZones();
            });
        });
    }

    function focusZone(zoneId, lat, lng) {
        const fLat = parseFloat(lat);
        const fLng = parseFloat(lng);
        if (!isNaN(fLat) && !isNaN(fLng)) {
            map.setView([fLat, fLng], 7, { animate: true });
        }
        highlightPaysCard(zoneId);

        markersLayer.eachLayer(layer => {
            const pos = layer.getLatLng();
            if (Math.abs(pos.lat - fLat) < 0.01 && Math.abs(pos.lng - fLng) < 0.01) {
                layer.openPopup();
            }
        });
    }

    function highlightPaysCard(zoneId) {
        document.querySelectorAll('.pays-card').forEach(el => el.classList.remove('selected'));
        const card = document.getElementById(`pays-card-${zoneId}`);
        if (card) {
            card.classList.add('selected');
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function loadAlertesList(zoneId, zoneName) {
        const params = new URLSearchParams();
        params.set('marketId', zoneId);
        const fForm = document.getElementById('carteFiltersForm');
        new FormData(fForm).forEach((v, k) => { if (v) params.append(k, v); });
        window.open('/alert/?' + params.toString(), '_blank');
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function parseWKTPolygon(wkt) {
        if (!wkt || typeof wkt !== 'string') return [];
        const match = wkt.match(/POLYGON\s*\(\s*\(?\s*(\(.*\))\s*\)?\s*\)/i);
        if (!match) return [];
        const ringStr = match[1].trim();
        const coordPairs = ringStr.split(',').map(p => p.trim());
        const coords = [];
        coordPairs.forEach(pair => {
            const parts = pair.replace(/[()]/g, '').trim().split(/\s+/);
            if (parts.length >= 2) {
                const lon = parseFloat(parts[0]);
                const lat = parseFloat(parts[1]);
                if (!isNaN(lon) && !isNaN(lat)) coords.push([lat, lon]);
            }
        });
        return coords;
    }

    const catLabels = {
        // Legacy enum values (for backward compatibility with old data)
        container_suspect: 'Conteneur suspect',
        flux_terrestre: 'Flux terrestre',
        acteur: 'Acteur',
        modus_operandi: 'Modus operandi',
        transit_tabac: 'Transit tabac',
        saisie: 'Saisie',
        veille_marche: 'Veille marché',
        tabac_brut: 'Tabac brut',
        importation_tabac: 'Import tabac',
        transit_cigarettes: 'Transit cigarettes',
        tabac_manufacture: 'Tabac manufacturé',
        signal_faible: 'Signal faible',
        signalement_operationnel: 'Signalement opérationnel',
        controle_cargaison: 'Contrôle cargaison',
        controle_documentaire: 'Contrôle documentaire',
        saisies_consolidees: 'Saisies consolidées',
        incoherence_declaration: 'Incohérence déclaration',
        suivi_operationnel: 'Suivi opérationnel',
        renseignement_logistique: 'Renseignement logistique',
        fret_express: 'Fret express',
        mouvement_transfrontalier: 'Mouvement transfrontalier',
        autre: 'Autre',
    };
    function categorieLabel(val) {
        if (!val) return '—';
        // If the value is already a French libellé (contains spaces or accented chars), return as-is
        if (val.includes(' ') || /[àâäéèêëïîôùûüÿçÀÂÄÉÈÊËÏÎÔÙÛÜŸÇ]/.test(val)) {
            return val;
        }
        // Otherwise, try to map from legacy enum value
        return catLabels[val] || val;
    }

    window.loadAlertesList = loadAlertesList;
    window.focusZone       = focusZone;
    window.toggleLegend    = function() {
        const legend = document.getElementById('carteLegend');
        const icon = document.getElementById('legendToggleIcon');
        if (legend.classList.contains('legend-expanded')) {
            legend.classList.remove('legend-expanded');
            if (icon) icon.style.transform = 'rotate(-90deg)';
        } else {
            legend.classList.add('legend-expanded');
            if (icon) icon.style.transform = 'rotate(0deg)';
        }
    };
})();
</script>
{% endblock %}
