{% extends 'base.html.twig' %}
{% block title %}Carte des alertes — Afrique{% endblock %}
{% block header_title %}Carte des alertes{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://tiles.maps.eox.at" crossorigin>
<link rel="dns-prefetch" href="https://tiles.maps.eox.at">
<link rel="preconnect" href="https://gibs.earthdata.nasa.gov" crossorigin>
<link rel="dns-prefetch" href="https://gibs.earthdata.nasa.gov">
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin=""/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" crossorigin=""/>
<style>
/* ── Layout plein-écran style Google Maps ── */
.carte-shell {
    display: grid;
    grid-template-columns: 340px 1fr;
    grid-template-rows: auto 1fr;
    height: calc(100vh - 64px);
    gap: 0;
    margin: -20px;
}
@media(max-width: 900px) {
    .carte-shell { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(380px, 54dvh) auto; min-height: 0; height: auto; }
    .carte-shell > aside { grid-row: 2; }
    .carte-shell > div { grid-row: 1; min-height: 0; }
    .carte-side  { height: auto; max-height: none; overflow: visible; border-right: 0; border-top: 1px solid var(--border); }
    #map { min-height: 0; height: 100%; }
}
@media(max-width: 560px) {
    .carte-shell { gap: 0; margin: -12px; grid-template-rows: minmax(340px, 56dvh) auto; }
    .carte-filters { padding: 10px 12px; }
    .carte-results { padding-top: 6px; }
    .pays-card { padding: 9px 12px; }
    .pays-card-nom { font-size: 12px; }
    .pays-card-iso { font-size: 9px; }
    .pays-badge-count { width: 30px; height: 30px; font-size: 11px; }
    .carte-shell .map-tools { align-self: stretch; gap: 4px; padding: 5px; }
    .carte-shell .map-tools-count { display: none; }
    .carte-shell .map-tools button { width: 36px; height: 36px; justify-content: center; padding: 0; font-size: 0; }
    .carte-shell .map-tools button i { font-size: 15px; }
    .carte-shell .category-targets { width: min(290px, 100%); max-width: 100%; }
    .carte-shell .carte-legend { left: 8px; right: 8px; bottom: 10px; min-width: auto; max-width: calc(100% - 16px); padding: 8px 10px; }
    .carte-shell .carte-loading { left: 50%; }
}
/* ── Panneau gauche ── */
.carte-side {
    background: #ffffff;
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    overflow: hidden;
}
.carte-filters {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    max-height: calc(100vh - 170px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border2) transparent;
}
.carte-filters::-webkit-scrollbar { width: 5px; }
.carte-filters::-webkit-scrollbar-track { background: transparent; }
.carte-filters::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 5px; }
.carte-results {
    flex: 1; overflow-y: auto;
    padding: 8px 0;
}
@media(max-width: 900px) {
    .carte-side {
        height: auto;
        max-height: none;
        overflow: visible;
        border-right: 0;
        border-top: 1px solid var(--border);
    }
    .carte-filters {
        max-height: none;
        overflow: visible;
    }
    .carte-results {
        flex: none;
        overflow: visible;
    }
}
@media(max-width: 560px) {
    .carte-filters { padding: 10px 12px; }
}

.carte-market-dropdown {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
}
.carte-market-dropdown summary {
    min-height: 40px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    cursor: pointer;
    color: var(--text);
    font-size: 12px;
}
.carte-market-dropdown summary::-webkit-details-marker { display: none; }
.carte-market-dropdown summary::after {
    content: '';
    width: 7px;
    height: 7px;
    margin: -4px 2px 0 auto;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
    transition: transform .18s ease, margin .18s ease;
}
.carte-market-dropdown[open] summary::after {
    margin-top: 4px;
    transform: rotate(225deg);
}
.carte-market-summary-icon { color: var(--amber); }
.carte-market-summary-count {
    margin-left: auto;
    color: var(--muted);
    font-size: 10px;
}
.carte-market-dropdown[open] .carte-market-summary-count { margin-left: 0; }
.carte-market-options {
    max-height: 220px;
    overflow-y: auto;
    padding: 4px 8px 8px;
    border-top: 1px solid var(--border);
}
.carte-market-option {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px;
    border-radius: 6px;
    color: var(--text);
    font-size: 11px;
    cursor: pointer;
}
.carte-market-option:hover { background: var(--card2); }
.carte-market-option input {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--green);
    flex: 0 0 15px;
}
.carte-market-option span { min-width: 0; flex: 1; }
.carte-market-option small { color: var(--muted); font-size: 9px; }
@media(max-width: 900px) {
    .carte-market-options {
        max-height: none;
        overflow: visible;
    }
}

/* ── Carte ── */
#map {
    width: 100%; height: 100%;
    background: #edf1f3;
    contain: layout style paint;
}
#map.map-dark-tiles .leaflet-tile {
    filter: grayscale(.2) invert(.88) hue-rotate(180deg) brightness(.84) contrast(.9);
}
#map.map-tiles-unavailable::after {
    content: 'Fond de carte indisponible — les données GEI restent accessibles dans le panneau.';
    position: absolute; z-index: 1000; top: 12px; left: 50%; transform: translateX(-50%);
    max-width: calc(100% - 24px); padding: 7px 12px; border: 1px solid #f0c36d;
    border-radius: 6px; background: rgba(255, 248, 230, .96); color: #7a4d00;
    font-size: 11px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,.08);
}

/* ── Marqueurs — double dimension visuelle (priorité = gradient + halo, volume = taille/bordure) ── */
.z-marker {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    font-weight: 800;
    cursor: pointer;
    transition: transform .2s cubic-bezier(.34, 1.56, .64, 1), box-shadow .2s ease;
    line-height: 1;
    will-change: transform;
    border: 2.5px solid #fff;
    user-select: none;
}
.z-marker:hover {
    transform: scale(1.16);
    z-index: 1000 !important;
}

/* Marqueurs Clairs — Gradients soignés */
.z-marker.critique {
    background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
    border-color: #dc2626;
    color: #991b1b;
    box-shadow: 0 4px 12px rgba(220, 38, 38, .35);
    animation: pulse-beacon 2s cubic-bezier(.4, 0, .6, 1) infinite;
}
.z-marker.eleve {
    background: linear-gradient(135deg, #ffedd5 0%, #fed7aa 100%);
    border-color: #ea580c;
    color: #9a3412;
    box-shadow: 0 3px 10px rgba(234, 88, 12, .3);
}
.z-marker.modere {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    border-color: #d97706;
    color: #92400e;
    box-shadow: 0 3px 10px rgba(217, 119, 6, .25);
}
.z-marker.faible {
    background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
    border-color: #16a34a;
    color: #166534;
    box-shadow: 0 3px 10px rgba(22, 163, 74, .25);
}

@keyframes pulse-beacon {
    0% {
        box-shadow: 0 0 0 0 rgba(220, 38, 38, .6), 0 4px 12px rgba(220, 38, 38, .35);
    }
    70% {
        box-shadow: 0 0 0 12px rgba(220, 38, 38, 0), 0 4px 12px rgba(220, 38, 38, .35);
    }
    100% {
        box-shadow: 0 0 0 0 rgba(220, 38, 38, 0), 0 4px 12px rgba(220, 38, 38, .35);
    }
}

/* ── Animation de flux pour le tracé de corridor ── */
@keyframes route-flow-dash {
    from { stroke-dashoffset: 28; }
    to   { stroke-dashoffset: 0; }
}
.route-flow-line {
    animation: route-flow-dash 1.3s linear infinite;
}

/* ── Balises de corridor (Waypoints & Radar Beacons) ── */
.route-origin-beacon {
    position: relative;
    width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
}
.route-beacon-core {
    width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 8px rgba(0,0,0,.35);
    z-index: 3;
    display: flex; align-items: center; justify-content: center;
}
.route-beacon-core-dot {
    width: 4px; height: 4px; border-radius: 50%; background: #ffffff;
}
.route-beacon-wave {
    position: absolute; top: 0; left: 0;
    width: 26px; height: 26px; border-radius: 50%;
    border: 2px solid currentColor;
    opacity: 0.85;
    animation: radar-wave 2s cubic-bezier(.21, .53, .56, 1) infinite;
    pointer-events: none;
    z-index: 2;
}
.route-beacon-wave-2 {
    animation-delay: 1s;
}
@keyframes radar-wave {
    0%   { transform: scale(0.5); opacity: 0.9; }
    75%  { transform: scale(2.2); opacity: 0.15; }
    100% { transform: scale(2.6); opacity: 0; }
}

/* Balise d'arrivée (Target Pin) */
.route-dest-beacon {
    position: relative;
    width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
}
.route-dest-core {
    width: 16px; height: 16px; border-radius: 50%;
    border: 2.5px solid #ffffff;
    box-shadow: 0 2px 8px rgba(0,0,0,.35);
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
}
.route-dest-target {
    width: 6px; height: 6px; border-radius: 50%; background: #ffffff;
}

/* Balise de transit (Étape) */
.route-step-beacon {
    width: 12px; height: 12px; border-radius: 50%;
    border: 2px solid #ffffff;
    box-shadow: 0 1px 6px rgba(0,0,0,.3);
}

/* ── Popup / Tooltip de corridor ultra-soigné ── */
.corridor-popup-card {
    padding: 14px 16px;
    min-width: 260px;
    font-family: inherit;
}
.corridor-popup-badge-row {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    margin-bottom: 8px;
}
.corridor-badge-prio {
    font-size: 9.5px; font-weight: 800; text-transform: uppercase;
    padding: 2px 8px; border-radius: 99px; letter-spacing: .06em;
}
.corridor-badge-prio.critique { background: #fee2e2; color: #991b1b; }
.corridor-badge-prio.eleve { background: #ffedd5; color: #9a3412; }
.corridor-badge-prio.modere { background: #fef3c7; color: #92400e; }
.corridor-badge-prio.faible { background: #dcfce7; color: #166534; }
.corridor-badge-count {
    font-size: 11px; font-weight: 700; color: #64748b;
}
.corridor-popup-title {
    font-size: 13.5px; font-weight: 800; color: var(--text);
    display: flex; align-items: center; gap: 6px;
    line-height: 1.35; margin-bottom: 4px;
}
.corridor-popup-sub {
    font-size: 11px; color: #16856b; font-weight: 600;
    margin-bottom: 8px;
}
.corridor-popup-cats {
    display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 12px;
}
.corridor-popup-btn {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    width: 100%; padding: 8px 12px; border-radius: 7px;
    background: #16856b; color: #ffffff !important; font-size: 11.5px; font-weight: 700;
    text-decoration: none; border: none; cursor: pointer;
    transition: background .15s, transform .15s;
}
.corridor-popup-btn:hover {
    background: #126b57; transform: translateY(-1px);
}

/* ── Tiroir latéral rétractable (Alerts Drawer) ── */
.carte-alerts-drawer {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 410px; max-width: calc(100% - 30px);
    background: #ffffff;
    border-left: 1px solid var(--border);
    box-shadow: -10px 0 35px rgba(15, 23, 42, .22);
    z-index: 1500;
    display: flex; flex-direction: column;
    transform: translateX(105%);
    transition: transform .32s cubic-bezier(.16, 1, .3, 1);
    backdrop-filter: blur(12px);
}
.carte-alerts-drawer.is-open {
    transform: translateX(0);
}
.drawer-header {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;
    padding: 16px 18px 14px;
    border-bottom: 1px solid var(--border);
    background: #f8fafc;
}
.drawer-badge-prio {
    font-size: 9px; font-weight: 800; text-transform: uppercase;
    letter-spacing: .08em; color: #16856b; margin-bottom: 2px;
}
.drawer-title {
    margin: 0; font-size: 16.5px; font-weight: 800; color: var(--text);
    line-height: 1.3;
}
.drawer-subtitle {
    font-size: 11px; color: var(--muted); margin-top: 2px;
}
.drawer-close-btn {
    width: 32px; height: 32px; flex: 0 0 32px; border-radius: 8px;
    border: 1px solid var(--border); background: #ffffff;
    display: grid; place-items: center; cursor: pointer; color: var(--muted);
    transition: all .15s;
}
.drawer-close-btn:hover { background: #fee2e2; color: #ef4444; border-color: #fca5a5; }

.drawer-search-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-bottom: 1px solid var(--border);
    background: #ffffff;
}
.drawer-input {
    width: 100%; border: none; outline: none; font-size: 12px;
    background: transparent; color: var(--text);
}
.drawer-count-chip {
    font-size: 10px; font-weight: 700; padding: 2px 7px;
    background: #e2e8f0; color: #475569; border-radius: 99px;
}

.drawer-body {
    flex: 1; overflow-y: auto; padding: 12px 14px;
    display: flex; flex-direction: column; gap: 10px;
}
.drawer-loading {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; padding: 40px 10px; color: var(--muted); font-size: 12.5px;
}
.drawer-loading i { font-size: 24px; color: #16856b; }
.drawer-list {
    display: flex; flex-direction: column; gap: 9px;
}
.drawer-empty {
    text-align: center; padding: 36px 14px; color: var(--muted); font-size: 12.5px;
}
.drawer-footer {
    padding: 12px 16px; border-top: 1px solid var(--border);
    background: #f8fafc;
}

/* Alert Card inside Drawer */
.drawer-alert-card {
    padding: 11px 13px; border-radius: 9px;
    border: 1px solid var(--border); background: #ffffff;
    transition: transform .15s, box-shadow .15s, border-color .15s;
    display: flex; flex-direction: column; gap: 5px;
    text-decoration: none; color: inherit;
    position: relative;
}
.drawer-alert-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 16px rgba(15, 23, 42, .08);
    border-color: #16856b;
}
.drawer-alert-header {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.drawer-alert-code {
    font-size: 12px; font-weight: 800; font-family: monospace; color: #16856b;
    display: flex; align-items: center; gap: 5px;
}
.drawer-alert-badge {
    font-size: 9.5px; font-weight: 700; padding: 2px 6px; border-radius: 99px;
    text-transform: uppercase;
}
.drawer-alert-badge.critique { background: #fee2e2; color: #991b1b; }
.drawer-alert-badge.eleve { background: #ffedd5; color: #9a3412; }
.drawer-alert-badge.modere { background: #fef3c7; color: #92400e; }
.drawer-alert-badge.faible { background: #dcfce7; color: #166534; }
.drawer-alert-resume {
    font-size: 11px; color: var(--text); line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.drawer-alert-meta {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 10px; color: var(--muted); border-top: 1px dashed var(--border); padding-top: 4px; margin-top: 2px;
}

/* ── Sélecteur de couches (Tile Switcher) ── */
.tile-switcher-group {
    display: inline-flex;
    border: 1px solid #dbe4ea;
    border-radius: 8px;
    background: #ffffff;
    overflow: hidden;
}
.tile-switch-btn {
    border: none; background: transparent; padding: 6px 9px;
    font: inherit; font-size: 11px; font-weight: 700; color: #475569;
    display: inline-flex; align-items: center; gap: 4px; cursor: pointer;
    transition: background .15s, color .15s;
    border-right: 1px solid #e2e8f0;
}
.tile-switch-btn:last-child { border-right: none; }
.tile-switch-btn:hover { background: #f1f5f9; color: #1e293b; }
.tile-switch-btn.active, .tile-switch-btn[aria-pressed="true"] {
    background: #e6f5ef; color: #0f766e;
}

/* ── MarkerCluster — style GEI cohérent ── */
.marker-cluster-small,
.marker-cluster-medium,
.marker-cluster-large { background: transparent !important; }
.marker-cluster-small div,
.marker-cluster-medium div,
.marker-cluster-large div { background: transparent !important; }
.leaflet-marker-icon.marker-cluster { background: none !important; }

/* ── Popup Leaflet — style GEI clair ── */
.leaflet-popup-content-wrapper {
    background: #ffffff !important;
    border: 1px solid var(--border) !important;
    border-radius: 10px !important;
    box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    padding: 0 !important;
    min-width: 260px;
}
.leaflet-popup-content  { margin: 0 !important; }
.leaflet-popup-tip-container { display: none; }
.popup-body  { padding: 14px 16px; }
.popup-title { font-size: 15px; font-weight: 800; color: var(--text); margin-bottom: 6px; }
.popup-total {
    font-size: 28px; font-weight: 900; color: #16856b;
    line-height: 1; display: inline-block;
}
.popup-total-label { font-size: 11px; color: var(--muted); margin-left: 6px; }
.popup-cats  { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px; }
.popup-cat   {
    font-size: 10.5px; padding: 2px 8px; border-radius: 99px;
    background: #f6faf8; color: var(--dim);
    border: 1px solid var(--border);
}
.popup-corridors { margin-top: 8px; }
.popup-corridor-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 4px; }
.popup-corridor   {
    font-size: 10.5px; padding: 2px 8px; border-radius: 99px;
    background: #e6f5ef; color: #16856b;
    border: 1px solid #b9e2d2;
}
.popup-btn   {
    display: block; text-align: center;
    padding: 8px; border-top: 1px solid var(--border);
    font-size: 12px; font-weight: 600; color: #16856b;
    text-decoration: none;
    transition: background .15s;
    cursor: pointer;
}
.popup-btn:hover { background: #e6f5ef; }
.map-controls {
    position: absolute; z-index: 1000; top: 14px; left: 14px; right: 14px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;
    pointer-events: none;
}
.map-controls > * { position: relative; inset: auto; pointer-events: auto; }
.map-controls .category-targets { order: 0; }
.map-controls .map-tools { order: 1; }
.map-tools {
    position: relative; top: auto; right: auto; left: auto;
    display: flex; align-items: center; gap: 7px; flex-wrap: wrap;
    justify-content: flex-end; max-width: calc(100% - 300px);
    padding: 6px 8px; border: 1px solid rgba(148,163,184,.28); border-radius: 12px;
    background: rgba(255,255,255,.96); box-shadow: 0 5px 18px rgba(15,23,42,.15);
    backdrop-filter: blur(8px);
}
.map-tools-count { padding: 0 7px; color: #475569; font-size: 11px; font-weight: 700; }
.map-tools button {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px;
    border: 1px solid #dbe4ea; border-radius: 8px; background: #fff; color: #334155;
    font: inherit; font-size: 11px; font-weight: 700; cursor: pointer;
}
.map-tools button:hover, .map-tools button[aria-pressed="true"] {
    border-color: #16856b; background: #e9f6f1; color: #126b57;
}
.map-tools button:disabled { opacity: .45; cursor: not-allowed; }
.category-targets {
    position: relative; top: auto; left: auto; flex: 0 1 290px;
    width: min(290px, calc(100% - 28px));
    border: 1px solid rgba(148,163,184,.35); border-radius: 12px;
    background: rgba(255,255,255,.97); color: #334155;
    box-shadow: 0 5px 18px rgba(15,23,42,.14); backdrop-filter: blur(8px);
}
@media(max-width: 1100px) {
    .map-controls {
        top: 8px; left: 8px; right: 8px;
        flex-direction: column; align-items: stretch; gap: 6px;
    }
    .map-controls .category-targets { width: min(290px, 100%); flex: 0 0 auto; }
    .map-controls .map-tools { width: fit-content; max-width: 100%; align-self: flex-end; }
    .category-target-list { max-height: 130px; }
}
@media(max-width: 560px) {
    .map-controls .map-tools { width: auto; align-self: stretch; }
}
.category-targets summary {
    display: flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 12px;
    list-style: none; cursor: pointer; font-size: 11px; font-weight: 750;
}
.category-targets summary::-webkit-details-marker { display: none; }
.category-targets summary::after { content: '⌄'; margin-left: auto; color: #64748b; font-size: 16px; }
.category-targets[open] summary { border-bottom: 1px solid #e2e8f0; }
.category-targets[open] summary::after { content: '⌃'; }
.category-target-list { display: flex; flex-wrap: wrap; gap: 6px; max-height: 180px; overflow-y: auto; padding: 10px; }
.category-target {
    display: inline-flex; align-items: center; gap: 6px; max-width: 100%; min-height: 30px; padding: 5px 9px;
    border: 1px solid #dbe4ea; border-radius: 999px; background: #fff; color: #334155;
    font: inherit; font-size: 10px; font-weight: 650; cursor: pointer;
}
.category-target > span:nth-child(2) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.category-target:hover, .category-target[aria-pressed="true"] { border-color: #16856b; background: #e9f6f1; color: #126b57; }
.category-target-swatch { width: 9px; height: 9px; flex: 0 0 9px; border-radius: 50%; }
.category-target-count { color: #64748b; font-variant-numeric: tabular-nums; }
.category-target-note { margin: 0; padding: 0 10px 10px; color: #64748b; font-size: 9px; line-height: 1.4; }
.category-target-empty { padding: 8px 10px; color: #64748b; font-size: 10px; }
.target-zone { fill-opacity: .14; opacity: .48; }
.target-zone:hover { fill-opacity: .24; opacity: .8; }
.target-zone-tooltip { font-size: 10px; font-weight: 650; }
.route-arrow-icon { background: transparent; border: 0; }
.route-arrow-icon span {
    display: block; color: #126b57; font-size: 14px; line-height: 18px;
    text-shadow: 0 1px 2px rgba(255,255,255,.95); transform-origin: center;
}
body.dark .map-tools { background: rgba(15,23,42,.96); border-color: var(--border); }
body.dark .map-tools-count { color: var(--text); }
body.dark .map-tools button { background: var(--navy-800); border-color: var(--border); color: var(--text); }
body.dark .map-tools button:hover, body.dark .map-tools button[aria-pressed="true"] {
    background: rgba(22,133,107,.22); color: #6ee7b7;
}
body.dark .tile-switcher-group { border-color: var(--border); background: var(--navy-800); }
body.dark .tile-switch-btn { color: var(--muted); border-right-color: var(--border); }
body.dark .tile-switch-btn:hover { background: var(--navy-700); color: var(--text); }
body.dark .tile-switch-btn.active, body.dark .tile-switch-btn[aria-pressed="true"] {
    background: rgba(22,133,107,.25); color: #6ee7b7;
}
body.dark .carte-alerts-drawer { background: var(--navy-900); border-left-color: var(--border); }
body.dark .drawer-header { background: var(--navy-800); border-bottom-color: var(--border); }
body.dark .drawer-close-btn { background: var(--navy-900); border-color: var(--border); color: var(--muted); }
body.dark .drawer-search-bar { background: var(--navy-900); border-bottom-color: var(--border); }
body.dark .drawer-count-chip { background: var(--navy-800); color: var(--muted); }
body.dark .drawer-footer { background: var(--navy-800); border-top-color: var(--border); }
body.dark .drawer-alert-card { background: var(--navy-800); border-color: var(--border); }
body.dark .drawer-alert-card:hover { border-color: #10b981; }
body.dark .category-targets { background: rgba(15,23,42,.97); border-color: var(--border); color: var(--text); }
body.dark .category-targets[open] summary { border-bottom-color: var(--border); }
body.dark .category-targets summary::after,
body.dark .category-target-count,
body.dark .category-target-note,
body.dark .category-target-empty { color: var(--muted); }
body.dark .category-target { background: var(--navy-800); border-color: var(--border); color: var(--text); }
body.dark .category-target:hover,
body.dark .category-target[aria-pressed="true"] { background: rgba(22,133,107,.22); color: #6ee7b7; }

/* ── Panneau résultats ── */
.pays-card {
    padding: 10px 16px; border-bottom: 1px solid var(--border);
    cursor: pointer; transition: background .15s;
    display: flex; align-items: center; gap: 12px;
}
.pays-card:hover { background: #f6faf8; }
.pays-card.selected { background: #e6f5ef; border-left: 3px solid #16856b; }
.pays-badge-count {
    width: 36px; height: 36px; flex-shrink: 0;
    border-radius: 50%; display: grid; place-items: center;
    font-weight: 800; font-size: 13px; color: #fff;
}
.pays-card-info { flex: 1; min-width: 0; }
.pays-card-nom  { font-size: 13px; font-weight: 700; color: var(--text); }
.pays-card-iso  { font-size: 10.5px; font-mono font-bold; color: #16856b; }
.pays-card-cats { font-size: 10.5px; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── Barre de filtres ── */
.carte-filter-row { display: flex; flex-direction: column; gap: 8px; }

/* ── Légende ── */
.carte-legend {
    position: absolute; bottom: 24px; left: 12px;
    z-index: 1000;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 200px;
    max-width: 320px;
    box-shadow: 0 4px 16px rgba(0,0,0,.08);
}
.legend-label {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; color: var(--dim); font-weight: 600;
}
.legend-dot {
    display: inline-block;
    width: 12px; height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
}
.legend-toggle-btn {
    background: none; border: none; cursor: pointer;
    color: var(--muted); font-size: 11px; padding: 4px;
    border-radius: 4px; transition: all .2s;
}
.legend-toggle-btn:hover { color: #16856b; background: #f6faf8; }
#legendToggleIcon { transition: transform .2s; }
@media(max-width: 900px) {
    .carte-legend {
        left: 12px; bottom: 12px;
        max-width: calc(100% - 24px);
        min-width: auto;
    }
    .carte-legend #carteLegendBody {
        display: none;
        max-height: min(34dvh, 210px);
        overflow-y: auto;
    }
    .carte-legend.legend-expanded #carteLegendBody {
        display: block;
    }
}
@media(min-width: 901px) {
    .carte-legend #carteLegendBody {
        display: block !important;
    }
}

/* ── Spinner ── */
.carte-loading {
    position: absolute; top: 50%; left: calc(50% + 170px);
    transform: translate(-50%, -50%);
    z-index: 2000;
    display: none;
}
.carte-loading.visible { display: block; }

/* ── Dark mode support ── */
body.dark .z-marker { border-color: rgba(255, 255, 255, .85); }
body.dark .z-marker.critique {
    background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 100%);
    border-color: #f87171;
    color: #fef2f2;
    box-shadow: 0 0 14px rgba(239, 68, 68, .55);
}
body.dark .z-marker.eleve {
    background: linear-gradient(135deg, #7c2d12 0%, #9a3412 100%);
    border-color: #fb923c;
    color: #fff7ed;
    box-shadow: 0 0 12px rgba(249, 115, 22, .45);
}
body.dark .z-marker.modere {
    background: linear-gradient(135deg, #78350f 0%, #92400e 100%);
    border-color: #fbbf24;
    color: #fffbeb;
    box-shadow: 0 0 12px rgba(245, 158, 11, .4);
}
body.dark .z-marker.faible {
    background: linear-gradient(135deg, #14532d 0%, #166534 100%);
    border-color: #4ade80;
    color: #f0fdf4;
    box-shadow: 0 0 12px rgba(34, 197, 94, .4);
}
body.dark .carte-side { background: var(--navy-900); border-right-color: var(--border); }
body.dark .pays-card { border-bottom-color: var(--border); }
body.dark .pays-card:hover { background: var(--navy-800); }
body.dark .pays-card.selected { background: var(--navy-800); border-left-color: var(--amber); }
body.dark .pays-card-nom { color: var(--text); }
body.dark .pays-card-iso { color: var(--amber); }
body.dark .pays-card-cats { color: var(--muted); }
body.dark .carte-legend { background: var(--navy-900); border-color: var(--border); box-shadow: 0 4px 16px rgba(0,0,0,.4); }
body.dark .legend-toggle-btn:hover { color: var(--amber); background: rgba(255,255,255,.05); }
body.dark .carte-loading > div { background: var(--navy-900); border-color: var(--border); }
body.dark .leaflet-popup-content-wrapper { background: var(--navy-900) !important; border-color: var(--border) !important; }
body.dark .popup-title { color: var(--text); }
body.dark .popup-total { color: var(--amber); }
body.dark .popup-total-label { color: var(--muted); }
body.dark .popup-cat { background: var(--navy-800); color: var(--muted); border-color: var(--border); }
body.dark .popup-corridor { background: rgba(22,133,107,.15); color: var(--amber); border-color: rgba(22,133,107,.25); }
body.dark .popup-btn { color: var(--amber); border-top-color: var(--border); }
body.dark .popup-btn:hover { background: rgba(22,133,107,.1); }
</style>
{% endblock %}

{% block body %}
<div class="carte-shell">

    {# ── PANNEAU GAUCHE ── #}
    <aside class="carte-side">

        {# En-tête #}
        <div style="padding: 14px 16px; border-bottom: 1px solid var(--border);">
            <p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#16856b;">
                <i class="bi bi-map me-1.5"></i>Carte des alertes — Afrique
            </p>
            <div id="carteStats" style="display:flex;gap:14px;margin-top:8px;font-size:12px;color:var(--muted);">
                <span><span id="totalPays" class="font-700" style="color:var(--text)">{{ totalPays }}</span> pays</span>
                <span><span id="totalAlertes" class="font-700" style="color:#16856b">{{ totalAlertes }}</span> alertes</span>
            </div>
        </div>

        {# Filtres #}
        <div class="carte-filters">
            <form id="carteFiltersForm" class="carte-filter-row">

                <div>
                    <details class="carte-market-dropdown">
                        <summary>
                            <i class="bi bi-globe-africa carte-market-summary-icon" aria-hidden="true"></i>
                            <span>Marchés</span>
                            <span class="carte-market-summary-count" id="carteMarketSelectionCount">Tous les marchés</span>
                        </summary>
                        <div class="carte-market-options" id="fMarche">
                        {% for market in markets %}
                            <label class="carte-market-option">
                                <input type="checkbox" name="marche[]" value="{{ market.id }}"
                                    {% if filters.marche and (market.id in filters.marche) %}checked{% endif %}>
                                <span>{{ market.nom }}</span>
                                <small>{{ market.codeIso3 }}</small>
                            </label>
                        {% endfor %}
                        </div>
                    </details>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Catégorie de produit</label>
                    <select name="categorie" id="fCategorie" class="form-select" style="font-size:12px;">
                        <option value="">Toutes les catégories</option>
                        {% for cat in categories %}
                            <option value="{{ cat.libelle }}"
                                {% if filters.categorie == cat.libelle %}selected{% endif %}>
                                {{ cat.libelle }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Priorité</label>
                    <select name="priorite" id="fPriorite" class="form-select" style="font-size:12px;">
                        <option value="">Toutes les priorités</option>
                        {% for n in niveaux %}
                            <option value="{{ n.value }}"
                                {% if filters.priorite == n.value %}selected{% endif %}>
                                {{ n.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Statut</label>
                    <select name="statut" id="fStatut" class="form-select" style="font-size:12px;">
                        <option value="">Tous les statuts</option>
                        {% for s in statuts %}
                            <option value="{{ s.value }}"
                                {% if filters.statut == s.value %}selected{% endif %}>
                                {{ s.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Urgence</label>
                    <select name="urgence" id="fUrgence" class="form-select" style="font-size:12px;">
                        <option value="">Toutes</option>
                        {% for u in urgences %}
                            <option value="{{ u.value }}"
                                {% if filters.urgence == u.value %}selected{% endif %}>
                                {{ u.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Type d'alerte</label>
                    <select name="typeAlerte" id="fTypeAlerte" class="form-select" style="font-size:12px;">
                        <option value="">Tous</option>
                        {% for t in typeAlertes %}
                            <option value="{{ t.value }}"
                                {% if filters.typeAlerte == t.value %}selected{% endif %}>
                                {{ t.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
                    <div>
                        <label class="form-label" style="font-size:11px;">Score min</label>
                        <input type="number" name="scoreMin" id="fScoreMin" class="form-input" style="font-size:12px;"
                               min="0" max="25" placeholder="0" value="{{ filters.scoreMin|default('') }}">
                    </div>
                    <div>
                        <label class="form-label" style="font-size:11px;">Score max</label>
                        <input type="number" name="scoreMax" id="fScoreMax" class="form-input" style="font-size:12px;"
                               min="0" max="25" placeholder="25" value="{{ filters.scoreMax|default('') }}">
                    </div>
                </div>

                <div>
                    <label class="form-label" style="font-size:11px;">Origine</label>
                    <select name="origine" id="fOrigine" class="form-select" style="font-size:12px;">
                        <option value="">Toutes</option>
                        <option value="saisie_agent" {% if filters.origine == 'saisie_agent' %}selected{% endif %}>Saisie agent</option>
                        <option value="import_excel" {% if filters.origine == 'import_excel' %}selected{% endif %}>Import Excel</option>
                    </select>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
                    <div>
                        <label class="form-label" style="font-size:11px;">Du</label>
                        <input type="date" name="dateDebut" id="fDateDebut" class="form-input" style="font-size:12px;"
                               value="{{ filters.dateDebut|default('') }}">
                    </div>
                    <div>
                        <label class="form-label" style="font-size:11px;">Au</label>
                        <input type="date" name="dateFin" id="fDateFin" class="form-input" style="font-size:12px;"
                               value="{{ filters.dateFin|default('') }}">
                    </div>
                </div>

                <div style="display:flex;gap:6px;">
                    <button type="submit" class="db-btn db-btn-amber" style="flex:1;justify-content:center;font-size:12px;">
                        <i class="bi bi-search me-1"></i>Appliquer
                    </button>
                    <a href="{{ path('app_carte_index') }}" class="db-btn db-btn-ghost" style="font-size:12px;">
                        <i class="bi bi-arrow-clockwise-left"></i>
                    </a>
                </div>

            </form>
        </div>

        {# Liste des pays avec compteurs — triés par nombre d'alertes #}
        <div class="carte-results" id="paysListContainer">
            <div class="text-center py-8 text-slate-500 text-sm" id="paysListPlaceholder">
                <i class="bi bi-arrow-repeat bi-spin text-amber-400 bi-lg block mb-2"></i>
                Chargement des données…
            </div>
        </div>

    </aside>

    {# ── CARTE LEAFLET ── #}
    <div style="position:relative;display:flex;flex-direction:column;height:100%;">
        <div id="map" style="flex:1;width:100%;min-height:0;"></div>

        {# ── TIROIR D'ALERTES LATÉRAL (DRAWER) ── #}
        <aside class="carte-alerts-drawer" id="carteAlertsDrawer" aria-hidden="true">
            <div class="drawer-header">
                <div style="min-width:0;flex:1;">
                    <div class="drawer-badge-prio" id="drawerPrioBadge">ZONE OPÉRATIONNELLE</div>
                    <h3 class="drawer-title" id="drawerTitle">Bénin</h3>
                    <div class="drawer-subtitle" id="drawerSubtitle">0 alerte filtrée</div>
                </div>
                <button type="button" class="drawer-close-btn" id="drawerCloseBtn" aria-label="Fermer le volet">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="drawer-search-bar">
                <i class="bi bi-search text-muted"></i>
                <input type="text" id="drawerSearchInput" placeholder="Filtrer (code, mot-clé, corridor...)" class="drawer-input">
                <span class="drawer-count-chip" id="drawerFilteredCount">0</span>
            </div>
            <div class="drawer-body" id="drawerBody">
                <div class="drawer-loading" id="drawerLoading">
                    <i class="bi bi-arrow-repeat bi-spin"></i>
                    <span>Chargement des alertes…</span>
                </div>
                <div class="drawer-list" id="drawerAlertsList"></div>
            </div>
            <div class="drawer-footer" id="drawerFooter">
                <a href="#" id="drawerOpenRegisterBtn" target="_blank" rel="noopener noreferrer" class="db-btn db-btn-amber w-100" style="justify-content:center;font-size:12px;">
                    <i class="bi bi-box-arrow-up-right me-1.5"></i>Ouvrir dans le registre complet
                </a>
            </div>
        </aside>

        <div class="map-controls">
        <div class="map-tools" role="group" aria-label="Outils de carte">
            {# Sélecteur de fond de carte #}
            <div class="tile-switcher-group" role="group" aria-label="Fond cartographique">
                <button type="button" class="tile-switch-btn active" data-tile-mode="plan" title="Plan de rues OpenStreetMap" aria-pressed="true">
                    <i class="bi bi-map"></i><span>Plan</span>
                </button>
                <button type="button" class="tile-switch-btn" data-tile-mode="satellite" title="Imagerie satellite quotidienne NASA" aria-pressed="false">
                    <i class="bi bi-clouds"></i><span>Satellite</span>
                </button>
                <button type="button" class="tile-switch-btn" data-tile-mode="sombre" title="Plan de rues sombre" aria-pressed="false">
                    <i class="bi bi-moon-stars"></i><span>Sombre</span>
                </button>
            </div>

            <span class="map-tools-count" id="routeCount" aria-live="polite">0 parcours indicatif</span>
            <button type="button" id="marketToggle" aria-label="Afficher ou masquer les alertes par marché" title="Alertes par marché" aria-pressed="true">
                <i class="bi bi-geo-alt"></i>Alertes
            </button>
            <button type="button" id="routeToggle" aria-label="Afficher ou masquer les parcours transfrontaliers" title="Parcours transfrontaliers" aria-pressed="true" disabled>
                <i class="bi bi-bezier2"></i>Parcours
            </button>
            <button type="button" id="routeFit" aria-label="Cadrer les parcours indicatifs" title="Cadrer les parcours" disabled>
                <i class="bi bi-crosshair2"></i>Cadrer
            </button>
            <button type="button" id="mapReset" aria-label="Recentrer la carte sur l'Afrique" title="Vue Afrique">
                <i class="bi bi-globe-africa"></i>Vue Afrique
            </button>
            <button type="button" id="mapFullscreen" aria-label="Plein écran" title="Plein écran">
                <i class="bi bi-arrows-fullscreen" id="fsIcon"></i>
            </button>
        </div>

        <details class="category-targets">
            <summary><i class="bi bi-bullseye" aria-hidden="true"></i>Zones par catégorie</summary>
            <div class="category-target-list" id="categoryTargetOptions">
                <div class="category-target-empty">Chargement des catégories…</div>
            </div>
            <p class="category-target-note">Zones indicatives agrégées par marché ; le halo n'est pas une frontière ni une localisation précise.</p>
        </details>
        </div>

        {# Légende enrichie ── #}
        <div class="carte-legend" id="carteLegend">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <button onclick="toggleLegend()" style="display:flex;align-items:center;gap:4px;background:none;border:none;cursor:pointer;color:var(--text);font-size:11px;font-weight:700;padding:0">
                    <i class="bi bi-map me-1"></i>Légende
                </button>
                <button onclick="toggleLegend()" class="legend-toggle-btn" title="Réduire">
                    <i class="bi bi-chevron-down" id="legendToggleIcon"></i>
                </button>
            </div>
            <div id="carteLegendBody">
                <div style="margin-bottom:8px;padding-top:6px;border-top:1px solid var(--border);">
                    <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px;">Couches de la carte</p>
                    <span class="legend-label"><i class="bi bi-geo-alt-fill me-1" style="color:#16856b"></i>Alertes par marché</span><br>
                    <span class="legend-label"><i class="bi bi-bezier2 me-1" style="color:#2563eb"></i>Parcours transfrontaliers</span>
                </div>
                <div style="margin-bottom:8px;padding-top:6px;border-top:1px solid var(--border);">
                    <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px;">Volume : taille du point</p>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#F9A825;font-size:9px"></i>1–5 alertes</span><br>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#F57C00;font-size:11px"></i>6–20 alertes</span><br>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#EF6C00;font-size:13px"></i>21–50 alertes</span><br>
                    <span class="legend-label"><i class="bi bi-circle-fill me-1" style="color:#E65100;font-size:15px"></i>Plus de 50 alertes</span>
                </div>
                <div style="margin-bottom:8px;padding-top:6px;border-top:1px solid var(--border);">
                    <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px;">Priorité dominante (couleur du marqueur)</p>
                    <div style="display:flex;gap:10px;flex-wrap:wrap;">
                        <span class="legend-label"><span class="legend-dot" style="background:#ef4444"></span>Critique</span>
                        <span class="legend-label"><span class="legend-dot" style="background:#f97316"></span>Élevé</span>
                        <span class="legend-label"><span class="legend-dot" style="background:#f59e0b"></span>Modéré</span>
                        <span class="legend-label"><span class="legend-dot" style="background:#22c55e"></span>Faible</span>
                    </div>
                </div>
                <div id="legendActiveFilters" style="font-size:10px;color:var(--muted);border-top:1px solid var(--border);padding-top:6px;margin-top:2px">
                    <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:4px;">Filtres actifs</p>
                    <div id="legendFiltersList" style="display:flex;flex-wrap:wrap;gap:4px;">
                        {% if filters.marche is iterable and filters.marche %}
                            {% for mId in filters.marche %}
                                {% for m in markets %}
                                    {% if (m.id ~ '') == (mId ~ '') %}
                                        <span class="status-pill" style="font-size:9px">Marche : {{ m.nom }}</span>
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        {% endif %}
                        {% if filters.categorie %}  <span class="status-pill" style="font-size:9px">Cat : {{ filters.categorie }}</span>{% endif %}
                        {% if filters.priorite %}   <span class="status-pill" style="font-size:9px">Prio : {{ filters.priorite }}</span>{% endif %}
                        {% if filters.statut %}     <span class="status-pill" style="font-size:9px">Statut : {{ filters.statut }}</span>{% endif %}
                        {% if filters.urgence %}    <span class="status-pill" style="font-size:9px">Urgence : {{ filters.urgence }}</span>{% endif %}
                        {% if filters.typeAlerte %}<span class="status-pill" style="font-size:9px">Type : {{ filters.typeAlerte }}</span>{% endif %}
                        {% if filters.scoreMin or filters.scoreMax %}<span class="status-pill" style="font-size:9px">Score : {{ filters.scoreMin|default('0') }}-{{ filters.scoreMax|default('25') }}</span>{% endif %}
                        {% if filters.origine %}    <span class="status-pill" style="font-size:9px">Origine : {{ filters.origine }}</span>{% endif %}
                        {% if filters.dateDebut %}  <span class="status-pill" style="font-size:9px">Du {{ filters.dateDebut }}</span>{% endif %}
                        {% if filters.dateFin %}    <span class="status-pill" style="font-size:9px">Au {{ filters.dateFin }}</span>{% endif %}
                        {% if not filters.marche and not filters.categorie and not filters.priorite and not filters.statut and not filters.urgence and not filters.typeAlerte and not filters.scoreMin and not filters.scoreMax and not filters.origine and not filters.dateDebut and not filters.dateFin %}
                        <span style="color:var(--muted)">aucun filtre actif</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Spinner #}
        <div class="carte-loading" id="carteLoading">
            <div style="background:#ffffff;border:1px solid var(--border);border-radius:10px;padding:12px 20px;display:flex;align-items:center;gap:10px;">
                <i class="bi bi-arrow-repeat bi-spin" style="color:#16856b"></i>
                <span style="font-size:13px;color:var(--muted);">Chargement…</span>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js" crossorigin=""></script>
<script>
(function() {
    'use strict';

    let map, markersLayer, targetZonesLayer, routeLayer, currentTileLayer;
    let allZones = [];
    let activeLoadController = null;
    const marketInputs = document.querySelectorAll('#fMarche input[name="marche[]"]');
    const marketCount = document.getElementById('carteMarketSelectionCount');
    const AFRICA_BOUNDS = [[-37, -25], [38, 55]];
    const CATEGORY_COLORS = ['#0f766e', '#2563eb', '#7c3aed', '#d97706', '#be123c', '#0891b2', '#4d7c0f'];

    let debounceTimer = null;
    function debouncedLoadZones(delay = 250) {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            loadZones();
        }, delay);
    }

    function updateMarketCount() {
        const selected = [...marketInputs].filter(input => input.checked).length;
        marketCount.textContent = selected ? `${selected} marché${selected > 1 ? 's' : ''} sélectionné${selected > 1 ? 's' : ''}` : 'Tous les marchés';
    }

    marketInputs.forEach(input => input.addEventListener('change', () => {
        updateMarketCount();
        debouncedLoadZones(280);
    }));
    updateMarketCount();

    function categoryColor(value) {
        let hash = 0;
        for (const char of String(value || '')) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
        return CATEGORY_COLORS[hash % CATEGORY_COLORS.length];
    }

    let currentTileMode = 'plan'; // 'plan' | 'satellite' | 'sombre'
    const TILE_CONFIG = {
        plan: {
            url: 'https://tiles.maps.eox.at/wmts/1.0.0/osm_3857/default/g/{z}/{y}/{x}.png',
            subdomains: '',
            attr: 'Données &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap et autres</a>, rendu &copy; <a href="https://eox.at" target="_blank" rel="noopener noreferrer">EOX</a> (<a href="https://maps.eox.at/#data" target="_blank" rel="noopener noreferrer">données</a>)',
            maxZoom: 19,
            maxNativeZoom: 19,
        },
        satellite: {
            url: `https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/VIIRS_SNPP_CorrectedReflectance_TrueColor/default/${new Date(Date.now() - 86400000).toISOString().slice(0, 10)}/GoogleMapsCompatible_Level9/{z}/{y}/{x}.jpg`,
            subdomains: '',
            attr: 'Imagerie quotidienne VIIRS &copy; <a href="https://earthdata.nasa.gov/eosdis/science-system-description/eosdis-components/gibs" target="_blank" rel="noopener noreferrer">NASA EOSDIS GIBS</a>',
            maxZoom: 18,
            maxNativeZoom: 9,
        },
        sombre: {
            url: 'https://tiles.maps.eox.at/wmts/1.0.0/osm_3857/default/g/{z}/{y}/{x}.png',
            subdomains: '',
            attr: 'Données &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap et autres</a>, rendu &copy; <a href="https://eox.at" target="_blank" rel="noopener noreferrer">EOX</a> (<a href="https://maps.eox.at/#data" target="_blank" rel="noopener noreferrer">données</a>)',
            maxZoom: 19,
            maxNativeZoom: 19,
        },
    };

    function setTileMode(mode) {
        if (!map || !TILE_CONFIG[mode]) return;
        currentTileMode = mode;
        const cfg = TILE_CONFIG[mode];

        if (currentTileLayer && map.hasLayer(currentTileLayer)) {
            map.removeLayer(currentTileLayer);
        }
        currentTileLayer = L.tileLayer(cfg.url, {
            attribution: cfg.attr,
            subdomains: cfg.subdomains,
            maxZoom: cfg.maxZoom,
            maxNativeZoom: cfg.maxNativeZoom,
            keepBuffer: 1,
            updateWhenIdle: true,
            crossOrigin: true,
        }).addTo(map);

        currentTileLayer.on('tileerror', () => document.getElementById('map')?.classList.add('map-tiles-unavailable'));
        currentTileLayer.on('load', () => document.getElementById('map')?.classList.remove('map-tiles-unavailable'));

        document.getElementById('map')?.classList.toggle('map-dark-tiles', mode === 'sombre');

        document.querySelectorAll('.tile-switch-btn').forEach(btn => {
            const active = btn.dataset.tileMode === mode;
            btn.classList.toggle('active', active);
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        if (targetZonesLayer && typeof targetZonesLayer.bringToBack === 'function') targetZonesLayer.bringToBack();
        if (markersLayer && typeof markersLayer.bringToFront === 'function') markersLayer.bringToFront();
    }

    function destroyMap() {
        activeLoadController?.abort();
        activeLoadController = null;
        if (map) {
            try { map.remove(); } catch(e) {}
            map = null;
            markersLayer = null;
            targetZonesLayer = null;
            routeLayer = null;
            currentTileLayer = null;
        }
    }

    function initMap() {
        if (map) return;

        const isDark = document.body.classList.contains('dark') || localStorage.getItem('gei-dark') === '1';

        if (typeof L === 'undefined') {
            document.getElementById('map').innerHTML = '<div style="display:grid;place-items:center;height:100%;color:var(--muted);font-size:13px;text-align:center;padding:20px"><div><i class="bi bi-exclamation-triangle" style="font-size:32px;display:block;margin-bottom:10px"></i>Impossible de charger la carte.<br>Veuillez recharger la page.</div></div>';
            return;
        }

        map = L.map('map', {
            center: [5, 20],
            zoom: 4,
            minZoom: 2,
            maxZoom: 18,
            zoomControl: false,
        });

        L.control.zoom({
            position: 'bottomright',
            zoomInTitle: 'Zoom avant',
            zoomOutTitle: 'Zoom arrière',
        }).addTo(map);

        markersLayer = (typeof L.markerClusterGroup === 'function')
            ? L.markerClusterGroup({
                maxClusterRadius: 45,
                spiderfyOnMaxZoom: true,
                showCoverageOnHover: false,
                zoomToBoundsOnClick: true,
                iconCreateFunction: function(cluster) {
                    const count = cluster.getChildCount();
                    let size = 36, cls = 'faible';
                    if (count > 50) { size = 52; cls = 'critique'; }
                    else if (count > 20) { size = 46; cls = 'eleve'; }
                    else if (count > 5) { size = 40; cls = 'modere'; }
                    return L.divIcon({
                        html: `<div class="z-marker ${cls}" style="width:${size}px;height:${size}px;font-size:13px;border-width:3px;">${count > 99 ? '99+' : count}</div>`,
                        className: '',
                        iconSize: [size, size],
                        iconAnchor: [size/2, size/2],
                    });
                },
            }).addTo(map)
            : L.layerGroup().addTo(map);
        targetZonesLayer = L.layerGroup().addTo(map);
        routeLayer = L.featureGroup();

        setTileMode(isDark ? 'sombre' : 'plan');

        map.fitBounds(AFRICA_BOUNDS, { padding: [10, 10] });

        setTimeout(() => { map.invalidateSize(); }, 100);
        setTimeout(() => { map.invalidateSize(); }, 500);

        loadZones();

        document.getElementById('carteFiltersForm').addEventListener('submit', e => {
            e.preventDefault();
            loadZones();
        });
        document.getElementById('marketToggle').addEventListener('click', toggleMarkets);
        document.getElementById('routeToggle').addEventListener('click', toggleRoutes);
        document.getElementById('routeFit').addEventListener('click', fitRoutes);
        document.getElementById('mapReset').addEventListener('click', () => {
            map.fitBounds(AFRICA_BOUNDS, { padding: [20, 20] });
        });
        document.getElementById('mapFullscreen')?.addEventListener('click', toggleFullscreen);

        document.querySelectorAll('.tile-switch-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                setTileMode(btn.dataset.tileMode || 'plan');
            });
        });
    }

    // Mettre à jour les tiles lors du basculement mode nuit
    document.addEventListener('dark-mode-changed', (e) => {
        if (!map) return;
        const isDark = e.detail?.dark ?? (document.body.classList.contains('dark') || localStorage.getItem('gei-dark') === '1');
        if (currentTileMode !== 'satellite') {
            setTileMode(isDark ? 'sombre' : 'plan');
        }
    });

    function toggleFullscreen() {
        const shell = document.querySelector('.carte-shell');
        const icon = document.getElementById('fsIcon');
        if (!document.fullscreenElement) {
            shell?.requestFullscreen().then(() => {
                if (icon) icon.className = 'bi bi-fullscreen-exit';
                setTimeout(() => map?.invalidateSize(), 150);
            }).catch(() => {});
        } else {
            document.exitFullscreen().then(() => {
                if (icon) icon.className = 'bi bi-arrows-fullscreen';
                setTimeout(() => map?.invalidateSize(), 150);
            }).catch(() => {});
        }
    }
    document.addEventListener('fullscreenchange', () => {
        const icon = document.getElementById('fsIcon');
        if (icon) icon.className = document.fullscreenElement ? 'bi bi-fullscreen-exit' : 'bi bi-arrows-fullscreen';
        setTimeout(() => map?.invalidateSize(), 150);
    });

    window.addEventListener('resize', () => { if (map) map.invalidateSize(); });

    document.addEventListener('turbo:load', initMap);
    document.addEventListener('turbo:before-cache', destroyMap);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMap);
    } else {
        initMap();
    }

    function loadZones() {
        const loading = document.getElementById('carteLoading');
        activeLoadController?.abort();
        const controller = new AbortController();
        activeLoadController = controller;
        loading.classList.add('visible');

        const params = new URLSearchParams();
        const form = document.getElementById('carteFiltersForm');
        new FormData(form).forEach((v, k) => { if (v) params.append(k, v); });

        // Mise à jour dynamique des badges de filtres dans la légende
        updateLegendFilters(params);

        const requestOptions = { credentials: 'same-origin', signal: controller.signal };
        const zonesRequest = fetch('/carte/api/zones?' + params.toString(), requestOptions)
            .then(r => {
                if (!r.ok || r.redirected || !r.headers.get('content-type')?.includes('application/json')) {
                    throw new Error('La session a expiré ou les données cartographiques sont indisponibles.');
                }
                return r.json();
            });
        const routesRequest = fetch('/carte/api/parcours?' + params.toString(), requestOptions)
            .then(response => response.ok ? response.json() : []);

        Promise.all([zonesRequest, routesRequest])
            .then(([zones, routes]) => {
                allZones = zones;
                updateCategoryTargets(zones);
                renderMarkers(zones);
                renderSidePanel(zones);
                updateStats(zones);
                renderRoutes(routes);
                history.replaceState(null, '', '/carte?' + params.toString());
            })
            .catch(error => {
                if (error.name === 'AbortError') return;
                const container = document.getElementById('paysListContainer');
                if (container) {
                    container.innerHTML = `<div style="padding:28px 16px;text-align:center;color:var(--muted);font-size:12.5px;">
                        <i class="bi bi-exclamation-triangle text-amber-400" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                        <strong>Carte momentanément indisponible</strong><br>${escHtml(error.message)}<br>
                        <button type="button" class="db-btn db-btn-ghost db-btn-sm" style="margin-top:10px;" onclick="location.reload()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Recharger
                        </button>
                    </div>`;
                }
            })
            .finally(() => {
                if (activeLoadController === controller) {
                    loading.classList.remove('visible');
                    activeLoadController = null;
                }
            });
    }

    function updateLegendFilters(params) {
        const list = document.getElementById('legendFiltersList');
        if (!list) return;
        const chips = [];
        const marcheValues = params.getAll('marche[]');
        if (marcheValues.length > 0) {
            const chipMap = {
                '1': 'Bénin', '2': 'Togo', '3': 'Niger', '4': 'Mali',
                '5': 'Sénégal', '6': "Côte d'Ivoire", '7': 'Ghana',
                '8': 'Guinée', '9': 'Burkina Faso',
            };
            marcheValues.forEach(v => {
                chips.push(`Marché : ${escHtml(chipMap[v] || 'Marché ' + v)}`);
            });
        }
        if (params.get('categorie')) chips.push(`Cat : ${params.get('categorie')}`);
        if (params.get('priorite')) chips.push(`Prio : ${params.get('priorite')}`);
        if (params.get('statut')) chips.push(`Statut : ${params.get('statut')}`);
        if (params.get('urgence')) chips.push(`Urgence : ${params.get('urgence')}`);
        if (params.get('typeAlerte')) chips.push(`Type : ${params.get('typeAlerte')}`);
        if (params.get('scoreMin') || params.get('scoreMax')) chips.push(`Score : ${params.get('scoreMin') || '0'}-${params.get('scoreMax') || '25'}`);
        if (params.get('origine')) chips.push(`Origine : ${params.get('origine')}`);
        if (params.get('dateDebut')) chips.push(`Du ${params.get('dateDebut')}`);
        if (params.get('dateFin')) chips.push(`Au ${params.get('dateFin')}`);

        if (chips.length > 0) {
            list.innerHTML = chips.map(c => `<span class="status-pill" style="font-size:9px">${escHtml(c)}</span>`).join('');
        } else {
            list.innerHTML = '<span style="color:var(--muted)">aucun filtre actif</span>';
        }
    }

    function renderMarkers(zones) {
        markersLayer.clearLayers();
        targetZonesLayer.clearLayers();
        const bounds = [];

        zones.forEach(zone => {
            (zone.localities || []).forEach(locality => {
                const localityLat = Number(locality.latitude);
                const localityLng = Number(locality.longitude);
                if (!Number.isFinite(localityLat) || !Number.isFinite(localityLng)) return;

                bounds.push([localityLat, localityLng]);
                const localityMarker = L.circleMarker([localityLat, localityLng], {
                    radius: 7,
                    color: '#ffffff',
                    weight: 2,
                    fillColor: '#f59e0b',
                    fillOpacity: 0.95,
                }).addTo(targetZonesLayer);
                localityMarker.bindPopup(
                    `<strong>${escHtml(locality.name)}</strong> · ${escHtml(locality.type || 'Localité')}<br>${locality.count} alerte(s)<br>${escHtml(zone.nom)}`,
                    { maxWidth: 240 }
                );
            });

            const count = parseInt(zone.alertCount) || 0;
            // RÈGLE STRICTE : les marchés avec 0 alerte disparaissent de la carte
            if (count <= 0) return;
            if (!zone.latitude || !zone.longitude) return;

            const lat = parseFloat(zone.latitude);
            const lng = parseFloat(zone.longitude);
            bounds.push([lat, lng]);

            const prio = zone.maxPriority || 'faible';
            const categories = Object.entries(zone.categories || {}).sort((a, b) => Number(b[1]) - Number(a[1]));
            const dominantCategory = categories[0]?.[0] || '';
            const targetColor = dominantCategory ? categoryColor(dominantCategory) : '#16856b';
            const targetRadius = Math.min(36, 14 + Math.sqrt(count) * 2.2);

            const targetZone = L.circleMarker([lat, lng], {
                radius: targetRadius,
                color: targetColor,
                weight: 1.5,
                fillColor: targetColor,
                opacity: 0.75,
                fillOpacity: 0.2,
                className: 'target-zone',
                interactive: false,
            }).addTo(targetZonesLayer);

            targetZone.bindTooltip(
                `${escHtml(zone.nom)} · ${count} alerte${count > 1 ? 's' : ''} · ${escHtml(dominantCategory ? categorieLabel(dominantCategory) : 'toutes catégories')}`,
                { className: 'target-zone-tooltip', direction: 'top', offset: [0, -targetRadius] }
            );

            // Double dimension visuelle : taille selon le volume
            let size = 32;
            let fontSize = 11;
            let volClass = 'vol-faible';
            if (count > 50) {
                size = 46;
                fontSize = 13;
                volClass = 'vol-critique';
            } else if (count > 20) {
                size = 40;
                fontSize = 12;
                volClass = 'vol-eleve';
            } else if (count > 5) {
                size = 35;
                fontSize = 12;
                volClass = 'vol-modere';
            }
            if (window.matchMedia('(max-width: 560px)').matches) {
                size = Math.round(size * 0.75);
                fontSize = Math.max(9, Math.round(fontSize * 0.85));
            }

            const label = count > 99 ? '99+' : String(count);

            const icon = L.divIcon({
                html: `<div class="z-marker ${prio} ${volClass}" style="width:${size}px;height:${size}px;font-size:${fontSize}px;" title="${escHtml(zone.nom)} : ${count} alerte(s) (Priorité : ${prio})">
                           ${label}
                       </div>`,
                className: '',
                iconSize:   [size, size],
                iconAnchor: [size / 2, size / 2],
                popupAnchor:[0, -(size / 2) - 4],
            });

            const marker = L.marker([lat, lng], { icon })
                .addTo(markersLayer);
            marker.zoneId = zone.id;

            const cats = zone.categories || {};
            const catHtml = Object.entries(cats).slice(0, 5).map(([k, v]) => {
                const label = categorieLabel(k);
                return `<span class="popup-cat"><span class="category-target-swatch" style="background:${categoryColor(k)}"></span>${escHtml(label)} <strong>${v}</strong></span>`;
            }).join('');

            const corridors = zone.corridors || {};
            const corridorHtml = Object.entries(corridors).slice(0, 5).map(([k, v]) => {
                return `<span class="popup-corridor">${escHtml(k)} <strong>${v}</strong></span>`;
            }).join('');
            const corridorTitleHtml = Object.keys(corridors).length > 0
                ? `<div class="popup-corridors"><div class="popup-corridor-title">Corridors et ports</div>${corridorHtml}</div>`
                : '';

            const popupHtml = `
                <div class="popup-body">
                    <div class="popup-title">
                        <span style="font-size:11px;font-family:monospace;color:#16856b;">${escHtml(zone.codeIso3)}</span>
                        ${escHtml(zone.nom)}
                    </div>
                    <div>
                        <span class="popup-total">${count}</span>
                        <span class="popup-total-label">alerte${count > 1 ? 's' : ''} filtrée${count > 1 ? 's' : ''}</span>
                    </div>
                    ${catHtml ? `<div class="popup-cats">${catHtml}</div>` : ''}
                    ${corridorTitleHtml}
                </div>
                <a class="popup-btn" href="#" onclick="openDrawerForMarket(${zone.marketId || zone.id}, '${escHtml(zone.nom)}', '${escHtml(zone.codeIso3 || '')}'); return false;">
                    <i class="bi bi-layout-sidebar-reverse me-1"></i>Voir les alertes du marché
                </a>`;

            marker.bindPopup(popupHtml, { maxWidth: 300, className: '' });
            marker.on('click', () => highlightPaysCard(zone.id));

        });

        // ── Choroplèthe : polygones de zone par intensité d'alertes ──
        // Important : ajoutés sur targetZonesLayer pour ne pas perturber MarkerCluster
        zones.forEach(zone => {
            const count = parseInt(zone.alertCount) || 0;
            if (!zone.polygonWkt || count <= 0) return;
            if (!zone.latitude || !zone.longitude) return;

            const coords = parseWKTPolygon(zone.polygonWkt);
            if (!coords || coords.length === 0) return;

            const dominantCategory = Object.entries(zone.categories || {}).sort((a, b) => Number(b[1]) - Number(a[1]))[0]?.[0];
            const fillColor = dominantCategory ? categoryColor(dominantCategory) : '#16856b';

            const polygon = L.polygon(coords, {
                fillColor: fillColor,
                color: fillColor,
                weight: 1.8,
                opacity: 0.75,
                fillOpacity: 0.16,
                smoothFactor: 1.2,
            }).addTo(targetZonesLayer);

            polygon.on('mouseover', function() {
                this.setStyle({ weight: 2.8, fillOpacity: 0.32 });
            });
            polygon.on('mouseout', function() {
                this.setStyle({ weight: 1.8, fillOpacity: 0.16 });
            });

            polygon.bindPopup(
                `<strong>${escHtml(zone.nom)}</strong><br>Zone indicative — ${count} alerte${count > 1 ? 's' : ''}`
            );
        });

        targetZonesLayer.eachLayer(layer => {
            if (typeof layer.bringToBack === 'function') layer.bringToBack();
        });
        if (bounds.length > 0) {
            const africanBounds = bounds.filter(b => b[0] >= -37 && b[0] <= 38 && b[1] >= -25 && b[1] <= 55);
            if (africanBounds.length > 0) {
                map.fitBounds(africanBounds, { padding: [60, 60], maxZoom: 8 });
            }
        }
    }

    // ── Calcul de trajectoire courbe (Bézier quadratique géodésique) ──
    function getCurvedSegment(p1, p2, curveFactor = 0.16, flip = false) {
        const lat1 = p1[0], lng1 = p1[1];
        const lat2 = p2[0], lng2 = p2[1];
        const dLat = lat2 - lat1;
        const dLng = lng2 - lng1;
        const dist = Math.hypot(dLat, dLng);
        if (dist < 0.05) return [p1, p2];

        const midLat = (lat1 + lat2) / 2;
        const midLng = (lng1 + lng2) / 2;
        const normLat = -dLng / dist;
        const normLng = dLat / dist;

        const sign = flip ? -1 : 1;
        const ctrlLat = midLat + normLat * dist * curveFactor * sign;
        const ctrlLng = midLng + normLng * dist * curveFactor * sign;

        const steps = Math.max(16, Math.min(36, Math.round(dist * 6)));
        const pts = [];
        for (let i = 0; i <= steps; i++) {
            const t = i / steps;
            const invT = 1 - t;
            const lat = invT * invT * lat1 + 2 * invT * t * ctrlLat + t * t * lat2;
            const lng = invT * invT * lng1 + 2 * invT * t * ctrlLng + t * t * lng2;
            pts.push([lat, lng]);
        }
        return pts;
    }

    function renderRoutes(routes) {
        if (!routeLayer) return;
        routeLayer.clearLayers();

        const uniqueRoutes = new Map();
        routes.forEach(route => {
            const key = (route.markets || []).join(' → ');
            if (!uniqueRoutes.has(key)) {
                uniqueRoutes.set(key, {
                    ...route,
                    occurrences: 0,
                    corridors: new Set(),
                    localites: new Set(),
                    categories: new Set(),
                    alerts: [],
                    maxPriority: 'faible',
                });
            }
            const item = uniqueRoutes.get(key);
            item.occurrences += 1;
            if (route.portCorridor && route.portCorridor !== '—') item.corridors.add(route.portCorridor);
            if (route.localite) item.localites.add(route.localite);
            if (route.categorie) item.categories.add(route.categorie);
            item.alerts.push({
                id: route.id,
                codeGei: route.codeGei,
                priorite: route.priorite,
                portCorridor: route.portCorridor,
                localite: route.localite || null,
                typeLocalisation: route.typeLocalisation || null,
            });
            const prioRanks = { critique: 4, eleve: 3, modere: 2, faible: 1 };
            if ((prioRanks[route.priorite] || 1) > (prioRanks[item.maxPriority] || 1)) {
                item.maxPriority = route.priorite;
            }
        });

        const validRoutes = [...uniqueRoutes.values()].filter(route => Array.isArray(route.points) && route.points.length > 1);

        const prioStyles = {
            critique: { line: '#ef4444', glow: '#f87171', wave: '#ef4444', label: 'Critique' },
            eleve:    { line: '#ea580c', glow: '#fb923c', wave: '#f97316', label: 'Élevé' },
            modere:   { line: '#d97706', glow: '#fde68a', wave: '#f59e0b', label: 'Modéré' },
            faible:   { line: '#0f766e', glow: '#34d399', wave: '#10b981', label: 'Faible' },
        };

        validRoutes.forEach((route, rIndex) => {
            if (!Array.isArray(route.points) || route.points.length < 2) return;
            const prio = route.maxPriority || 'faible';
            const style = prioStyles[prio] || prioStyles.faible;

            // Déterminer la courbure (alternance pour un rendu fluide et sans collision)
            const flip = rIndex % 2 === 1;
            const curveFactor = 0.15 + (rIndex % 3) * 0.04;

            // Assemblage des coordonnées courbes
            const allCurvedPoints = [];
            for (let i = 0; i < route.points.length - 1; i++) {
                const seg = getCurvedSegment(route.points[i], route.points[i + 1], curveFactor, flip);
                if (i > 0) seg.shift();
                allCurvedPoints.push(...seg);
            }

            // 1. Halo lumineux d'arrière-plan (lueur corridor)
            const glowLine = L.polyline(allCurvedPoints, {
                color: style.glow,
                weight: 10,
                opacity: 0.32,
                lineCap: 'round',
                lineJoin: 'round',
                interactive: false,
            }).addTo(routeLayer);

            // 2. Tracé dynamique animé avec tirets fluides
            const line = L.polyline(allCurvedPoints, {
                color: style.line,
                weight: 3.8,
                opacity: 0.95,
                dashArray: '8 8',
                className: 'route-flow-line',
                lineCap: 'round',
                lineJoin: 'round',
            }).addTo(routeLayer);

            const corridorNames = [...route.corridors].join(', ');
            const localiteNames = [...(route.localites || [])].join(', ');
            const catsList = [...route.categories].slice(0, 4).map(c => `<span class="popup-cat">${escHtml(categorieLabel(c))}</span>`).join('');
            const routeLabel = (route.markets || []).join(' ➔ ');

            // Icône selon le type de localisation du 1er item
            const firstAlert = route.alerts?.[0];
            const typeLocIcon = firstAlert?.typeLocalisation === 'port' ? 'bi-anchor'
                : firstAlert?.typeLocalisation === 'aeroport' ? 'bi-airplane'
                : firstAlert?.typeLocalisation === 'localite' ? 'bi-pin-map-fill'
                : 'bi-signpost-2';

            const tooltipHtml = `
                <div style="font-size:11.5px;line-height:1.45;padding:2px;">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px;">
                        <span class="corridor-badge-prio ${prio}">${style.label}</span>
                        <span style="font-size:10px;color:#64748b;font-weight:700;">${route.occurrences} alerte${route.occurrences > 1 ? 's' : ''}</span>
                    </div>
                    <div style="font-weight:800;color:${style.line};"><i class="bi bi-arrow-right-circle me-1"></i>${escHtml(routeLabel)}</div>
                    ${corridorNames ? `<div style="font-size:10.5px;color:#60a5fa;margin-top:2px;"><i class="bi ${typeLocIcon} me-1"></i>${escHtml(corridorNames)}</div>` : ''}
                    ${localiteNames ? `<div style="font-size:10.5px;color:#fbbf24;margin-top:1px;"><i class="bi bi-pin-map-fill me-1"></i>${escHtml(localiteNames)}</div>` : ''}
                </div>`;

            line.bindTooltip(tooltipHtml, { sticky: true });

            const popupHtml = `
                <div class="corridor-popup-card">
                    <div class="corridor-popup-badge-row">
                        <span class="corridor-badge-prio ${prio}">${style.label}</span>
                        <span class="corridor-badge-count">${route.occurrences} alerte${route.occurrences > 1 ? 's' : ''} associée${route.occurrences > 1 ? 's' : ''}</span>
                    </div>
                    <div class="corridor-popup-title">
                        <i class="bi bi-arrow-right-circle text-emerald-600"></i>
                        <span>${escHtml(routeLabel)}</span>
                    </div>
                    ${corridorNames ? `<div class="corridor-popup-sub"><i class="bi ${typeLocIcon} me-1"></i>${escHtml(corridorNames)}</div>` : ''}
                    ${localiteNames ? `<div class="corridor-popup-sub" style="color:#fbbf24"><i class="bi bi-pin-map-fill me-1"></i>${escHtml(localiteNames)}</div>` : ''}
                    ${catsList ? `<div class="corridor-popup-cats">${catsList}</div>` : ''}
                    <button type="button" class="corridor-popup-btn" onclick="openDrawerForCorridorGroup(${rIndex}); return false;">
                        <i class="bi bi-layout-sidebar-reverse"></i>Voir les alertes de ce transit
                    </button>
                </div>`;

            line.bindPopup(popupHtml, { maxWidth: 320 });

            line.on('mouseover', function() {
                this.setStyle({ weight: 5.5, opacity: 1 });
                glowLine.setStyle({ weight: 15, opacity: 0.6 });
            });
            line.on('mouseout', function() {
                this.setStyle({ weight: 3.8, opacity: 0.95 });
                glowLine.setStyle({ weight: 10, opacity: 0.32 });
            });

            // 3. Flèche d'orientation vectorielle positionnée au milieu de la courbe
            if (allCurvedPoints.length > 4) {
                const midIdx = Math.floor(allCurvedPoints.length / 2);
                const pPrev = map.latLngToLayerPoint(allCurvedPoints[midIdx - 1]);
                const pNext = map.latLngToLayerPoint(allCurvedPoints[midIdx + 1]);
                const midLatLng = allCurvedPoints[midIdx];
                const angle = Math.atan2(pNext.y - pPrev.y, pNext.x - pPrev.x) * 180 / Math.PI;

                L.marker(midLatLng, {
                    interactive: false,
                    icon: L.divIcon({
                        className: 'route-arrow-icon',
                        html: `<svg width="22" height="22" viewBox="0 0 24 24" style="transform:rotate(${angle}deg);display:block;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.35));"><path d="M5 12h14M13 5l7 7-7 7" fill="none" stroke="${style.line}" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
                        iconSize: [22, 22],
                        iconAnchor: [11, 11],
                    }),
                }).addTo(routeLayer);
            }

            // 4. Balises d'étapes le long du parcours
            route.points.forEach((point, index) => {
                const isStart = index === 0;
                const isEnd = index === route.points.length - 1;
                const marketName = route.markets[index] || '';

                if (isStart) {
                    L.marker(point, {
                        icon: L.divIcon({
                            className: '',
                            html: `<div class="route-origin-beacon" style="color:${style.wave}">
                                <div class="route-beacon-wave"></div>
                                <div class="route-beacon-wave route-beacon-wave-2"></div>
                                <div class="route-beacon-core" style="background:${style.line}">
                                    <div class="route-beacon-core-dot"></div>
                                </div>
                            </div>`,
                            iconSize: [26, 26],
                            iconAnchor: [13, 13],
                        }),
                        zIndexOffset: 600,
                    }).bindTooltip(
                        `<div style="font-size:11px;"><strong>Point de départ</strong> : ${escHtml(marketName)}</div>`,
                        { direction: 'top', offset: [0, -12] }
                    ).addTo(routeLayer);
                } else if (isEnd) {
                    L.marker(point, {
                        icon: L.divIcon({
                            className: '',
                            html: `<div class="route-dest-beacon">
                                <div class="route-dest-core" style="background:${style.line}">
                                    <div class="route-dest-target"></div>
                                </div>
                            </div>`,
                            iconSize: [22, 22],
                            iconAnchor: [11, 11],
                        }),
                        zIndexOffset: 600,
                    }).bindTooltip(
                        `<div style="font-size:11px;"><strong>Destination finale</strong> : ${escHtml(marketName)}</div>`,
                        { direction: 'top', offset: [0, -11] }
                    ).addTo(routeLayer);
                } else {
                    L.marker(point, {
                        icon: L.divIcon({
                            className: '',
                            html: `<div class="route-step-beacon" style="background:${style.line}"></div>`,
                            iconSize: [12, 12],
                            iconAnchor: [6, 6],
                        }),
                        zIndexOffset: 500,
                    }).bindTooltip(
                        `<div style="font-size:11px;"><strong>Étape ${index + 1}</strong> : ${escHtml(marketName)}</div>`,
                        { direction: 'top', offset: [0, -6] }
                    ).addTo(routeLayer);
                }
            });
        });

        window.currentCorridorGroups = validRoutes;

        const count = validRoutes.length;
        const countLabel = document.getElementById('routeCount');
        const toggle = document.getElementById('routeToggle');
        const fit = document.getElementById('routeFit');
        if (countLabel) countLabel.textContent = `${count} parcours indicatif${count > 1 ? 's' : ''}`;
        if (toggle) toggle.disabled = count === 0;
        if (fit) fit.disabled = count === 0;
        if (count === 0) {
            if (toggle) toggle.setAttribute('aria-pressed', 'false');
            if (map?.hasLayer(routeLayer)) map.removeLayer(routeLayer);
        } else {
            // Afficher automatiquement les parcours dès qu'ils existent
            if (!map?.hasLayer(routeLayer)) {
                routeLayer.addTo(map);
            }
            if (toggle) toggle.setAttribute('aria-pressed', 'true');
        }
    }

    function toggleMarkets() {
        if (!map || !markersLayer || !targetZonesLayer) return;
        const button = document.getElementById('marketToggle');
        const visible = button?.getAttribute('aria-pressed') === 'true';
        const layers = [markersLayer, targetZonesLayer];
        layers.forEach(layer => {
            if (visible) {
                map.removeLayer(layer);
            } else {
                layer.addTo(map);
            }
        });
        button?.setAttribute('aria-pressed', visible ? 'false' : 'true');
    }

    function toggleRoutes() {
        if (!map || !routeLayer) return;
        const button = document.getElementById('routeToggle');
        const visible = button?.getAttribute('aria-pressed') === 'true';
        if (visible) {
            map.removeLayer(routeLayer);
            button.setAttribute('aria-pressed', 'false');
        } else {
            routeLayer.addTo(map);
            button.setAttribute('aria-pressed', 'true');
        }
    }

    function fitRoutes() {
        if (!map || !routeLayer?.getBounds().isValid()) return;
        map.fitBounds(routeLayer.getBounds(), { padding: [50, 50], maxZoom: 7 });
    }

    function renderSidePanel(zones) {
        const container = document.getElementById('paysListContainer');
        const sorted    = [...zones].sort((a, b) => b.alertCount - a.alertCount);
        const activeZones = sorted.filter(z => (parseInt(z.alertCount) || 0) > 0);

        if (activeZones.length === 0) {
            container.innerHTML = `<div style="padding:28px 16px;text-align:center;color:var(--muted);font-size:12.5px;">
                <i class="bi bi-funnel text-amber-400" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                <strong>Aucune alerte trouvée</strong><br>
                Aucun résultat pour les critères sélectionnés.<br>
                <a href="/carte" class="db-btn db-btn-ghost db-btn-sm" style="margin-top:10px;display:inline-flex;">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Réinitialiser les filtres
                </a>
            </div>`;
            return;
        }

        container.innerHTML = activeZones.map(zone => {
            const count = parseInt(zone.alertCount) || 0;
            const prio  = zone.maxPriority || 'faible';
            const cats  = zone.categories || {};
            const catList = Object.entries(cats).slice(0, 3)
                .map(([k, v]) => `${categorieLabel(k)} (${v})`).join(', ');
            const colors = { critique: '#ef4444', eleve: '#f97316', modere: '#f59e0b', faible: '#22c55e' };

            return `<div class="pays-card" id="pays-card-${zone.id}" onclick="focusZone(${zone.id}, ${zone.latitude}, ${zone.longitude})">
                <div class="pays-badge-count" style="background:${colors[prio] ?? '#64748b'}">${count > 99 ? '99+' : count}</div>
                <div class="pays-card-info">
                    <div style="display:flex;align-items:center;gap:6px;">
                        <span class="pays-card-iso">${escHtml(zone.codeIso3 ?? '')}</span>
                        <span class="pays-card-nom">${escHtml(zone.nom)}</span>
                    </div>
                    ${catList ? `<div class="pays-card-cats">${escHtml(catList)}</div>` : '<div class="pays-card-cats">Alertes actives</div>'}
                </div>
                <i class="bi bi-chevron-right pays-card-chevron"></i>
            </div>`;
        }).join('');
    }

    function updateStats(zones) {
        const activeZones = zones.filter(z => (parseInt(z.alertCount) || 0) > 0);
        const total = activeZones.reduce((s, z) => s + (parseInt(z.alertCount) || 0), 0);
        document.getElementById('totalPays').textContent    = activeZones.length;
        document.getElementById('totalAlertes').textContent = total;
    }

    function updateCategoryTargets(zones) {
        const container = document.getElementById('categoryTargetOptions');
        const select = document.getElementById('fCategorie');
        if (!container || !select) return;

        const counts = new Map();
        zones.forEach(zone => {
            Object.entries(zone.categories || {}).forEach(([category, count]) => {
                counts.set(category, (counts.get(category) || 0) + (Number(count) || 0));
            });
        });
        const selected = select.value;
        const entries = [...counts.entries()].sort((a, b) => b[1] - a[1]);
        const allCount = entries.reduce((sum, [, count]) => sum + count, 0);
        const options = [{
            value: '',
            label: 'Toutes',
            count: allCount,
            color: '#16856b',
        }, ...entries.map(([value, count]) => ({
            value,
            label: categorieLabel(value),
            count,
            color: categoryColor(value),
        }))];

        container.innerHTML = options.map(option => `
            <button type="button" class="category-target" data-category="${escHtml(option.value)}"
                    aria-pressed="${selected === option.value ? 'true' : 'false'}">
                <span class="category-target-swatch" style="background:${option.color}"></span>
                <span>${escHtml(option.label)}</span>
                <span class="category-target-count">${option.count}</span>
            </button>
        `).join('') || '<div class="category-target-empty">Aucune zone avec des alertes pour ces filtres.</div>';

        container.querySelectorAll('.category-target').forEach(button => {
            button.addEventListener('click', () => {
                const value = button.dataset.category || '';
                if (value && ![...select.options].some(option => option.value === value)) {
                    select.add(new Option(categorieLabel(value), value));
                }
                select.value = value;
                loadZones();
            });
        });
    }

    function focusZone(zoneId, lat, lng) {
        const fLat = parseFloat(lat);
        const fLng = parseFloat(lng);
        highlightPaysCard(zoneId);

        let targetMarker = null;
        markersLayer.eachLayer(layer => {
            if (layer.zoneId === zoneId) {
                targetMarker = layer;
            } else if (layer.getLatLng) {
                const pos = layer.getLatLng();
                if (Math.abs(pos.lat - fLat) < 0.01 && Math.abs(pos.lng - fLng) < 0.01) {
                    targetMarker = layer;
                }
            }
        });

        if (targetMarker) {
            if (typeof markersLayer.zoomToShowLayer === 'function') {
                markersLayer.zoomToShowLayer(targetMarker, () => {
                    targetMarker.openPopup();
                });
            } else {
                if (!isNaN(fLat) && !isNaN(fLng)) {
                    map.setView([fLat, fLng], 7, { animate: true });
                }
                targetMarker.openPopup();
            }
        } else if (!isNaN(fLat) && !isNaN(fLng)) {
            map.setView([fLat, fLng], 7, { animate: true });
        }
    }

    function highlightPaysCard(zoneId) {
        document.querySelectorAll('.pays-card').forEach(el => el.classList.remove('selected'));
        const card = document.getElementById(`pays-card-${zoneId}`);
        if (card) {
            card.classList.add('selected');
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    // ── Gestion du Tiroir Latéral d'Alertes (Drawer) ──
    let currentDrawerAlerts = [];
    const drawer = document.getElementById('carteAlertsDrawer');
    const drawerLoading = document.getElementById('drawerLoading');
    const drawerList = document.getElementById('drawerAlertsList');
    const drawerTitle = document.getElementById('drawerTitle');
    const drawerSubtitle = document.getElementById('drawerSubtitle');
    const drawerPrioBadge = document.getElementById('drawerPrioBadge');
    const drawerSearch = document.getElementById('drawerSearchInput');
    const drawerCountChip = document.getElementById('drawerFilteredCount');
    const drawerRegisterBtn = document.getElementById('drawerOpenRegisterBtn');

    function collapseMapPanels() {
        const categoryTargets = document.querySelector('.category-targets');
        if (categoryTargets) categoryTargets.open = false;
        const legend = document.getElementById('carteLegend');
        const icon = document.getElementById('legendToggleIcon');
        legend?.classList.remove('legend-expanded');
        if (icon) icon.style.transform = 'rotate(-90deg)';
    }

    function openDrawerForMarket(marketId, marketName, iso3 = '') {
        if (!drawer) return;
        collapseMapPanels();
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        drawerTitle.textContent = (iso3 ? iso3 + ' · ' : '') + marketName;
        drawerSubtitle.textContent = 'Chargement des alertes...';
        drawerPrioBadge.textContent = 'MARCHÉ SÉLECTIONNÉ';
        drawerPrioBadge.className = 'drawer-badge-prio';
        if (drawerLoading) drawerLoading.style.display = 'flex';
        if (drawerList) drawerList.innerHTML = '';
        if (drawerSearch) drawerSearch.value = '';

        const params = new URLSearchParams();
        params.set('marketId', marketId);
        const fForm = document.getElementById('carteFiltersForm');
        new FormData(fForm).forEach((v, k) => { if (v && k !== 'marche[]') params.append(k, v); });

        if (drawerRegisterBtn) drawerRegisterBtn.href = '/alert/?' + params.toString();

        fetch('/carte/api/alertes?' + params.toString(), { credentials: 'same-origin' })
            .then(r => r.ok ? r.json() : [])
            .then(alerts => {
                currentDrawerAlerts = alerts;
                drawerSubtitle.textContent = `${alerts.length} alerte${alerts.length > 1 ? 's' : ''} filtrée${alerts.length > 1 ? 's' : ''}`;
                renderDrawerAlerts(alerts);
            })
            .catch(() => {
                if (drawerList) drawerList.innerHTML = '<div class="drawer-empty"><i class="bi bi-exclamation-triangle text-amber-500 mb-2" style="font-size:24px;display:block;"></i>Impossible de charger les alertes.</div>';
            })
            .finally(() => {
                if (drawerLoading) drawerLoading.style.display = 'none';
            });
    }

    function openDrawerForCorridorGroup(groupIndex) {
        const group = (window.currentCorridorGroups || [])[groupIndex];
        if (!group || !drawer) return;
        collapseMapPanels();
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        drawerTitle.innerHTML = `<i class="bi bi-bezier2 text-emerald-600 me-1"></i>${escHtml((group.markets || []).join(' ➔ '))}`;
        drawerSubtitle.textContent = `${group.occurrences} alerte${group.occurrences > 1 ? 's' : ''} de transit`;
        drawerPrioBadge.textContent = 'CORRIDOR DE TRANSIT';
        drawerPrioBadge.className = `drawer-badge-prio ${group.maxPriority || 'faible'}`;
        if (drawerLoading) drawerLoading.style.display = 'flex';
        if (drawerList) drawerList.innerHTML = '';
        if (drawerSearch) drawerSearch.value = '';

        const params = new URLSearchParams();
        if (group.principalId) params.set('marketId', group.principalId);
        const fForm = document.getElementById('carteFiltersForm');
        new FormData(fForm).forEach((v, k) => { if (v && k !== 'marche[]') params.append(k, v); });

        if (drawerRegisterBtn) drawerRegisterBtn.href = '/alert/?' + params.toString();

        fetch('/carte/api/alertes?' + params.toString(), { credentials: 'same-origin' })
            .then(r => r.ok ? r.json() : [])
            .then(alerts => {
                const routeAlertIds = new Set((group.alerts || []).map(a => a.id));
                let filtered = alerts.filter(a => routeAlertIds.has(a.id));
                if (filtered.length === 0) filtered = alerts;
                currentDrawerAlerts = filtered;
                drawerSubtitle.textContent = `${filtered.length} alerte${filtered.length > 1 ? 's' : ''} associée${filtered.length > 1 ? 's' : ''}`;
                renderDrawerAlerts(filtered);
            })
            .catch(() => {
                if (drawerList) drawerList.innerHTML = '<div class="drawer-empty"><i class="bi bi-exclamation-triangle text-amber-500 mb-2" style="font-size:24px;display:block;"></i>Impossible de charger les alertes.</div>';
            })
            .finally(() => {
                if (drawerLoading) drawerLoading.style.display = 'none';
            });
    }

    function closeDrawer() {
        if (!drawer) return;
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
    }

    function renderDrawerAlerts(alerts) {
        if (!drawerList) return;
        if (drawerCountChip) drawerCountChip.textContent = alerts.length;
        if (!alerts || alerts.length === 0) {
            drawerList.innerHTML = '<div class="drawer-empty"><i class="bi bi-inbox text-slate-400 mb-2" style="font-size:28px;display:block;"></i>Aucune alerte pour cette sélection.</div>';
            return;
        }

        drawerList.innerHTML = alerts.map(a => {
            const prio = a.niveauPriorite || 'faible';
            const alertRef = a.token || a.id;
            return `<a href="/alert/${encodeURIComponent(alertRef)}" target="_blank" rel="noopener noreferrer" class="drawer-alert-card">
                <div class="drawer-alert-header">
                    <span class="drawer-alert-code"><i class="bi bi-shield-fill-exclamation"></i>${escHtml(a.codeGei)}</span>
                    <span class="drawer-alert-badge ${prio}">${escHtml(a.prioriteLabel || prio)}</span>
                </div>
                ${a.resumeExecutif ? `<div class="drawer-alert-resume">${escHtml(a.resumeExecutif)}</div>` : ''}
                <div class="drawer-alert-meta">
                    <span>${escHtml(a.categorieLabel || a.categorie || '—')}</span>
                    ${(a.localite || (a.portCorridor && a.portCorridor !== '—')) ? `<span style="color:#0f766e;"><i class="bi bi-geo-alt me-0.5"></i>${escHtml(a.localite || a.portCorridor)}</span>` : ''}
                    <span><i class="bi bi-calendar3 me-1"></i>${escHtml(a.dateCreation || '')}</span>
                </div>
            </a>`;
        }).join('');
    }

    if (drawerSearch) {
        drawerSearch.addEventListener('input', () => {
            const q = drawerSearch.value.trim().toLowerCase();
            if (!q) {
                renderDrawerAlerts(currentDrawerAlerts);
                return;
            }
            const filtered = currentDrawerAlerts.filter(a => {
                return (a.codeGei && a.codeGei.toLowerCase().includes(q)) ||
                       (a.resumeExecutif && a.resumeExecutif.toLowerCase().includes(q)) ||
                       (a.categorie && a.categorie.toLowerCase().includes(q)) ||
                       (a.localite && a.localite.toLowerCase().includes(q)) ||
                       (a.portCorridor && a.portCorridor.toLowerCase().includes(q)) ||
                       (a.statutLabel && a.statutLabel.toLowerCase().includes(q));
            });
            renderDrawerAlerts(filtered);
        });
    }

    document.getElementById('drawerCloseBtn')?.addEventListener('click', closeDrawer);

    function loadAlertesList(zoneId, zoneName) {
        openDrawerForMarket(zoneId, zoneName);
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function parseWKTPolygon(wkt) {
        if (!wkt || typeof wkt !== 'string') return [];
        const match = wkt.match(/POLYGON\s*\(\s*\(?\s*(\(.*\))\s*\)?\s*\)/i);
        if (!match) return [];
        const ringStr = match[1].trim();
        const coordPairs = ringStr.split(',').map(p => p.trim());
        const coords = [];
        coordPairs.forEach(pair => {
            const parts = pair.replace(/[()]/g, '').trim().split(/\s+/);
            if (parts.length >= 2) {
                const lon = parseFloat(parts[0]);
                const lat = parseFloat(parts[1]);
                if (!isNaN(lon) && !isNaN(lat)) coords.push([lat, lon]);
            }
        });
        return coords;
    }

    const catLabels = {
        // Legacy enum values (for backward compatibility with old data)
        container_suspect: 'Conteneur suspect',
        flux_terrestre: 'Flux terrestre',
        acteur: 'Acteur',
        modus_operandi: 'Modus operandi',
        transit_tabac: 'Transit tabac',
        saisie: 'Saisie',
        veille_marche: 'Veille marché',
        tabac_brut: 'Tabac brut',
        importation_tabac: 'Import tabac',
        transit_cigarettes: 'Transit cigarettes',
        tabac_manufacture: 'Tabac manufacturé',
        signal_faible: 'Signal faible',
        signalement_operationnel: 'Signalement opérationnel',
        controle_cargaison: 'Contrôle cargaison',
        controle_documentaire: 'Contrôle documentaire',
        saisies_consolidees: 'Saisies consolidées',
        incoherence_declaration: 'Incohérence déclaration',
        suivi_operationnel: 'Suivi opérationnel',
        renseignement_logistique: 'Renseignement logistique',
        fret_express: 'Fret express',
        mouvement_transfrontalier: 'Mouvement transfrontalier',
        autre: 'Autre',
    };
    function categorieLabel(val) {
        if (!val) return '—';
        // If the value is already a French libellé (contains spaces or accented chars), return as-is
        if (val.includes(' ') || /[àâäéèêëïîôùûüÿçÀÂÄÉÈÊËÏÎÔÙÛÜŸÇ]/.test(val)) {
            return val;
        }
        // Otherwise, try to map from legacy enum value
        return catLabels[val] || val.replace(/[_-]+/g, ' ').replace(/\s+/g, ' ').trim();
    }

    window.loadAlertesList = loadAlertesList;
    window.openDrawerForMarket = openDrawerForMarket;
    window.openDrawerForCorridorGroup = openDrawerForCorridorGroup;
    window.closeDrawer     = closeDrawer;
    window.focusZone       = focusZone;
    window.toggleLegend    = function() {
        const legend = document.getElementById('carteLegend');
        const icon = document.getElementById('legendToggleIcon');
        if (legend.classList.contains('legend-expanded')) {
            legend.classList.remove('legend-expanded');
            if (icon) icon.style.transform = 'rotate(-90deg)';
        } else {
            const categoryTargets = document.querySelector('.category-targets');
            if (categoryTargets) categoryTargets.open = false;
            legend.classList.add('legend-expanded');
            if (icon) icon.style.transform = 'rotate(0deg)';
        }
    };
    document.querySelector('.category-targets')?.addEventListener('toggle', event => {
        if (!event.currentTarget.open) return;
        const legend = document.getElementById('carteLegend');
        const icon = document.getElementById('legendToggleIcon');
        legend?.classList.remove('legend-expanded');
        if (icon) icon.style.transform = 'rotate(-90deg)';
    });
})();
</script>
{% endblock %}
