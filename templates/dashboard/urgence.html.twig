{% extends 'base.html.twig' %}

{% block title %}Dossiers d'urgence 72h · Plateforme GEI{% endblock %}
{% block header_title %}Urgence 72h{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# En-tête de page #}
    <div class="page-header-row mb-4">
        <div>
            <p class="page-eyebrow">
                <i class="bi bi-stopwatch me-1.5 text-amber-500"></i>
                Suivi SLA temps réel · Annexe E
            </p>
            <h2 class="page-title">Dossiers d'urgence 72h</h2>
            <p class="page-subtitle">
                Workflow opérationnel : Détection (T0) → Coordination opérationnelle (T+48h) → Suivi & clôture (T+72h)
            </p>
        </div>
        <div class="header-actions-group">
            {% if active_cases|length > 0 %}
            <span class="status-pill status-urgence-actif" title="Dossiers sous surveillance continue SLA 72h">
                <span class="status-dot status-dot-live"></span>
                {{ active_cases|length }} cas actif{{ active_cases|length > 1 ? 's' : '' }}
            </span>
            {% endif %}
            <a href="{{ path('app_dashboard_operationnel') }}" class="db-btn db-btn-top-dashboard">
                <i class="bi bi-speedometer2 me-1.5"></i>Dashboard
            </a>
        </div>
    </div>

    {# Liste des cas d'urgence 72h #}
    {% for case in active_cases %}

    <div class="db-card mb-4 urgence-card-container">
        <div class="db-card-header">
            <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
                <a href="{{ path('app_alert_show', {token: encrypt_id(case.alert.id, 'alert')}) }}"
                   class="code-gei-link" style="font-size:15px;letter-spacing:0.02em">
                    {{ case.alert.codeGei }}
                </a>
                <span style="font-weight:700;color:var(--text);font-size:13px">
                    <i class="bi bi-globe-africa me-1" style="color:var(--muted)"></i>
                    {{ case.alert.market.nom }}
                </span>
                <span style="font-size:11px;color:var(--muted)">
                    <i class="bi bi-calendar-event me-1"></i>
                    Activé le {{ case.dateActivation|date('d/m/Y à H:i') }}
                </span>
            </div>
            <div class="case-header-actions">
                <a href="{{ path('app_urgence_case_pdf', {id: case.id}) }}" class="db-btn db-btn-export" title="Télécharger le rapport PDF de ce dossier">
                    <i class="bi bi-file-earmark-pdf"></i><span>Exporter le suivi PDF</span>
                </a>
                {# Timer SLA temps réel #}
                {% include 'components/_sla_timer.html.twig' with {case: case} %}
            </div>
        </div>

        {# Phases SLA — grille responsive ordonnée chronologiquement #}
        <div class="db-card-body p-0">
            <div class="urgence-scroll-wrapper">
                <div class="urgence-phases-grid">
                    {% for phase in case.sortedPhases %}
                    <div class="urgence-phase-card {% if phase.isTerminee %}phase-done
                                      {% elseif phase.isEnRetard %}phase-late
                                      {% else %}phase-current{% endif %}">
                        {# Header de phase : badge numéro et tag SLA sans tiret #}
                        <div class="phase-card-top">
                            <span class="phase-tag-num">{{ phase.phase.phaseNumero() }}</span>
                            <span class="phase-tag-sla">{{ phase.phase.slaLabel() }}</span>
                        </div>

                        {# Titre de la phase : dénomination nette et professionnelle sans tiret vibecoder #}
                        <h4 class="phase-card-title">{{ phase.phase.label() }}</h4>

                        {% if phase.phase.value in ['coordination', 'suivi'] %}
                            {% if phase.commentaire %}
                                <div class="phase-observation">
                                    <span class="phase-observation-label"><i class="bi bi-chat-left-text me-1"></i>Observation</span>
                                    <p>{{ phase.commentaire }}</p>
                                </div>
                            {% endif %}
                            <details class="phase-observation-editor" {% if not phase.commentaire %}open{% endif %}>
                                <summary>
                                    <i class="bi bi-pencil-square me-1"></i>
                                    {{ phase.commentaire ? 'Modifier l’observation' : 'Ajouter une observation' }}
                                </summary>
                                <form method="post" action="{{ path('app_urgence_phase_observation', {id: phase.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('phase-observation-' ~ phase.id) }}">
                                    <label for="observation-{{ phase.id }}" class="visually-hidden">Observation — {{ phase.phase.label() }}</label>
                                    <textarea id="observation-{{ phase.id }}" name="commentaire" rows="3" maxlength="5000"
                                              placeholder="Décrire les faits observés, décisions ou points de vigilance…">{{ phase.commentaire }}</textarea>
                                    <button type="submit" class="db-btn db-btn-validate-step db-btn-sm">
                                        <i class="bi bi-check2 me-1"></i>Enregistrer
                                    </button>
                                </form>
                            </details>
                        {% endif %}

                        {# Séparateur subtil #}
                        <div class="phase-card-sep"></div>

                        {# Statut & Action #}
                        <div class="phase-card-footer">
                            {% if phase.isTerminee %}
                                {% if phase.isTermineeAvecRetard %}
                                    <span class="status-pill status-critique" title="Complétée après l'échéance SLA">
                                        <span class="status-dot"></span>Complétée avec retard
                                    </span>
                                {% else %}
                                    <span class="status-pill status-clos">
                                        <span class="status-dot"></span>Complétée
                                    </span>
                                {% endif %}
                            {% elseif phase.isEnRetard %}
                                <span class="status-pill status-critique">
                                    <span class="status-dot"></span>En retard
                                </span>
                                <form method="post" action="{{ path('app_urgence_phase_advance', {id: phase.id}) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('advance-phase-' ~ phase.id) }}">
                                    <button type="submit" class="db-btn db-btn-red db-btn-sm" title="Marquer cette phase comme complétée">
                                        <i class="bi bi-check2-circle me-1"></i>Compléter
                                    </button>
                                </form>
                            {% else %}
                                <span class="status-pill status-en_cours">
                                    <span class="status-dot"></span>En cours
                                </span>
                                <form method="post" action="{{ path('app_urgence_phase_advance', {id: phase.id}) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('advance-phase-' ~ phase.id) }}">
                                    <button type="submit" class="db-btn db-btn-validate-step db-btn-sm" title="Marquer cette phase comme complétée">
                                        <i class="bi bi-check2-circle me-1"></i>Compléter
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Barre de progression globale du cas #}
        {% set done = case.phases|filter(p => p.isTerminee)|length %}
        {% set total = case.phases|length %}
        {% if total > 0 %}
        <div class="urgence-progress-wrapper">
            <div class="d-flex justify-between items-center mb-1.5" style="display:flex;justify-content:space-between;align-items:center;">
                <span class="urgence-progress-label">
                    Progression du protocole · {{ done }}/{{ total }} phases validées
                </span>
                <span class="urgence-progress-pct" style="color:{% if done == total %}var(--green){% elseif (done / total) >= 0.5 %}var(--amber){% else %}var(--red){% endif %};">
                    {{ ((done / total) * 100)|round }}%
                </span>
            </div>
            <div class="urgence-progress-track">
                <div class="urgence-progress-bar"
                     style="width:{{ ((done / total) * 100)|round }}%;
                            background:{% if done == total %}var(--green){% elseif (done / total) >= 0.5 %}var(--amber){% else %}var(--red){% endif %};">
                </div>
            </div>
        </div>
        {% endif %}
    </div>

    {% else %}

    {# État vide #}
    <div class="db-card">
        <div class="db-card-body text-center py-12">
            <i class="bi bi-check-circle fa-2x text-emerald-500 mb-3" style="display:block"></i>
            <p style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:6px">
                Aucun dossier d'urgence 72h en cours
            </p>
            <p style="font-size:12px;color:var(--muted);max-width:440px;margin:0 auto 20px;line-height:1.6">
                Le protocole SLA 72h (Annexe E) est activé dès qu'une alerte prioritaire
                nécessite une coordination opérationnelle renforcée et un suivi accéléré.
            </p>
            <a href="{{ path('app_alert_index') }}" class="db-btn db-btn-top-dashboard">
                <i class="bi bi-shield-check me-1.5"></i>Accéder au registre des alertes
            </a>
        </div>
    </div>

    {% endfor %}

    {% if closed_cases is not empty %}
        <section class="closed-cases-section" aria-labelledby="closed-cases-title">
            <div class="closed-cases-heading">
                <div>
                    <p class="page-eyebrow"><i class="bi bi-archive me-1"></i>Historique</p>
                    <h3 id="closed-cases-title">Suivis clôturés</h3>
                    <p>Les derniers dossiers clôturés et leurs observations restent consultables et exportables.</p>
                </div>
                <span class="closed-cases-count">{{ closed_cases|length }} dossier{{ closed_cases|length > 1 ? 's' : '' }}</span>
            </div>
            <div class="closed-cases-list">
                {% for case in closed_cases %}
                    <article class="closed-case-card">
                        <div class="closed-case-main">
                            <div class="closed-case-title">
                                <a href="{{ path('app_alert_show', {token: encrypt_id(case.alert.id, 'alert')}) }}" class="code-gei-link">
                                    {{ case.alert.codeGei }}
                                </a>
                                <span>{{ case.alert.market.nom }}</span>
                            </div>
                            <p class="closed-case-date">
                                <i class="bi bi-check-circle me-1"></i>
                                Clôturé le {{ case.dateCloture ? case.dateCloture|date('d/m/Y à H:i') : case.dateActivation|date('d/m/Y à H:i') }}
                            </p>
                            {% for phase in case.sortedPhases %}
                                {% if phase.phase.value in ['coordination', 'suivi'] and phase.commentaire %}
                                    <div class="closed-case-observation">
                                        <strong>Observation · {{ phase.phase.label() }}</strong>
                                        <p>{{ phase.commentaire }}</p>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <a href="{{ path('app_urgence_case_pdf', {id: case.id}) }}" class="db-btn db-btn-export" title="Télécharger le rapport PDF de ce dossier">
                            <i class="bi bi-file-earmark-pdf"></i><span>Exporter le PDF</span>
                        </a>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ─── Actions d'en-tête & Bouton Dashboard ─── */
.header-actions-group {
    display: flex;
    align-items: center;
    gap: 10px;
}

.case-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
}

.db-btn-export {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 7px 11px;
    border: 1px solid #d5e4dd;
    border-radius: 7px;
    background: #f5faf7;
    color: #17654f;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background .15s ease, border-color .15s ease, transform .15s ease;
}

.db-btn-export:hover {
    background: #e6f5ef;
    border-color: #9dcdb8;
    color: #0c5c48;
    transform: translateY(-1px);
}

.db-btn-export:focus-visible,
.phase-observation-editor summary:focus-visible {
    outline: 3px solid rgba(22, 133, 107, .3);
    outline-offset: 2px;
}

/* Badge 1 cas actif en vert institutionnel moderne */
.status-pill.status-urgence-actif {
    background: #e6f5ef !important;
    color: #0c5c48 !important;
    border: 1px solid #b9e2d2 !important;
    font-weight: 700;
    font-size: 11px;
    padding: 6px 13px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    box-shadow: 0 1px 3px rgba(22, 133, 107, 0.08);
}

.status-dot.status-dot-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse-dot 1.8s infinite;
}

@keyframes pulse-dot {
    0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    70% {
        transform: scale(1);
        box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
    }
    100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
}

/* Bouton Dashboard réparé : survol vert élégant et contrasté */
.db-btn-top-dashboard {
    background: #ffffff !important;
    color: #17352e !important;
    border: 1px solid #dce8e3 !important;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    text-decoration: none;
}

.db-btn-top-dashboard:hover {
    background: #16856b !important;
    color: #ffffff !important;
    border-color: #16856b !important;
    box-shadow: 0 3px 8px rgba(22, 133, 107, 0.25);
    transform: translateY(-1px);
}

.db-btn-top-dashboard:active {
    transform: translateY(0);
}

/* ─── Grille des 5 phases — Responsive et Pro ─── */
.urgence-card-container {
    overflow: hidden;
}

.urgence-scroll-wrapper {
    width: 100%;
    overflow-x: auto;
    padding: 0;
    scrollbar-width: thin;
}

.urgence-phases-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 0;
    width: 100%;
}

@media(max-width: 900px) {
    .urgence-phases-grid {
        min-width: 660px;
    }
}

.urgence-phase-card {
    padding: 16px 14px;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--card);
    transition: background 0.2s ease, border-color 0.2s ease;
}

.urgence-phase-card:last-child {
    border-right: none;
}

.urgence-phase-card.phase-done {
    background: rgba(52, 211, 153, 0.05);
}

.urgence-phase-card.phase-late {
    background: rgba(239, 68, 68, 0.04);
}

.urgence-phase-card.phase-current {
    background: #ffffff;
}

/* Top bar de chaque carte : badges épurés sans tiret */
.phase-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.phase-tag-num {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    background: var(--card2);
    padding: 2px 7px;
    border-radius: 5px;
    border: 1px solid var(--border);
}

.phase-done .phase-tag-num {
    background: rgba(52, 211, 153, 0.12);
    border-color: rgba(52, 211, 153, 0.3);
    color: #0d5f4c;
}

.phase-late .phase-tag-num {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.3);
    color: #b91c1c;
}

.phase-tag-sla {
    font-size: 10.5px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace, sans-serif;
    color: #16856b;
    background: #e6f5ef;
    padding: 2px 6px;
    border-radius: 4px;
}

.phase-late .phase-tag-sla {
    color: #ef4444;
    background: #fee2e2;
}

/* Titre de phase : zéro trait d'union / cadratin vibecoder */
.phase-card-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    margin: 3px 0 0 0;
    line-height: 1.4;
    min-height: 38px;
    display: flex;
    align-items: flex-start;
    word-break: break-word;
    hyphens: auto;
}

.phase-done .phase-card-title {
    color: #0c5c48;
}

.phase-late .phase-card-title {
    color: #b91c1c;
}

.phase-card-sep {
    height: 1px;
    background: var(--border);
    margin: 4px 0 6px 0;
    opacity: 0.7;
}

.phase-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
}

.phase-observation {
    padding: 8px 9px;
    border-left: 3px solid #16856b;
    border-radius: 0 5px 5px 0;
    background: rgba(22, 133, 107, .07);
}

.phase-observation-label {
    color: #17654f;
    font-size: 10px;
    font-weight: 700;
}

.phase-observation p,
.closed-case-observation p {
    margin: 3px 0 0;
    color: var(--text);
    font-size: 11px;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.phase-observation-editor {
    margin-top: 2px;
    color: var(--muted);
}

.phase-observation-editor summary {
    width: fit-content;
    color: #17654f;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
}

.phase-observation-editor summary::-webkit-details-marker {
    display: none;
}

.phase-observation-editor summary::after {
    content: '⌄';
    margin-left: 5px;
}

.phase-observation-editor[open] summary::after {
    content: '⌃';
}

.phase-observation-editor form {
    display: grid;
    gap: 7px;
    margin-top: 7px;
}

.phase-observation-editor textarea {
    width: 100%;
    min-height: 72px;
    resize: vertical;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    color: var(--text);
    font: inherit;
    font-size: 11px;
    line-height: 1.5;
}

.phase-observation-editor textarea:focus {
    border-color: #16856b;
    outline: 2px solid rgba(22, 133, 107, .15);
}

.phase-observation-editor button {
    justify-self: start;
}

.closed-cases-section {
    margin: 28px 0 10px;
}

.closed-cases-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
}

.closed-cases-heading h3 {
    margin: 3px 0 4px;
    color: var(--text);
    font-size: 18px;
    font-weight: 750;
}

.closed-cases-heading > div > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
}

.closed-cases-count {
    padding: 5px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
}

.closed-cases-list {
    display: grid;
    gap: 10px;
}

.closed-case-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
}

.closed-case-main {
    min-width: 0;
    flex: 1;
}

.closed-case-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.closed-case-title > span,
.closed-case-date {
    color: var(--muted);
    font-size: 11px;
}

.closed-case-date {
    margin: 5px 0 0;
}

.closed-case-observation {
    margin-top: 9px;
    padding: 7px 9px;
    border-left: 3px solid #16856b;
    background: rgba(22, 133, 107, .06);
}

.closed-case-observation strong {
    color: #17654f;
    font-size: 10px;
}

/* Bouton de validation d'étape en vert institutionnel */
.db-btn-validate-step {
    background: #16856b;
    color: #ffffff;
    border: 1px solid #16856b;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.db-btn-validate-step:hover {
    background: #0f5947;
    border-color: #0f5947;
    box-shadow: 0 2px 5px rgba(22, 133, 107, 0.3);
}

/* ─── Barre de progression globale ─── */
.urgence-progress-wrapper {
    padding: 12px 18px 16px;
    background: var(--card2);
    border-top: 1px solid var(--border);
}

.urgence-progress-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
}

.urgence-progress-pct {
    font-size: 12px;
    font-weight: 800;
}

.urgence-progress-track {
    height: 6px;
    background: #e2ece7;
    border-radius: 99px;
    overflow: hidden;
    margin-top: 5px;
}

.urgence-progress-bar {
    height: 100%;
    border-radius: 99px;
    transition: width 0.5s ease;
}

/* ─── Dark mode adaptatif ─── */
body.dark .status-pill.status-urgence-actif {
    background: rgba(52, 211, 153, 0.12) !important;
    color: #34d399 !important;
    border-color: rgba(52, 211, 153, 0.3) !important;
}

body.dark .db-btn-top-dashboard {
    background: #1b2b22 !important;
    color: #e2ede8 !important;
    border-color: #2e4d3c !important;
}

body.dark .db-btn-top-dashboard:hover {
    background: #34d399 !important;
    color: #09120e !important;
    border-color: #34d399 !important;
    box-shadow: 0 3px 10px rgba(52, 211, 153, 0.3);
}

body.dark .urgence-phase-card.phase-current {
    background: var(--card);
}

body.dark .phase-tag-num {
    background: #1e3328;
    border-color: #2e4d3c;
    color: #8fa89b;
}

body.dark .phase-tag-sla {
    color: #34d399;
    background: rgba(52, 211, 153, 0.12);
}

body.dark .urgence-progress-wrapper {
    background: rgba(27, 43, 34, 0.5);
    border-top-color: #2e4d3c;
}

body.dark .urgence-progress-track {
    background: #1b2b22;
}

body.dark .db-btn-export {
    border-color: #2e4d3c;
    background: rgba(52, 211, 153, .08);
    color: #68d9a8;
}

body.dark .db-btn-export:hover {
    border-color: #3b8f71;
