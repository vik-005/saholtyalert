{% extends 'base.html.twig' %}

{% block title %}KPI Stratégiques — Comité AIT{% endblock %}
{% block header_title %}Tableau de Bord KPI Stratégique (Comité AIT) — Partie E§14{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Filtres Période (Optionnel : jours, semaines, mois) -->
    <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl">
        <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Période d'Analyse</p>
        <p class="text-sm text-slate-300 mt-2">
            Du <span class="font-mono font-bold text-amber-400">{{ debut|date('d/m/Y') }}</span>
            au <span class="font-mono font-bold text-amber-400">{{ fin|date('d/m/Y') }}</span>
        </p>
    </div>

    <!-- Section 1 : Cartes KPI Principales (F.1) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Carte 1: Alertes Soumises -->
        <div class="p-5 bg-slate-900 border border-slate-800 rounded-xl shadow-md hover:shadow-lg hover:border-slate-700 transition">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Alertes Soumises</span>
                <span class="text-2xl font-bold {% if kpi_alertes_soumises.trend == 'up' %}text-emerald-400{% elseif kpi_alertes_soumises.trend == 'down' %}text-red-400{% else %}text-slate-400{% endif %}">
                    {% if kpi_alertes_soumises.trend == 'up' %}↑{% elseif kpi_alertes_soumises.trend == 'down' %}↓{% else %}—{% endif %}
                </span>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="text-4xl font-extrabold text-white">{{ kpi_alertes_soumises.value }}</span>
                <span class="text-sm font-semibold text-slate-400">alertes</span>
            </div>
            <p class="text-xs text-slate-400">
                Var. : <span class="font-bold {% if kpi_alertes_soumises.variation >= 0 %}text-emerald-400{% else %}text-red-400{% endif %}">{{ '%+.1f'|format(kpi_alertes_soumises.variation) }}%</span>
                vs période précédente
            </p>
        </div>

        <!-- Carte 2: Alertes Traitées -->
        <div class="p-5 bg-slate-900 border border-slate-800 rounded-xl shadow-md hover:shadow-lg hover:border-slate-700 transition">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Alertes Traitées</span>
                <span class="text-2xl font-bold {% if kpi_alertes_traitees.trend == 'up' %}text-emerald-400{% elseif kpi_alertes_traitees.trend == 'down' %}text-red-400{% else %}text-slate-400{% endif %}">
                    {% if kpi_alertes_traitees.trend == 'up' %}↑{% elseif kpi_alertes_traitees.trend == 'down' %}↓{% else %}—{% endif %}
                </span>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="text-4xl font-extrabold text-white">{{ kpi_alertes_traitees.value }}</span>
                <span class="text-sm font-semibold text-slate-400">traitées</span>
            </div>
            <p class="text-xs text-slate-400">
                Var. : <span class="font-bold {% if kpi_alertes_traitees.variation >= 0 %}text-emerald-400{% else %}text-red-400{% endif %}">{{ '%+.1f'|format(kpi_alertes_traitees.variation) }}%</span>
            </p>
        </div>

        <!-- Carte 3: Taux de Transmission -->
        <div class="p-5 bg-slate-900 border border-slate-800 rounded-xl shadow-md hover:shadow-lg hover:border-slate-700 transition">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-3">Taux de Transmission</span>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="text-4xl font-extrabold text-amber-400">{{ kpi_taux_transmission.value }}%</span>
            </div>
            <p class="text-xs text-slate-400">
                {{ kpi_taux_transmission.count }} / {{ kpi_taux_transmission.total }} alertes transmises
            </p>
        </div>

        <!-- Carte 4: Score Moyen -->
        <div class="p-5 bg-slate-900 border border-slate-800 rounded-xl shadow-md hover:shadow-lg hover:border-slate-700 transition">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-3">Score Moyen GEI</span>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="text-4xl font-extrabold text-emerald-400">{{ kpi_score_moyen.value }}</span>
                <span class="text-sm font-semibold text-slate-400">/100</span>
            </div>
            <p class="text-xs text-slate-400">Qualité moyenne des alertes</p>
        </div>
    </div>

    <!-- Section 2 : Délai Moyen 72h (Suivi Urgence) -->
    <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl shadow-md">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Suivi Réaction 72h</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2">Délai Moyen Traitement</span>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold text-amber-400">{{ delai_moyen_72h }}</span>
                    <span class="text-sm font-semibold text-slate-400">heures</span>
                </div>
                <p class="text-xs text-emerald-400 font-medium mt-2">✓ Objectif ≤ 72.0h {% if delai_moyen_72h <= 72 %}respecté{% else %}dépassé{% endif %}</p>
            </div>

            <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2">Cas Urgence Actifs</span>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold text-white">{{ cases_count }}</span>
                    <span class="text-sm font-semibold text-slate-400">dossiers</span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-2">Cas escaladés en cours</p>
            </div>

            <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2">Taux d'Exploitabilité</span>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold text-emerald-400">
                        {% if kpis.total > 0 %}{{ ((kpis.actionnables / kpis.total) * 100)|number_format(1) }}%{% else %}0%{% endif %}
                    </span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-2">Fiches qualifiées actionnables</p>
            </div>
        </div>
    </div>

    <!-- Section 3 : Répartition par Priorité (F.3 — Graphique Donut) -->
    {% if repartition_priorite %}
    <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl shadow-md">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Répartition par Priorité</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {% for item in repartition_priorite %}
            <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg text-center">
                <p class="text-sm font-bold text-slate-300 mb-2">
                    {% set prio = item.priorite %}
                    {% if prio == 'critique' %}🔴 Critique
                    {% elseif prio == 'eleve' %}🟠 Élevé
                    {% elseif prio == 'modere' %}🟡 Modéré
                    {% elseif prio == 'faible' %}🟢 Faible
                    {% else %}Non classée{% endif %}
                </p>
                <p class="text-3xl font-extrabold text-amber-400">{{ item.nb }}</p>
                <p class="text-xs text-slate-400 mt-1">alertes</p>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Section 4 : Alertes Récentes (F.4 — Table) -->
    {% if alertes_recentes %}
    <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl shadow-md overflow-hidden">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Alertes Récentes (Top 8)</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-xs text-slate-300">
                <thead class="bg-slate-950 text-slate-400 font-semibold border-b border-slate-800">
                    <tr>
                        <th class="p-3 text-left">Code GEI</th>
                        <th class="p-3 text-left">Statut</th>
                        <th class="p-3 text-center">Score</th>
                        <th class="p-3 text-left">Agent</th>
                        <th class="p-3 text-left">Maj. le</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    {% for alert in alertes_recentes %}
                    <tr class="hover:bg-slate-800/40">
                        <td class="p-3 font-mono font-bold text-amber-400">{{ alert.codeGei ?? 'BROUILLON' }}</td>
                        <td class="p-3">
                            <span class="px-2 py-1 bg-slate-800 text-slate-300 rounded text-2xs font-semibold">
                                {{ alert.statut ? alert.statut.label() : '—' }}
                            </span>
                        </td>
                        <td class="p-3 text-center font-bold">{{ alert.scoreGei ?? '-' }}</td>
                        <td class="p-3 text-slate-400">{{ alert.emetteur ? alert.emetteur.nomComplet : 'N/A' }}</td>
                        <td class="p-3 text-slate-500">{{ alert.updatedAt is not null ? alert.updatedAt|date('d/m/Y H:i') : '-' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    <!-- Section 5 : Activité Récente (F.6) -->
    {% if activite_recente %}
    <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl shadow-md overflow-hidden">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Activité Récente (Top 10)</h3>
        <div class="space-y-2">
            {% for log in activite_recente %}
            <div class="p-3 bg-slate-950 border border-slate-800/50 rounded-lg flex items-center justify-between text-xs">
                <div class="flex-1">
                    <span class="font-semibold text-slate-300">{{ log.userName ?? 'Système' }}</span>
                    <span class="text-slate-500 mx-1">·</span>
                    <span class="text-slate-400">{{ log.action }}</span>
                    {% if log.codeGei %}
                        <span class="text-slate-500 mx-1">·</span>
                        <span class="font-mono text-amber-400">{{ log.codeGei }}</span>
                    {% endif %}
                </div>
                <span class="text-slate-500">{{ log.dateAction|date('H:i') }}</span>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Footer: Légende & Explications -->
    <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl">
        <p class="text-2xs text-slate-500 font-medium">
            <span class="font-bold text-slate-400">Légende KPI :</span>
            Alertes soumises = saisies sur la plateforme ;
            Alertes traitées = transmises, archivées ou clôturées ;
            Taux de transmission = % alertes qualifiées transmises ;
            Score moyen = moyenne des scores GEI (0-100) ;
            Délai moyen 72h = temps moyen de réaction sur cas escaladés.
        </p>
    </div>
</div>
{% endblock %}


