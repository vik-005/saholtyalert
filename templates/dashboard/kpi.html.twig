{% extends 'base.html.twig' %}
{% block title %}KPI Stratégiques — Comité AIT{% endblock %}
{% block header_title %}KPI Stratégiques{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête ── #}
    <div class="page-header-row">
        <div>
            <p class="page-eyebrow"><i class="bi-pie-chart me-1.5"></i>Comité AIT — Partie E §14</p>
            <h2 class="page-title">Tableau de bord KPI</h2>
            <p class="page-subtitle">
                Période :
                <strong style="color:var(--amber)">{{ debut|date('d/m/Y') }}</strong>
                →
                <strong style="color:var(--amber)">{{ fin|date('d/m/Y') }}</strong>
            </p>
        </div>
        <a href="{{ path('app_dashboard_statistiques') }}" class="db-btn db-btn-ghost">
            <i class="bi-bar-chart me-1.5"></i>Statistiques détaillées
        </a>
    </div>

    {# ── KPI CARDS ── #}
    <div class="db-kpi-row">

        {# Alertes soumises #}
        <div class="kpi-card">
            <div class="kpi-card-top">
                <div>
                    <p class="kpi-label">Alertes soumises</p>
                    <p class="kpi-value">{{ kpi_alertes_soumises.value }}</p>
                </div>
                <div class="kpi-icon-wrap kpi-icon-amber">
                    <i class="bi-file-text"></i>
                </div>
            </div>
            <div class="kpi-card-bottom">
                <span class="kpi-trend {{ kpi_alertes_soumises.trend == 'up' ? 'kpi-trend-up' : (kpi_alertes_soumises.trend == 'down' ? 'kpi-trend-down' : 'kpi-trend-up') }}">
                    <i class="bi-arrow-{{ kpi_alertes_soumises.trend == 'down' ? 'down' : 'up' }}"></i>
                    {{ kpi_alertes_soumises.variation >= 0 ? '+' : '' }}{{ kpi_alertes_soumises.variation|number_format(1) }}%
                </span>
                <span class="kpi-trend-label">vs période préc.</span>
            </div>
        </div>

        {# Alertes traitées #}
        <div class="kpi-card">
            <div class="kpi-card-top">
                <div>
                    <p class="kpi-label">Alertes traitées</p>
                    <p class="kpi-value">{{ kpi_alertes_traitees.value }}</p>
                </div>
                <div class="kpi-icon-wrap kpi-icon-emerald">
                    <i class="bi-check-circle"></i>
                </div>
            </div>
            <div class="kpi-card-bottom">
                <span class="kpi-trend {{ kpi_alertes_traitees.trend == 'up' ? 'kpi-trend-up' : 'kpi-trend-down' }}">
                    <i class="bi-arrow-{{ kpi_alertes_traitees.trend == 'down' ? 'down' : 'up' }}"></i>
                    {{ kpi_alertes_traitees.variation >= 0 ? '+' : '' }}{{ kpi_alertes_traitees.variation|number_format(1) }}%
                </span>
                <span class="kpi-trend-label">transmises / clôturées</span>
            </div>
        </div>

        {# Taux de transmission #}
        <div class="kpi-card">
            <div class="kpi-card-top">
                <div>
                    <p class="kpi-label">Taux de transmission</p>
                    <p class="kpi-value" style="color:var(--amber)">{{ kpi_taux_transmission.value }}%</p>
                </div>
                <div class="kpi-icon-wrap kpi-icon-blue">
                    <i class="bi-send"></i>
                </div>
            </div>
            <div class="kpi-card-bottom">
                <span class="kpi-trend-label">
                    {{ kpi_taux_transmission.count }} / {{ kpi_taux_transmission.total }} alertes transmises
                </span>
            </div>
        </div>

        {# Score moyen #}
        <div class="kpi-card">
            <div class="kpi-card-top">
                <div>
                    <p class="kpi-label">Score moyen GEI</p>
                    <p class="kpi-value" style="color:var(--green)">{{ kpi_score_moyen.value }}</p>
                </div>
                <div class="kpi-icon-wrap kpi-icon-emerald">
                    <i class="bi-star"></i>
                </div>
            </div>
            <div class="kpi-card-bottom">
                <span class="kpi-trend-label">Qualité moyenne des alertes /25</span>
            </div>
        </div>

    </div>

    {# ── SLA 72h ── #}
    <div class="db-mid-row">

        <div class="db-chart-card">
            <div class="db-card-header db-card-header-border">
                <div>
                    <p class="db-card-eyebrow"><i class="bi-stopwatch me-1.5"></i>Suivi Réaction 72h</p>
                    <p class="db-card-title">Performance SLA urgence</p>
                </div>
            </div>
            <div class="kpi-sla-grid">

                <div class="kpi-sla-item">
                    <p class="kpi-label">Délai moyen traitement</p>
                    <div style="display:flex;align-items:baseline;gap:6px;margin:6px 0">
                        <span class="kpi-value" style="font-size:32px;color:{{ delai_moyen_72h <= 72 ? 'var(--green)' : 'var(--red)' }}">{{ delai_moyen_72h }}</span>
                        <span class="kpi-label">heures</span>
                    </div>
                    <div style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;color:{{ delai_moyen_72h <= 72 ? 'var(--green)' : 'var(--red)' }}">
                        <i class="bi-{{ delai_moyen_72h <= 72 ? 'check-circle' : 'x-circle' }} fa-xs"></i>
                        Objectif ≤ 72h {% if delai_moyen_72h <= 72 %}respecté{% else %}dépassé{% endif %}
                    </div>
                </div>

                <div class="kpi-sla-item">
                    <p class="kpi-label">Cas urgence actifs</p>
                    <div style="display:flex;align-items:baseline;gap:6px;margin:6px 0">
                        <span class="kpi-value" style="font-size:32px">{{ cases_count }}</span>
                        <span class="kpi-label">dossiers</span>
                    </div>
                    <span style="font-size:11px;color:var(--muted)">Cas escaladés en cours</span>
                </div>

                <div class="kpi-sla-item">
                    <p class="kpi-label">Taux d'exploitabilité</p>
                    <div style="display:flex;align-items:baseline;gap:6px;margin:6px 0">
                        <span class="kpi-value" style="font-size:32px;color:var(--green)">
                            {% if kpis.total > 0 %}{{ ((kpis.actionnables / kpis.total) * 100)|number_format(1) }}%{% else %}0%{% endif %}
                        </span>
                    </div>
                    <span style="font-size:11px;color:var(--muted)">Fiches actionnables qualifiées</span>
                </div>

            </div>
        </div>

        {# Répartition priorité #}
        {% if repartition_priorite %}
        <div class="db-chart-card">
            <div class="db-card-header db-card-header-border">
                <div>
                    <p class="db-card-eyebrow"><i class="bi-flag me-1.5"></i>Répartition</p>
                    <p class="db-card-title">Par priorité</p>
                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:10px;margin-top:4px">
                {% for item in repartition_priorite %}
                {% set pval = item.priorite %}
                {% set picon = pval == 'critique' ? 'bi-radioactive' : (pval == 'eleve' ? 'bi-fire' : (pval == 'modere' ? 'bi-exclamation-circle' : 'bi-check-circle')) %}
                {% set pclass = pval == 'critique' ? 'priority-critique' : (pval == 'eleve' ? 'priority-eleve' : (pval == 'modere' ? 'priority-modere' : 'priority-faible')) %}
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                    <span class="priority-badge {{ pclass }}">
                        <i class="bi-{{ picon }} fa-xs me-1"></i>
                        {{ pval|capitalize }}
                    </span>
                    <span style="font-size:18px;font-weight:800;color:var(--text)">{{ item.nb }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

    </div>

    {# ── Alertes récentes ── #}
    {% if alertes_recentes %}
    <div class="db-table-card">
        <div class="db-card-header db-card-header-border" style="padding:14px 16px">
            <div>
                <p class="db-card-eyebrow"><i class="bi-clock me-1.5"></i>Alertes récentes</p>
                <p class="db-card-title">Top 8 — dernières saisies</p>
            </div>
            <a href="{{ path('app_alert_index') }}" class="db-btn db-btn-ghost" style="font-size:11px">
                <i class="bi-arrow-right me-1"></i>Tout voir
            </a>
        </div>
        <div class="db-table-wrap">
            <table class="db-table">
                <thead>
                    <tr>
                        <th><i class="bi-hashtag me-1 opacity-50"></i>Code GEI</th>
                        <th><i class="bi-bullseye me-1 opacity-50"></i>Statut</th>
                        <th class="text-center"><i class="bi-star me-1 opacity-50"></i>Score</th>
                        <th><i class="bi-person me-1 opacity-50"></i>Agent</th>
                        <th><i class="bi-calendar me-1 opacity-50"></i>Mise à jour</th>
                    </tr>
                </thead>
                <tbody>
                    {% for alert in alertes_recentes %}
                    <tr class="db-tr">
                        <td>
                            <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="code-gei-link">
                                {{ alert.codeGei ?? 'BROUILLON' }}
                            </a>
                        </td>
                        <td>
                            <span class="status-pill status-{{ alert.statut ? alert.statut.value : 'ouvert' }}">
                                <span class="status-dot"></span>
                                {{ alert.statut ? alert.statut.label() : '—' }}
                            </span>
                        </td>
                        <td class="text-center">
                            {% if alert.scoreGei %}
                                <span class="score-badge
                                    {% if alert.scoreGei >= 18 %}score-critique
                                    {% elseif alert.scoreGei >= 14 %}score-eleve
                                    {% elseif alert.scoreGei >= 10 %}score-modere
                                    {% else %}score-faible{% endif %}">
                                    {{ alert.scoreGei }}
                                </span>
                            {% else %}
                                <span style="color:var(--muted)">—</span>
                            {% endif %}
                        </td>
                        <td style="color:var(--muted)">{{ alert.emetteur ? alert.emetteur.nomComplet : 'N/A' }}</td>
                        <td style="color:var(--muted);white-space:nowrap">
                            {{ alert.updatedAt is not null ? alert.updatedAt|date('d/m/Y H:i') : '—' }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# ── Activité récente ── #}
    {% if activite_recente %}
    <div class="db-chart-card">
        <div class="db-card-header db-card-header-border">
            <div>
                <p class="db-card-eyebrow"><i class="bi-journal me-1.5"></i>Journal d'activité</p>
                <p class="db-card-title">10 dernières actions</p>
            </div>
        </div>
        <div class="activities-list">
            {% for log in activite_recente %}
            <div class="activity-item">
                <div class="activity-icon-wrap activity-icon-slate">
                    <i class="bi-bullseye fa-xs"></i>
                </div>
                <div class="activity-body">
                    <p class="activity-title">
                        <strong>{{ log.userName ?? 'Système' }}</strong>
                        <span style="font-weight:400;color:var(--muted)"> — {{ log.action }}</span>
                        {% if log.codeGei %}
                            <span class="code-gei-link ms-1" style="font-size:10.5px">{{ log.codeGei }}</span>
                        {% endif %}
                    </p>
                    <span class="activity-meta">{{ log.dateAction|date('d/m/Y à H:i') }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── Note de bas de page ── #}
    <div style="background:var(--card2);border:1px solid var(--border);border-radius:var(--r);padding:12px 16px">
        <p style="font-size:10.5px;color:var(--muted);line-height:1.6">
            <i class="bi-info-circle me-1.5" style="color:var(--amber)"></i>
            <strong>Légende KPI :</strong>
            Alertes soumises = saisies sur la plateforme ·
            Alertes traitées = transmises, archivées ou clôturées ·
            Taux de transmission = % alertes qualifiées transmises ·
            Score moyen = moyenne des scores GEI (0–25) ·
            Délai moyen 72h = temps moyen de réaction sur cas escaladés.
        </p>
    </div>

</div>

<style>
.kpi-sla-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 16px;
}
.kpi-sla-item {
    background: var(--card2);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 14px 16px;
}
@media(max-width:768px) {
    .kpi-sla-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}
