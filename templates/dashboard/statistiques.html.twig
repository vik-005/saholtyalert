{% extends 'base.html.twig' %}
{% block title %}Statistiques GEI{% endblock %}
{% block header_title %}Statistiques{% endblock %}

{% block body %}
<div class="db-wrapper" id="statsPage">

{# ═══════════════════════════════════════════════════════════════════════════
   FILTRES GLOBAUX — s'appliquent à tous les graphiques simultanément
════════════════════════════════════════════════════════════════════════════ #}
<div class="stats-filter-bar" id="globalFilters">
    <form method="get" id="filterForm" class="stats-filter-form">
        <div class="stats-filter-group">
            <label class="stats-filter-label"><i class="bi bi-calendar me-1.5"></i>Période</label>
            <input type="date" name="debut" value="{{ debut }}" class="stats-input" id="filterDebut">
            <span class="text-slate-500 text-xs">→</span>
            <input type="date" name="fin"   value="{{ fin }}"   class="stats-input" id="filterFin">
        </div>

        <div class="stats-filter-group">
            <label class="stats-filter-label"><i class="bi bi-globe-africa me-1.5"></i>Marchés</label>
            <div class="stats-market-checks">
                {% for m in all_markets %}
                <label class="stats-check-label">
                    <input type="checkbox" name="markets[]" value="{{ m.id }}"
                           {% if m.id in selected_markets or selected_markets is empty %}checked{% endif %}
                           class="stats-checkbox">
                    <span>{{ m.codeIso3 }}</span>
                </label>
                {% endfor %}
            </div>
        </div>

        <div class="stats-filter-actions">
            <button type="submit" class="stats-apply-btn">
                <i class="bi bi-arrow-clockwise me-1.5"></i>Appliquer
            </button>
            <a href="{{ path('app_dashboard_statistiques') }}" class="stats-reset-btn">
                <i class="bi bi-x me-1"></i>Reset
            </a>
            <a href="{{ path('app_export_statistiques') }}?debut={{ debut }}&fin={{ fin }}&markets={{ selected_markets|join(',') }}"
               class="stats-apply-btn" style="background:#16856b;color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:5px;"
               title="Exporter les statistiques en Excel">
                <i class="bi bi-file-earmark-spreadsheet"></i> Excel
            </a>
        </div>
    </form>

    <div class="stats-period-shortcuts">
        <button class="stats-shortcut" onclick="setPeriod(7)">7j</button>
        <button class="stats-shortcut" onclick="setPeriod(30)">30j</button>
        <button class="stats-shortcut" onclick="setPeriod(90)">3 mois</button>
        <button class="stats-shortcut" onclick="setPeriod(365)">1 an</button>
    </div>
</div>

<div class="stats-scope-note" role="status">
    <i class="bi bi-info-circle me-1"></i>
    <strong>{{ total_alertes_periode }}</strong> alerte{{ total_alertes_periode > 1 ? 's' : '' }} sur la période sélectionnée
    ({{ debut|date('d/m/Y') }} au {{ fin|date('d/m/Y') }}). Le registre global peut contenir d'autres périodes.
</div>

<div class="stats-card" style="margin-top:16px;">
    <div class="db-card-header">
        <div>
            <p class="db-card-eyebrow"><i class="bi bi-shield-check me-1.5"></i>Qualification juridique</p>
            <p class="db-card-title">Alertes licites et illicites sur la période</p>
        </div>
    </div>
    <div class="stats-row-2col">
        {% for legal_status in legal_status_counts %}
            <div class="stats-scope-note" role="status">
                <strong>
                    {{ legal_status.legalStatus == 'licite' ? 'Licite' : (legal_status.legalStatus == 'illicite' ? 'Illicite' : 'Non renseigné') }}
                </strong>
                <span>{{ legal_status.nb }} alerte{{ legal_status.nb != 1 ? 's' : '' }}</span>
            </div>
        {% endfor %}
    </div>
</div>

{# ═══════════════════════════════════════════════════════════════════════════
   LIGNE 1 — 2 JAUGES + Score Moyen
════════════════════════════════════════════════════════════════════════════ #}
<div class="stats-gauge-row">

    {# Jauge SLA 72h #}
    <div class="stats-card stats-gauge-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-stopwatch me-1.5"></i>SLA Urgence 72h</p>
                <p class="db-card-title">Conformité des délais</p>
            </div>
        </div>
        {% set sla = jauge_sla %}
        <div class="gauge-wrap">
            <canvas id="gaugeSla" width="200" height="110"></canvas>
            <div class="gauge-label">
                {% if sla.taux is not null %}
                    <span class="gauge-val {{ sla.color_class }}">{{ sla.taux }}%</span>
                    <span class="gauge-sub">{{ sla.respectees }}/{{ sla.cloturees }} cas</span>
                {% else %}
                    <span class="gauge-val gauge-gray">N/A</span>
                    <span class="gauge-sub">Aucun cas clôturé</span>
                {% endif %}
            </div>
        </div>
        <div class="gauge-thresholds">
            <span class="gauge-t gauge-t-red">< 70% Critique</span>
            <span class="gauge-t gauge-t-amber">70–89% Moyen</span>
            <span class="gauge-t gauge-t-green">≥ 90% Bon</span>
        </div>
    </div>

    {# Jauge Exploitables #}
    <div class="stats-card stats-gauge-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-lightning me-1.5"></i>Exploitabilité</p>
                <p class="db-card-title">Alertes actionnables</p>
            </div>
        </div>
        {% set exp = jauge_exploitables %}
        <div class="gauge-wrap">
            <canvas id="gaugeExploitables" width="200" height="110"></canvas>
            <div class="gauge-label">
                <span class="gauge-val {{ exp.color_class }}">{{ exp.taux }}%</span>
                <span class="gauge-sub">{{ exp.actionnables }}/{{ exp.total }}</span>
            </div>
        </div>
        <div class="gauge-thresholds">
            <span class="gauge-t gauge-t-red">< 40%</span>
            <span class="gauge-t gauge-t-amber">40–59%</span>
            <span class="gauge-t gauge-t-green">≥ 60%</span>
        </div>
    </div>

    {# Évolution temporelle — line chart #}
    <div class="stats-card stats-card-wide">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-graph-up me-1.5"></i>Évolution</p>
                <p class="db-card-title">Soumissions vs Transmises</p>
            </div>
        </div>
        <div class="db-chart-legend stats-evolution-legend">
            <span class="chart-legend-item chart-legend-amber"><span class="chart-legend-dot"></span>Soumises</span>
            <span class="chart-legend-item chart-legend-emerald"><span class="chart-legend-dot"></span>Transmises</span>
        </div>
        <div class="stats-evolution-chart-wrap">
            <canvas id="chartEvolution" role="img"
                    aria-label="Évolution des alertes soumises et transmises sur la période sélectionnée"></canvas>
        </div>
    </div>

</div>

{# ═══════════════════════════════════════════════════════════════════════════
   LIGNE 2 — VOLUME PAR PAYS + SCORE MOYEN PAR PAYS
════════════════════════════════════════════════════════════════════════════ #}
<div class="stats-row-2col">

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-list-staggered me-1.5"></i>Volume par marché principal</p>
                <p class="db-card-title">Chaque alerte est comptée une seule fois</p>
            </div>
        </div>
        <canvas id="chartVolumeParPays" height="200"></canvas>
    </div>

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-star-half me-1.5"></i>Score moyen par pays</p>
                <p class="db-card-title">Zones les plus sensibles</p>
            </div>
        </div>
        <canvas id="chartScoreMoyenPays" height="200"></canvas>
    </div>

</div>

<div class="stats-card" style="margin-top:16px;">
    <div class="db-card-header">
        <div>
            <p class="db-card-eyebrow"><i class="bi bi-signpost-2 me-1.5"></i>Analyse des parcours</p>
            <p class="db-card-title">Trajets transfrontaliers analysés séparément du volume principal</p>
        </div>
        <div style="display:flex;gap:18px;font-size:12px;color:var(--muted);">
            <span><strong style="color:var(--text)">{{ parcours_stats.avec_parcours }}</strong> avec parcours</span>
            <span><strong style="color:var(--text)">{{ parcours_stats.sans_parcours }}</strong> sans parcours</span>
        </div>
    </div>
    {% if parcours_stats.routes|length > 0 %}
    <div style="position:relative;min-height:120px;">
        <canvas id="chartParcours" style="width:100%;min-height:120px;"></canvas>
    </div>
    <div class="stats-route-list" aria-label="Liste des parcours" style="margin-top:12px;">
        {% for route in parcours_stats.routes|slice(0, 10) %}
            <div class="stats-route-row">
                <span><i class="bi bi-signpost-2 me-1.5" style="color:#34d399"></i>{{ route.trajet }}</span>
                <strong>{{ route.nb }} alerte{{ route.nb > 1 ? 's' : '' }}</strong>
            </div>
        {% endfor %}
    </div>
    {% else %}
    <div style="text-align:center;padding:32px 16px;color:var(--muted);">
        <i class="bi bi-signpost-2" style="font-size:32px;display:block;margin-bottom:10px;opacity:.35;"></i>
        <p style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:4px;">Aucun parcours multi-marchés</p>
        <p style="font-size:12px;">Les alertes doivent avoir au moins un marché associé pour générer un parcours transfrontalier.</p>
    </div>
    {% endif %}
</div>

{# ═══════════════════════════════════════════════════════════════════════════
   LIGNE 3 — STATUTS EMPILÉS + TAUX TRANSMISSION
════════════════════════════════════════════════════════════════════════════ #}
<div class="stats-row-2col">

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-layers me-1.5"></i>Statuts par pays</p>
                <p class="db-card-title">Répartition empilée</p>
            </div>
        </div>
        <canvas id="chartStatutsParPays" height="220"></canvas>
    </div>

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-send me-1.5"></i>Taux transmission</p>
                <p class="db-card-title">Par marché (%)</p>
            </div>
        </div>
        <canvas id="chartTauxTransmission" height="220"></canvas>
    </div>

</div>

{# ═══════════════════════════════════════════════════════════════════════════
   LIGNE 4 — CATÉGORIES DONUT + TOP OPÉRATEURS
════════════════════════════════════════════════════════════════════════════ #}
<div class="stats-row-2col">

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-pie-chart me-1.5"></i>Catégories</p>
                <p class="db-card-title">Répartition par type</p>
            </div>
        </div>
        <div style="display:flex; gap:20px; align-items:center;">
            <div style="position:relative; width:180px; flex-shrink:0;">
                <canvas id="chartCategories" width="180" height="180"></canvas>
            </div>
            <div id="catLegend" class="donut-legend" style="flex:1;"></div>
        </div>
    </div>

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-building me-1.5"></i>Top opérateurs</p>
                <p class="db-card-title">Top {{ top_operateurs|length }}</p>
            </div>
        </div>
        <div style="overflow-y:auto; max-height:260px;">
            <canvas id="chartTopOperateurs" height="250"></canvas>
        </div>
    </div>

</div>

{# ═══════════════════════════════════════════════════════════════════════════
   LIGNE 5 — ACTIVITÉ PAR AGENT + TOP CORRIDORS
════════════════════════════════════════════════════════════════════════════ #}
<div class="stats-row-2col">

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-persons me-1.5"></i>Activité agents</p>
                <p class="db-card-title">Nb soumissions par agent</p>
            </div>
        </div>
        <div style="overflow-y:auto; max-height:300px;">
            <canvas id="chartActiviteAgents" height="280"></canvas>
        </div>
    </div>

    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-signpost-split me-1.5"></i>Top corridors</p>
                <p class="db-card-title">Corridors les plus signalés</p>
            </div>
        </div>
        <div style="overflow-y:auto; max-height:300px;">
            <canvas id="chartTopCorridors" height="280"></canvas>
        </div>
    </div>

</div>

{# ═══════════════════════════════════════════════════════════════════════════
   LIGNE 6 — DÉLAI MOYEN DE TRAITEMENT
════════════════════════════════════════════════════════════════════════════ #}
<div class="stats-row-1col">
    <div class="stats-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-clock me-1.5"></i>Délai de traitement</p>
                <p class="db-card-title">Heures moyennes soumission → clôture par pays</p>
            </div>
        </div>
        <canvas id="chartDelaiMoyen" height="80"></canvas>
    </div>
</div>

</div>{# /db-wrapper #}

{# ═══════════════════════════════════════════════════════════════════════════
   DONNÉES INJECTÉES + SCRIPTS CHART.JS
   Bibliothèque : Chart.js 4.4 (déjà chargée dans base.html.twig)
   Palette : dark navy #090e1a, amber #fbbf24, rouge/vert/orange statuts uniquement
════════════════════════════════════════════════════════════════════════════ #}
{% block javascripts %}{{ parent() }}
<script>
function initStatsCharts() {
document.querySelectorAll('#statsPage canvas').forEach(canvas => {
    const existingChart = Chart.getChart(canvas);
    if (existingChart) existingChart.destroy();
});
// ─── Constantes de couleurs (charte GEI — ne pas modifier) ────────────────
const C = {
    amber:    '#fbbf24',
    orange:   '#fb923c',
    red:      '#ef4444',
    emerald:  '#34d399',
    blue:     '#60a5fa',
    purple:   '#c084fc',
    cyan:     '#22d3ee',
    slate:    '#64748b',
    bg:       '#090e1a',
    card:     '#0f172a',
    border:   'rgba(148,163,184,0.1)',
    text:     '#94a3b8',
    // Statuts
    statut: {
        nouveau: '#60a5fa', ouvert: '#60a5fa',
        en_cours: '#fbbf24', en_cours_analyse: '#fbbf24',
        a_completer: '#fb923c', a_investiguer: '#c084fc',
        ouvert_prioritaire: '#ef4444',
        a_valider_saholty: '#f97316',
        transmis: '#34d399',
        suivi: '#94a3b8',
        archive: '#475569', clos: '#1e293b',
    },
    priorite: {
        critique: 'rgba(239,68,68,0.85)',
        eleve: 'rgba(251,146,60,0.85)',
        modere: 'rgba(251,191,36,0.85)',
        faible: 'rgba(52,211,153,0.85)',
    }
};

// ─── Defaults Chart.js communs ─────────────────────────────────────────────
Chart.defaults.color       = C.text;
Chart.defaults.borderColor = C.border;
Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
Chart.defaults.font.size   = 11;
Chart.defaults.devicePixelRatio = Math.min(window.devicePixelRatio || 1, 3);

const TOOLTIP = {
    backgroundColor: '#1e293b',
    borderColor: 'rgba(148,163,184,0.2)',
    borderWidth: 1,
    padding: 10,
    titleFont: { size: 12, weight: '700' },
    bodyFont: { size: 11 },
};

// ─── Données serveur ───────────────────────────────────────────────────────
const DATA = {
    sla:          {{ jauge_sla|json_encode|raw }},
    exploitables: {{ jauge_exploitables|json_encode|raw }},
    evolution:    {{ evolution|json_encode|raw }},
    volumePays:   {{ volume_par_pays|json_encode|raw }},
    parcours:     {{ parcours_stats|json_encode|raw }},
    scorePays:    {{ score_moyen_pays|json_encode|raw }},
    statutsPays:  {{ statuts_par_pays|json_encode|raw }},
    txTransmission: {{ tx_transmission|json_encode|raw }},
    categories:   {{ repartition_categorie|json_encode|raw }},
    corridors:    {{ top_corridors|json_encode|raw }},
    operateurs:   {{ top_operateurs|json_encode|raw }},
    agents:       {{ activite_agents|json_encode|raw }},
    delaiMoyen:   {{ delai_moyen|json_encode|raw }},
};

// ─── 1. Jauges semi-circulaires ────────────────────────────────────────────
function buildGauge(canvasId, value, color, max = 100) {
    const ctx = document.getElementById(canvasId)?.getContext('2d');
    if (!ctx) return;
    const taux = value ?? 0;
    const rest = max - taux;
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            datasets: [{
                data: [taux, rest],
                backgroundColor: [color, 'rgba(148,163,184,0.08)'],
                borderWidth: 0,
                borderRadius: 4,
            }]
        },
        options: {
            responsive: false,
            circumference: 180,
            rotation: -90,
            cutout: '75%',
            plugins: { legend: { display: false }, tooltip: { enabled: false } },
            animation: { duration: 900, easing: 'easeOutCubic' },
        }
    });
}
const slaColor = DATA.sla.taux === null ? C.slate
    : DATA.sla.taux >= 90 ? C.emerald
    : DATA.sla.taux >= 70 ? C.amber : C.red;
const expColor = DATA.exploitables.taux >= 60 ? C.emerald
    : DATA.exploitables.taux >= 40 ? C.amber : C.red;

buildGauge('gaugeSla',         DATA.sla.taux ?? 0,           slaColor);
buildGauge('gaugeExploitables', DATA.exploitables.taux ?? 0, expColor);

// ─── 2. Évolution temporelle (area line) ──────────────────────────────────
(function() {
    const ctx = document.getElementById('chartEvolution')?.getContext('2d');
    if (!ctx || !DATA.evolution.labels) return;
    const chartHeight = ctx.canvas.clientHeight || 260;
    const ga = ctx.createLinearGradient(0,0,0,chartHeight);
    ga.addColorStop(0, 'rgba(251,191,36,0.25)'); ga.addColorStop(1, 'rgba(251,191,36,0.01)');
    const ge = ctx.createLinearGradient(0,0,0,chartHeight);
    ge.addColorStop(0, 'rgba(52,211,153,0.18)'); ge.addColorStop(1, 'rgba(52,211,153,0.01)');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: DATA.evolution.labels,
            datasets: [
                { label:'Soumises',  data: DATA.evolution.soumises,  borderColor: C.amber,
                  backgroundColor: ga, fill: true, tension: 0.4, borderWidth: 2.5,
                  pointRadius: 2.5, pointHoverRadius: 5, pointBackgroundColor: C.amber,
                  pointBorderColor: C.amber, pointBorderWidth: 0, pointHoverBorderWidth: 0 },
                { label:'Transmises', data: DATA.evolution.transmises, borderColor: C.emerald,
                  backgroundColor: ge, fill: true, tension: 0.4, borderWidth: 2,
                  pointRadius: 2.5, pointHoverRadius: 5, pointBackgroundColor: C.emerald,
                  pointBorderColor: C.emerald, pointBorderWidth: 0, pointHoverBorderWidth: 0 },
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            layout: { padding: { top: 8, right: 8, bottom: 2 } },
            plugins: {
                legend: { display: false },
                tooltip: {
                    ...TOOLTIP,
                    borderWidth: 0,
                    displayColors: true,
                    callbacks: {
                        title: items => {
                            const label = DATA.evolution.labels[items[0]?.dataIndex] ?? '';
                            if (/^\d{4}-\d{2}-\d{2}$/.test(label)) {
                                return new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' })
                                    .format(new Date(`${label}T12:00:00`));
                            }
                            return label;
                        },
                        label: item => ` ${item.dataset.label} : ${item.parsed.y}`,
                    },
                },
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: {
                        color: C.slate,
                        autoSkip: true,
                        maxTicksLimit: window.matchMedia('(max-width: 640px)').matches ? 5 : 9,
                        maxRotation: 0,
                        minRotation: 0,
                        font: { size: window.matchMedia('(max-width: 640px)').matches ? 9 : 10 },
                        callback: (_value, index) => {
                            const label = DATA.evolution.labels[index] ?? '';
                            if (/^\d{4}-\d{2}-\d{2}$/.test(label)) {
                                return new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: 'short' })
                                    .format(new Date(`${label}T12:00:00`));
                            }
                            return label;
                        },
                    },
                    border: { display: false },
                },
                y: {
                    grid: { color: 'rgba(148,163,184,0.08)', drawTicks: false },
                    ticks: { color: C.slate, precision: 0, padding: 8 },
                    border: { display: false },
                    beginAtZero: true,
                },
            }
        }
    });
})();

// ─── 4 bis. Parcours les plus fréquents ───────────────────────────────────
(function() {
    const canvas = document.getElementById('chartParcours');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const routes = Array.isArray(DATA.parcours?.routes) ? DATA.parcours.routes.slice(0, 10) : [];
    if (!routes.length) return;

    // Hauteur dynamique selon le nombre de barres
    const dynamicHeight = Math.max(120, routes.length * 36);
    canvas.style.height = dynamicHeight + 'px';
    canvas.height = dynamicHeight;

    // Palette dégradée vert→cyan pour distinguer les parcours
    const palette = routes.map((_, i) => {
        const t = routes.length > 1 ? i / (routes.length - 1) : 0;
        const r = Math.round(52  + t * (34  - 52));
        const g = Math.round(211 + t * (211 - 211));
        const b = Math.round(153 + t * (238 - 153));
        return `rgba(${r},${g},${b},0.82)`;
    });

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: routes.map(r => {
                const lbl = String(r.trajet || '');
                return lbl.length > 45 ? lbl.slice(0, 45) + '…' : lbl;
            }),
            datasets: [{
                label: 'Alertes avec ce parcours',
                data: routes.map(r => Number(r.nb)),
                backgroundColor: palette,
                borderColor: palette.map(c => c.replace('0.82)', '1)')),
                borderWidth: 1, borderRadius: 6,
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    ...TOOLTIP,
                    callbacks: {
                        title: items => String(DATA.parcours.routes[items[0].dataIndex]?.trajet || items[0].label),
                        label: item => ` ${item.parsed.x} alerte${item.parsed.x > 1 ? 's' : ''}`,
                    },
                },
            },
            scales: {
                x: {
                    beginAtZero: true,
                    grid: { color: 'rgba(148,163,184,0.06)' },
                    ticks: { color: C.slate, precision: 0 },
                    border: { display: false },
                },
                y: {
                    grid: { display: false },
                    ticks: { color: C.text, font: { size: 10 } },
                    border: { display: false },
                },
            },
        }
    });
})();

// ─── 3. Volume par pays (bâtons verticaux, tri décroissant) ───────────────
(function() {
    const ctx = document.getElementById('chartVolumeParPays')?.getContext('2d');
    if (!ctx || !DATA.volumePays.length) return;
    const sorted = [...DATA.volumePays].sort((a,b) => b.nb - a.nb);
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: sorted.map(d => d.iso3 || d.pays),
            datasets: [{ label:'Alertes', data: sorted.map(d => d.nb),
                backgroundColor: C.amber + 'CC', borderColor: C.amber,
                borderWidth: 1, borderRadius: 6 }]
        },
        options: {
            responsive: true, plugins: { legend: { display: false }, tooltip: { ...TOOLTIP,
                callbacks: { title: ctx => DATA.volumePays.find(d => d.iso3 === ctx[0].label || d.pays === ctx[0].label)?.pays || ctx[0].label }
            }},
            scales: {
                x: { grid: { display: false }, ticks: { color: C.text } , border: { display: false }},
                y: { grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate }, border: { display: false }, beginAtZero: true },
            }
        }
    });
})();

// ─── 4. Score moyen par pays (bâtons horizontaux) ─────────────────────────
(function() {
    const ctx = document.getElementById('chartScoreMoyenPays')?.getContext('2d');
    if (!ctx || !DATA.scorePays.length) return;
    const sorted = [...DATA.scorePays].sort((a,b) => b.score_moyen - a.score_moyen);
    const colors = sorted.map(d => d.score_moyen >= 18 ? C.red : d.score_moyen >= 14 ? C.orange : d.score_moyen >= 10 ? C.amber : C.emerald);
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: sorted.map(d => d.pays),
            datasets: [{ label:'Score moyen', data: sorted.map(d => d.score_moyen),
                backgroundColor: colors.map(c => c + 'CC'), borderColor: colors,
                borderWidth: 1, borderRadius: 5 }]
        },
        options: {
            indexAxis: 'y', responsive: true,
            plugins: { legend: { display: false }, tooltip: TOOLTIP },
            scales: {
                x: { grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate }, border: { display: false }, min: 0, max: 25 },
                y: { grid: { display: false }, ticks: { color: C.text }, border: { display: false } },
            }
        }
    });
})();

// ─── 5. Statuts empilés par pays ──────────────────────────────────────────
(function() {
    const ctx = document.getElementById('chartStatutsParPays')?.getContext('2d');
    if (!ctx || !DATA.statutsPays.length) return;

    // Pivot : pays → {statut: nb}
    const paysSet = [...new Set(DATA.statutsPays.map(r => r.pays))];
    const statutSet = [...new Set(DATA.statutsPays.map(r => r.statut))];

    const datasets = statutSet.map(st => ({
        label: st,
        data: paysSet.map(p => {
            const row = DATA.statutsPays.find(r => r.pays === p && r.statut === st);
            return row ? row.nb : 0;
        }),
        backgroundColor: (C.statut[st] || C.slate) + 'CC',
        borderColor: C.statut[st] || C.slate,
        borderWidth: 0, borderRadius: 3,
    }));

    new Chart(ctx, {
        type: 'bar',
        data: { labels: paysSet, datasets },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { color: C.text, boxWidth: 12, padding: 10, font: { size: 10 } } },
                tooltip: TOOLTIP,
            },
            scales: {
                x: { stacked: true, grid: { display: false }, ticks: { color: C.text }, border: { display: false } },
                y: { stacked: true, grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate }, border: { display: false }, beginAtZero: true },
            }
        }
    });
})();

// ─── 6. Taux de transmission par pays (bâtons horizontaux %) ──────────────
(function() {
    const ctx = document.getElementById('chartTauxTransmission')?.getContext('2d');
    if (!ctx || !DATA.txTransmission.length) return;
    const sorted = [...DATA.txTransmission].sort((a,b) => b.taux - a.taux);
    const colors = sorted.map(d => d.taux >= 80 ? C.emerald : d.taux >= 50 ? C.amber : C.red);
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: sorted.map(d => d.pays),
            datasets: [{ label:'Taux (%)', data: sorted.map(d => d.taux),
                backgroundColor: colors.map(c => c + 'CC'), borderColor: colors,
                borderWidth: 1, borderRadius: 5 }]
        },
        options: {
            indexAxis: 'y', responsive: true,
            plugins: { legend: { display: false }, tooltip: { ...TOOLTIP,
                callbacks: { label: ctx => ` ${ctx.parsed.x}% (${DATA.txTransmission.find(d=>d.pays===ctx.label)?.transmis ?? 0} transmises)` }
            }},
            scales: {
                x: { grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate, callback: v => v + '%' },
                     border: { display: false }, min: 0, max: 100 },
                y: { grid: { display: false }, ticks: { color: C.text }, border: { display: false } },
            }
        }
    });
})();

// ─── 7. Donut catégories ──────────────────────────────────────────────────
(function() {
    const ctx = document.getElementById('chartCategories')?.getContext('2d');
    if (!ctx || !DATA.categories.length) return;
    const palette = [C.amber, C.orange, C.red, C.emerald, C.blue, C.purple, C.cyan, '#f0abfc','#fde68a','#6ee7b7','#7dd3fc','#a5b4fc','#fca5a5','#fcd34d'];
    const top8 = DATA.categories.slice(0, 8);
    const otherNb = DATA.categories.slice(8).reduce((s, d) => s + Number(d.nb), 0);
    if (otherNb > 0) top8.push({ categorie: 'Autre', nb: otherNb });

    const chart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: top8.map(d => d.categorie),
            datasets: [{ data: top8.map(d => d.nb),
                backgroundColor: palette.slice(0, top8.length),
                borderColor: 'transparent', borderWidth: 0, hoverBorderWidth: 0, hoverOffset: 6 }]
        },
        options: {
            responsive: false, cutout: '65%',
            plugins: { legend: { display: false }, tooltip: TOOLTIP },
        }
    });

    // Légende externe
    const legend = document.getElementById('catLegend');
    if (legend) {
        legend.innerHTML = top8.map((d, i) => `
            <div class="donut-legend-item">
                <span class="donut-dot" style="background:${palette[i]}"></span>
                <span class="donut-legend-label" style="font-size:10.5px">${d.categorie}</span>
                <span class="donut-legend-val">${d.nb}</span>
            </div>`).join('');
    }
})();

// ─── 8. Top corridors (bâtons horizontaux) ────────────────────────────────
(function() {
    const ctx = document.getElementById('chartTopCorridors')?.getContext('2d');
    if (!ctx || !Array.isArray(DATA.corridors) || !DATA.corridors.length) return;
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: DATA.corridors.map(d => {
                const label = String(d.corridor ?? 'Inconnu');
                return label.length > 30 ? label.slice(0,30)+'…' : label;
            }),
            datasets: [{ label:'Alertes', data: DATA.corridors.map(d => d.nb),
                backgroundColor: C.blue + 'CC', borderColor: C.blue, borderWidth: 1, borderRadius: 5 }]
        },
        options: {
            indexAxis: 'y', responsive: true,
            plugins: { legend: { display: false }, tooltip: { ...TOOLTIP,
                callbacks: { title: ctx => String(DATA.corridors[ctx[0].dataIndex]?.corridor ?? ctx[0].label) }
            }},
            scales: {
                x: { grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate }, border: { display: false }, beginAtZero: true },
                y: { grid: { display: false }, ticks: { color: C.text, font: { size: 10 } }, border: { display: false } },
            }
        }
    });
})();

// ─── 8b. Top opérateurs (bâtons horizontaux) ───────────────────────────────
(function() {
    const ctx = document.getElementById('chartTopOperateurs')?.getContext('2d');
    if (!ctx || !Array.isArray(DATA.operateurs) || !DATA.operateurs.length) return;
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: DATA.operateurs.map(d => {
                const label = String(d.operateurs ?? d.operateur ?? 'Inconnu');
                return label.length > 30 ? label.slice(0,30)+'…' : label;
            }),
            datasets: [{ label:'Alertes', data: DATA.operateurs.map(d => d.nb),
                backgroundColor: C.amber + 'CC', borderColor: C.amber, borderWidth: 1, borderRadius: 5 }]
        },
        options: {
            indexAxis: 'y', responsive: true,
            plugins: { legend: { display: false }, tooltip: { ...TOOLTIP,
                callbacks: { title: ctx => String(DATA.operateurs[ctx[0].dataIndex]?.operateurs ?? DATA.operateurs[ctx[0].dataIndex]?.operateur ?? ctx[0].label) }
            }},
            scales: {
                x: { grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate }, border: { display: false }, beginAtZero: true },
                y: { grid: { display: false }, ticks: { color: C.text, font: { size: 10 } }, border: { display: false } },
            }
        }
    });
})();

// ─── 9. Activité agents (bâtons horizontaux) ─────────────────────────────
(function() {
    const ctx = document.getElementById('chartActiviteAgents')?.getContext('2d');
    if (!ctx || !DATA.agents.length) return;
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: DATA.agents.map(d => d.agent),
            datasets: [{ label:'Soumissions', data: DATA.agents.map(d => d.nb),
                backgroundColor: C.purple + 'CC', borderColor: C.purple, borderWidth: 1, borderRadius: 5 }]
        },
        options: {
            indexAxis: 'y', responsive: true,
            plugins: { legend: { display: false }, tooltip: TOOLTIP },
            scales: {
                x: { grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate }, border: { display: false }, beginAtZero: true },
                y: { grid: { display: false }, ticks: { color: C.text, font: { size: 10 } }, border: { display: false } },
            }
        }
    });
})();

// ─── 10. Délai moyen de traitement ────────────────────────────────────────
(function() {
    const ctx = document.getElementById('chartDelaiMoyen')?.getContext('2d');
    if (!ctx || !DATA.delaiMoyen.length) return;
    const colors = DATA.delaiMoyen.map(d => d.delai_moyen_h <= 72 ? C.emerald : d.delai_moyen_h <= 120 ? C.amber : C.red);
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: DATA.delaiMoyen.map(d => d.pays),
            datasets: [
                { label:'Délai moyen (h)', data: DATA.delaiMoyen.map(d => d.delai_moyen_h),
                  backgroundColor: colors.map(c => c + 'CC'), borderColor: colors, borderWidth: 1, borderRadius: 5 },
                // Ligne SLA cible = 72h
                { label:'SLA cible (72h)', data: DATA.delaiMoyen.map(() => 72),
                  type: 'line', borderColor: C.red + '80', borderWidth: 1.5, borderDash: [5,3],
                  pointRadius: 0, fill: false, tension: 0 }
            ]
        },
        options: {
            responsive: true,
            plugins: { tooltip: TOOLTIP,
                legend: { position: 'top', labels: { color: C.text, boxWidth: 12, padding: 12, font: { size: 10 } } } },
            scales: {
                x: { grid: { display: false }, ticks: { color: C.text }, border: { display: false } },
                y: { grid: { color: 'rgba(148,163,184,0.06)' }, ticks: { color: C.slate, callback: v => v+'h' },
                     border: { display: false }, beginAtZero: true },
            }
        }
    });
})();

// ─── Filtres globaux — raccourcis période ─────────────────────────────────
function setPeriod(days) {
    const fin   = new Date();
    const debut = new Date(fin - days * 86400000);
    const fmt   = d => d.toISOString().slice(0, 10);
    document.getElementById('filterDebut').value = fmt(debut);
    document.getElementById('filterFin').value   = fmt(fin);
    document.getElementById('filterForm').submit();
}

} // END initStatsCharts

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatsCharts, { once: true });
} else {
    initStatsCharts();
}
document.addEventListener('turbo:load', initStatsCharts);
</script>

