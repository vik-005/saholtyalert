{% extends 'base.html.twig' %}
{% block title %}Analyses & Cartes — GEI{% endblock %}
{% block header_title %}Analyses & Cartes{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête ── #}
    <div class="page-header-row">
        <div>
            <p class="page-eyebrow">
                <i class="bi {{ type_icon }} me-1.5"></i>Analyse géographique
            </p>
            <h2 class="page-title">{{ page_title }}</h2>
            <p class="page-subtitle">
                {{ page_subtitle }}
                sur la période
                <strong style="color:var(--amber)">{{ debut|date('d/m/Y') }}</strong>
                →
                <strong style="color:var(--amber)">{{ fin|date('d/m/Y') }}</strong>
            </p>
        </div>
        <a href="{{ path('app_dashboard_statistiques') }}" class="db-btn db-btn-ghost">
            <i class="bi bi-bar-chart me-1.5"></i>Statistiques complètes
        </a>
    </div>

    {# ── Filtres ── #}
    <div class="stats-filter-bar corridor-filter-bar">
        <button type="button" class="corridor-filter-toggle" id="corridorFilterToggle"
                aria-expanded="false" aria-controls="corridorFilterContent">
            <span class="corridor-filter-toggle-copy">
                <i class="bi bi-sliders2" aria-hidden="true"></i>
                <span>
                    <strong>Filtres d’analyse</strong>
                    <small>Période, marchés et localisation</small>
                </span>
            </span>
            <i class="bi bi-chevron-down corridor-filter-chevron" aria-hidden="true"></i>
        </button>
        <div class="corridor-filter-content" id="corridorFilterContent">
        <form method="get" class="stats-filter-form corridor-filter-form" id="corridorFilterForm">

            {# Période #}
            <div class="stats-filter-group">
                <label class="stats-filter-label">
                    <i class="bi bi-calendar me-1"></i>Période
                </label>
                <input type="date" name="debut" value="{{ debut }}" class="stats-input" id="filterDebut">
                <span style="color:var(--muted);font-size:11px">→</span>
                <input type="date" name="fin"   value="{{ fin }}"   class="stats-input" id="filterFin">
            </div>

            {# Marchés #}
            <div class="stats-filter-group" style="flex-wrap:wrap;gap:6px">
                <label class="stats-filter-label">
                    <i class="bi bi-globe-africa me-1"></i>Marchés
                </label>
                <div class="stats-market-checks" id="marketChecksContainer">
                    {% for m in all_markets %}
                    <label class="stats-check-label">
                        <input type="checkbox" name="markets[]" value="{{ m.id }}"
                               {% if m.id in selected_markets %}checked{% endif %}
                               class="stats-checkbox market-cb">
                        <span>{{ m.codeIso3 }}</span>
                    </label>
                    {% endfor %}
                </div>
                <div style="display:flex;gap:4px;margin-left:4px">
                    <button type="button" class="corridor-mkt-btn" onclick="selectAllMarkets(true)" title="Tout sélectionner">
                        <i class="bi bi-check2-all"></i>
                    </button>
                    <button type="button" class="corridor-mkt-btn" onclick="selectAllMarkets(false)" title="Tout désélectionner">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            {# Type #}
            <div class="stats-filter-group">
                <label class="stats-filter-label">
                    <i class="bi bi-tag me-1"></i>Type
                </label>
                <span class="corridor-select-wrap">
                    <select name="type_loc" class="stats-input" id="filterTypeLoc"
                            onchange="document.getElementById('corridorFilterForm').submit()">
                        <option value=""        {% if not type_loc %}selected{% endif %}>Tous</option>
                        <option value="corridor" {% if type_loc == 'corridor' %}selected{% endif %}>Corridor de transit</option>
                        <option value="port"     {% if type_loc == 'port' %}selected{% endif %}>Port maritime</option>
                        <option value="aeroport" {% if type_loc == 'aeroport' %}selected{% endif %}>Aéroport international</option>
                        <option value="localite" {% if type_loc == 'localite' %}selected{% endif %}>Localité (ville / village)</option>
                    </select>
                </span>
            </div>

            <div class="stats-filter-actions">
                <button type="submit" class="stats-apply-btn">
                    <i class="bi bi-arrow-clockwise me-1.5"></i>Appliquer
                </button>
                <a href="{{ path('app_dashboard_corridors') }}" class="stats-reset-btn">
                    <i class="bi bi-x me-1"></i>Reset
                </a>
            </div>
        </form>

        {# Boutons raccourcis période — état actif calculé en PHP #}
        {% set diffDays = (debut|date('U') - fin|date('U'))|abs // 86400 %}
        <div class="stats-period-shortcuts">
            <button class="stats-shortcut {% if diffDays >= 28 and diffDays <= 32 %}active{% endif %}"
                    onclick="setCorridorPeriod(30)">30j</button>
            <button class="stats-shortcut {% if diffDays >= 85 and diffDays <= 95 %}active{% endif %}"
                    onclick="setCorridorPeriod(90)">3 mois</button>
            <button class="stats-shortcut {% if diffDays >= 360 and diffDays <= 370 %}active{% endif %}"
                    onclick="setCorridorPeriod(365)">1 an</button>
        </div>
        </div>
    </div>

    {# ── Statistiques des villes et villages ── #}
    <section class="db-chart-card" style="margin-top:12px" aria-labelledby="localityStatsTitle">
        <div class="db-card-header db-card-header-border">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-pin-map-fill me-1.5"></i>Localités</p>
                <p class="db-card-title" id="localityStatsTitle">Alertes par ville et village</p>
            </div>
            <span class="db-card-eyebrow" style="font-size:10px;background:var(--card2);padding:3px 8px;border-radius:6px;border:1px solid var(--border)">
                {{ localite_counts.total_alertes }} alertes recensées
            </span>
        </div>
        <div class="corridor-kpi-row" style="margin:12px 0">
            <div class="corridor-kpi-card">
                <div class="corridor-kpi-icon" style="background:rgba(21,128,61,.1);color:#15803d"><i class="bi bi-buildings"></i></div>
                <div><div class="corridor-kpi-value">{{ localite_counts.ville }}</div><div class="corridor-kpi-label">Villes distinctes</div></div>
            </div>
            <div class="corridor-kpi-card">
                <div class="corridor-kpi-icon" style="background:rgba(180,83,9,.1);color:#b45309"><i class="bi bi-house"></i></div>
                <div><div class="corridor-kpi-value">{{ localite_counts.village }}</div><div class="corridor-kpi-label">Villages distincts</div></div>
            </div>
        </div>
        {% if localites|length > 0 %}
        <div class="db-table-wrap" style="max-height:420px;overflow:auto">
            <table class="db-table">
                <thead>
                    <tr>
                        <th>Localité</th>
                        <th>Type</th>
                        <th>Pays</th>
                        <th class="text-center">Nombre d’alertes</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in localites %}
                    <tr class="db-tr">
                        <td style="font-weight:650;color:var(--text)">{{ row.localite }}</td>
                        <td>
                            {% if row.type == 'ville' %}
                                <span class="loc-type" style="color:#15803d">Ville</span>
                            {% elseif row.type == 'village' %}
                                <span class="loc-type" style="color:#b45309">Village</span>
                            {% else %}
                                <span class="loc-type">Non précisé</span>
                            {% endif %}
                        </td>
                        <td>{{ row.pays }}</td>
                        <td class="text-center">
                            <span class="score-badge {% if row.nb >= 10 %}score-critique{% elseif row.nb >= 5 %}score-eleve{% elseif row.nb >= 3 %}score-modere{% else %}score-faible{% endif %}">{{ row.nb }}</span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="db-empty-state" style="padding:24px">
            <p>Aucune ville ou aucun village renseigné sur la période et les marchés sélectionnés.</p>
        </div>
        {% endif %}
    </section>

    {# ── État vide global soigné (Spec A.3) ── #}
    {% if not has_data %}
    <div class="db-chart-card db-empty-state" style="padding:60px 20px;text-align:center;margin-top:16px">
        <i class="bi {{ type_icon }}" style="font-size:44px;color:var(--muted);opacity:0.75;display:block;margin-bottom:14px"></i>
        <h3 style="font-size:16px;font-weight:700;color:var(--text);margin-bottom:8px">Aucune alerte trouvée</h3>
        <p style="color:var(--muted);font-size:13px;margin-bottom:20px;max-width:500px;margin-left:auto;margin-right:auto;line-height:1.5">
            Aucune alerte ne correspond à cette sélection sur la période choisie.
        </p>
        <div style="display:inline-flex;flex-direction:column;gap:6px;text-align:left;background:rgba(255,255,255,0.02);border:1px solid var(--border);border-radius:8px;padding:12px 18px;margin-bottom:24px;font-size:11.5px;color:var(--muted)">
            <div><i class="bi bi-calendar3 me-2" style="color:var(--amber)"></i>
                Période : <strong style="color:var(--text)">{{ debut|date('d/m/Y') }} → {{ fin|date('d/m/Y') }}</strong>
            </div>
            <div><i class="bi bi-globe-africa me-2" style="color:var(--amber)"></i>
                Marchés : <strong style="color:var(--text)">{{ selected_markets|length > 0 ? selected_markets|length ~ ' sélectionné(s)' : 'Aucun sélectionné' }}</strong>
            </div>
            <div><i class="bi {{ type_icon }} me-2" style="color:var(--amber)"></i>
                Type : <strong style="color:var(--text)">{{ type_loc ? type_loc|capitalize : 'Tous' }}</strong>
            </div>
        </div>
        <div>
            <a href="{{ path('app_dashboard_corridors') }}" class="db-btn db-btn-amber">
                <i class="bi bi-arrow-clockwise me-1.5"></i>Réinitialiser les filtres
            </a>
        </div>
    </div>

    {% else %}

    {# ── KPI Cards ── #}
    <div class="corridor-kpi-row" style="margin-top:12px">
        {# Total alertes #}
        <div class="corridor-kpi-card">
            <div class="corridor-kpi-icon" style="background:rgba(69,227,184,0.1);color:#45e3b8">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div>
                <div class="corridor-kpi-value">{{ kpis.total }}</div>
                <div class="corridor-kpi-label">Alerte{{ kpis.total > 1 ? 's' : '' }} au total</div>
            </div>
        </div>

        {% if not type_loc %}
        {# Mode Tous : décomposition par type #}
        <div class="corridor-kpi-card">
            <div class="corridor-kpi-icon" style="background:rgba(34,197,94,0.1);color:#22c55e">
                <i class="bi bi-signpost-2"></i>
            </div>
            <div>
                <div class="corridor-kpi-value">{{ kpis.nb_corridors }}</div>
                <div class="corridor-kpi-label">Corridor{{ kpis.nb_corridors > 1 ? 's' : '' }}</div>
                {% if kpis.total > 0 %}
                <div class="corridor-kpi-pct">{{ (kpis.nb_corridors / kpis.total * 100)|round(1) }}%</div>
                {% endif %}
            </div>
        </div>
        <div class="corridor-kpi-card">
            <div class="corridor-kpi-icon" style="background:rgba(59,130,246,0.1);color:#60a5fa">
                <i class="bi bi-anchor"></i>
            </div>
            <div>
                <div class="corridor-kpi-value">{{ kpis.nb_ports }}</div>
                <div class="corridor-kpi-label">Port{{ kpis.nb_ports > 1 ? 's' : '' }}</div>
                {% if kpis.total > 0 %}
                <div class="corridor-kpi-pct">{{ (kpis.nb_ports / kpis.total * 100)|round(1) }}%</div>
                {% endif %}
            </div>
        </div>
        <div class="corridor-kpi-card">
            <div class="corridor-kpi-icon" style="background:rgba(251,191,36,0.1);color:var(--amber)">
                <i class="bi bi-airplane"></i>
            </div>
            <div>
                <div class="corridor-kpi-value">{{ kpis.nb_aeroports }}</div>
                <div class="corridor-kpi-label">Aéroport{{ kpis.nb_aeroports > 1 ? 's' : '' }}</div>
                {% if kpis.total > 0 %}
                <div class="corridor-kpi-pct">{{ (kpis.nb_aeroports / kpis.total * 100)|round(1) }}%</div>
                {% endif %}
            </div>
        </div>
        <div class="corridor-kpi-card">
            <div class="corridor-kpi-icon" style="background:rgba(251,146,60,0.1);color:#fb923c">
                <i class="bi bi-pin-map-fill"></i>
            </div>
            <div>
                <div class="corridor-kpi-value">{{ kpis.nb_localites|default(0) }}</div>
                <div class="corridor-kpi-label">Localité{{ kpis.nb_localites|default(0) > 1 ? 's' : '' }}</div>
                {% if kpis.total > 0 %}
                <div class="corridor-kpi-pct">{{ ((kpis.nb_localites|default(0)) / kpis.total * 100)|round(1) }}%</div>
                {% endif %}
            </div>
        </div>
        {% else %}
        {# Mode type unique : éléments distincts + top #}
        <div class="corridor-kpi-card">
            <div class="corridor-kpi-icon" style="background:rgba(69,227,184,0.08);color:#45e3b8">
                <i class="bi {{ type_icon }}"></i>
            </div>
            <div>
                <div class="corridor-kpi-value">{{ top_localisations|length }}</div>
                <div class="corridor-kpi-label">{{ chart_item_label|capitalize }}{{ top_localisations|length > 1 ? 's' : '' }} distincts</div>
            </div>
        </div>
        {% if kpis.top_element %}
        <div class="corridor-kpi-card corridor-kpi-card-featured">
            <div class="corridor-kpi-icon" style="background:rgba(251,191,36,0.1);color:var(--amber)">
                <i class="bi bi-trophy"></i>
            </div>
            <div>
                <div class="corridor-kpi-label" style="margin-bottom:4px">Top {{ chart_item_label }}</div>
                <div style="font-size:13px;font-weight:700;color:var(--text)">{{ kpis.top_element.corridor }}</div>
                <div style="font-size:10.5px;color:var(--muted)">{{ kpis.top_element.nb }} alerte{{ kpis.top_element.nb > 1 ? 's' : '' }} · {{ kpis.top_element.pays }}</div>
            </div>
        </div>
        {% endif %}
        {% endif %}
    </div>

    {# ── Grille principale : graphique + volume par pays ── #}
    <div class="db-mid-row corridor-chart-grid" style="margin-top:12px">

        {# ── Graphique barres horizontales ── #}
        <div class="db-chart-card">
            <div class="db-card-header db-card-header-border">
                <div>
                    <p class="db-card-eyebrow">
                        <i class="bi {{ type_icon }} me-1.5"></i>{{ chart_title }}
                    </p>
                    <p class="db-card-title">{{ chart_subtitle }}</p>
                </div>
                <span class="db-card-eyebrow" style="font-size:10px;background:var(--card2);padding:3px 8px;border-radius:6px;border:1px solid var(--border)">
                    {{ top_localisations|length }} {{ chart_item_label }}{{ top_localisations|length > 1 ? 's' : '' }}
                </span>
            </div>
            {% if top_localisations|length > 0 %}
            <div class="corridor-chart-wrap" id="corridorChartWrap"
                 style="height:{{ top_localisations|length * 32 > 640 ? 640 : (top_localisations|length * 32 > 240 ? top_localisations|length * 32 : 240) }}px">
                <canvas id="corridorsChart" role="img"
                        aria-label="{{ chart_title }} : nombre d'alertes par localisation">
                </canvas>
            </div>
            {% else %}
            <div class="db-empty-state" style="padding:40px">
                <i class="bi {{ type_icon }}" style="font-size:36px;color:var(--muted);display:block;margin-bottom:12px"></i>
                <p>Aucun {{ chart_item_label }} sur cette période.</p>
            </div>
            {% endif %}
        </div>

        {# ── Volume par pays ── #}
        <div class="db-chart-card">
            <div class="db-card-header db-card-header-border">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-globe-africa me-1.5"></i>Volume par pays</p>
                    <p class="db-card-title">
                        Alertes par marché
                        {% if type_loc %}<span style="font-size:10px;color:var(--muted)"> · {{ type_loc|capitalize }}s</span>{% endif %}
                    </p>
                </div>
            </div>
            <div class="countries-list" style="margin-top:8px">
                {% set maxVol = volume_par_pays|length > 0 ? (volume_par_pays|map(r => r.nb)|sort|last) : 1 %}
                {% if maxVol == 0 %}{% set maxVol = 1 %}{% endif %}
                {% for row in volume_par_pays %}
                <div class="country-item">
                    <span class="country-label">
                        <i class="bi bi-geo-alt me-1" style="color:var(--muted)"></i>
                        {{ row.iso3 }}
                    </span>
                    <div class="country-bar-wrap">
                        <div class="country-bar-track">
                            <div class="country-bar-fill"
                                 style="width:{{ maxVol > 0 ? (row.nb / maxVol * 100)|round : 0 }}%">
                            </div>
                        </div>
                    </div>
                    <span class="country-pct">{{ row.nb }}</span>
                </div>
                {% else %}
                <div class="db-empty-state" style="padding:20px">
                    <p>Aucune donnée sur cette période.</p>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>

    {# ── Répartition par type de localisation (uniquement en mode « Tous ») ── #}
    {% if not type_loc and loc_type_stats|length > 0 %}
    <div class="db-chart-card" style="margin-top:12px">
        <div class="db-card-header db-card-header-border">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-diagram-3 me-1.5"></i>Répartition par type</p>
                <p class="db-card-title">Ventilation corridor / port / aéroport</p>
            </div>
        </div>
        {% set totalLoc = loc_type_stats|reduce((acc, s) => acc + s.nb, 0) %}
        <div class="corridor-type-grid" style="margin-top:12px">
            {% for stat in loc_type_stats %}
            {% set typeColors = {
                'corridor': {bg: 'rgba(34,197,94,0.1)', color: '#22c55e', icon: 'bi-signpost-2'},
                'port':     {bg: 'rgba(59,130,246,0.1)', color: '#60a5fa', icon: 'bi-anchor'},
                'aeroport': {bg: 'rgba(251,191,36,0.1)', color: 'var(--amber)', icon: 'bi-airplane'}
            } %}
            {% set tc = typeColors[stat.type] ?? typeColors['corridor'] %}
            <div class="corridor-type-card">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                    <span style="width:36px;height:36px;border-radius:8px;background:{{ tc.bg }};display:grid;place-items:center;font-size:16px;color:{{ tc.color }}">
                        <i class="bi {{ tc.icon }}"></i>
                    </span>
                    <span style="font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--dim)">
                        {{ stat.type|capitalize }}
                    </span>
                </div>
                <div style="font-size:30px;font-weight:800;color:var(--text);line-height:1">{{ stat.nb }}</div>
                <div style="font-size:10px;color:var(--muted);margin-top:6px">
                    {% if totalLoc > 0 %}{{ (stat.nb / totalLoc * 100)|round(1) }}% du total{% else %}—{% endif %}
                </div>
                {# Barre de progression proportionnelle réelle #}
                <div style="margin-top:10px;height:4px;background:var(--card2);border-radius:99px;overflow:hidden">
                    <div style="height:100%;width:{{ totalLoc > 0 ? (stat.nb / totalLoc * 100)|round : 0 }}%;background:{{ tc.color }};border-radius:99px"></div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── Tableau détaillé ── #}
    <div class="db-table-card" style="margin-top:12px">
        <div class="db-card-header db-card-header-border" style="padding:14px 16px">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-table me-1.5"></i>Détail</p>
                <p class="db-card-title">
                    {% if type_loc == 'port' %}Classement des ports
                    {% elseif type_loc == 'corridor' %}Classement des corridors
                    {% elseif type_loc == 'aeroport' %}Classement des aéroports
                    {% else %}Classement global — tous types{% endif %}
                </p>
            </div>
            {% if type_loc %}
            <a href="{{ path('app_dashboard_corridors', {debut: debut, fin: fin}) }}"
               class="db-btn db-btn-ghost" style="font-size:10.5px">
                <i class="bi bi-x me-1"></i>Voir tous les types
            </a>
            {% endif %}
        </div>
        <div class="db-table-wrap">
            <table class="db-table">
                <thead>
                    <tr>
                        <th style="width:36px">#</th>
                        <th>
                            <i class="bi {{ type_icon }} me-1 opacity-50"></i>
                            {% if type_loc == 'port' %}Port{% elseif type_loc == 'aeroport' %}Aéroport{% elseif type_loc == 'corridor' %}Corridor{% else %}Localisation{% endif %}
                        </th>
                        {% if not type_loc %}
                        <th style="width:90px">Type</th>
                        {% endif %}
                        <th style="width:80px">Pays</th>
                        <th class="text-center" style="width:80px"><i class="bi bi-shield-fill me-1 opacity-50"></i>Alertes</th>
                        <th style="min-width:140px"><i class="bi bi-bar-chart me-1 opacity-50"></i>Part relative</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in top_localisations %}
                    <tr class="db-tr">
                        <td style="color:var(--muted);font-weight:700;font-size:11px">{{ loop.index }}</td>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px">
                                {% if not type_loc %}
                                {% set rowIcon = row.type == 'port' ? 'bi-anchor' : (row.type == 'aeroport' ? 'bi-airplane' : 'bi-signpost-2') %}
                                {% else %}
                                {% set rowIcon = type_icon %}
                                {% endif %}
                                <i class="bi {{ rowIcon }}" style="color:var(--amber);font-size:12px"></i>
                                <span style="font-weight:600;color:var(--text)">{{ row.corridor }}</span>
                            </div>
                        </td>
                        {% if not type_loc %}
                        <td>
                            <span class="loc-type loc-type-{{ row.type }}">{{ row.type|capitalize }}</span>
                        </td>
                        {% endif %}
                        <td>
                            <span style="font-size:10.5px;color:var(--muted);font-weight:600">{{ row.iso3 }}</span>
                        </td>
                        <td class="text-center">
                            <span class="score-badge {% if row.nb >= 10 %}score-critique{% elseif row.nb >= 5 %}score-eleve{% elseif row.nb >= 3 %}score-modere{% else %}score-faible{% endif %}">
                                {{ row.nb }}
                            </span>
                        </td>
                        <td>
                            {# part_relative est pré-calculée côté service — valeur réelle garantie #}
                            <div style="display:flex;align-items:center;gap:8px">
                                <div style="flex:1;height:5px;background:var(--card2);border-radius:99px;overflow:hidden">
                                    <div style="height:100%;width:{{ row.part_relative }}%;background:var(--amber);border-radius:99px;transition:width .3s"></div>
                                </div>
                                <span style="font-size:10.5px;font-weight:600;color:var(--muted);min-width:38px;text-align:right">
                                    {{ row.part_relative }}%
                                </span>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="{{ type_loc ? 5 : 6 }}">
                            <div class="db-empty-state" style="padding:30px">
                                <i class="bi {{ type_icon }}" style="font-size:32px;color:var(--muted);display:block;margin-bottom:8px"></i>
                                <p>Aucun {{ chart_item_label }} identifié sur cette période.</p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% endif %}{# end has_data #}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
/* ══════════════════════════════════════════════════════════════════════════
   Page /corridors — Chart.js + filtres marchés + raccourcis période
   Toutes les données viennent du backend (aucune valeur fictive).
   ══════════════════════════════════════════════════════════════════════════ */

/* ── Données préparées par le backend ── */
const corridorsData = {
    labels: {{ top_localisations|map(r => r.corridor)|json_encode|raw }},
    values: {{ top_localisations|map(r => r.nb)|json_encode|raw }},
    types:  {{ top_localisations|map(r => r.type)|json_encode|raw }},
};
const currentType = '{{ type_loc|escape('js') }}';

/* ── Palette de couleurs par type (charte GEI : amber/vert, bleu discret) ── */
function getBarColor(type, alpha) {
    switch (type) {
        case 'corridor': return `rgba(34,197,94,${alpha})`;
        case 'port':     return `rgba(96,165,250,${alpha})`;
        case 'aeroport': return `rgba(251,191,36,${alpha})`;
        default:         return `rgba(69,227,184,${alpha})`;
    }
}

/* ── Rendu du graphique ── */
if (corridorsData.labels.length > 0) {
    const ctx = document.getElementById('corridorsChart');
    if (ctx) {
        const maxVal = Math.max(...corridorsData.values, 1);
        new Chart(ctx.getContext('2d'), {
            type: 'bar',
            data: {
                labels: corridorsData.labels,
                datasets: [{
                    label: 'Alertes',
                    data: corridorsData.values,
                    backgroundColor: corridorsData.values.map((v, i) => {
                        const type = corridorsData.types[i] || currentType || '';
                        const alpha = 0.4 + (v / maxVal) * 0.55;
                        return getBarColor(type, alpha);
                    }),
                    borderColor: 'transparent',
                    borderWidth: 0,
                    borderRadius: 6,
                    borderSkipped: false,
                    barPercentage: 0.78,
                    categoryPercentage: 0.86,
                    maxBarThickness: 22,
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                layout: { padding: { top: 4, right: 8, bottom: 4 } },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: document.body.classList.contains('dark')
                            ? 'rgba(15,23,42,0.97)'
                            : 'rgba(255,255,255,0.98)',
                        borderWidth: 0,
                        padding: 12,
                        cornerRadius: 8,
                        titleColor: document.body.classList.contains('dark') ? '#f1f5f9' : '#0f172a',
                        bodyColor: document.body.classList.contains('dark') ? '#cbd5e1' : '#475569',
                        titleFont: { family: 'Inter, sans-serif', size: 11, weight: 'bold' },
                        bodyFont:  { family: 'Inter, sans-serif', size: 11 },
                        displayColors: false,
                        callbacks: {
                            title: items => corridorsData.labels[items[0]?.dataIndex] || '',
                            label: ctx => ` ${ctx.parsed.x} alerte${ctx.parsed.x > 1 ? 's' : ''}`
                        }
                    }
                },
                scales: {
                    x: {
                        grid:   { color: document.body.classList.contains('dark') ? 'rgba(148,163,184,0.10)' : 'rgba(71,85,105,0.08)', drawBorder: false },
                        ticks:  { color: document.body.classList.contains('dark') ? '#94a3b8' : '#64748b', font: { size: 10, family: 'Inter, sans-serif' }, precision: 0 },
                        border: { display: false },
                        beginAtZero: true,
                    },
                    y: {
                        grid:   { display: false },
                        ticks:  {
                            color: document.body.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            font: { size: window.matchMedia('(max-width: 640px)').matches ? 9 : 10, family: 'Inter, sans-serif' },
                            callback: value => {
                                const label = corridorsData.labels[value] ?? value;
                                const limit = window.matchMedia('(max-width: 640px)').matches ? 17 : 28;
                                return label.length > limit ? label.slice(0, limit - 1) + '…' : label;
                            }
                        },
                        border: { display: false },
                    }
                }
            }
        });
    }
}

const corridorFilterToggle = document.getElementById('corridorFilterToggle');
const corridorFilterContent = document.getElementById('corridorFilterContent');
corridorFilterToggle?.addEventListener('click', () => {
    const isExpanded = corridorFilterToggle.getAttribute('aria-expanded') === 'true';
    corridorFilterToggle.setAttribute('aria-expanded', String(!isExpanded));
    corridorFilterContent?.classList.toggle('is-open', !isExpanded);
});

/* ── Raccourcis période ── */
function setCorridorPeriod(days) {
    const today = new Date();
    const from  = new Date(today);
    from.setDate(from.getDate() - days);
    const fmt = d => d.toISOString().split('T')[0];
    document.getElementById('filterDebut').value = fmt(from);
    document.getElementById('filterFin').value   = fmt(today);
    document.getElementById('corridorFilterForm').submit();
}

/* ── Tout sélectionner / désélectionner les marchés ── */
function selectAllMarkets(checked) {
    document.querySelectorAll('.market-cb').forEach(cb => cb.checked = checked);
}
</script>
{% endblock %}