{% extends 'base.html.twig' %}

{% block title %}Dashboard GEI — Opérationnel{% endblock %}
{% block header_title %}Dashboard{% endblock %}

{% block body %}
{# ═══════════════════════════════════════════════════════════════════════════
   LAYOUT COINEST — 3 colonnes :
   LEFT  : KPI cards + Graphique évolution + Tableau registre
   RIGHT : Répartition par priorité (donut) + Score GEI + Activités récentes
════════════════════════════════════════════════════════════════════════════ #}

<div class="db-wrapper">

    {# ── LIGNE 1 : 5 KPI CARDS (Composant réutilisable _stat_card) ────────────────── #}
    <div class="db-kpi-row">
        {# Card 1 — Total alertes #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Total Alertes',
            value: kpis.total,
            icon: 'bi-clipboard-data',
            color: 'teal',
            trend_val: '+' ~ (kpis.total > 0 ? '12%' : '0%'),
            trend_label: 'vs. mois dernier',
            trend_dir: 'up'
        } %}

        {# Card 2 — Alertes critiques #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Alertes Critiques',
            value: kpis.critiques,
            icon: 'bi-exclamation-triangle',
            color: 'red',
            trend_val: 'Score ≥ 18',
            trend_label: 'Urgence 72h requise',
            trend_dir: 'down'
        } %}

        {# Card 3 — Actionnables #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Actionnables',
            value: kpis.actionnables,
            icon: 'bi-lightning-charge',
            color: 'amber',
            trend_val: '+' ~ (kpis.actionnables > 0 ? '8%' : '0%'),
            trend_label: 'Exploitabilité opérat.',
            trend_dir: 'up'
        } %}

        {# Card 4 — Transmis #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Transmis',
            value: kpis.transmis,
            icon: 'bi-send',
            color: 'blue',
            trend_val: '+' ~ (kpis.transmis > 0 ? '3' : '0'),
            trend_label: 'cette semaine',
            trend_dir: 'up'
        } %}

        {# Card 5 — Délai traitement moy. #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Délai traitement moy.',
            value: kpis.delaiMoyenH is defined and kpis.delaiMoyenH is not null ? (kpis.delaiMoyenH ~ 'h') : (avgDelaiTraitement is defined and avgDelaiTraitement is not null ? (avgDelaiTraitement ~ 'h') : 'N/A'),
            icon: 'bi-hourglass-split',
            color: 'slate',
            trend_val: 'Soumission → Validation',
            trend_label: 'Parties B & D',
            trend_dir: 'neutral'
        } %}
    </div>

    {# ── LIGNE 2 : GRAPHIQUE ÉVOLUTION + DONUT + SCORE GEI ──────────────── #}
    <div class="db-mid-row">

        {# ──── COLONNE GAUCHE : Évolution alertes (line chart) ─────────── #}
        <div class="db-chart-card db-chart-lg">
            <div class="db-card-header">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-graph-up me-1.5"></i>Évolution des alertes</p>
                    <p class="db-card-title">Activité du Registre GEI</p>
                </div>
                <div class="db-card-actions">
                    <span class="db-live-indicator"><span></span>Données live · 30 jours</span>
                </div>
            </div>
            <div class="db-chart-legend">
                <span class="chart-legend-item chart-legend-amber">
                    <span class="chart-legend-dot"></span>Nouvelles alertes
                </span>
                <span class="chart-legend-item chart-legend-blue">
                    <span class="chart-legend-dot"></span>Transmises
                </span>
                <span class="db-chart-total"><strong>{{ kpis.total }}</strong> alertes suivies</span>
            </div>
            <div class="db-chart-area">
                <canvas id="alertEvolutionChart" height="90"></canvas>
            </div>
        </div>

        {# ──── COLONNE DROITE : Donut répartition + stats ──────────────── #}
        <div class="db-chart-card db-chart-sm">
            <div class="db-card-header">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-pie-chart me-1.5"></i>Répartition</p>
                    <p class="db-card-title">Par Priorité</p>
                </div>
                <div class="db-card-actions">
                    <button class="db-icon-btn" title="Actualiser">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            <div class="donut-wrap">
                <canvas id="priorityDonutChart" width="160" height="160"></canvas>
                <div class="donut-center">
                    <span class="donut-total">{{ kpis.total }}</span>
                    <span class="donut-total-label">Total</span>
                </div>
            </div>

            <div class="donut-legend">
                <div class="donut-legend-item">
                    <span class="donut-dot donut-dot-red"></span>
                    <span class="donut-legend-label">Critique</span>
                    <span class="donut-legend-val">{{ kpis.critiques }}</span>
                    <span class="donut-legend-pct">{{ kpis.total > 0 ? ((kpis.critiques / kpis.total) * 100)|round }}%</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot donut-dot-amber"></span>
                    <span class="donut-legend-label">Élevé</span>
                    <span class="donut-legend-val">{{ kpis.eleve ?? 0 }}</span>
                    <span class="donut-legend-pct">{{ kpis.total > 0 ? (((kpis.eleve ?? 0) / kpis.total) * 100)|round }}%</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot donut-dot-yellow"></span>
                    <span class="donut-legend-label">Modéré</span>
                    <span class="donut-legend-val">{{ kpis.modere ?? 0 }}</span>
                    <span class="donut-legend-pct">{{ kpis.total > 0 ? (((kpis.modere ?? 0) / kpis.total) * 100)|round }}%</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot donut-dot-emerald"></span>
                    <span class="donut-legend-label">Faible</span>
                    <span class="donut-legend-val">{{ kpis.faible ?? 0 }}</span>
                    <span class="donut-legend-pct">{{ kpis.total > 0 ? (((kpis.faible ?? 0) / kpis.total) * 100)|round }}%</span>
                </div>
            </div>
        </div>

    </div>

    {# ── LIGNE 3 : TABLEAU REGISTRE + PANNEAU DROIT ─────────────────────── #}
    <div class="db-bottom-row">

        {# ──── COLONNE PRINCIPALE : Tableau Registre ───────────────────── #}
        <div class="db-table-card">
            <div class="db-card-header db-card-header-border">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-table-list me-1.5"></i>Registre GEI</p>
                    <p class="db-card-title">Alertes récentes</p>
                </div>
                <div class="db-card-actions">
                    {# Filtres rapides #}
                    <form method="get" class="db-filter-form">
                        <div class="db-search-wrap">
                            <i class="bi bi-search db-search-icon"></i>
                            <input type="text" name="search" value="{{ filters.search }}"
                                   placeholder="Code GEI, corridor…" class="db-search-input">
                        </div>
                        <select name="market" class="db-select">
                            <option value="">Tous les pays</option>
                            {% for m in markets %}
                                <option value="{{ m.id }}" {% if filters.market == m.id ~ '' %}selected{% endif %}>
                                    {{ m.nom }}
                                </option>
                            {% endfor %}
                        </select>
                        <select name="priorite" class="db-select">
                            <option value="">Toutes priorités</option>
                            <option value="critique" {% if filters.niveauPriorite == 'critique' %}selected{% endif %}>🔴 Critique</option>
                            <option value="eleve"    {% if filters.niveauPriorite == 'eleve'    %}selected{% endif %}>🟠 Élevé</option>
                            <option value="modere"   {% if filters.niveauPriorite == 'modere'   %}selected{% endif %}>🟡 Modéré</option>
                            <option value="faible"   {% if filters.niveauPriorite == 'faible'   %}selected{% endif %}>🟢 Faible</option>
                        </select>
                        <button type="submit" class="db-filter-btn">
                            <i class="bi bi-funnel"></i>
                        </button>
                    </form>

                    <div class="db-card-btn-group">
                        <a href="{{ path('app_alert_import') }}" class="db-btn db-btn-emerald" title="Import Excel">
                            <i class="bi bi-file-arrow-up"></i>
                            <span>Import</span>
                        </a>
                        <a href="{{ path('app_export_registre', {
                                search:   filters.search          ?? '',
                                market:   filters.market          ?? '',
                                priorite: filters.niveauPriorite  ?? '',
                                statut:   filters.statut          ?? ''
                            }) }}"
                           class="db-btn db-btn-ghost" title="Export Excel (données filtrées)">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                        </a>
                        <a href="{{ path('app_export_registre_pdf', {
                                search:   filters.search          ?? '',
                                market:   filters.market          ?? '',
                                priorite: filters.niveauPriorite  ?? '',
                                statut:   filters.statut          ?? ''
                            }) }}"
                           class="db-btn db-btn-ghost" title="Rapport PDF (données filtrées)">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </a>
                        <a href="{{ path('app_alert_new') }}" class="db-btn db-btn-amber">
                            <i class="bi bi-plus"></i>
                            <span>Nouvelle</span>
                        </a>
                    </div>
                </div>
            </div>

            <details class="db-advanced-filters" {% if filters.statut or filters.niveauPriorite or filters.categorie or filters.urgence or filters.scoreMin is not null or filters.scoreMax is not null or filters.origine or filters.dateDebut or filters.dateFin or filters.urgence72h or filters.agent or filters.manager or filters.tri %}open{% endif %}>
                <summary><i class="bi bi-sliders2-vertical"></i><span>Filtres avancés</span><small>15 critères</small><i class="bi bi-chevron-down db-filter-chevron"></i></summary>
                <form method="get" class="db-advanced-grid">
                    <label class="db-filter-field db-filter-field-wide">Recherche
                        <input type="search" name="search" value="{{ filters.search|default('') }}" placeholder="Code, pays, corridor, résumé…">
                    </label>
                    <label class="db-filter-field">Marché
                        <select name="market"><option value="">Tous</option>{% for market in markets %}<option value="{{ market.id }}" {% if filters.market == market.id %}selected{% endif %}>{{ market.nom }}</option>{% endfor %}</select>
                    </label>
                    <label class="db-filter-field">Statut
                        <select name="statut"><option value="">Tous</option>{% for value, label in {'nouveau':'Nouveau','en_cours':'En cours','transmis':'Transmis','validee':'Validée','a_completer':'À compléter','cloturee':'Clôturée'} %}<option value="{{ value }}" {% if filters.statut == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
                    </label>
                    <label class="db-filter-field">Priorité
                        <select name="priorite"><option value="">Toutes</option>{% for value, label in {'critique':'Critique','eleve':'Élevée','modere':'Modérée','faible':'Faible'} %}<option value="{{ value }}" {% if filters.niveauPriorite == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
                    </label>
                    <label class="db-filter-field">Catégorie<input type="search" name="categorie" value="{{ filters.categorie|default('') }}" placeholder="Catégorie"></label>
                    <label class="db-filter-field">Urgence
                        <select name="urgence"><option value="">Toutes</option>{% for value, label in {'immediate':'Immédiate','24h':'24 heures','72h':'72 heures'} %}<option value="{{ value }}" {% if filters.urgence == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
                    </label>
                    <label class="db-filter-field">Origine
                        <select name="origine"><option value="">Toutes</option><option value="saisie_agent" {% if filters.origine == 'saisie_agent' %}selected{% endif %}>Saisie agent</option><option value="import_excel" {% if filters.origine == 'import_excel' %}selected{% endif %}>Import Excel</option></select>
                    </label>
                    <label class="db-filter-field">Date début<input type="date" name="dateDebut" value="{{ filters.dateDebut|default('') }}"></label>
                    <label class="db-filter-field">Date fin<input type="date" name="dateFin" value="{{ filters.dateFin|default('') }}"></label>
                    <label class="db-filter-field">Score minimum<input type="number" name="scoreMin" min="0" max="25" value="{{ filters.scoreMin|default('') }}" placeholder="0"></label>
                    <label class="db-filter-field">Score maximum<input type="number" name="scoreMax" min="0" max="25" value="{{ filters.scoreMax|default('') }}" placeholder="25"></label>
                    <label class="db-filter-field">Agent
                        <select name="agent"><option value="">Tous</option>{% for agent in agents|default([]) %}<option value="{{ agent.id }}" {% if filters.agent == agent.id %}selected{% endif %}>{{ agent.nomComplet }}</option>{% endfor %}</select>
                    </label>
                    <label class="db-filter-field">Manager
                        <select name="manager"><option value="">Tous</option>{% for manager in managers|default([]) %}<option value="{{ manager.id }}" {% if filters.manager == manager.id %}selected{% endif %}>{{ manager.nomComplet }}</option>{% endfor %}</select>
                    </label>
                    <label class="db-filter-field">Tri
                        <select name="tri"><option value="">Plus récents</option><option value="scoreGei" {% if filters.tri == 'scoreGei' %}selected{% endif %}>Score GEI</option><option value="niveauPriorite" {% if filters.tri == 'niveauPriorite' %}selected{% endif %}>Priorité</option><option value="market" {% if filters.tri == 'market' %}selected{% endif %}>Marché</option></select>
                    </label>
                    <label class="db-filter-check"><input type="checkbox" name="urgence72h" value="1" {% if filters.urgence72h %}checked{% endif %}> Urgence 72h uniquement</label>
                    <div class="db-advanced-actions"><button type="submit" class="db-btn db-btn-amber"><i class="bi bi-funnel"></i> Appliquer</button><a href="{{ path('app_dashboard_operationnel') }}" class="db-btn db-btn-ghost">Réinitialiser</a></div>
                </form>
            </details>

            {# Urgence 72h actives #}
            {% if active_cases|length > 0 %}
            <div class="urgence-banner">
                <span class="urgence-pulse"></span>
                <i class="bi bi-stopwatch urgence-icon"></i>
                <span class="urgence-text">
                    <strong>{{ active_cases|length }} cas urgence 72h actifs</strong>
                    — procédure critique en cours
                </span>
                <a href="{{ path('app_dashboard_urgence') }}" class="urgence-link">
                    Voir le suivi SLA <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            {% endif %}

            {# Tableau #}
            <div class="db-table-wrap">
                <table class="db-table">
                    <thead>
                        <tr>
                            <th class="w-8"></th>
                            <th><i class="bi bi-hash me-1 opacity-50"></i>Code GEI</th>
                            <th><i class="bi bi-calendar me-1 opacity-50"></i>Date</th>
                            <th><i class="bi bi-globe-africa me-1 opacity-50"></i>Zone / Corridor</th>
                            <th><i class="bi bi-tag me-1 opacity-50"></i>Catégorie</th>
                            <th><i class="bi bi-text-left me-1 opacity-50"></i>Résumé</th>
                            <th class="text-center"><i class="bi bi-star-half me-1 opacity-50"></i>Score</th>
                            <th><i class="bi bi-flag me-1 opacity-50"></i>Priorité</th>
                            <th><i class="bi bi-circle-dot me-1 opacity-50"></i>Statut</th>
                            <th class="text-right"><i class="bi bi-three-dots me-1 opacity-50"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for alert in alerts %}
                        {# Couleur de ligne selon priorité #}
                        {% set rowClass = '' %}
                        {% if alert.effectiveNiveauPriorite and alert.effectiveNiveauPriorite.value == 'critique' %}
                            {% set rowClass = 'row-critique' %}
                        {% elseif alert.effectiveNiveauPriorite and alert.effectiveNiveauPriorite.value == 'eleve' %}
                            {% set rowClass = 'row-eleve' %}
                        {% endif %}

                        <tr class="db-tr {{ rowClass }}" id="row-{{ alert.id }}">
                            <td>
                                <button type="button" data-toggle-row="{{ alert.id }}" class="row-expand-btn" id="expbtn-{{ alert.id }}" title="Afficher les détails" aria-expanded="false">
                                    <i class="bi bi-plus" id="expicon-{{ alert.id }}"></i>
                                </button>
                            </td>
                            <td>
                                <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="code-gei-link">
                                    {{ alert.codeGei ?? 'BROUILLON' }}
                                </a>
                                {% if alert.surveillanceRenforcee %}
                                    <i class="bi bi-eye text-amber-400 ms-1" title="Surveillance renforcée"></i>
                                {% endif %}
                                {% if alert.transmissionPrioritaire %}
                                    <i class="bi bi-lightning text-red-400 ms-1" title="Transmission prioritaire"></i>
                                {% endif %}
                            </td>
                            <td class="text-slate-400 whitespace-nowrap">{{ alert.dateCreation|date('d/m/Y') }}</td>
                            <td>
                                <span class="table-market">{{ alert.market.nom }}</span>
                                {% if alert.portCorridor %}
                                    <span class="table-corridor">
                                        <i class="bi bi-route bi-xs me-0.5 opacity-50"></i>
                                        {{ alert.portCorridor|slice(0,28) }}{% if alert.portCorridor|length > 28 %}…{% endif %}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap">
                                <span class="table-categorie">
                                    {{ alert.categorie ?: '—' }}
                                </span>
                            </td>
                            <td class="table-resume" title="{{ alert.resumeExecutif }}">
                                {{ alert.resumeExecutif|slice(0,55) }}{% if alert.resumeExecutif|length > 55 %}…{% endif %}
                            </td>
                            <td class="text-center">
                                {% set score = alert.effectiveScore %}
                                {% if score %}
                                    <span class="score-badge
                                        {% if score >= 18 %}score-critique
                                        {% elseif score >= 14 %}score-eleve
                                        {% elseif score >= 10 %}score-modere
                                        {% else %}score-faible{% endif %}">
                                        {{ score }}
                                    </span>
                                    {% if alert.scoreSurcharge %}
                                        <i class="bi bi-pen bi-xs text-amber-400 ms-0.5" title="Score surchargé par Manager"></i>
                                    {% endif %}
                                {% else %}
                                    <span class="text-slate-600">—</span>
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap">
                                {% set prio = alert.effectiveNiveauPriorite %}
                                {% if prio %}
                                    <span class="priority-badge priority-{{ prio.value }}">
                                        {% if prio.value == 'critique' %}<i class="bi bi-broadcast bi-xs me-1"></i>
                                        {% elseif prio.value == 'eleve' %}<i class="bi bi-fire bi-xs me-1"></i>
                                        {% elseif prio.value == 'modere' %}<i class="bi bi-exclamation-circle bi-xs me-1"></i>
                                        {% else %}<i class="bi bi-check-circle bi-xs me-1"></i>{% endif %}
                                        {{ prio.label() }}
                                    </span>
                                {% else %}
                                    <span class="text-slate-600">—</span>
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap">
                                {% set st = alert.statut %}
                                <span class="status-pill status-{{ st.value }}">
                                    <span class="status-dot"></span>
                                    {{ st.label() }}
                                </span>
                            </td>
                            <td class="text-right whitespace-nowrap">
                                <div class="table-actions">
                                    <a href="{{ path('app_alert_show', {id: alert.id}) }}"
                                       class="tbl-btn tbl-btn-ghost" title="Voir la fiche">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    {% if is_granted('ALERT_QUALIFY', alert) %}
                                    <a href="{{ path('app_alert_qualify', {id: alert.id}) }}"
                                       class="tbl-btn tbl-btn-amber" title="Qualifier">
                                        <i class="bi bi-star-half"></i>
                                    </a>
                                    {% endif %}
                                    <a href="{{ path('app_alert_pdf', {id: alert.id}) }}"
                                       class="tbl-btn tbl-btn-red" title="PDF">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>

                        {# Ligne détails dépliable #}
                        <tr id="detail-{{ alert.id }}" class="db-detail-row hidden">
                            <td colspan="10">
                                <div class="detail-grid">
                                    <div class="detail-col">
                                        <p class="detail-col-title">
                                            <i class="bi bi-check2-all me-1.5 text-amber-400"></i>
                                            Éléments Factuels
                                        </p>
                                        <p class="detail-text">{{ alert.elementsFactuels ?: 'Non renseigné' }}</p>
                                    </div>
                                    <div class="detail-col">
                                        <p class="detail-col-title">
                                            <i class="bi bi-lightbulb me-1.5 text-amber-400"></i>
                                            Hypothèses Analytiques
                                        </p>
                                        <p class="detail-text">{{ alert.hypothesesAnalytiques ?: 'Non renseigné' }}</p>
                                    </div>
                                    <div class="detail-col detail-col-meta">
                                        <p class="detail-col-title">
                                            <i class="bi bi-sliders me-1.5 text-amber-400"></i>
                                            Qualification
                                        </p>
                                        <div class="detail-meta-grid">
                                            <span class="meta-lbl">Fiabilité</span>
                                            <span class="meta-val">{{ alert.fiabiliteSource ? alert.fiabiliteSource.value : '—' }}</span>
                                            <span class="meta-lbl">Crédibilité</span>
                                            <span class="meta-val">{{ alert.credibiliteContenu ?? '—' }}/4</span>
                                            <span class="meta-lbl">Urgence</span>
                                            <span class="meta-val">{{ alert.urgence ? alert.urgence.label() : '—' }}</span>
                                            <span class="meta-lbl">Impact</span>
                                            <span class="meta-val">{{ alert.impact ? alert.impact.label() : '—' }}</span>
                                            <span class="meta-lbl">Exploitabilité</span>
                                            <span class="meta-val">{{ alert.exploitabilite ? alert.exploitabilite.label() : '—' }}</span>
                                            <span class="meta-lbl">Recommandation</span>
                                            <span class="meta-val text-amber-400">{{ alert.recommandation ? alert.recommandation.label() : '—' }}</span>
                                        </div>
                                        {% if alert.actionsEnCours %}
                                        <div class="detail-actions-note">
                                            <i class="bi bi-clipboard me-1 text-slate-400"></i>
                                            {{ alert.actionsEnCours }}
                                        </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" class="db-empty-state">
                                <i class="bi bi-folder2-open bi-2x text-slate-600 mb-3"></i>
                                <p>Aucune alerte trouvée</p>
                                <a href="{{ path('app_alert_new') }}" class="db-btn db-btn-amber mt-3">
                                    <i class="bi bi-plus me-1.5"></i>Créer la première alerte
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ──── COLONNE DROITE : Score moyen + Activités récentes ──────── #}
        <div class="db-right-col">

            {# Score moyen GEI #}
            <div class="db-score-card">
                <div class="db-card-header">
                    <div>
                        <p class="db-card-eyebrow"><i class="bi bi-star me-1.5"></i>Score GEI Moyen</p>
                        <p class="db-card-title">Indice de Risque</p>
                    </div>
                    <button class="db-icon-btn" title="Détails">
                        <i class="bi bi-three-dots"></i>
                    </button>
                </div>
                <div class="score-display">
                    {% set scoreDisplay = kpis.scoreMoyen ?? 0 %}
                    {% set scoreClass = 'score-faible' %}
                    {% if scoreDisplay >= 18 %}{% set scoreClass = 'score-critique' %}
                    {% elseif scoreDisplay >= 14 %}{% set scoreClass = 'score-eleve' %}
                    {% elseif scoreDisplay >= 10 %}{% set scoreClass = 'score-modere' %}{% endif %}
                    <span class="score-display-value {{ scoreClass }}">{{ scoreDisplay|number_format(1) }}</span>
                    <span class="score-display-max">/25</span>
                </div>
                <div class="score-bar-wrap">
                    <div class="score-bar-track">
                        <div class="score-bar-fill {{ scoreClass }}"
                             style="width: {{ ((scoreDisplay / 25) * 100)|round }}%"></div>
                    </div>
                </div>
                <div class="score-thresholds">
                    <span class="threshold-item threshold-faible">≤9 Faible</span>
                    <span class="threshold-item threshold-modere">10-13 Modéré</span>
                    <span class="threshold-item threshold-eleve">14-17 Élevé</span>
                    <span class="threshold-item threshold-critique">≥18 Critique</span>
                </div>
            </div>

            {# Plans par pays (équivalent "Saving Plans" COINEST) #}
            <div class="db-countries-card">
                <div class="db-card-header">
                    <div>
                        <p class="db-card-eyebrow"><i class="bi bi-globe-africa me-1.5"></i>Par Pays</p>
                        <p class="db-card-title">Répartition marchés</p>
                    </div>
                    <a href="{{ path('app_alert_new') }}" class="db-text-link">
                        <i class="bi bi-plus me-1"></i>Ajouter
                    </a>
                </div>
                <div class="countries-list">
                    {% for stat in kpis.parPays ?? [] %}
                    <div class="country-item">
                        <span class="country-label">
                            <i class="bi bi-geo-alt bi-xs me-1.5 text-amber-400"></i>
                            {{ stat.nom }}
                        </span>
                        <div class="country-bar-wrap">
                            <div class="country-bar-track">
                                <div class="country-bar-fill"
                                     style="width: {{ kpis.total > 0 ? ((stat.count / kpis.total) * 100)|round : 0 }}%"></div>
                            </div>
                        </div>
                        <span class="country-pct">{{ kpis.total > 0 ? ((stat.count / kpis.total) * 100)|round : 0 }}%</span>
                    </div>
                    {% else %}
                    {% for m in markets|slice(0,5) %}
                    <div class="country-item">
                        <span class="country-label">
                            <i class="bi bi-geo-alt bi-xs me-1.5 text-amber-400"></i>
                            {{ m.nom }}
                        </span>
                        <div class="country-bar-wrap">
                            <div class="country-bar-track">
                                <div class="country-bar-fill" style="width: {{ (20 - loop.index * 2) }}%"></div>
                            </div>
                        </div>
                        <span class="country-pct">{{ (20 - loop.index * 2) }}%</span>
                    </div>
                    {% endfor %}
                    {% endfor %}
                </div>
            </div>

            {# Activités récentes (équivalent "Recent Activities" COINEST) #}
            <div class="db-activities-card">
                <div class="db-card-header">
                    <div>
                        <p class="db-card-eyebrow"><i class="bi bi-clock-history me-1.5"></i>Activité</p>
                        <p class="db-card-title">Activités Récentes</p>
                    </div>
                    <button class="db-icon-btn">
                        <i class="bi bi-three-dots"></i>
                    </button>
                </div>

                <div class="activities-list">
                    {% set today_activities = [] %}
                    {% set yesterday_activities = [] %}

                    {% for alert in alerts|slice(0,6) %}
                        {% if loop.index <= 3 %}
                            {% set today_activities = today_activities|merge([alert]) %}
                        {% else %}
                            {% set yesterday_activities = yesterday_activities|merge([alert]) %}
                        {% endif %}
                    {% endfor %}

                    {% if today_activities|length > 0 %}
                    <p class="activity-day-label">Aujourd'hui</p>
                    {% for alert in today_activities %}
                    <div class="activity-item">
                        <div class="activity-icon-wrap
                            {% if alert.effectiveNiveauPriorite and alert.effectiveNiveauPriorite.value == 'critique' %}activity-icon-red
                            {% elseif alert.effectiveNiveauPriorite and alert.effectiveNiveauPriorite.value == 'eleve' %}activity-icon-amber
                            {% else %}activity-icon-blue{% endif %}">
                            {% if alert.effectiveNiveauPriorite and alert.effectiveNiveauPriorite.value == 'critique' %}
                                <i class="bi bi-broadcast bi-xs"></i>
                            {% elseif alert.statut.value in ['validee', 'transmis'] %}
                                <i class="bi bi-send bi-xs"></i>
                            {% else %}
                                <i class="bi bi-file-earmark-plus bi-xs"></i>
                            {% endif %}
                        </div>
                        <div class="activity-body">
                            <p class="activity-title">
                                <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="hover:text-amber-400 transition">
                                    {{ alert.codeGei ?? 'Brouillon' }}
                                </a>
                                — {{ alert.market.nom }}
                            </p>
                            <span class="activity-meta">
                                {{ alert.dateCreation|date('d/m/Y') }}
                                {% if alert.portCorridor %}
                                    · {{ alert.portCorridor|slice(0,25) }}{% if alert.portCorridor|length > 25 %}…{% endif %}
                                {% endif %}
                            </span>
                        </div>
                    </div>
                    {% endfor %}
                    {% endif %}

                    {% if yesterday_activities|length > 0 %}
                    <p class="activity-day-label">Précédentes</p>
                    {% for alert in yesterday_activities %}
                    <div class="activity-item">
                        <div class="activity-icon-wrap activity-icon-slate">
                            <i class="bi bi-file-text bi-xs"></i>
                        </div>
                        <div class="activity-body">
                            <p class="activity-title">
                                <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="hover:text-amber-400 transition">
                                    {{ alert.codeGei ?? 'Brouillon' }}
                                </a>
                            </p>
                            <span class="activity-meta">{{ alert.dateCreation|date('d/m/Y') }} · {{ alert.statut ? alert.statut.label() : '—' }}</span>
                        </div>
                    </div>
                    {% endfor %}
                    {% endif %}

                    {% if alerts|length == 0 %}
                    <div class="activity-empty">
                        <i class="bi bi-clock text-slate-600 bi-lg mb-2"></i>
                        <p>Aucune activité récente</p>
                    </div>
                    {% endif %}
                </div>
            </div>

        </div>{# /db-right-col #}

    </div>{# /db-bottom-row #}

</div>{# /db-wrapper #}

{# ═══════════════════════════════════════════════════════════════════════════
   SCRIPTS : Chart.js — graphique évolution + donut priorités
════════════════════════════════════════════════════════════════════════════ #}
{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
/* ─── Données injectées depuis le contrôleur ─── */
const chartData = {
    labels:      {{ chartLabels|default(['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'])|json_encode|raw }},
    nouvelles:   {{ chartNouvelles|default([3,5,2,8,6,4,7])|json_encode|raw }},
    transmises:  {{ chartTransmises|default([1,2,1,3,2,2,3])|json_encode|raw }},
    priorites: {
        critique: {{ kpis.critiques }},
        eleve:    {{ kpis.eleve ?? 0 }},
        modere:   {{ kpis.modere ?? 0 }},
        faible:   {{ kpis.faible ?? 0 }},
    }
};

/* ─── Defaults Chart.js ─── */
Chart.defaults.color          = '#94a3b8';
Chart.defaults.borderColor    = 'rgba(148,163,184,0.08)';
Chart.defaults.font.family    = 'Inter, system-ui, sans-serif';
Chart.defaults.font.size      = 11;

/* ─── 1) Graphique évolution (line chart) ─── */
/* ─── 1) Graphique évolution (line chart) — Différenciation Teal vs Bleu ─── */
const evolutionCtx = document.getElementById('alertEvolutionChart').getContext('2d');

/* Nouvelles alertes : Teal primaire (#16856b) */
const gradientTeal = evolutionCtx.createLinearGradient(0, 0, 0, 200);
gradientTeal.addColorStop(0,   'rgba(22,133,107,0.16)');
gradientTeal.addColorStop(1,   'rgba(22,133,107,0.01)');

/* Transmises : Bleu de la charte (#3b82f6) */
const gradientBlue = evolutionCtx.createLinearGradient(0, 0, 0, 200);
gradientBlue.addColorStop(0, 'rgba(59,130,246,0.15)');
gradientBlue.addColorStop(1, 'rgba(59,130,246,0.01)');

const evolutionChart = new Chart(evolutionCtx, {
    type: 'line',
    data: {
        labels: chartData.labels,
        datasets: [
            {
                label: 'Nouvelles alertes',
                data: chartData.nouvelles,
                borderColor:     '#16856b',
                backgroundColor: gradientTeal,
                borderWidth:     2,
                pointBackgroundColor: '#16856b',
                pointBorderColor:     '#ffffff',
                pointBorderWidth:     2,
                pointRadius:     3.5,
                pointHoverRadius: 6,
                tension: 0.35,
                fill: true,
            },
            {
                label: 'Transmises',
                data: chartData.transmises,
                borderColor:     '#3b82f6',
                backgroundColor: gradientBlue,
                borderWidth:     2,
                pointBackgroundColor: '#3b82f6',
                pointBorderColor:     '#ffffff',
                pointBorderWidth:     2,
                pointRadius:     3.5,
                pointHoverRadius: 6,
                tension: 0.35,
                fill: true,
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: 'rgba(18,63,53,0.97)',
                borderColor:     'rgba(69,227,184,0.25)',
                borderWidth:     1,
                padding:         12,
                cornerRadius:    8,
                titleColor:      '#e2ede8',
                bodyColor:       '#a8c4b8',
                titleFont:       { size: 12, weight: '700', family: 'Inter, sans-serif' },
                bodyFont:        { size: 11, family: 'Inter, sans-serif' },
                callbacks: {
                    label: ctx => ` ${ctx.dataset.label} : ${ctx.parsed.y}`
                }
            }
        },
        scales: {
            x: {
                grid: { color: 'rgba(148,163,184,0.04)', drawBorder: false },
                ticks: {
                    color: '#7da090',
                    autoSkip: true,
                    maxTicksLimit: 8,
                    maxRotation: 0,
                    minRotation: 0,
                    padding: 8,
                    font: { size: 10, family: 'Inter, sans-serif' }
                },
                border: { display: false }
            },
            y: {
                grid: { color: 'rgba(148,163,184,0.04)', drawBorder: false },
                ticks: { color: '#7da090', stepSize: 1, font: { size: 10, family: 'Inter, sans-serif' } },
                border: { display: false },
                beginAtZero: true
            }
        }
    }
});

/* ─── 2) Donut priorités ─── */
const donutCtx = document.getElementById('priorityDonutChart').getContext('2d');
const donutData = [
    chartData.priorites.critique,
    chartData.priorites.eleve,
    chartData.priorites.modere,
    chartData.priorites.faible,
];

/* Éviter un donut vide si tout = 0 */
const donutTotal = donutData.reduce((a, b) => a + b, 0);
const finalDonutData = donutTotal > 0 ? donutData : [1, 1, 1, 1];

new Chart(donutCtx, {
    type: 'doughnut',
    data: {
        labels: ['Critique', 'Élevé', 'Modéré', 'Faible'],
        datasets: [{
            data: finalDonutData,
            backgroundColor: [
                'rgba(239,68,68,0.85)',
                'rgba(251,146,60,0.85)',
                'rgba(251,191,36,0.85)',
                'rgba(52,211,153,0.85)',
            ],
            borderColor: '#090e1a',
            borderWidth: 3,
            hoverBorderWidth: 0,
            hoverOffset: 6,
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        cutout: '72%',
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: 'rgba(18,63,53,0.97)',
                borderColor:     'rgba(69,227,184,0.25)',
                borderWidth:     1,
                padding:         10,
                cornerRadius:    8,
                titleColor:      '#e2ede8',
                bodyColor:       '#a8c4b8',
                titleFont:       { family: 'Inter, sans-serif' },
                bodyFont:        { family: 'Inter, sans-serif' },
                callbacks: {
                    label: ctx => {
                        const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                        const pct   = total > 0 ? Math.round((ctx.parsed / total) * 100) : 0;
                        return ` ${ctx.label} : ${donutTotal > 0 ? ctx.parsed : 0} (${pct}%)`;
                    }
                }
            }
        }
    }
});

/* ─── Toggle ligne détails ─── */
function toggleRow(id) {
    const row  = document.getElementById('detail-' + id);
    const icon = document.getElementById('expicon-' + id);
    const btn  = document.getElementById('expbtn-' + id);

    const isOpening = row.classList.contains('hidden');
    if (isOpening) {
        row.classList.remove('hidden');
        icon.classList.replace('bi bi-plus', 'bi bi-dash');
        btn.classList.add('expand-active');
    } else {
        row.classList.add('hidden');
        icon.classList.replace('bi bi-dash', 'bi bi-plus');
        btn.classList.remove('expand-active');
    }
    syncRowToggleState(row, icon, btn);
}

function syncRowToggleState(row, icon, btn) {
    const expanded = !row.classList.contains('hidden');
    btn.setAttribute('aria-expanded', String(expanded));
    btn.classList.toggle('expand-active', expanded);
    icon.classList.toggle('bi-plus', !expanded);
    icon.classList.toggle('bi-dash', expanded);
}

document.querySelectorAll('[data-toggle-row]').forEach((button) => {
    button.addEventListener('click', (event) => {
        if (event.__geiRowHandled) return;
        event.__geiRowHandled = true;
        const now = Date.now();
        if (button.dataset.lastToggleAt && now - Number(button.dataset.lastToggleAt) < 250) return;
        button.dataset.lastToggleAt = String(now);
        toggleRow(button.dataset.toggleRow);
        window.setTimeout(() => {
            const row = document.getElementById('detail-' + button.dataset.toggleRow);
            const icon = document.getElementById('expicon-' + button.dataset.toggleRow);
            if (row && icon) syncRowToggleState(row, icon, button);
        }, 0);
    });
});

document.querySelectorAll('.db-detail-row').forEach((row) => {
    const id = row.id.replace('detail-', '');
    const button = document.getElementById('expbtn-' + id);
    const icon = document.getElementById('expicon-' + id);
    if (!button || !icon) return;
    new MutationObserver(() => syncRowToggleState(row, icon, button)).observe(row, {
        attributes: true,
        attributeFilter: ['class']
    });
});

}); // END DOMContentLoaded
</script>
{% endblock %}
{% endblock %}
