{% extends 'base.html.twig' %}

{% block title %}Mon Tableau de Bord — GEI Platform{% endblock %}
{% block header_title %}Mon Tableau de Bord{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ═══════════════════════════════════════════════════════════════════════════
       EN-TÊTE : Bienvenue + Statistiques rapides
    ═════════════════════════════════════════════════════════════════════════ #}
    <div class="agent-header">
        <div>
            <p class="page-eyebrow">
                <i class="bi bi-person-check me-1.5 text-emerald-400"></i>
                Dashboard Personnel
            </p>
            <h1 class="page-title">Mon activité terrain</h1>
            <p class="page-subtitle">
                Tableau de bord de vos alertes soumises — retrouvez ici vos statistiques et activité pour rédiger vos rapports d'activité.
            </p>
        </div>
        <a href="{{ path('app_wizard_new') }}" class="db-btn db-btn-amber">
            <i class="bi bi-plus-lg me-1.5"></i>
            <span>Nouvelle alerte</span>
        </a>
    </div>

    <form method="get" action="{{ path('app_agent_dashboard') }}" class="db-card agent-dashboard-filters">
        <label class="form-label" for="agentDashboardDays">Période des statistiques</label>
        <select id="agentDashboardDays" name="days" class="form-select" onchange="this.form.submit()">
            <option value="all" {% if days is null %}selected{% endif %}>Toute la période</option>
            {% for period in allowedDays %}
                <option value="{{ period }}" {% if days == period %}selected{% endif %}>
                    {{ period }} derniers jours
                </option>
            {% endfor %}
        </select>
    </form>

    {% if hasError %}
        <div class="db-card" role="alert">
            Les statistiques sont momentanément indisponibles. Veuillez réessayer plus tard.
        </div>
    {% endif %}

    {# ─────────────────────────────────────────────────────────────────────── #}
    {# LIGNE 1 : KPIs PRINCIPAUX (5 cards) #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    <div class="db-kpi-row">
        {# Total alertes soumises #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Alertes Soumises',
            value: kpis.total,
            icon: 'bi-file-earmark-text',
            color: 'teal'
        } %}

        {# Taux de validation #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Taux de Validation',
            value: tauxValidation.taux_validation ~ '%',
            icon: 'bi-check-circle',
            color: 'emerald',
            trend_val: tauxValidation.validee ~ '/' ~ tauxValidation.total,
            trend_label: 'Validées / Total',
            trend_dir: 'up'
        } %}

        {# Score GEI moyen #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Score GEI Moyen',
            value: kpis.scoreMoyen,
            icon: 'bi-star-half',
            color: (kpis.scoreMoyen >= 18 ? 'red' : (kpis.scoreMoyen >= 14 ? 'amber' : (kpis.scoreMoyen >= 10 ? 'blue' : 'teal'))),
            trend_val: (kpis.scoreMoyen >= 18 ? 'Critique' : (kpis.scoreMoyen >= 14 ? 'Élevé' : (kpis.scoreMoyen >= 10 ? 'Modéré' : 'Faible'))),
            trend_dir: 'neutral'
        } %}

        {# Alertes en attente de validation #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'En Attente',
            value: (tauxValidation.en_cours ?? 0) + (tauxValidation.nouveau ?? 0),
            icon: 'bi-hourglass-split',
            color: 'amber',
            trend_val: (tauxValidation.en_cours ?? 0) ~ ' en validation',
            trend_dir: 'neutral'
        } %}

        {# Délai moyen traitement #}
        {% include 'components/_stat_card.html.twig' with {
            title: 'Délai Moyen',
            value: (kpis.delaiMoyenH is not null ? kpis.delaiMoyenH ~ 'h' : 'N/A'),
            icon: 'bi-clock',
            color: 'slate',
            trend_val: 'Soumission → Validation',
            trend_dir: 'neutral'
        } %}
    </div>

    {# ─────────────────────────────────────────────────────────────────────── #}
    {# LIGNE 2 : GRAPHIQUES (Évolution + Distribution scores) #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    <div class="db-mid-row">

        {# Évolution mensuelle #}
        <div class="db-chart-card db-chart-lg">
            <div class="db-card-header">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-graph-up me-1.5"></i>Votre Activité</p>
                    <p class="db-card-title">Soumissions et Validations</p>
                </div>
                <span class="db-live-indicator"><span></span>{{ (evolutionMensuelle.mois ?? 12) }} derniers mois</span>
            </div>
            <div class="db-chart-area">
                <canvas id="evolutionMensuelleChart" height="90"></canvas>
            </div>
        </div>

        {# Distribution des scores #}
        <div class="db-chart-card db-chart-sm">
            <div class="db-card-header">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-pie-chart me-1.5"></i>Qualité</p>
                    <p class="db-card-title">Distribution Scores</p>
                </div>
            </div>
            <div class="donut-wrap">
                <canvas id="scoreDistributionChart" width="160" height="160"></canvas>
                <div class="donut-center">
                    <span class="donut-total">{{ kpis.total }}</span>
                    <span class="donut-total-label">Total</span>
                </div>
            </div>
            <div class="donut-legend">
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#ef4444;"></span>
                    <span class="donut-legend-label">Critique (18+)</span>
                    <span class="donut-legend-val">{{ scoreDistribution.critique ?? 0 }}</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#f97316;"></span>
                    <span class="donut-legend-label">Élevé (14-17)</span>
                    <span class="donut-legend-val">{{ scoreDistribution.eleve ?? 0 }}</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#f59e0b;"></span>
                    <span class="donut-legend-label">Modéré (10-13)</span>
                    <span class="donut-legend-val">{{ scoreDistribution.modere ?? 0 }}</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#10b981;"></span>
                    <span class="donut-legend-label">Faible (1-9)</span>
                    <span class="donut-legend-val">{{ scoreDistribution.faible ?? 0 }}</span>
                </div>
            </div>
        </div>

    </div>

    {# ─────────────────────────────────────────────────────────────────────── #}
    {# LIGNE 3 : RÉPARTITIONS (Catégories + Urgences) #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    <div class="db-row">

        {# Catégories #}
        <div class="db-chart-card">
            <div class="db-card-header">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-tags me-1.5"></i>Par Catégorie</p>
                    <p class="db-card-title">Répartition des Alertes</p>
                </div>
            </div>
            {% if catStats|length > 0 %}
            <div class="db-chart-area" style="height: 220px;">
                <canvas id="categorieChart"></canvas>
            </div>
            {% else %}
            <p class="text-center text-slate-500 py-8">Aucune alerte catégorisée pour le moment</p>
            {% endif %}
        </div>

        {# Urgences #}
        <div class="db-chart-card">
            <div class="db-card-header">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-exclamation-circle me-1.5"></i>Par Urgence</p>
                    <p class="db-card-title">Niveaux d'Urgence</p>
                </div>
            </div>
            {% if urgenceStats|length > 0 %}
            <div class="db-chart-area" style="height: 220px;">
                <canvas id="urgenceChart"></canvas>
            </div>
            {% else %}
            <p class="text-center text-slate-500 py-8">Aucune donnée d'urgence</p>
            {% endif %}
        </div>

        {# Priorités (donut) #}
        <div class="db-chart-card">
            <div class="db-card-header">
                <div>
                    <p class="db-card-eyebrow"><i class="bi bi-flag me-1.5"></i>Par Priorité</p>
                    <p class="db-card-title">Répartition Calculée</p>
                </div>
            </div>
            <div class="donut-wrap" style="margin: 12px auto;">
                <canvas id="priorityChart" width="140" height="140"></canvas>
            </div>
            <div class="donut-legend">
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#ef4444;"></span>
                    <span class="donut-legend-label">Critique</span>
                    <span class="donut-legend-val">{{ kpis.critique }}</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#f97316;"></span>
                    <span class="donut-legend-label">Élevé</span>
                    <span class="donut-legend-val">{{ kpis.eleve }}</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#f59e0b;"></span>
                    <span class="donut-legend-label">Modéré</span>
                    <span class="donut-legend-val">{{ kpis.modere }}</span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot" style="background:#10b981;"></span>
                    <span class="donut-legend-label">Faible</span>
                    <span class="donut-legend-val">{{ kpis.faible }}</span>
                </div>
            </div>
        </div>

    </div>

    {# ─────────────────────────────────────────────────────────────────────── #}
    {# LIGNE 4 : ALERTES RÉCENTES #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    <div class="db-card">
        <div class="db-card-header">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-clock-history me-1.5"></i>Activité Récente</p>
                <p class="db-card-title">8 Dernières Alertes Soumises</p>
            </div>
            <a href="{{ path('app_alert_index') }}" class="db-link">
                Voir le registre complet <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        {% if alertesRecentes|length > 0 %}
        <div class="db-table-wrap">
            <table class="db-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-hash me-1 opacity-50"></i>Code</th>
                        <th><i class="bi bi-calendar me-1 opacity-50"></i>Date</th>
                        <th><i class="bi bi-tag me-1 opacity-50"></i>Catégorie</th>
                        <th><i class="bi bi-exclamation me-1 opacity-50"></i>Urgence</th>
                        <th class="text-center"><i class="bi bi-star-half me-1 opacity-50"></i>Score</th>
                        <th><i class="bi bi-circle-dot me-1 opacity-50"></i>Statut</th>
                        <th class="text-right"><i class="bi bi-three-dots me-1 opacity-50"></i>Action</th>
                    </tr>
                </thead>
                <tbody>
                {% for alert in alertesRecentes %}
                    {% set alertToken = encrypt_id(alert.id, 'alert') %}
                    {% set rowClass = alert.effectiveNiveauPriorite and alert.effectiveNiveauPriorite.value == 'critique' ? 'row-critique' : (alert.effectiveNiveauPriorite and alert.effectiveNiveauPriorite.value == 'eleve' ? 'row-eleve' : '') %}
                    <tr class="db-tr {{ rowClass }}">
                        <td>
                            <a href="{{ path('app_alert_show', {token: alertToken}) }}" class="code-gei-link">
                                {{ alert.codeGei ?? 'BROUILLON' }}
                            </a>
                        </td>
                        <td class="text-slate-400 text-sm">{{ alert.dateCreation|date('d/m/Y') }}</td>
                        <td class="text-sm">{{ alert.categorie ?: '—' }}</td>
                        <td class="text-sm">
                            {% if alert.urgence %}
                                <span class="urgence-badge urgence-{{ alert.urgence.value|lower }}">{{ alert.urgence.label() }}</span>
                            {% else %}
                                <span class="text-slate-400">—</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {% set score = alert.effectiveScore ?? 0 %}
                            <span class="score-badge {% if score >= 18 %}score-critique{% elseif score >= 14 %}score-eleve{% elseif score >= 10 %}score-modere{% else %}score-faible{% endif %}">
                                {{ score }}
                            </span>
                        </td>
                        <td>
                            <span class="status-badge status-{{ alert.statut.value|lower|replace('_', '-') }}">
                                {{ alert.statut.label() }}
                            </span>
                        </td>
                        <td class="text-right">
                            <a href="{{ path('app_alert_show', {token: alertToken}) }}" class="db-icon-btn" title="Voir la fiche">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="text-center text-slate-500 py-12">
            <i class="bi bi-inbox block text-2xl mb-2"></i>
            Vous n'avez pas encore soumis d'alerte
        </p>
        {% endif %}
    </div>

</div>

{# ═══════════════════════════════════════════════════════════════════════════
   SCRIPTS Chart.js
═════════════════════════════════════════════════════════════════════════ #}
<script>
/* ═════════════════════════════════════════════════════════════════════════════
   ECharts PRO — Dashboard Agent — graphiques animés, responsive, dark/light
   ═════════════════════════════════════════════════════════════════════════════ */
document.addEventListener("DOMContentLoaded", function() {
    const GEI = {
        teal:   "#16856b",
        blue:   "#3b82f6",
        amber:  "#fbbf24",
        emerald:"#34d399",
        red:    "#ef4444",
        orange: "#f97316",
        yellow: "#eab308",
    };
    const isDark = document.body.classList.contains("dark") || document.documentElement.classList.contains("dark");
    const textColor = isDark ? "#a8c4b8" : "#94a3b8";
    const gridColor = isDark ? "rgba(168,196,184,0.08)" : "rgba(148,163,184,0.08)";

    function initChart(elId, option) {
        const el = document.getElementById(elId);
        if (!el || typeof echarts === "undefined") return;
        const chart = echarts.init(el, null, { renderer: "canvas", devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2) });
        window.__gei_echarts = window.__gei_echarts || {};
        window.__gei_echarts[elId] = chart;
        chart.setOption(option, true);
        return chart;
    }

    /* ─── 1) Évolution mensuelle (line area) ─── */
    const evoLabels = {{ evolutionMensuelle.labels|json_encode|raw }};
    const evoSoumises = {{ evolutionMensuelle.soumises|json_encode|raw }};
    const evoValidees = {{ evolutionMensuelle.validees|json_encode|raw }};

    const gradTeal = new echarts.graphic.LinearGradient(0, 0, 0, 1, [
        { offset: 0, color: isDark ? "rgba(22,133,107,0.35)" : "rgba(22,133,107,0.18)" },
        { offset: 1, color: isDark ? "rgba(22,133,107,0.05)" : "rgba(22,133,107,0.02)" },
    ]);
    const gradBlue = new echarts.graphic.LinearGradient(0, 0, 0, 1, [
        { offset: 0, color: isDark ? "rgba(59,130,246,0.30)" : "rgba(59,130,246,0.16)" },
        { offset: 1, color: isDark ? "rgba(59,130,246,0.05)" : "rgba(59,130,246,0.02)" },
    ]);

    initChart("evolutionMensuelleChart", {
        backgroundColor: "transparent",
        animation: true,
        animationDuration: 1200,
        animationEasing: "cubicOut",
        tooltip: {
            trigger: "axis",
            backgroundColor: isDark ? "rgba(18,63,53,0.95)" : "rgba(255,255,255,0.95)",
            textStyle: { color: "#a8c4b8", fontSize: 11, fontFamily: "Inter, sans-serif" },
        },
        grid: { left: 40, right: 20, top: 30, bottom: 40, containLabel: true },
        xAxis: {
            type: "category",
            data: evoLabels,
            axisLine: { show: false },
            axisTick: { show: false },
            axisLabel: { color: textColor, fontSize: 10 },
            splitLine: { show: false },
        },
        yAxis: {
            type: "value",
            axisLine: { show: false },
            axisTick: { show: false },
            axisLabel: { color: textColor, fontSize: 10 },
            splitLine: { lineStyle: { color: gridColor, type: "dashed" } },
            min: 0,
        },
        series: [
            {
                name: "Soumises",
                type: "line",
                smooth: true,
                symbol: "circle",
                symbolSize: 5,
                itemStyle: { color: GEI.teal },
                lineStyle: { width: 2, color: GEI.teal },
                areaStyle: { color: gradTeal },
                data: evoSoumises,
            },
            {
                name: "Validées",
                type: "line",
                smooth: true,
                symbol: "circle",
                symbolSize: 5,
                itemStyle: { color: GEI.blue },
                lineStyle: { width: 2, color: GEI.blue },
                areaStyle: { origin: "start", color: gradBlue },
                data: evoValidees,
            }
        ]
    });

    /* ─── Helpers donut ─── */
    function donutOption(title, values, labels, colors, totalKey) {
        const total = values.reduce((a, b) => a + b, 0) || 1;
        return {
            backgroundColor: "transparent",
            animation: true,
            animationDuration: 1500,
            animationEasing: "cubicOut",
            tooltip: {
                trigger: "item",
                backgroundColor: isDark ? "rgba(18,63,53,0.95)" : "rgba(255,255,255,0.95)",
                textStyle: { color: "#a8c4b8", fontSize: 11, fontFamily: "Inter, sans-serif" },
                formatter: function (params) {
                    const pct = total > 0 ? Math.round((params.value / total) * 100) : 0;
                    return params.name + " : " + params.value + " (" + pct + "%)";
                }
            },
            series: [{
                type: "pie",
                radius: ["55%", "75%"],
                avoidLabelOverlap: false,
                itemStyle: { borderRadius: 8, borderColor: "transparent", borderWidth: 0 },
                label: { show: false },
                emphasis: { label: { show: true, fontSize: 12 } },
                labelLine: { show: false },
                data: values.map((v, i) => ({ value: v, name: labels[i], itemStyle: { color: colors[i] } })),
            }]
        };
    }

    /* ─── 2) Distribution des scores (donut) ─── */
    const sdValues = [
        {{ scoreDistribution.critique ?? 0 }},
        {{ scoreDistribution.eleve ?? 0 }},
        {{ scoreDistribution.modere ?? 0 }},
        {{ scoreDistribution.faible ?? 0 }},
    ];
    initChart("scoreDistributionChart", donutOption(
        "Distribution des scores",
        sdValues,
        ["Critique", "Élevé", "Modéré", "Faible"],
        [GEI.red, GEI.orange, GEI.amber, GEI.emerald]
    ));

    /* ─── 3) Priorités (donut) ─── */
    const pValues = [
        {{ kpis.critique ?? 0 }},
        {{ kpis.eleve ?? 0 }},
        {{ kpis.modere ?? 0 }},
        {{ kpis.faible ?? 0 }},
    ];
    initChart("priorityChart", donutOption(
        "Répartition par priorité",
        pValues,
        ["Critique", "Élevé", "Modéré", "Faible"],
        [GEI.red, GEI.orange, GEI.amber, GEI.emerald]
    ));

    /* ─── 4) Catégories (bar horizontal) ─── */
    const catStats = {{ catStats|json_encode|raw }};
    if (Array.isArray(catStats) && catStats.length > 0) {
        initChart("categorieChart", {
            backgroundColor: "transparent",
            animation: true,
            animationDuration: 1000,
            tooltip: {
                trigger: "axis",
                axisPointer: { type: "shadow" },
                backgroundColor: isDark ? "rgba(18,63,53,0.95)" : "rgba(255,255,255,0.95)",
                textStyle: { color: "#a8c4b8", fontSize: 11, fontFamily: "Inter, sans-serif" },
            },
            grid: { left: 100, right: 30, top: 20, bottom: 30, containLabel: true },
            yAxis: {
                type: "category",
                data: catStats.map(c => c.categorie || "Sans catégorie"),
                axisLine: { show: false },
                axisTick: { show: false },
                axisLabel: { color: textColor, fontSize: 11 },
                inverse: true,
            },
            xAxis: {
                type: "value",
                axisLine: { show: false },
                axisTick: { show: false },
                axisLabel: { color: textColor, fontSize: 10 },
                splitLine: { lineStyle: { color: gridColor, type: "dashed" } },
                min: 0,
            },
            series: [{
                type: "bar",
                data: catStats.map(c => c.count),
                itemStyle: {
                    color: GEI.teal,
                    borderRadius: [0, 6, 6, 0],
                },
                barMaxWidth: 26,
            }]
        });
    }

    /* ─── 5) Urgences (bar horizontal) ─── */
    const urgences = {{ urgenceStats|json_encode|raw }};
    if (Array.isArray(urgences) && urgences.length > 0) {
        const uColors = {
            immediate: GEI.red,
            "24h": GEI.orange,
            "72h": GEI.amber,
            routine: GEI.emerald,
        };
        initChart("urgenceChart", {
            backgroundColor: "transparent",
            animation: true,
            animationDuration: 1000,
            tooltip: {
                trigger: "axis",
                axisPointer: { type: "shadow" },
                backgroundColor: isDark ? "rgba(18,63,53,0.95)" : "rgba(255,255,255,0.95)",
                textStyle: { color: "#a8c4b8", fontSize: 11, fontFamily: "Inter, sans-serif" },
            },
            grid: { left: 100, right: 30, top: 20, bottom: 30, containLabel: true },
            yAxis: {
                type: "category",
                data: urgences.map(u => u.urgence || "Sans"),
                axisLine: { show: false },
                axisTick: { show: false },
                axisLabel: { color: textColor, fontSize: 11 },
                inverse: true,
            },
            xAxis: {
                type: "value",
                axisLine: { show: false },
                axisTick: { show: false },
                axisLabel: { color: textColor, fontSize: 10 },
                splitLine: { lineStyle: { color: gridColor, type: "dashed" } },
                min: 0,
            },
            series: [{
                type: "bar",
                data: urgences.map(u => ({ value: u.count, itemStyle: { color: uColors[u.urgence] || GEI.slate, borderRadius: [0, 6, 6, 0] } })),
                barMaxWidth: 26,
            }]
        });
    }

    /* Responsive global */
    if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => {
            if (window.__gei_echarts) {
                Object.values(window.__gei_echarts).forEach(chart => chart.resize());
            }
        });
        ro.observe(document.body);
    }
});
</script>

{% endblock %}
