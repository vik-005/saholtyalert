{% extends 'base.html.twig' %}

{% block body_login %}
<div class="auth-shell auth-shell-pro">

    {# ══════════════════════════════════════════════════════════════════
       PANNEAU GAUCHE — fond vert institutionnel + slideshow photo
    ══════════════════════════════════════════════════════════════════ #}
    <aside class="auth-brand-panel">

        {# ── Diaporama fond ── #}
        <div class="auth-slide-wrap" id="authSlideWrap">
            {#
                Images issues de Unsplash (libres de droits, thème opérationnel / sécurité).
                Remplacez les URLs par vos propres assets si besoin.
            #}
            <div class="auth-slide-item auth-slide-active"
                 style="background-image:url('https://images.unsplash.com/photo-1557597774-9d475d030a6d?w=900&q=80&auto=format&fit=crop')">
            </div>
            <div class="auth-slide-item"
                 style="background-image:url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=900&q=80&auto=format&fit=crop')">
            </div>
            <div class="auth-slide-item"
                 style="background-image:url('https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=900&q=80&auto=format&fit=crop')">
            </div>
            <div class="auth-slide-item"
                 style="background-image:url('https://images.unsplash.com/photo-1591696205602-2f950c417cb9?w=900&q=80&auto=format&fit=crop')">
            </div>
        </div>

        {# ── Overlay vert semi-transparent ── #}
        <div class="auth-slide-overlay"></div>

        {# ── Contenu branding (au-dessus de l'overlay) ── #}
        <a href="{{ path('app_login') }}" class="auth-brand">
            <span><i class="fa-solid fa-shield-halved"></i></span>GEI Platform
        </a>

        <div class="auth-brand-copy">
            <p class="auth-brand-tag">Groupe d'échange d'informations</p>
            <h2>Une information mieux qualifiée.<br>Une décision mieux protégée.</h2>
            <p>Plateforme sécurisée de collecte, qualification et suivi des alertes opérationnelles.</p>
        </div>

        <ul class="auth-brand-points">
            <li><i class="fa-solid fa-circle-check"></i>Accès contrôlé par rôle</li>
            <li><i class="fa-solid fa-circle-check"></i>Traçabilité des opérations</li>
            <li><i class="fa-solid fa-circle-check"></i>Suivi des urgences sous 72 h</li>
        </ul>

        <p class="auth-brand-footer"><i class="fa-solid fa-lock"></i> Dispositif GEI/AIT · Accès restreint</p>

        {# ── Points de navigation ── #}
        <div class="auth-slide-dots" id="authSlideDots">
            <button class="auth-slide-dot auth-dot-active" data-slide="0" aria-label="Slide 1"></button>
            <button class="auth-slide-dot" data-slide="1" aria-label="Slide 2"></button>
            <button class="auth-slide-dot" data-slide="2" aria-label="Slide 3"></button>
            <button class="auth-slide-dot" data-slide="3" aria-label="Slide 4"></button>
        </div>

    </aside>

    {# ══════════════════════════════════════════════════════════════════
       PANNEAU DROIT — formulaire
    ══════════════════════════════════════════════════════════════════ #}
    <main class="auth-form-panel auth-form-panel-pro">
        <div class="auth-mobile-brand">
            <span><i class="fa-solid fa-shield-halved"></i></span> GEI Platform
        </div>
        <div class="auth-form-inner">{% block auth_form %}{% endblock %}</div>
        <p class="auth-footer-note">© {{ 'now'|date('Y') }} · Plateforme GEI</p>
    </main>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
/* ── Slideshow panneau gauche ── */
(function() {
    const slides = document.querySelectorAll('.auth-slide-item');
    const dots   = document.querySelectorAll('.auth-slide-dots .auth-slide-dot');
    if (!slides.length) return;

    let current = 0;
    let timer   = null;

    function goTo(idx) {
        slides[current].classList.remove('auth-slide-active');
        dots[current]?.classList.remove('auth-dot-active');
        current = (idx + slides.length) % slides.length;
        slides[current].classList.add('auth-slide-active');
        dots[current]?.classList.add('auth-dot-active');
    }

    function next() { goTo(current + 1); }

    function startAuto() {
        clearInterval(timer);
        timer = setInterval(next, 5000);
    }

    // Clic sur les dots
    dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
            goTo(parseInt(dot.dataset.slide, 10));
            startAuto(); // reset du timer
        });
    });

    startAuto();
})();

/* ── Afficher/masquer mot de passe ── */
function togglePassword(inputId, btnId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(btnId)?.querySelector('i');
    if (!input || !icon) return;
    const visible = input.type === 'password';
    input.type = visible ? 'text' : 'password';
    icon.classList.toggle('fa-eye',      !visible);
    icon.classList.toggle('fa-eye-slash', visible);
}
</script>
{% endblock %}
