{% extends 'base.html.twig' %}

{% block body_login %}
<div class="auth-shell auth-shell-pro">
    {% include 'components/_auth_brand_panel.html.twig' with {
        brand_name: 'GEI System',
        slides: [
            {
                image: 'images/auth/access-control.svg',
                eyebrow: 'Accès maîtrisés',
                title: 'Les bonnes informations, aux bons profils.',
                text: 'Les autorisations sont organisées selon les rôles définis pour la plateforme.'
            },
            {
                image: 'images/auth/traceability.svg',
                eyebrow: 'Suivi opérationnel',
                title: 'Chaque alerte suit un parcours clair.',
                text: 'La qualification, les décisions et les transmissions s’appuient sur un historique opérationnel.'
            },
            {
                image: 'images/auth/incident-response.svg',
                eyebrow: 'Réactivité coordonnée',
                title: 'Une urgence suivie dans le temps.',
                text: 'Les dossiers éligibles disposent d’un suivi dédié selon le protocole opérationnel 72 h.'
            }
        ]
    } %}

    <main class="auth-form-panel auth-form-panel-pro">
        <div class="auth-mobile-brand">
            <span><i class="bi bi-shield-lock"></i></span> GEI System
        </div>
        <div class="auth-form-inner">{% block auth_form %}{% endblock %}</div>
        <div class="auth-footer-note auth-legal-footer">
            <span>© {{ 'now'|date('Y') }} · Plateforme GEI</span>
            <nav aria-label="Informations légales">
                <a href="{{ path('app_privacy_policy') }}">Confidentialité</a>
                <a href="{{ path('app_terms_of_use') }}">Conditions d’utilisation</a>
            </nav>
        </div>
    </main>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(() => {
    const carousel = document.querySelector('[data-auth-slideshow]');
    if (!carousel) return;

    const slides = [...carousel.querySelectorAll('[data-auth-slide]')];
    const dots = [...carousel.querySelectorAll('[data-auth-slide-dot]')];
    const pauseButton = carousel.querySelector('[data-auth-slide-pause]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let isPaused = reducedMotion;
    let timer;

    const showSlide = (nextIndex) => {
        activeIndex = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, index) => {
            const active = index === activeIndex;
            slide.classList.toggle('auth-slide-active', active);
            slide.setAttribute('aria-hidden', String(!active));
            dots[index].classList.toggle('auth-dot-active', active);
            dots[index].setAttribute('aria-pressed', String(active));
        });
    };

    const restartTimer = () => {
        window.clearInterval(timer);
        if (!isPaused && !carousel.matches(':hover') && !carousel.contains(document.activeElement)) {
            timer = window.setInterval(() => showSlide(activeIndex + 1), 6000);
        }
    };

    pauseButton?.addEventListener('click', () => {
        isPaused = !isPaused;
        const label = pauseButton.querySelector('span');
        const icon = pauseButton.querySelector('i');
        pauseButton.setAttribute('aria-pressed', String(isPaused));
        label.textContent = isPaused ? 'Reprendre' : 'Mettre en pause';
        icon.classList.toggle('bi-play-fill', isPaused);
        icon.classList.toggle('bi-pause-fill', !isPaused);
        restartTimer();
    });
    dots.forEach((dot) => dot.addEventListener('click', () => {
        showSlide(Number(dot.dataset.authSlideDot));
        restartTimer();
    }));
    carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
    carousel.addEventListener('mouseleave', restartTimer);
    carousel.addEventListener('focusin', () => window.clearInterval(timer));
    carousel.addEventListener('focusout', restartTimer);
    restartTimer();
})();

function togglePassword(inputId, btnId) {
    const input = document.getElementById(inputId);
    const button = document.getElementById(btnId);
    const icon = button?.querySelector('i');
    if (!input || !button || !icon) return;
    const visible = input.type === 'password';
    input.type = visible ? 'text' : 'password';
    icon.classList.toggle('bi-eye',      !visible);
    icon.classList.toggle('bi-eye-slash', visible);
    button.setAttribute('aria-label', visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
    button.setAttribute('aria-pressed', String(visible));
}
</script>
{% endblock %}
