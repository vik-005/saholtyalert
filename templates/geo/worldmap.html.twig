{% extends 'base.html.twig' %}
{% block title %}Carte Mondiale Détaillée — GEOINT GEI{% endblock %}

{% block stylesheets %}{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/maplibre-gl@4.3.2/dist/maplibre-gl.css" rel="stylesheet">
<style>
/* Carte full responsive */
.worldmap-wrap {
    position: relative;
    width: 100%;
    height: calc(100vh - 240px);
    min-height: 440px;
}
@media (max-width: 767px) {
    .worldmap-wrap { height: 70vw; min-height: 300px; }
}

/* Panneaux flottants */
#wm-layers-panel {
    position: absolute; top: 12px; left: 12px; z-index: 20;
    background: rgba(255,255,255,.97); border-radius: 8px;
    padding: 10px 14px; box-shadow: 0 2px 10px rgba(0,0,0,.12);
    min-width: 165px;
}

#wm-counter {
    position: absolute; top: 12px; right: 56px; z-index: 20;
    background: rgba(30,41,59,.88); color: #f1f5f9;
    border-radius: 8px; padding: 5px 12px; font-size: .82rem;
}

#wm-popup-panel {
    position: absolute; bottom: 24px; left: 12px; z-index: 20;
    width: 290px; max-height: calc(50% - 12px); overflow-y: auto;
    background: rgba(255,255,255,.97); border-radius: 10px;
    padding: 14px; box-shadow: 0 4px 20px rgba(0,0,0,.18);
    display: none;
}

/* Flux sur carte mondiale */
.flux-toggle.active { font-weight: 700; }

/* Légende flux */
.wm-flux-legend {
    position: absolute; bottom: 24px; right: 12px; z-index: 20;
    background: rgba(255,255,255,.97); border-radius: 8px;
    padding: 8px 12px; box-shadow: 0 2px 10px rgba(0,0,0,.12);
    min-width: 140px; display: none;
}
.leg-line { display: inline-block; height: 2px; border-radius: 1px; vertical-align: middle; margin-right: 6px; }

/* Responsive */
@media (max-width: 575px) {
    #wm-layers-panel { max-width: 150px; font-size: .78rem; }
    #wm-popup-panel  { width: 92%; left: 4%; bottom: 10px; }
    .wm-flux-legend  { right: 4px; bottom: 10px; display: none !important; }
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-3 px-3 px-md-4">

    {# En-tête #}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 fw-800 mb-0">
                <i class="bi bi-layers-fill me-2" style="color:#7c2d12;"></i>Carte Mondiale Détaillée
            </h1>
            <p class="text-muted small mb-0">Multi-couches · Clustering · Flux en pointillés · MapLibre GL</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('app_geo_choropleth') }}" class="btn btn-sm btn-outline-primary">Choroplèthe</a>
            <a href="{{ path('app_geo_heatmap') }}"    class="btn btn-sm btn-outline-danger">Heatmap</a>
            <a href="{{ path('app_geo_flux') }}"       class="btn btn-sm btn-outline-success">Flux</a>
            <a href="{{ path('app_geo_dashboard') }}"  class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>GEOINT
            </a>
        </div>
    </div>

    {# Filtres #}
    <div class="card mb-2 shadow-sm">
        <div class="card-body py-2">
            {% include 'geo/_filters.html.twig' %}
        </div>
    </div>

    {# Carte #}
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="worldmap-wrap">
                <div id="worldmap-container" style="width:100%;height:100%;"></div>

                {# Panneau couches #}
                <div id="wm-layers-panel">
                    <div class="fw-600 small mb-2"><i class="bi bi-layers me-1"></i>Couches</div>

                    {% set layers = [
                        {id:'alerts',        label:'Alertes',         icon:'bi-exclamation-circle', color:'#3b82f6'},
                        {id:'infrastructure',label:'Infrastructures',  icon:'bi-building',           color:'#0891b2'},
                        {id:'markets',       label:'Pays / Marchés',   icon:'bi-globe',              color:'#8b5cf6'},
                    ] %}
                    {% for layer in layers %}
                    <label class="d-flex align-items-center gap-2 mb-1" style="font-size:.84rem;cursor:pointer;">
                        <input type="checkbox" class="layer-check" data-layer="{{ layer.id }}"
                               {{ layer.id == 'alerts' ? 'checked' : '' }}>
                        <i class="bi {{ layer.icon }}" style="color:{{ layer.color }};"></i>
                        {{ layer.label }}
                    </label>
                    {% endfor %}

                    <hr class="my-2">
                    {# Couche flux en plus #}
                    <label class="d-flex align-items-center gap-2 mb-1" style="font-size:.84rem;cursor:pointer;">
                        <input type="checkbox" id="layer-flux-check">
                        <i class="bi bi-arrow-left-right" style="color:#0f766e;"></i>
                        Flux / Parcours
                    </label>

                    <hr class="my-2">
                    <div class="fw-600 small mb-1">Lignes flux</div>
                    <div class="btn-group btn-group-sm w-100">
                        <button class="btn btn-outline-secondary flux-toggle active" data-dash="solid">Plein</button>
                        <button class="btn btn-outline-secondary flux-toggle" data-dash="dashed">Pointillé</button>
                        <button class="btn btn-outline-secondary flux-toggle" data-dash="mixed">Mixte</button>
                    </div>
                </div>

                {# Compteur #}
                <div id="wm-counter">
                    <i class="bi bi-geo-alt-fill me-1"></i>
                    <span id="wm-count">—</span> points
                </div>

                {# Légende flux #}
                <div class="wm-flux-legend" id="wm-flux-legend">
                    <div class="fw-600 small mb-2">Flux — priorité</div>
                    <div class="small mb-1"><span class="leg-line" style="width:22px;background:#ef4444;"></span>Critique</div>
                    <div class="small mb-1"><span class="leg-line" style="width:22px;background:#f97316;"></span>Élevé</div>
                    <div class="small mb-1"><span class="leg-line" style="width:22px;background:#f59e0b;"></span>Modéré</div>
                    <div class="small"><span class="leg-line" style="width:22px;background:#3b82f6;"></span>Faible</div>
                </div>

                {# Panneau détail #}
                <div id="wm-popup-panel">
                    <button class="btn-close float-end" id="wm-panel-close" style="font-size:.65rem;"></button>
                    <div class="fw-700 mb-2 small" id="wm-panel-title">Détail</div>
                    <div id="wm-panel-content" style="font-size:.8rem;"></div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/maplibre-gl@4.3.2/dist/maplibre-gl.js"></script>
<script>
(function () {
    'use strict';

    const API_WM   = '{{ path("app_geo_api_worldmap") }}';
    const API_FLUX = '{{ path("app_geo_api_flux") }}';

    // ── État ──────────────────────────────────────────────────────────────
    let map      = null;
    let mapReady = false;
    let pending  = [];

    const LAYER_DATA = { alerts: null, infrastructure: null, markets: null, flux: null };
    const activeLayers = new Set(['alerts']);
    let fluxActive = false;
    let dashStyle  = 'solid';

    // ── Initialisation MapLibre ───────────────────────────────────────────
    function initMap() {
        map = new maplibregl.Map({
            container: 'worldmap-container',
            style    : 'https://demotiles.maplibre.org/style.json',
            center   : [5, 10],
            zoom     : 3,
            minZoom  : 1,
            maxZoom  : 18,
            attributionControl: false,
        });

        map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
        map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');
        map.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-left');

        map.on('load', () => {
            mapReady = true;
            pending.forEach(fn => fn());
            pending = [];
        });
    }

    function whenReady(fn) {
        if (mapReady) fn(); else pending.push(fn);
    }

    // ── Chargement données couche normale ─────────────────────────────────
    function buildQuery(layerId) {
        const fd = new FormData(document.getElementById('geo-filters'));
        fd.set('layer', layerId);
        return new URLSearchParams(fd).toString();
    }

    function loadLayer(layerId) {
        fetch(API_WM + '?' + buildQuery(layerId))
            .then(r => { if (!r.ok) throw new Error(r.statusText); return r.json(); })
            .then(geojson => {
                LAYER_DATA[layerId] = geojson;
                whenReady(() => { renderLayer(layerId); updateCounter(); });
            })
            .catch(e => console.error('WorldMap layer error:', layerId, e));
    }

    // ── Chargement flux ───────────────────────────────────────────────────
    function loadFlux() {
        const fd = new FormData(document.getElementById('geo-filters'));
        fetch(API_FLUX + '?' + new URLSearchParams(fd).toString())
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(data => {
                LAYER_DATA.flux = data.routes || { type:'FeatureCollection', features:[] };
                whenReady(() => { renderFluxLayer(); updateCounter(); });
            })
            .catch(e => console.error('Flux error:', e));
    }

    // ── Rendu couche normale ──────────────────────────────────────────────
    function renderLayer(layerId) {
        const geojson = LAYER_DATA[layerId];
        if (!geojson) return;

        const srcId = `wm-src-${layerId}`;

        if (map.getSource(srcId)) {
            map.getSource(srcId).setData(geojson);
        } else {
            const isAlerts = layerId === 'alerts';
            map.addSource(srcId, {
                type    : 'geojson',
                data    : geojson,
                cluster : isAlerts,
                clusterRadius : 50,
                clusterMaxZoom: 10,
            });
            addPaintLayers(layerId, srcId);
        }

        // Visibilité
        const vis = activeLayers.has(layerId) ? 'visible' : 'none';
        [`wm-${layerId}`, `wm-${layerId}-text`, `wm-${layerId}-clusters`, `wm-${layerId}-cluster-count`]
            .forEach(id => { if (map.getLayer(id)) map.setLayoutProperty(id, 'visibility', vis); });
    }

    // ── Couche flux avec pointillés ───────────────────────────────────────
    function renderFluxLayer() {
        const geojson = LAYER_DATA.flux;
        if (!geojson) return;

        const vis = fluxActive ? 'visible' : 'none';

        // Source
        if (map.getSource('wm-flux')) {
            map.getSource('wm-flux').setData(geojson);
        } else {
            map.addSource('wm-flux', { type: 'geojson', data: geojson });
        }

        // Bordure blanche
        if (!map.getLayer('wm-flux-casing')) {
            map.addLayer({
                id    : 'wm-flux-casing',
                type  : 'line',
                source: 'wm-flux',
                paint : { 'line-color':'#fff', 'line-width':['+',2,['get','width']], 'line-opacity':.4 },
                layout: { 'line-join':'round', 'line-cap':'round', 'visibility': vis },
            });
        } else { map.setLayoutProperty('wm-flux-casing','visibility',vis); }

        // Ligne principale
        if (!map.getLayer('wm-flux-lines')) {
            map.addLayer({
                id    : 'wm-flux-lines',
                type  : 'line',
                source: 'wm-flux',
                paint : buildFluxPaint(),
                layout: { 'line-join':'round', 'line-cap':'round', 'visibility': vis },
            });

            map.on('click','wm-flux-lines', e => {
                const p = e.features[0].properties || {};
                let pays = [];
                try { pays = Array.isArray(p.pays) ? p.pays : JSON.parse(p.pays||'[]'); } catch {}
                openPanel(`
                    <table class="table table-sm mb-0">
                        <tr><td>Code GEI</td><td class="fw-600">${esc(p.code_gei)}</td></tr>
                        <tr><td>Priorité</td>
                            <td><span class="badge ${pbadge(p.niveau_priorite)}">${esc(p.niveau_priorite)}</span></td></tr>
                        <tr><td>Catégorie</td><td>${esc(p.categorie)}</td></tr>
                        <tr><td>Parcours</td><td class="small">${pays.join(' → ')}</td></tr>
                        <tr><td>Score</td><td>${esc(p.score)}</td></tr>
                    </table>`, p.code_gei ?? 'Flux');
            });
            map.on('mouseenter','wm-flux-lines',() => map.getCanvas().style.cursor='pointer');
            map.on('mouseleave','wm-flux-lines',() => map.getCanvas().style.cursor='');
        } else {
            map.setLayoutProperty('wm-flux-lines','visibility',vis);
            const paint = buildFluxPaint();
            Object.entries(paint).forEach(([k,v]) => map.setPaintProperty('wm-flux-lines',k,v));
            map.setLayoutProperty('wm-flux-casing','visibility',vis);
        }

        // Légende flux
        document.getElementById('wm-flux-legend').style.display = fluxActive ? 'block' : 'none';
    }

    function buildFluxPaint() {
        const dash = dashStyle === 'solid'  ? [1] :
                     dashStyle === 'dashed' ? [3,2] : [4,2];
        return {
            'line-color'    : ['get','color'],
            'line-width'    : ['interpolate',['linear'],['zoom'], 3,['get','width'], 10,['+',1,['get','width']]],
            'line-opacity'  : 0.85,
            'line-dasharray': ['literal', dash],
        };
    }

    // ── Couches de dessin pour chaque type de layer ───────────────────────
    function addPaintLayers(layerId, srcId) {
        if (layerId === 'alerts') {
            // Clusters
            map.addLayer({
                id    : 'wm-alerts-clusters',
                type  : 'circle',
                source: srcId,
                filter: ['has','point_count'],
                paint : {
                    'circle-radius'      : ['step',['get','point_count'], 18, 10, 24, 50, 32],
                    'circle-color'       : ['step',['get','point_count'], '#3b82f6', 10, '#f59e0b', 50, '#ef4444'],
                    'circle-stroke-width': 3,
                    'circle-stroke-color': '#fff',
                    'circle-opacity'     : .9,
                },
            });
            map.addLayer({
                id    : 'wm-alerts-cluster-count',
                type  : 'symbol',
                source: srcId,
                filter: ['has','point_count'],
                layout: { 'text-field':['get','point_count_abbreviated'], 'text-size':12 },
                paint : { 'text-color':'#fff' },
            });
            map.addLayer({
                id    : 'wm-alerts',
                type  : 'circle',
                source: srcId,
                filter: ['!',['has','point_count']],
                paint : {
                    'circle-radius'      : 7,
                    'circle-color'       : ['get','color'],
                    'circle-stroke-width': 2,
                    'circle-stroke-color': '#fff',
                    'circle-opacity'     : .85,
                },
            });

            map.on('click','wm-alerts-clusters', e => {
                const feat = map.queryRenderedFeatures(e.point,{layers:['wm-alerts-clusters']})[0];
                map.getSource(srcId).getClusterExpansionZoom(
                    feat.properties.cluster_id,
                    (err, zoom) => { if (!err) map.flyTo({ center: feat.geometry.coordinates, zoom }); }
                );
            });
            map.on('click','wm-alerts', e => {
                const p = e.features[0].properties || {};
                openPanel(
                    p.type === 'market_centroid' ? buildCentroidHTML(p) : buildAlertHTML(p),
                    p.market ?? 'Alerte'
                );
            });
            ['wm-alerts-clusters','wm-alerts'].forEach(id => {
                map.on('mouseenter', id, () => map.getCanvas().style.cursor='pointer');
                map.on('mouseleave', id, () => map.getCanvas().style.cursor='');
            });
        }

        if (layerId === 'infrastructure') {
            map.addLayer({
                id    : 'wm-infrastructure',
                type  : 'circle',
                source: srcId,
                paint : {
                    'circle-radius'      : 8,
                    'circle-color'       : ['get','color'],
                    'circle-stroke-width': 2,
                    'circle-stroke-color': '#fff',
                    'circle-opacity'     : .85,
                },
            });
            map.addLayer({
                id    : 'wm-infrastructure-text',
                type  : 'symbol',
                source: srcId,
                minzoom: 5,
                layout: { 'text-field':['get','nom'], 'text-size':9, 'text-offset':[0,1.5], 'text-anchor':'top' },
                paint : { 'text-color':'#334155', 'text-halo-color':'#fff', 'text-halo-width':1 },
            });
            map.on('click','wm-infrastructure', e => {
                const p = e.features[0].properties || {};
                openPanel(`<b>${p.nom??'—'}</b><br>Type : ${p.type??'—'}<br>Marché : ${p.market??'—'}`, 'Infrastructure');
            });
            map.on('mouseenter','wm-infrastructure',() => map.getCanvas().style.cursor='pointer');
            map.on('mouseleave','wm-infrastructure',() => map.getCanvas().style.cursor='');
        }

        if (layerId === 'markets') {
            map.addLayer({
                id    : 'wm-markets',
                type  : 'circle',
                source: srcId,
                paint : {
                    'circle-radius'  : ['+', 6, ['min', 20, ['/', ['get','total'], 3]]],
                    'circle-color'   : ['get','color'],
                    'circle-opacity' : .7,
                    'circle-stroke-width': 2,
                    'circle-stroke-color': '#fff',
                },
            });
            map.addLayer({
                id    : 'wm-markets-text',
                type  : 'symbol',
                source: srcId,
                minzoom: 4,
                layout: { 'text-field':['get','iso3'], 'text-size':10, 'text-offset':[0,1.5], 'text-anchor':'top' },
                paint : { 'text-color':'#1e293b', 'text-halo-color':'#fff', 'text-halo-width':1 },
            });
            map.on('click','wm-markets', e => {
                openPanel(buildMarketHTML(e.features[0].properties||{}), e.features[0].properties?.nom??'Pays');
            });
            map.on('mouseenter','wm-markets',() => map.getCanvas().style.cursor='pointer');
            map.on('mouseleave','wm-markets',() => map.getCanvas().style.cursor='');
        }
    }

    // ── HTML des popups ───────────────────────────────────────────────────
    const BADGE = {critique:'bg-danger',eleve:'bg-warning text-dark',modere:'bg-info'};

    function pbadge(p) { return BADGE[p] || 'bg-secondary'; }

    function buildAlertHTML(p) {
        return `<table class="table table-sm mb-0">
            <tr><td>Priorité</td><td><span class="badge ${pbadge(p.niveau_priorite)}">${esc(p.niveau_priorite)}</span></td></tr>
            <tr><td>Catégorie</td><td>${esc(p.categorie)}</td></tr>
            <tr><td>Statut</td><td>${esc(p.statut)}</td></tr>
            <tr><td>Score</td><td>${esc(p.score)}</td></tr>
            <tr><td>Localisation</td><td>${esc(p.type_localisation)}</td></tr>
            <tr><td>Date</td><td>${esc(p.date)}</td></tr>
        </table>`;
    }
    function buildCentroidHTML(p) {
        return `<table class="table table-sm mb-0">
            <tr><td>Pays</td><td class="fw-700">${esc(p.iso3)}</td></tr>
            <tr><td>Total</td><td><span class="badge bg-primary">${p.total??0}</span></td></tr>
            <tr><td>Critiques</td><td>${(p.critique>0)?`<span class="badge bg-danger">${p.critique}</span>`:'—'}</td></tr>
            <tr><td>Score moyen</td><td>${esc(p.score)}</td></tr>
        </table>`;
    }
    function buildMarketHTML(p) {
        return `<table class="table table-sm mb-0">
            <tr><td>ISO3</td><td class="fw-700">${esc(p.iso3)}</td></tr>
            <tr><td>Continent</td><td>${esc(p.continent)}</td></tr>
            <tr><td>Total alertes</td><td><span class="badge bg-primary">${p.total??0}</span></td></tr>
            <tr><td>Critiques</td><td>${(p.critique>0)?`<span class="badge bg-danger">${p.critique}</span>`:'—'}</td></tr>
            <tr><td>Transmises</td><td>${p.transmis??0}</td></tr>
        </table>`;
    }

    function openPanel(html, title) {
        document.getElementById('wm-panel-title').textContent   = title;
        document.getElementById('wm-panel-content').innerHTML   = html;
        document.getElementById('wm-popup-panel').style.display = 'block';
    }

    document.getElementById('wm-panel-close')?.addEventListener('click', () => {
        document.getElementById('wm-popup-panel').style.display = 'none';
    });

    // ── Compteur ──────────────────────────────────────────────────────────
    function updateCounter() {
        let total = 0;
        activeLayers.forEach(id => { total += LAYER_DATA[id]?.features?.length ?? 0; });
        if (fluxActive) total += LAYER_DATA.flux?.features?.length ?? 0;
        document.getElementById('wm-count').textContent = total.toLocaleString('fr-FR');
    }

    // ── Toggles couches ───────────────────────────────────────────────────
    document.querySelectorAll('.layer-check').forEach(chk => {
        chk.addEventListener('change', () => {
            const id = chk.dataset.layer;
            if (chk.checked) {
                activeLayers.add(id);
                if (!LAYER_DATA[id]) loadLayer(id); else whenReady(() => renderLayer(id));
            } else {
                activeLayers.delete(id);
                whenReady(() => renderLayer(id));
            }
            updateCounter();
        });
    });

    document.getElementById('layer-flux-check')?.addEventListener('change', chk => {
        fluxActive = chk.target.checked;
        if (fluxActive && !LAYER_DATA.flux) {
            loadFlux();
        } else {
            whenReady(() => renderFluxLayer());
        }
        updateCounter();
    });

    // ── Styles de tirets ──────────────────────────────────────────────────
    document.querySelectorAll('.flux-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.flux-toggle').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            dashStyle = btn.dataset.dash;
            if (map.getLayer('wm-flux-lines')) {
                const p = buildFluxPaint();
                Object.entries(p).forEach(([k,v]) => map.setPaintProperty('wm-flux-lines',k,v));
            }
        });
    });

    // ── Rechargement total ────────────────────────────────────────────────
    function reloadAll() {
        activeLayers.forEach(id => loadLayer(id));
        if (fluxActive) loadFlux();
    }

    document.getElementById('geo-filters')?.addEventListener('submit', e => { e.preventDefault(); reloadAll(); });
    document.getElementById('btn-reset-filters')?.addEventListener('click', () => setTimeout(reloadAll, 60));

    function esc(s) {
        return String(s ?? '—').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // ── Lancement ─────────────────────────────────────────────────────────
    initMap();
    // Chargement initial des couches actives après chargement du style
    ['alerts'].forEach(id => {
        whenReady(() => loadLayer(id));
    });
    // Si le style n'est pas encore ready, on déclenche manuellement après init
    if (!mapReady) {
        const origOnLoad = map.on.bind(map);
        // Le listener 'load' est déjà enregistré dans initMap — les couches seront chargées
    }
})();
</script>
{% endblock %}
