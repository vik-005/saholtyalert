{% extends 'base.html.twig' %}

{% block title %}Sécurité — Clés WebAuthn (empreinte digitale){% endblock %}
{% block header_title %}Clés d’authentification biométrique{% endblock %}

{% block body %}
<div class="db-wrapper">

    <div class="page-header-row">
        <div>
            <p class="page-eyebrow">
                <i class="bi bi-fingerprint me-1.5 text-amber-400"></i>
                Espace personnel · Sécurité
            </p>
            <h2 class="page-title">Empreinte digitale / Passkeys</h2>
            <p class="page-subtitle">
                Connectez-vous à SAHOTLY ALERT SYSTEM avec votre empreinte digitale (Windows Hello, Touch ID ou Android)
                sans saisir votre mot de passe.
            </p>
        </div>
    </div>

    <a href="{{ path('app_account_settings') }}" class="btn btn-secondary mb-3">
        <i class="bi bi-arrow-left me-1.5"></i>Retour au profil
    </a>

    {% if app.user and not hasCredential %}
    <div class="tfa-status-bar tfa-status-off">
        <div class="tfa-status-left">
            <span class="tfa-status-icon"><i class="bi bi-fingerprint"></i></span>
            <div>
                <p class="tfa-status-title">Aucune clé d’empreinte enregistrée</p>
                <p class="tfa-status-sub">Enregistrez votre première clé pour vous connecter par empreinte digitale.</p>
            </div>
        </div>
    </div>
    {% elseif app.user %}
    <div class="tfa-status-bar tfa-status-on">
        <div class="tfa-status-left">
            <span class="tfa-status-icon"><i class="bi bi-fingerprint-fill"></i></span>
            <div>
                <p class="tfa-status-title">Clés d’empreinte enregistrées</p>
                <p class="tfa-status-sub">{{ credentials|length }} clé(s) d’authentification biométrique activée(s) sur votre compte.</p>
            </div>
        </div>
    </div>
    {% endif %}

    {% if app.user %}
    <div class="webauthn-grid">
        <div class="webauthn-card">
            <div class="webauthn-card-header">
                <i class="bi bi-plus-circle-fill me-2 text-emerald-400"></i>
                <strong>Enregistrer une nouvelle empreinte</strong>
            </div>
            <p class="webauthn-card-sub">
                Donnez un nom à votre clé (ex: « Mon MacBook », « Téléphone personnel »).
            </p>

            <form id="webauthnRegisterForm" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('webauthn_register') }}">
                <input type="hidden" name="_token_url" value="{{ path('app_webauthn_register_options') }}">

                <div class="webauthn-field">
                    <label for="webauthnCredentialName" class="webauthn-field-label">
                        Nom de la clé
                        <span class="webauthn-required">*</span>
                    </label>
                    <input
                        type="text"
                        id="webauthnCredentialName"
                        name="name"
                        placeholder="Ex: Mon employée - Windows Hello"
                        class="webauthn-field-input"
                        required
                        maxlength="100"
                        autofocus
                    >
                </div>

                <button
                    type="button"
                    id="webauthnRegisterBtn"
                    class="webauthn-register-btn"
                    disabled
                >
                    <i class="bi bi-fingerprint me-1.5"></i>
                    Enregistrer l’empreinte
                </button>
            </form>

            <p class="webauthn-hint">
                <i class="bi bi-info-circle me-1"></i>
                Votre empreinte reste stockée sur votre appareil uniquement ; la plateforme n’en conserve
                que la clef cryptographique publique.
            </p>
        </div>

        {% if credentials|length > 0 %}
        <div class="webauthn-card webauthn-card-list">
            <div class="webauthn-card-header">
                <i class="bi bi-device-hdd me-2 text-amber-400"></i>
                <strong>Vos clés enregistrées</strong>
            </div>

            <table class="webauthn-table">
                <thead>
                <tr>
                    <th>Nom de la clé</th>
                    <th>Créée le</th>
                    <th>Dernière utilisation</th>
                    <th class="text-end">Action</th>
                </tr>
                </thead>
                <tbody>
                {% for credential in credentials %}
                <tr>
                    <td>
                        <span class="webauthn-badge">{{ credential.name }}</span>
                    </td>
                    <td>{{ credential.createdAt|date('d/m/Y H:i') }}</td>
                    <td>{{ credential.lastUsedAt ? credential.lastUsedAt|date('d/m/Y H:i') : '—' }}</td>
                    <td class="text-end">
                        <form method="post" action="{{ path('app_webauthn_remove') }}" onsubmit="return confirm('Supprimer cette clé d’empreinte ? Vous ne pourrez plus vous connecter avec cet appareil.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('webauthn_remove') }}">
                            <input type="hidden" name="credential_id" value="{{ credential.credentialId }}">
                            <button type="submit" class="webauthn-remove-btn">
                                <i class="bi bi-trash"></i> Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    const btn = document.getElementById('webauthnRegisterBtn');
    const form = document.getElementById('webauthnRegisterForm');
    if (!btn || !form) return;

    if (!window.isSecureContext) {
        btn.textContent = 'L’enregistrement biométrique nécessite une connexion HTTPS.';
        return;
    }

    if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.create) {
        btn.disabled = true;
        btn.textContent = 'L’enregistrement biométrique n’est pas pris en charge par ce navigateur.';
        return;
    }

    const optionsUrl = form ? form.querySelector('[name="_token_url"]').value : null;
    const registerUrl = '{{ path('app_webauthn_register') }}';
    const nameInput = document.getElementById('webauthnCredentialName');

    if (!btn || !form || !optionsUrl) return;

    btn.disabled = false;

    function base64urlToBytes(str) {
        str = str.replace(/-/g, '+').replace(/_/g, '/');
        const pad = str.length % 4;
        if (pad) str += '='.repeat(4 - pad);
        const bin = atob(str);
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        return bytes;
    }

    function bytesToBase64url(bytes) {
        let bin = '';
        for (const b of bytes) bin += String.fromCharCode(b);
        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function showError(message) {
        let el = document.getElementById('webauthnError');
        if (!el) {
            el = document.createElement('div');
            el.id = 'webauthnError';
            el.className = 'webauthn-error';
            form.parentNode.insertBefore(el, form.nextSibling);
        }
        el.textContent = message;
        el.style.display = '';
        btn.disabled = false;
        btn.textContent = 'Enregistrer l’empreinte';
    }

    btn.addEventListener('click', async () => {
        const name = (nameInput.value || '').trim();
        if (name === '') {
            nameInput.focus();
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Vérification de l’empreinte…';

        try {
            const res = await fetch(optionsUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ _token: form.querySelector('[name="_token"]').value }),
            });
            if (!res.ok) throw new Error('Impossible de générer le défi d’enregistrement.');
            const options = await res.json();

            const publicKey = { ...options };
            publicKey.challenge = base64urlToBytes(publicKey.challenge);
            publicKey.user.id = base64urlToBytes(publicKey.user.id);
            if (Array.isArray(publicKey.excludeCredentials)) {
                publicKey.excludeCredentials = publicKey.excludeCredentials.map(function (c) {
                    return { ...c, id: base64urlToBytes(c.id) };
                });
            }

            const credential = await navigator.credentials.create({ publicKey });

            if (!(credential instanceof PublicKeyCredential)) {
                throw new Error('Aucune clé créée par le navigateur.');
            }

            const response = credential.response;
            const body = {
                name: name,
                _token: form.querySelector('[name="_token"]').value,
                response: {
                    clientDataJSON: bytesToBase64url(new Uint8Array(response.clientDataJSON)),
                    attestationObject: bytesToBase64url(new Uint8Array(response.attestationObject)),
                    transports: response.transports || [],
                },
            };

            const check = await fetch(registerUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(body),
            });

            const result = await check.json();
            if (!check.ok || !result.success) {
                throw new Error(result.error || 'Échec de l’enregistrement de l’empreinte.');
            }

            window.location.reload();
        } catch (error) {
            showError(error.name === 'NotAllowedError'
                ? 'La demande a été annulée ou a expiré. Réessayez et confirmez votre identité sur l’appareil.'
                : (error.message || 'Échec de l’enregistrement de l’empreinte.'));
        }
    });
})();
</script>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.webauthn-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
}
@media(min-width: 768px) {
    .webauthn-grid { grid-template-columns: 340px 1fr; }
}
.webauthn-card {
    background: var(--navy-900);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.webauthn-card-list {
    flex-direction: column;
}
.webauthn-card-header {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 18px; font-size: 12.5px; font-weight: 700;
    color: var(--text); background: var(--card2);
    border-bottom: 1px solid var(--border);
}
.webauthn-card-sub {
    font-size: 11.5px; color: var(--text-muted);
    padding: 14px 18px; border-bottom: 1px solid var(--border);
}
.webauthn-field {
    padding: 0 18px 14px; display: flex; flex-direction: column; gap: 6px;
}
.webauthn-field-label {
    font-size: 11.5px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 6px;
}
.webauthn-required { color: #f87171; font-weight: 700; }
.webauthn-field-input {
    width: 100%; background: var(--navy-800); border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 14px; font-size: 13px; color: var(--text);
}
.webauthn-field-input:focus { border-color: var(--amber); outline: none; }
.webauthn-register-btn {
    width: 100%; margin: 0 18px 18px; padding: 12px; border-radius: 10px;
    background: #16856b; border: 1px solid #16856b; color: #fff;
    font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
}
.webauthn-register-btn:hover:not(:disabled) { background: #0d6b57; }
.webauthn-register-btn:disabled { opacity: .6; cursor: not-allowed; background: var(--navy-800); border-color: var(--border); color: var(--text-muted); }
.webauthn-hint {
    font-size: 10.5px; color: var(--text-muted); margin: 0 18px 18px; padding-top: 10px; border-top: 1px solid var(--border); font-style: italic;
}
.webauthn-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 18px; }
.webauthn-table th {
    text-align: left; color: var(--text-muted); font-weight: 600; padding: 10px 14px; border-bottom: 1px solid var(--border);
}
.webauthn-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); color: var(--text); }
.webauthn-table tr:last-child td { border-bottom: none; }
.webauthn-table th.text-end, .webauthn-table td.text-end { text-align: right; }
.webauthn-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.25);
    color: var(--amber); border-radius: 999px; padding: 3px 10px; font-size: 11px; font-weight: 700;
}
.webauthn-remove-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: none; border: 1px solid rgba(239,68,68,.3);
    color: #f87171; border-radius: 8px; padding: 6px 12px; font-size: 12px; font-weight: 600; cursor: pointer;
}
.webauthn-remove-btn:hover { background: rgba(239,68,68,.1); }
.webauthn-error {
    margin: 10px 18px; padding: 10px 14px; background: rgba(239,68,68,.1);
    border: 1px solid rgba(239,68,68,.25); color: #f87171; border-radius: 8px; font-size: 12px; display: none;
}
</style>
{% endblock %}
