{# Composant générique Chart.js pour les dashboards GEI #}
{# Usage : {% include 'components/_chart.html.twig' with { type: 'line', data: chartData, options: chartOptions } %} #}

{% set chartId = chartId ?? 'chart-' ~ random() %}
{% set canvasId = canvasId ?? chartId %}
{% set containerId = containerId ?? 'chart-container-' ~ random() %}

<div id="{{ containerId }}" class="chart-container {% if className is defined %}{{ className }}{% endif %}" style="width: {{ width ?? '100%' }}; height: {{ height ?? '300px' }};">
    <canvas id="{{ canvasId }}"></canvas>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('{{ canvasId }}')?.getContext('2d');
    if (!ctx) return;

    // Configuration Chart.js
    Chart.defaults.color = '#94a3b8';
    Chart.defaults.borderColor = 'rgba(148,163,184,0.1)';
    Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
    Chart.defaults.font.size = 11;

    // Palette de couleurs (charte GEI)
    const colors = {
        amber: '#fbbf24',
        orange: '#fb923c',
        red: '#ef4444',
        emerald: '#34d399',
        blue: '#60a5fa',
        purple: '#c084fc',
        cyan: '#22d3ee',
        slate: '#64748b',
        bg: '#090e1a',
        card: '#0f172a',
    };

    // Options par défaut
    const defaultOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: true,
                position: 'bottom',
                labels: {
                    color: '#94a3b8',
                    boxWidth: 12,
                    padding: 10,
                    font: { size: 11 }
                }
            },
            tooltip: {
                backgroundColor: '#1e293b',
                borderColor: 'rgba(148,163,184,0.2)',
                borderWidth: 1,
                padding: 10,
                cornerRadius: 8,
                titleFont: { size: 12, weight: '700' },
                bodyFont: { size: 11 },
            }
        },
        scales: {
            x: {
                grid: { color: 'rgba(148,163,184,0.06)' },
                ticks: { color: '#7da090', font: { size: 10 } },
                border: { display: false }
            },
            y: {
                grid: { color: 'rgba(148,163,184,0.06)' },
                ticks: { color: '#7da090', font: { size: 10 } },
                border: { display: false },
                beginAtZero: true
            }
        }
    };

    // Merge options
    const options = {{ options|default('{}')|raw }};
    const mergedOptions = Object.assign({}, defaultOptions, options);

    // Create chart
    const chart = new Chart(ctx, {
        type: '{{ type|default('bar') }}',
        data: {{ data|raw }},
        options: mergedOptions
    });

    // Store chart for later reference
    window.charts = window.charts || {};
    window.charts['{{ chartId }}'] = chart;
});
</script>

.chart-container {
    position: relative;
}
</style>