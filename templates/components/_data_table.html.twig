{# ─────────────────────────────────────────────────────────────────────────
   SAHOTLY SYSTEM - Data Table Component
   Professional table for displaying alerts, transmissions, and other data
   Supports sorting, pagination, filtering, and responsive mobile layout
───────────────────────────────────────────────────────────────────────── #}

{% macro data_table(items, columns, options = {}) %}
  {# Default options #}
  {% set defaults = {
    sortable: false,
    paginated: true,
    items_per_page: 10,
    striped: true,
    hoverable: true,
    responsive: true,
    show_actions: true,
    empty_message: 'Aucune donnée disponible'
  } %}
  {% set opts = defaults|merge(options) %}
  
  <div class="data-table-wrapper" data-sortable="{{ opts.sortable ? 'true' : 'false' }}">
    
    {# Table #}
    <div class="data-table-container">
      <table class="data-table {% if opts.striped %}data-table-striped{% endif %} {% if opts.hoverable %}data-table-hover{% endif %}">
        
        {# Table header #}
        <thead class="data-table-head">
          <tr class="data-table-row">
            {% for column in columns %}
              <th class="data-table-header {% if column.sortable ?? false %}sortable{% endif %}"
                  {% if column.width %}style="width: {{ column.width }}"{% endif %}>
                {% if column.sortable ?? false %}
                  <button type="button" class="data-table-sort-btn" data-sort-field="{{ column.field }}">
                    <span>{{ column.label }}</span>
                    <i class="bi bi-arrow-down-up" aria-hidden="true"></i>
                  </button>
                {% else %}
                  <span>{{ column.label }}</span>
                {% endif %}
              </th>
            {% endfor %}
            {% if opts.show_actions %}
              <th class="data-table-header data-table-actions-header">
                <span>Actions</span>
              </th>
            {% endif %}
          </tr>
        </thead>
        
        {# Table body #}
        <tbody class="data-table-body">
          {% if items|length > 0 %}
            {% for item in items %}
              <tr class="data-table-row" data-item-id="{{ item.id ?? loop.index }}">
                {% for column in columns %}
                  <td class="data-table-cell" data-label="{{ column.label }}">
                    {% if column.type == 'status' %}
                      <span class="status-pill status-{{ item[column.field]|lower }}">
                        <span class="status-dot" aria-hidden="true"></span>
                        <span class="status-text">{{ item[column.field] }}</span>
                      </span>
                    {% elseif column.type == 'priority' %}
                      <span class="priority-badge priority-{{ item[column.field]|lower }}">
                        <span class="priority-badge-dot" aria-hidden="true"></span>
                        <span class="priority-badge-text">{{ item[column.field] }}</span>
                      </span>
                    {% elseif column.type == 'score' %}
                      {% set score = item[column.field] %}
                      <span class="score-badge 
                        {% if score >= 18 %}score-critique
                        {% elseif score >= 14 %}score-eleve
                        {% elseif score >= 10 %}score-modere
                        {% else %}score-faible{% endif %}">
                        {{ score }}/25
                      </span>
                    {% elseif column.type == 'date' %}
                      <span class="text-mono">{{ item[column.field]|date(column.format ?? 'd/m/Y') }}</span>
                    {% elseif column.type == 'text' %}
                      <span class="text-truncate" title="{{ item[column.field] }}">
                        {{ item[column.field]|length > 50 ? item[column.field]|slice(0, 50) ~ '…' : item[column.field] }}
                      </span>
                    {% else %}
                      {{ item[column.field] ?? '—' }}
                    {% endif %}
                  </td>
                {% endfor %}
                
                {% if opts.show_actions and item.actions is defined %}
                  <td class="data-table-cell data-table-actions">
                    <div class="table-actions">
                      {% for action in item.actions %}
                        {% if action.type == 'button' %}
                          <a href="{{ action.url }}" class="table-action" title="{{ action.label }}">
                            <i class="bi {{ action.icon }}" aria-hidden="true"></i>
                          </a>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          {% else %}
            <tr class="data-table-empty">
              <td colspan="{{ columns|length + (opts.show_actions ? 1 : 0) }}" class="data-table-empty-cell">
                <div class="table-empty-state">
                  <i class="bi bi-inbox" aria-hidden="true"></i>
                  <p>{{ opts.empty_message }}</p>
                </div>
              </td>
            </tr>
          {% endif %}
        </tbody>
        
      </table>
    </div>
    
    {# Pagination #}
    {% if opts.paginated and items|length > opts.items_per_page %}
      <div class="data-table-pagination">
        <span class="pagination-info">
          Affichage 1 à {{ [opts.items_per_page, items|length]|min }} sur {{ items|length }} résultats
        </span>
        <nav class="pagination">
          <button class="pagination-btn pagination-prev" disabled>
            <i class="bi bi-chevron-left"></i> Précédent
          </button>
          <span class="pagination-pages">
            <button class="pagination-page pagination-page-active">1</button>
          </span>
          <button class="pagination-btn pagination-next">
            Suivant <i class="bi bi-chevron-right"></i>
          </button>
        </nav>
      </div>
    {% endif %}
    
  </div>
{% endmacro %}
