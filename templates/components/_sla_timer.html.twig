<div class="flex items-center gap-2 p-2 rounded-lg bg-slate-800/80 border border-slate-700">
    <div class="w-3 h-3 rounded-full animate-pulse
        {% if case.slaColorClass == 'sla-green' %}
            bg-emerald-500 shadow-lg shadow-emerald-500/50
        {% elseif case.slaColorClass == 'sla-orange' %}
            bg-amber-500 shadow-lg shadow-amber-500/50
        {% else %}
            bg-red-500 shadow-lg shadow-red-500/50
        {% endif %}">
    </div>
    <span class="text-xs font-mono font-bold text-white tracking-wider">
        {{ case.heuresRestantes|number_format(1) }}h restantes
    </span>
    <span class="text-xs text-slate-400 font-medium">/ 72h</span>
</div>
