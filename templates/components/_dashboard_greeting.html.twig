{% set hour = 'now'|date('G') %}
{% if hour < 12 %}
    {% set greeting = 'Bonjour' %}
{% elseif hour < 18 %}
    {% set greeting = 'Bon après-midi' %}
{% else %}
    {% set greeting = 'Bonsoir' %}
{% endif %}

<section class="dashboard-welcome" aria-label="Accueil personnalisé">
    <div class="dashboard-welcome-avatar">
        {% if app.user.photoProfil %}
            <img src="{{ path('app_account_photo', {v: app.user.photoProfil}) }}" alt="" width="48" height="48" decoding="async">
        {% else %}
            <span aria-hidden="true">{{ app.user.prenom|slice(0, 1) }}{{ app.user.nom|slice(0, 1) }}</span>
        {% endif %}
    </div>
    <div class="dashboard-welcome-copy">
        <p class="dashboard-welcome-eyebrow">{{ 'now'|date('d/m/Y') }}</p>
        <h2>{{ greeting }}, {{ app.user.prenom }}</h2>
        <p>{{ app.user.role.label() }} · Votre espace de suivi GEI</p>
    </div>
</section>
