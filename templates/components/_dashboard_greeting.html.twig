{% set hour = 'now'|date('G') %}
{% if hour < 12 %}
    {% set greeting = 'Bonjour' %}
{% elseif hour < 18 %}
    {% set greeting = 'Bon après-midi' %}
{% else %}
    {% set greeting = 'Bonsoir' %}
{% endif %}

<section class="dashboard-welcome" aria-label="Accueil personnalisé">
    <div class="dashboard-welcome-copy">
        <p class="dashboard-welcome-eyebrow">{{ 'now'|date('d/m/Y') }} · Espace GEI</p>
        <h2>{{ greeting }}, {{ app.user.prenom }}</h2>
        <p>{{ app.user.role.label() }} <span aria-hidden="true">·</span> Votre espace de suivi</p>
    </div>
</section>
