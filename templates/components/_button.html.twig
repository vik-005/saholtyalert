{# Macro pour boutons avec variants #}
{% macro button(label, variant = 'primary', type = 'submit', size = 'md', icon = null, class = '', disabled = false) %}
  {% set base = 'rounded-lg text-sm font-semibold transition-colors inline-flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed' %}
  {% set sizes = {
    sm: 'h-9 px-4',
    md: 'h-11 px-5',
    lg: 'h-12 px-6'
  } %}
  {% set variants = {
    primary:   'bg-orange-500 hover:bg-orange-600 text-white',
    secondary: 'bg-navy-900 hover:bg-navy-800 text-white dark:bg-navy-800 dark:hover:bg-navy-700',
    ghost:     'border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-navy-800',
    danger:    'bg-red-600 hover:bg-red-700 text-white',
    link:      'text-orange-500 hover:text-orange-600 dark:text-orange-400 dark:hover:text-orange-300 underline'
  } %}
  <button 
    type="{{ type }}" 
    class="{{ base }} {{ sizes[size] }} {{ variants[variant] }} {{ class }}"
    {% if disabled %}disabled{% endif %}
  >
    {% if icon %}<span class="inline-block">{{ icon }}</span>{% endif %}
    {{ label }}
  </button>
{% endmacro %}

{# Variante "full-width" pour formulaires #}
{% macro button_full(label, variant = 'primary', type = 'submit', icon = null, class = '', disabled = false) %}
  {{ _self.button(label, variant, type, 'md', icon, 'w-full ' ~ class, disabled) }}
{% endmacro %}
