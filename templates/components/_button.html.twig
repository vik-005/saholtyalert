{# ─────────────────────────────────────────────────────────────────────────
   SAHOTLY SYSTEM - Button Component
   Professional button component with multiple variants and states
───────────────────────────────────────────────────────────────────────── #}

{# Main button macro #}
{% macro button(label, variant = 'primary', url = null, type = 'button', disabled = false, icon = null, size = 'md', loading = false, extra_class = '') %}
  {% set btnClass = 'btn btn-' ~ variant ~ ' btn-' ~ size %}
  {% if extra_class %} {{ btnClass }} {{ extra_class }}{% endif %}
  
  {% if url %}
    <a href="{{ url }}" class="{{ btnClass }}" role="button" tabindex="0">
      {% if icon %}
        {% if icon starts with 'bi-' %}
          <i class="bi {{ icon }}" aria-hidden="true"></i>
        {% else %}
          {{ icon|raw }}
        {% endif %}
      {% endif %}
      <span class="btn-label">{{ label }}</span>
    </a>
  {% else %}
    <button 
      type="{{ type }}" 
      class="{{ btnClass }}" 
      {% if disabled %}disabled{% endif %}
      {% if loading %}data-loading="true"{% endif %}
    >
      {% if loading %}
        <span class="btn-spinner" aria-hidden="true">
          <span class="spinner-icon"></span>
        </span>
      {% else %}
        {% if icon %}
          {% if icon starts with 'bi-' %}
            <i class="bi {{ icon }}" aria-hidden="true"></i>
          {% else %}
            {{ icon|raw }}
          {% endif %}
        {% endif %}
      {% endif %}
      <span class="btn-label">{{ label }}</span>
    </button>
  {% endif %}
{% endmacro %}

{# Icon-only button (compact) #}
{% macro button_icon(icon, title = '', variant = 'secondary', url = null, type = 'button', disabled = false, size = 'md') %}
  {% set btnClass = 'btn btn-icon btn-' ~ variant ~ ' btn-' ~ size %}
  
  {% if url %}
    <a href="{{ url }}" class="{{ btnClass }}" role="button" title="{{ title }}" aria-label="{{ title }}">
      {% if icon starts with 'bi-' %}
        <i class="bi {{ icon }}" aria-hidden="true"></i>
      {% else %}
        {{ icon|raw }}
      {% endif %}
    </a>
  {% else %}
    <button 
      type="{{ type }}" 
      class="{{ btnClass }}" 
      title="{{ title }}"
      aria-label="{{ title }}"
      {% if disabled %}disabled{% endif %}
    >
      {% if icon starts with 'bi-' %}
        <i class="bi {{ icon }}" aria-hidden="true"></i>
      {% else %}
        {{ icon|raw }}
      {% endif %}
    </button>
  {% endif %}
{% endmacro %}

{# Button group — Multiple related buttons #}
{% macro button_group(buttons = [], variant = 'outline') %}
  <div class="button-group" role="group">
    {% for btn in buttons %}
      {{ _self.button(btn.label, btn.variant ?? variant, btn.url ?? null, btn.type ?? 'button', btn.disabled ?? false, btn.icon ?? null, btn.size ?? 'md') }}
    {% endfor %}
  </div>
{% endmacro %}

{# Confirmation button — Requires secondary confirmation #}
{% macro button_confirm(label, variant = 'danger', confirm_text = 'Are you sure?', on_confirm = null, disabled = false) %}
  <button 
    type="button"
    class="btn btn-{{ variant }} btn-confirm"
    data-confirm-text="{{ confirm_text }}"
    data-action="{{ on_confirm ?? '#' }}"
    {% if disabled %}disabled{% endif %}
  >
    <span class="btn-label">{{ label }}</span>
  </button>
{% endmacro %}
