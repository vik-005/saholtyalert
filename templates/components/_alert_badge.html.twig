{% if priority is defined and priority %}
    <span class="priority-badge priority-{{ priority.value }}">
        {{ priority.icon() }} {{ priority.label() }}
    </span>
{% elseif status is defined and status %}
    <span class="status-pill status-{{ status.value }}">
        <span class="status-dot"></span>
        {{ status.label() }}
    </span>
{% endif %}
