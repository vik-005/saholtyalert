{# Macro pour badges de statut/priorité avec design system unifié #}
{% macro badge_statut(statut, label = null) %}
  {% set statutValue = statut is iterable ? statut.value : (statut ?: 'nouveau') %}
  {% set labels = {
    nouveau: 'Nouveau',
    en_cours: 'En cours',
    a_investiguer: 'À investiguer',
    suivi: 'Suivi',
    ouvert: 'Ouvert',
    clos: 'Clos',
    archive: 'Archivé',
    transmis: 'Transmis',
    validee: 'Validée',
    a_valider_saholty: 'En attente de validation Manager',
    brouillon: 'Brouillon',
    soumis: 'Soumis',
    en_qualification: 'En qualification',
    en_attente_complement: 'En attente complément',
    actionnable: 'Actionnable'
  } %}
  <span class="status-pill status-{{ statutValue }}">
    <span class="status-dot"></span>
    {{ label ?? labels[statutValue] ?? statutValue|capitalize }}
  </span>
{% endmacro %}

{# Macro pour badges de priorité #}
{% macro badge_priorite(priorite, label = null) %}
  {% set labels = {
    critique: 'Critique',
    eleve: 'Élevé',
    modere: 'Modéré',
    faible: 'Faible'
  } %}
  <span class="priority-badge priority-{{ priorite }}">
    {{ label ?? labels[priorite] ?? priorite|capitalize }}
  </span>
{% endmacro %}
