{# ─────────────────────────────────────────────────────────────────────────
   SAHOTLY SYSTEM - Chart Container Component
   Professional wrapper for Chart.js, Leaflet, and other visualizations
   Handles responsive sizing, loading states, empty states
───────────────────────────────────────────────────────────────────────── #}

{% macro chart(chart_id, title, type = 'line', subtitle = null, description = null) %}
  <div class="chart-card" data-chart-id="{{ chart_id }}">
    <div class="chart-header">
      <div class="chart-title-wrapper">
        <h3 class="chart-title">{{ title }}</h3>
        {% if subtitle %}
          <p class="chart-subtitle">{{ subtitle }}</p>
        {% endif %}
      </div>
      <div class="chart-controls" aria-hidden="true">
        <button class="chart-export-btn" title="Télécharger le graphique">
          <i class="bi bi-download"></i>
        </button>
        <button class="chart-fullscreen-btn" title="Afficher en plein écran">
          <i class="bi bi-arrows-fullscreen"></i>
        </button>
      </div>
    </div>
    
    {% if description %}
      <p class="chart-description">{{ description }}</p>
    {% endif %}
    
    <div class="chart-container">
      <canvas id="{{ chart_id }}" class="chart-canvas" role="img" aria-label="{{ title }}"></canvas>
      <div class="chart-loading" aria-label="Chargement du graphique">
        <div class="chart-spinner"></div>
        <p>Chargement du graphique…</p>
      </div>
    </div>
  </div>
{% endmacro %}

{# Map container (Leaflet) #}
{% macro map(map_id, title, description = null, controls = true) %}
  <div class="map-card" data-map-id="{{ map_id }}">
    <div class="map-header">
      <div class="map-title-wrapper">
        <h3 class="map-title">{{ title }}</h3>
      </div>
      {% if controls %}
        <div class="map-controls">
          <button class="map-fullscreen-btn" title="Afficher en plein écran">
            <i class="bi bi-arrows-fullscreen"></i>
          </button>
        </div>
      {% endif %}
    </div>
    
    {% if description %}
      <p class="map-description">{{ description }}</p>
    {% endif %}
    
    <div class="map-container">
      <div id="{{ map_id }}" class="map-canvas"></div>
      <div class="map-loading">
        <div class="map-spinner"></div>
        <p>Chargement de la carte…</p>
      </div>
    </div>
  </div>
{% endmacro %}

{# Metric card — KPI-like display #}
{% macro metric(label, value, change = null, trend = null, color = 'teal') %}
  <div class="metric-card" data-color="{{ color }}">
    <div class="metric-header">
      <span class="metric-label">{{ label }}</span>
      {% if change is not null %}
        <span class="metric-badge {% if trend == 'up' %}metric-trend-up{% elseif trend == 'down' %}metric-trend-down{% else %}metric-trend-flat{% endif %}">
          {% if trend == 'up' %}
            <i class="bi bi-arrow-up"></i>
          {% elseif trend == 'down' %}
            <i class="bi bi-arrow-down"></i>
          {% else %}
            <i class="bi bi-dash"></i>
          {% endif %}
          {{ change }}%
        </span>
      {% endif %}
    </div>
    <div class="metric-value">
      {{ value }}
    </div>
  </div>
{% endmacro %}
