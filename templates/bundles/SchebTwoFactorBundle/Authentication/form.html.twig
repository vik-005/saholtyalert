{% extends 'base.html.twig' %}

{% block title %}Authentification à deux facteurs — GEI{% endblock %}

{% block body_attributes %} data-turbo-cache="false"{% endblock %}

{% block body_login %}
<div class="auth-shell auth-shell-pro">

    {# ══ PANNEAU GAUCHE — branding ══ #}
    <aside class="auth-brand-panel">
        <div class="auth-slide-wrap" id="authSlideWrap">
            <div class="auth-slide-item auth-slide-active"
                 style="background-image:url('https://images.unsplash.com/photo-1557597774-9d475d030a6d?w=900&q=80&auto=format&fit=crop')"></div>
            <div class="auth-slide-item"
                 style="background-image:url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=900&q=80&auto=format&fit=crop')"></div>
            <div class="auth-slide-item"
                 style="background-image:url('https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=900&q=80&auto=format&fit=crop')"></div>
        </div>
        <div class="auth-slide-overlay"></div>
        <a href="{{ path('app_login') }}" class="auth-brand">
            <span><i class="bi-shield-lock"></i></span>GEI Platform
        </a>
        <div class="auth-brand-copy">
            <p class="auth-brand-tag">Groupe d'échange d'informations</p>
            <h2>Vérification en deux étapes</h2>
            <p>Saisissez le code généré par votre application d'authentification pour accéder à la plateforme.</p>
        </div>
        <ul class="auth-brand-points">
            <li><i class="bi-check-circle"></i>Connexion sécurisée</li>
            <li><i class="bi-check-circle"></i>Code à usage unique</li>
            <li><i class="bi-check-circle"></i>Données chiffrées TLS</li>
        </ul>
        <p class="auth-brand-footer"><i class="bi-lock"></i> Dispositif GEI/AIT · Accès restreint</p>
        <div class="auth-slide-dots" id="authSlideDots">
            <button class="auth-slide-dot auth-dot-active" data-slide="0" aria-label="Slide 1"></button>
            <button class="auth-slide-dot" data-slide="1" aria-label="Slide 2"></button>
            <button class="auth-slide-dot" data-slide="2" aria-label="Slide 3"></button>
        </div>
    </aside>

    {# ══ PANNEAU DROIT — formulaire ══ #}
    <main class="auth-form-panel auth-form-panel-pro">
        <div class="auth-mobile-brand">
            <span><i class="bi-shield-lock"></i></span> GEI Platform
        </div>
        <div class="auth-form-inner">

            <div class="auth-form-header">
                <div class="auth-2fa-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h1 class="auth-title">Authentification à deux facteurs</h1>
                <p class="auth-subtitle">
                    Saisissez le code à 6 chiffres généré par votre application d'authentification.
                </p>
            </div>

            {% if error is defined and error %}
            <div class="auth-error">
                <i class="bi-x-circle auth-error-icon"></i>
                <div>
                    <p class="auth-error-title">Code invalide</p>
                    <p class="auth-error-msg">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            </div>
            {% endif %}

            <form method="post" action="{{ path('2fa_login_check') }}" class="auth-fields" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="auth-field-wrap">
                    <label class="auth-label" for="code">
                        <i class="bi-shield-lock me-1.5 opacity-60"></i>Code de vérification
                    </label>
                    <div class="auth-input-wrap">
                        <input
                            type="text"
                            id="code"
                            name="_code"
                            inputmode="numeric"
                            pattern="[0-9]{6}"
                            maxlength="6"
                            placeholder="000000"
                            class="auth-input text-center auth-code-input"
                            autocomplete="one-time-code"
                            required
                            autofocus
                        >
                    </div>
                    <p class="form-help text-center mt-2">Le code change toutes les 30 secondes.</p>
                </div>

                {# Clavier numérique visuel #}
                <div class="auth-numpad" id="authNumpad">
                    {% for i in 1..9 %}
                        <button type="button" class="auth-num-btn" data-digit="{{ i }}">{{ i }}</button>
                    {% endfor %}
                    <button type="button" class="auth-num-btn auth-num-clear" data-action="clear">
                        <i class="bi bi-backspace"></i>
                    </button>
                    <button type="button" class="auth-num-btn" data-digit="0">0</button>
                    <button type="button" class="auth-num-btn auth-num-ok" data-action="submit">
                        <i class="bi bi-check2"></i>
                    </button>
                </div>

                <div class="auth-checkbox-row">
                    <label class="auth-checkbox-label">
                        <input type="checkbox" name="_trusted_device" class="auth-checkbox">
                        <span class="auth-checkbox-custom"></span>
                        <span>Se souvenir de cet appareil pendant 30 jours</span>
                    </label>
                </div>

                <button type="submit" class="auth-submit-btn">
                    <i class="bi bi-shield-check me-2"></i>Valider le code
                </button>

                <div class="auth-2fa-info">
                    <div class="auth-security-item">
                        <i class="bi bi-clock-history text-amber-400"></i>
                        <span>Code valide 30 secondes</span>
                    </div>
                    <div class="auth-security-item">
                        <i class="bi bi-shield-lock text-amber-400"></i>
                        <span>Connexion chiffrée TLS</span>
                    </div>
                    <div class="auth-security-item">
                        <i class="bi bi-eye-slash text-amber-400"></i>
                        <span>Données confidentielles</span>
                    </div>
                </div>
            </form>

        </div>
        <p class="auth-footer-note">© {{ 'now'|date('Y') }} · Plateforme GEI</p>
    </main>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('code');
    const numpad = document.getElementById('authNumpad');
    if (!input || !numpad) return;
    let value = '';

    function render() {
        input.value = value;
        // Affichage visuel avec points
        const display = value.padEnd(6, '·');
        input.placeholder = display.slice(value.length ? value.length : 0);
        input.focus();
    }

    numpad.addEventListener('click', (e) => {
        const btn = e.target.closest('.auth-num-btn');
        if (!btn) return;
        const action = btn.dataset.action;
        const digit = btn.dataset.digit;
        if (action === 'clear') { value = value.slice(0, -1); }
        else if (action === 'submit') {
            if (value.length === 6) { input.value = value; input.form.submit(); }
            return;
        } else if (digit !== undefined && value.length < 6) { value += digit; }
        render();
        if (value.length === 6) { setTimeout(() => { input.value = value; input.form.submit(); }, 200); }
    });

    input.addEventListener('input', () => {
        value = input.value.replace(/\D/g, '').slice(0, 6);
        input.value = value;
    });

    input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value) { e.preventDefault(); }
        if (e.key === 'Enter' && input.value.length === 6) { input.form.submit(); }
    });
});

// Slideshow
(function() {
    const slides = document.querySelectorAll('.auth-slide-item');
    const dots   = document.querySelectorAll('.auth-slide-dot');
    if (!slides.length) return;
    let current = 0, timer = null;
    function goTo(idx) {
        slides[current].classList.remove('auth-slide-active');
        dots[current]?.classList.remove('auth-dot-active');
        current = (idx + slides.length) % slides.length;
        slides[current].classList.add('auth-slide-active');
        dots[current]?.classList.add('auth-dot-active');
    }
    dots.forEach(d => d.addEventListener('click', () => { goTo(+d.dataset.slide); clearInterval(timer); timer = setInterval(() => goTo(current+1), 5000); }));
    timer = setInterval(() => goTo(current + 1), 5000);
})();
</script>

<style>
/* Layout 2FA — reprend le style auth-shell */
.auth-2fa-icon {
    width: 64px; height: 64px;
    background: rgba(251,191,36,0.12);
    border: 1px solid rgba(251,191,36,0.3);
    border-radius: 16px;
    display: grid; place-items: center;
    margin: 0 auto 16px;
    font-size: 28px; color: #fbbf24;
}

.auth-code-input {
    letter-spacing: 8px;
    font-size: 24px;
    font-weight: 700;
    text-align: center;
}

.auth-numpad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 16px auto;
    max-width: 240px;
}

.auth-num-btn {
    aspect-ratio: 1;
    border: 1px solid rgba(148,163,184,0.15);
    background: rgba(255,255,255,0.04);
    border-radius: 10px;
    font-size: 18px;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    transition: all 0.15s;
    display: flex; align-items: center; justify-content: center;
}
.auth-num-btn:hover { background: rgba(251,191,36,0.12); border-color: rgba(251,191,36,0.4); color: #fbbf24; }
.auth-num-btn:active { transform: scale(0.94); }
.auth-num-clear { color: #f87171; font-size: 16px; }
.auth-num-ok { background: #16856b; border-color: #16856b; color: #fff; font-size: 16px; }
.auth-num-ok:hover { background: #0d715b; }

.auth-2fa-info {
    display: flex; gap: 12px; flex-wrap: wrap;
    justify-content: center; margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(148,163,184,0.1);
}
</style>
{% endblock %}