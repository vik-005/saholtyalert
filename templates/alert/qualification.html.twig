{% extends 'base.html.twig' %}
{% block title %}{{ canDecide ? 'Validation Manager' : 'Qualification' }} — {{ alert.codeGei ?? 'BROUILLON' }}{% endblock %}
{% block header_title %}{{ canDecide ? 'Validation Manager' : 'Qualification GEI' }}{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── EN-TÊTE ────────────────────────────────────────────────────────────── #}
    <div class="page-header-row">
        <div>
            <p class="page-eyebrow">
                {% if canDecide %}
                    <i class="bi bi-shield-check me-1.5 text-emerald-400"></i>
                    Annexe A — Décision Manager
                {% else %}
                    <i class="bi bi-star-half me-1.5 text-amber-400"></i>
                    Annexe C — Qualification Agent
                {% endif %}
            </p>
            <h2 class="page-title">
                {% if canDecide %}
                    Valider ou rejeter {{ alert.codeGei ?? 'la fiche' }}
                {% else %}
                    Qualifier {{ alert.codeGei ?? 'la fiche' }}
                {% endif %}
            </h2>
            <p class="page-subtitle">
                {% if canDecide %}
                    Relisez les informations soumises par l'Agent. Vos seules actions sont :
                    <strong class="text-emerald-400">Valider</strong> ou
                    <strong class="text-red-400">Rejeter</strong>.
                {% else %}
                    Remplissez les 5 critères de qualification (Annexe C). Le score GEI sera calculé
                    <strong class="text-amber-400">automatiquement</strong>.
                {% endif %}
            </p>
        </div>
        <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="db-btn db-btn-ghost">
            <i class="bi bi-arrow-left me-1.5"></i>Retour à la fiche
        </a>
    </div>

    {# ── BANDEAU URGENCE 72h — affiché si score critique et cas actif ───────── #}
    {% if alert.urgence72hCase and alert.urgence72hCase.isActive() %}
    <div class="workflow-banner workflow-banner-red">
        <span class="urgence-pulse"></span>
        <i class="bi-stopwatch text-red-400 fa-lg flex-shrink-0"></i>
        <div>
            <p class="workflow-banner-title">⚠️ URGENCE 72h ACTIVE — {{ alert.urgence72hCase.heuresRestantes }} h restantes</p>
            <p class="workflow-banner-sub">Procédure d'urgence déclenchée automatiquement (score ≥ 18). Suivi requis par le Manager.</p>
        </div>
        <a href="{{ path('app_dashboard_urgence') }}" class="db-btn flex-shrink-0"
           style="background:rgba(239,68,68,.1);color:#f87171;border-color:rgba(239,68,68,.2)">
            <i class="bi-stopwatch me-1.5"></i>Tableau de bord Urgence
        </a>
    </div>
    {% endif %}

    {# ── LAYOUT 2 COLONNES ─────────────────────────────────────────────────── #}
    <div class="qualify-layout">

        {# ═══════════════════════════════════════════════════════════════════════
           COLONNE GAUCHE
           ─ Blocs lecture seule (Agent) : identification, contenu, source, qualification
           ─ Section décision Manager (si canDecide) OU formulaire Agent (sinon)
           ═══════════════════════════════════════════════════════════════════════ #}
        <div class="qualify-form-col">

            {# ── BLOC 1 : Traçabilité Agent (toujours visible, toujours lecture seule) ── #}
            <div class="qualify-agent-recap">
                <p class="qualify-section-label">
                    <span class="form-section-num">1</span>Identification &amp; traçabilité
                    <span class="qs-readonly-badge"><i class="bi bi-lock-fill me-1"></i>Lecture seule</span>
                </p>
                <div class="qualify-recap-grid">
                    <span class="qualify-recap-label">Code GEI</span>
                    <span class="qualify-recap-val font-mono text-amber-400">{{ alert.codeGei ?? 'Non attribué' }}</span>
                    <span class="qualify-recap-label">Date de création</span>
                    <span class="qualify-recap-val">{{ alert.dateCreation|date('d/m/Y') }}</span>
                    <span class="qualify-recap-label">Agent soumetteur</span>
                    <span class="qualify-recap-val">
                        <i class="bi bi-person-fill me-1 text-amber-400"></i>
                        {{ alert.emetteur ? alert.emetteur.nomComplet : '—' }}
                        {% if alert.emetteur and alert.emetteur.market %}
                            <span class="text-slate-500 text-xs ms-1">({{ alert.emetteur.market.nom }})</span>
                        {% endif %}
                    </span>
                    <span class="qualify-recap-label">Marché émetteur</span>
                    <span class="qualify-recap-val">{{ alert.market ? alert.market.nom : '—' }}</span>
                    <span class="qualify-recap-label">Port / Corridor</span>
                    <span class="qualify-recap-val">{{ alert.portCorridor ?: '—' }}</span>
                </div>
            </div>

            {# ── BLOC 2 : Contenu Agent ── #}
            <div class="qualify-agent-recap">
                <p class="qualify-section-label">
                    <span class="form-section-num">2</span>Contenu de l'alerte
                    <span class="qs-readonly-badge"><i class="bi bi-lock-fill me-1"></i>Lecture seule</span>
                </p>
                <div class="qualify-recap-grid">
                    <span class="qualify-recap-label">Catégorie</span>
                    <span class="qualify-recap-val">{{ alert.categorie ?: '—' }}</span>
                    <span class="qualify-recap-label">Résumé exécutif</span>
                    <span class="qualify-recap-text">{{ alert.resumeExecutif ? (alert.resumeExecutif|slice(0, 250) ~ (alert.resumeExecutif|length > 250 ? '…' : '')) : '—' }}</span>
                    <span class="qualify-recap-label">Éléments factuels</span>
                    <span class="qualify-recap-text">{{ (alert.elementsFactuels ?: '—')|slice(0, 200) ~ (alert.elementsFactuels|length > 200 ? '…' : '') }}</span>
                    <span class="qualify-recap-label">Hypothèses analytiques</span>
                    <span class="qualify-recap-text">{{ (alert.hypothesesAnalytiques ?: '—')|slice(0, 160) ~ (alert.hypothesesAnalytiques|length > 160 ? '…' : '') }}</span>
                </div>
            </div>

            {# ── BLOC 3 : Source ── #}
            <div class="qualify-agent-recap">
                <p class="qualify-section-label">
                    <span class="form-section-num">3</span>Source
                    <span class="qs-readonly-badge"><i class="bi bi-lock-fill me-1"></i>Lecture seule</span>
                </p>
                <div class="qualify-recap-grid">
                    <span class="qualify-recap-label">Type de source</span>
                    <span class="qualify-recap-val">{{ alert.typeSource ?: '—' }}</span>
                    <span class="qualify-recap-label">Anonymisation</span>
                    <span class="qualify-recap-val">{{ alert.anonymisation ?: '—' }}</span>
                    <span class="qualify-recap-label">Fiabilité source</span>
                    <span class="qualify-recap-val fiab-{{ alert.fiabiliteSource ? alert.fiabiliteSource.value|lower : 'nd' }}">
                        {% if alert.fiabiliteSource %}
                            <strong>{{ alert.fiabiliteSource.value }}</strong> — {{ alert.fiabiliteSource.label() }}
                        {% else %}
                            <span class="text-slate-500">Non renseignée</span>
                        {% endif %}
                    </span>
                </div>
            </div>

            {# ── BLOC 4 : Qualification saisie par l'Agent ────────────────────── #}
            {#  En mode canDecide (Manager) → TOUJOURS en lecture seule (PARTIE A).  #}
            {#  En mode Agent → remplacé par le formulaire ci-dessous.               #}
            {% if canDecide %}
            <div class="qualify-agent-recap qualify-agent-recap--scores">
                <p class="qualify-section-label">
                    <span class="form-section-num">4</span>Qualification Agent — Critères Annexe C
                    <span class="qs-readonly-badge"><i class="bi bi-lock-fill me-1"></i>Lecture seule</span>
                </p>
                <div class="qualify-scores-readonly">
                    <div class="qs-score-item">
                        <span class="qs-score-label">Fiabilité</span>
                        <span class="qs-score-val fiab-{{ alert.fiabiliteSource ? alert.fiabiliteSource.value|lower : 'nd' }}">
                            {{ alert.fiabiliteSource ? alert.fiabiliteSource.value : '—' }}
                        </span>
                    </div>
                    <div class="qs-score-item">
                        <span class="qs-score-label">Crédibilité</span>
                        <span class="qs-score-val">{{ alert.credibiliteContenu ? alert.credibiliteContenu ~ '/4' : '—' }}</span>
                    </div>
                    <div class="qs-score-item">
                        <span class="qs-score-label">Urgence</span>
                        <span class="qs-score-val">{{ alert.urgence ? alert.urgence.label() : '—' }}</span>
                    </div>
                    <div class="qs-score-item">
                        <span class="qs-score-label">Impact</span>
                        <span class="qs-score-val">{{ alert.impact ? alert.impact.label() : '—' }}</span>
                    </div>
                    <div class="qs-score-item">
                        <span class="qs-score-label">Exploitabilité</span>
                        <span class="qs-score-val">{{ alert.exploitabilite ? alert.exploitabilite.label() : '—' }}</span>
                    </div>
                </div>

                {# Score GEI calculé — affiché en évidence pour le Manager #}
                <div class="qs-score-summary mt-3">
                    {% set score = alert.effectiveScore %}
                    <div class="qs-score-big {{ score ? (score >= 18 ? 'score-critique' : (score >= 14 ? 'score-eleve' : (score >= 10 ? 'score-modere' : 'score-faible'))) : 'text-slate-500' }}">
                        {{ score ?? '—' }}<span class="qs-score-big-max">/25</span>
                    </div>
                    <div class="qs-prio-label">
                        {% include 'components/_alert_badge.html.twig' with {priority: alert.effectiveNiveauPriorite} %}
                    </div>
                    {% if alert.scoreSurcharge %}
                        <span class="qs-surcharge-notice">
                            <i class="bi bi-pencil-square me-1"></i>Score surchargé par Manager
                            {% if alert.surchargePar %}({{ alert.surchargePar.nomComplet }}){% endif %}
                        </span>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            {# ════════════════════════════════════════════════════════════════════
               SECTION FORMULAIRE
               ─ Si canDecide → section "Décision Manager" (actions uniquement)
               ─ Sinon       → formulaire de qualification Agent
               ════════════════════════════════════════════════════════════════════ #}

            {% if canDecide %}

                {# ── DÉCISION MANAGER (PARTIE A) ─────────────────────────────── #}
                <div class="qualify-section qualify-section--decision">
                    <p class="qualify-section-label">
                        <span class="form-section-num" style="background:rgba(52,211,153,.1);border-color:rgba(52,211,153,.3);color:#34d399">5</span>
                        Décision GEI — Chef d'Opérations
                    </p>
                    <p class="text-xs text-slate-500 mb-4">
                        Vous avez relu l'intégralité de la fiche. Validez pour transmettre,
                        ou rejetez en fournissant un commentaire obligatoire.
                    </p>

                    {{ form_start(form, {'attr': {'class': 'qualify-form', 'id': 'qualificationForm'}}) }}

                    {# Commentaire de suivi Manager — actionnable (Partie A) #}
                    <div class="qualify-field mb-4">
                        {{ form_label(form.commentaires, 'Commentaire de suivi Manager', {'label_attr': {'class': 'qualify-label'}}) }}
                        {{ form_widget(form.commentaires, {'attr': {
                            'class': 'form-textarea',
                            'rows': 3,
                            'placeholder': 'Observations, instructions de suivi, justification de la décision…'
                        }}) }}
                        {{ form_errors(form.commentaires) }}
                    </div>

                    {# Responsable de suivi — actionnable #}
                    <div class="qualify-field mb-4">
                        {{ form_label(form.responsableSuivi, null, {'label_attr': {'class': 'qualify-label'}}) }}
                        {{ form_widget(form.responsableSuivi, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.responsableSuivi) }}
                    </div>

                    {# Sensibilité — actionnable #}
                    <div class="qualify-row-2 mb-4">
                        <div class="qualify-field">
                            {{ form_label(form.sensibilite, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            {{ form_widget(form.sensibilite, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.sensibilite) }}
                        </div>
                        <div class="qualify-field">
                            {{ form_label(form.transmission, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            {{ form_widget(form.transmission, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.transmission) }}
                        </div>
                    </div>

                    {# Boutons Manager : Rejeter (modal) + Valider #}
                    <div class="form-actions">
                        <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="db-btn db-btn-ghost">
                            <i class="bi bi-ban me-1.5"></i>Annuler
                        </a>
                        <button type="button" class="db-btn db-btn-danger" id="openRejectModal">
                            <i class="bi bi-x-circle me-1.5"></i>Rejeter la fiche
                        </button>
                        <button type="submit" class="db-btn db-btn-success" style="width:auto;padding:0 28px;">
                            <i class="bi bi-check-circle me-1.5"></i>Valider et transmettre
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>

                {# ── MODAL DE REJET ───────────────────────────────────────────── #}
                <div id="rejectModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="rejectModalTitle">
                    <div class="modal-box">
                        <div class="modal-header">
                            <div>
                                <p class="modal-eyebrow">
                                    <i class="bi bi-exclamation-triangle me-1.5 text-red-400"></i>Rejet de la fiche
                                </p>
                                <h3 class="modal-title" id="rejectModalTitle">Confirmer le rejet ?</h3>
                            </div>
                            <button class="modal-close-btn" id="closeRejectModal" aria-label="Fermer">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                        <p class="modal-body-text">
                            Le rejet retourne la fiche à l'Agent pour complément d'information.
                            <strong>Un commentaire est obligatoire.</strong>
                        </p>
                        <form id="rejectForm" method="post"
                              action="{{ path('app_alert_qualify', {id: alert.id}) }}"
                              class="space-y-4 mt-4"
                              novalidate>
                            <input type="hidden" name="_token" value="{{ csrf_token('qualify-' ~ alert.id) }}">
                            <input type="hidden" name="action_rejet" value="1">
                            <div>
                                <label class="form-label" for="rejectCommentaire">
                                    Commentaire de rejet <span class="text-red-400">*</span>
                                </label>
                                <textarea id="rejectCommentaire" name="commentaire_rejet" rows="4"
                                          class="form-textarea"
                                          placeholder="Expliquez pourquoi la fiche est rejetée et ce qui doit être complété…"
                                          required></textarea>
                                <p id="rejectError" class="text-red-400 text-xs mt-1 hidden">
                                    Le commentaire est obligatoire avant de rejeter.
                                </p>
                            </div>
                            <div class="modal-actions">
                                <button type="button" id="cancelRejectModal" class="btn-secondary">
                                    <i class="bi bi-ban me-1.5"></i>Annuler
                                </button>
                                <button type="submit" class="btn-danger" id="submitReject">
                                    <i class="bi bi-x-circle me-1.5"></i>Confirmer le rejet
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            {% else %}

                {# ── FORMULAIRE AGENT — Qualification (critères Annexe C) ──────── #}
                {{ form_start(form, {'attr': {'class': 'qualify-form', 'id': 'qualificationForm'}}) }}

                <div class="qualify-section">
                    <p class="qualify-section-label">
                        <span class="form-section-num">4</span>Critères de qualification — Annexe C
                    </p>

                    <div class="qualify-field">
                        {{ form_label(form.fiabiliteSource, null, {'label_attr': {'class': 'qualify-label'}}) }}
                        {{ form_widget(form.fiabiliteSource, {'attr': {'class': 'form-select js-score-trigger', 'id': 'qualification_fiabiliteSource'}}) }}
                        {{ form_errors(form.fiabiliteSource) }}
                        {{ form_help(form.fiabiliteSource) }}
                    </div>

                    <div class="qualify-field mt-3">
                        <div class="qualify-field-header">
                            {{ form_label(form.credibiliteContenu, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            <span class="qualify-field-hint">Inversée : 1 = plus crédible = score 4</span>
                        </div>
                        {{ form_widget(form.credibiliteContenu, {'attr': {'class': 'form-select js-score-trigger', 'id': 'qualification_credibiliteContenu'}}) }}
                        {{ form_errors(form.credibiliteContenu) }}
                    </div>

                    <div class="qualify-row-3 mt-3">
                        <div class="qualify-field">
                            {{ form_label(form.urgence, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            {{ form_widget(form.urgence, {'attr': {'class': 'form-select js-score-trigger', 'id': 'qualification_urgence'}}) }}
                            {{ form_errors(form.urgence) }}
                        </div>
                        <div class="qualify-field">
                            {{ form_label(form.impact, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            {{ form_widget(form.impact, {'attr': {'class': 'form-select js-score-trigger', 'id': 'qualification_impact'}}) }}
                            {{ form_errors(form.impact) }}
                        </div>
                        <div class="qualify-field">
                            {{ form_label(form.exploitabilite, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            {{ form_widget(form.exploitabilite, {'attr': {'class': 'form-select js-score-trigger', 'id': 'qualification_exploitabilite'}}) }}
                            {{ form_errors(form.exploitabilite) }}
                        </div>
                    </div>
                </div>

                <div class="qualify-section">
                    <p class="qualify-section-label">
                        <span class="form-section-num">5</span>Recommandation &amp; actions
                    </p>
                    <div class="qualify-field">
                        {{ form_label(form.recommandation, null, {'label_attr': {'class': 'qualify-label'}}) }}
                        {{ form_widget(form.recommandation, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.recommandation) }}
                    </div>
                    <div class="qualify-field mt-3">
                        {{ form_label(form.actionsEnCours, null, {'label_attr': {'class': 'qualify-label'}}) }}
                        {{ form_widget(form.actionsEnCours, {'attr': {'class': 'form-textarea', 'rows': 3}}) }}
                        {{ form_errors(form.actionsEnCours) }}
                    </div>
                    <div class="qualify-field mt-3">
                        {{ form_label(form.commentaires, null, {'label_attr': {'class': 'qualify-label'}}) }}
                        {{ form_widget(form.commentaires, {'attr': {'class': 'form-textarea', 'rows': 3, 'placeholder': 'Observations de l\'Agent, besoins complémentaires…'}}) }}
                        {{ form_errors(form.commentaires) }}
                    </div>
                </div>

                <div class="qualify-section">
                    <p class="qualify-section-label">
                        <span class="form-section-num">6</span>Confidentialité
                    </p>
                    <div class="qualify-row-2">
                        <div class="qualify-field">
                            {{ form_label(form.sensibilite, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            {{ form_widget(form.sensibilite, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.sensibilite) }}
                        </div>
                        <div class="qualify-field">
                            {{ form_label(form.transmission, null, {'label_attr': {'class': 'qualify-label'}}) }}
                            {{ form_widget(form.transmission, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.transmission) }}
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="db-btn db-btn-ghost">
                        <i class="bi bi-ban me-1.5"></i>Annuler
                    </a>
                    <button type="submit" class="auth-submit-btn" style="width:auto;padding:0 28px;">
                        <i class="bi bi-check me-1.5"></i>Valider la qualification
                    </button>
                </div>

                {{ form_end(form) }}

            {% endif %}

        </div>{# /qualify-form-col #}

        {# ═══════════════════════════════════════════════════════════════════════
           COLONNE DROITE — Score live + Surcharge Manager
           ═══════════════════════════════════════════════════════════════════════ #}
        <div class="qualify-side-col">

            {# Score live — visible pour Agent ET Manager #}
            <div class="qualify-score-card">
                <p class="db-card-eyebrow mb-3">
                    <i class="bi bi-lightning me-1.5"></i>Score GEI
                    {% if not canDecide %}<span class="text-xs opacity-60 ms-1">— Calcul en temps réel</span>{% endif %}
                </p>
                <div class="qualify-score-display">
                    <div id="liveScore"
                         class="qualify-score-val {{ alert.effectiveScore ? (alert.effectiveScore >= 18 ? 'score-critique' : (alert.effectiveScore >= 14 ? 'score-eleve' : (alert.effectiveScore >= 10 ? 'score-modere' : 'score-faible'))) : 'text-slate-500' }}">
                        {{ alert.effectiveScore ?? '—' }}
                    </div>
                    <div class="qualify-score-max">/25</div>
                </div>
                <div id="livePriorite" class="qualify-prio-badge mt-2">
                    {{ alert.effectiveNiveauPriorite ? alert.effectiveNiveauPriorite.label() : 'En attente des critères' }}
                </div>
                <div id="liveFormula" class="qualify-formula mt-3 hidden">
                    <code id="liveFormulaText" class="text-amber-400 text-xs"></code>
                </div>
            </div>

            {# Rappel formule Annexe C #}
            <div class="qualify-formula-box">
                <p class="qualify-formula-title">Formule Annexe C</p>
                <code class="qualify-formula-code">Score = (Fiabilité × Crédibilité) + Urgence + Impact + Exploitabilité</code>
                <div class="qualify-thresholds">
                    <span class="threshold-item threshold-critique"><i class="bi bi-broadcast me-1"></i>≥ 18 Critique</span>
                    <span class="threshold-item threshold-eleve"><i class="bi bi-fire me-1"></i>14–17 Élevé</span>
                    <span class="threshold-item threshold-modere"><i class="bi bi-exclamation-circle me-1"></i>10–13 Modéré</span>
                    <span class="threshold-item threshold-faible"><i class="bi bi-check-circle me-1"></i>≤ 9 Faible</span>
                </div>
            </div>

            {# Lien suivi urgence 72h — affiché si score critique (PARTIE A) #}
            {% if alert.urgence72hCase %}
            <a href="{{ path('app_dashboard_urgence') }}"
               class="qualify-urgence-link {{ alert.urgence72hCase.isActive() ? 'qualify-urgence-link--active' : '' }}">
                <i class="bi bi-stopwatch me-2 text-red-400"></i>
                <div>
                    <span class="font-700 text-sm">Suivi Urgence 72h</span>
                    <span class="block text-xs text-slate-400 mt-0.5">
                        {% if alert.urgence72hCase.isActive() %}
                            {{ alert.urgence72hCase.heuresRestantes }} h restantes — 4 phases en cours
                        {% else %}
                            Procédure clôturée
                        {% endif %}
                    </span>
                </div>
                <i class="bi bi-arrow-right ms-auto text-slate-500"></i>
            </a>
            {% endif %}

            {# Surcharge exceptionnelle, uniquement après validation finale. #}
            {% if is_granted('ROLE_PFT') and alert.statut.value == 'validee' %}
            <div class="qualify-override-card">
                <p class="qualify-section-label">
                    <i class="bi bi-pen-to-square me-1.5 text-amber-400"></i>Surcharge manuelle (Manager)
                </p>
                <p class="text-xs text-slate-500 mb-3">
                    À utiliser uniquement avec justification. Le score calculé reste affiché en parallèle.
                </p>
                <form method="post"
                      action="{{ path('app_alert_override_score', {id: alert.id}) }}"
                      class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('override-' ~ alert.id) }}">
                    <div class="qualify-field">
                        <label class="qualify-label">Score surchargé (1–25)</label>
                        <input type="number" name="score_surcharge" min="1" max="25"
                               value="{{ alert.scoreSurcharge }}" placeholder="ex. 19"
                               class="form-input">
                    </div>
                    <div class="qualify-field">
                        <label class="qualify-label">Priorité surchargée</label>
                        <select name="priorite_surcharge" class="form-select">
                            <option value="">Automatique (calculée)</option>
                            <option value="critique" {% if alert.niveauPrioriteSurcharge and alert.niveauPrioriteSurcharge.value == 'critique' %}selected{% endif %}>🔴 Critique</option>
                            <option value="eleve"    {% if alert.niveauPrioriteSurcharge and alert.niveauPrioriteSurcharge.value == 'eleve'    %}selected{% endif %}>🟠 Élevé</option>
                            <option value="modere"   {% if alert.niveauPrioriteSurcharge and alert.niveauPrioriteSurcharge.value == 'modere'   %}selected{% endif %}>🟡 Modéré</option>
                            <option value="faible"   {% if alert.niveauPrioriteSurcharge and alert.niveauPrioriteSurcharge.value == 'faible'   %}selected{% endif %}>🟢 Faible</option>
                        </select>
                    </div>
                    <div class="qualify-field">
                        <label class="qualify-label">Justification <span class="text-red-400">*</span></label>
                        <textarea name="justification_surcharge" rows="2" required
                                  placeholder="Motif de la décision de surcharge…"
                                  class="form-textarea">{{ alert.justificationSurcharge }}</textarea>
                    </div>
                    <button type="submit" class="db-btn db-btn-amber w-full justify-center">
                        <i class="bi bi-save me-1.5"></i>Enregistrer la surcharge
                    </button>
                </form>
            </div>
            {% endif %}

        </div>{# /qualify-side-col #}

    </div>{# /qualify-layout #}
</div>

<style>
/* Layout */
.qualify-layout { display:grid; grid-template-columns:1fr 320px; gap:20px; align-items:start; }
@media(max-width:1024px){ .qualify-layout { grid-template-columns:1fr; } }
.qualify-form-col  { display:flex; flex-direction:column; gap:16px; min-width:0; }
.qualify-side-col  { display:flex; flex-direction:column; gap:14px; position:sticky; top:80px; }

/* Blocs lecture seule */
.qualify-agent-recap {
    background:var(--navy-950); border:1px solid var(--border);
    border-left:3px solid rgba(148,163,184,.3);
    border-radius:var(--radius); padding:14px 16px;
}
.qualify-agent-recap--scores { border-left-color:rgba(251,191,36,.4); }
.qualify-recap-grid { display:grid; grid-template-columns:auto 1fr; gap:6px 14px; font-size:11.5px; margin-top:8px; }
.qualify-recap-label { color:var(--text-muted); white-space:nowrap; }
.qualify-recap-val   { font-weight:700; }
.qualify-recap-text  { color:var(--text-dim); font-size:11px; line-height:1.5; }
.fiab-a { color:#34d399; } .fiab-b { color:var(--amber); }
.fiab-c { color:#fb923c; } .fiab-d { color:#f87171; } .fiab-nd { color:var(--text-muted); }

/* Badge lecture seule */
.qs-readonly-badge {
    margin-left:auto; font-size:9.5px; font-weight:600;
    padding:2px 8px; border-radius:99px;
    background:rgba(148,163,184,.08); color:var(--text-muted);
    border:1px solid rgba(148,163,184,.15);
}

/* Score lecture seule Manager */
.qualify-scores-readonly {
    display:flex; flex-wrap:wrap; gap:10px; margin-top:10px;
}
.qs-score-item {
    display:flex; flex-direction:column; align-items:center; gap:3px;
    background:var(--navy-900); border:1px solid var(--border);
    border-radius:var(--radius); padding:8px 14px; min-width:80px;
}
.qs-score-label { font-size:9px; text-transform:uppercase; letter-spacing:.08em; color:var(--text-muted); }
.qs-score-val   { font-size:15px; font-weight:800; color:#fff; }
.qs-score-summary { display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding-top:10px; border-top:1px solid var(--border); }
.qs-score-big { font-size:40px; font-weight:900; line-height:1; }
.qs-score-big-max { font-size:16px; color:var(--text-muted); margin-left:2px; }
.qs-prio-label { display:flex; align-items:center; }
.qs-surcharge-notice {
    font-size:10px; color:var(--amber); background:var(--amber-dim);
    padding:2px 8px; border-radius:99px;
}

/* Section décision Manager */
.qualify-section--decision {
    background:var(--navy-900); border:1px solid rgba(52,211,153,.2);
    border-left:3px solid rgba(52,211,153,.5);
    border-radius:var(--radius); padding:18px;
}

/* Section Agent */
.qualify-section {
    background:var(--navy-900); border:1px solid var(--border);
    border-radius:var(--radius); padding:18px;
}
.qualify-section-label {
    display:flex; align-items:center; gap:8px;
    font-size:10.5px; font-weight:700; text-transform:uppercase;
    letter-spacing:.1em; color:var(--text-muted); margin-bottom:14px;
}
.qualify-field     { display:flex; flex-direction:column; gap:6px; }
.qualify-label     { font-size:12px; font-weight:600; color:var(--text-muted); }
.qualify-field-header { display:flex; align-items:center; justify-content:space-between; }
.qualify-field-hint { font-size:10px; color:var(--text-muted); font-style:italic; }
.qualify-row-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; }
.qualify-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
@media(max-width:640px){ .qualify-row-3,.qualify-row-2 { grid-template-columns:1fr; } }

/* Score live */
.qualify-score-card {
    background:var(--navy-900); border:1px solid var(--border);
    border-radius:var(--radius-lg); padding:20px; text-align:center;
}
.qualify-score-display { display:flex; align-items:baseline; justify-content:center; gap:6px; }
.qualify-score-val { font-size:64px; font-weight:900; line-height:1; transition:color .3s; }
.qualify-score-max { font-size:20px; color:var(--text-muted); }
.qualify-prio-badge {
    font-size:12px; font-weight:700; padding:5px 16px; border-radius:99px;
    background:var(--navy-800); color:var(--text-muted); border:1px solid var(--border);
    display:inline-block; transition:all .3s;
}
.qualify-formula { text-align:left; background:var(--navy-950); border-radius:8px; padding:8px 12px; }
.qualify-formula-box {
    background:var(--navy-900); border:1px solid var(--border);
    border-radius:var(--radius); padding:14px 16px;
}
.qualify-formula-title { font-size:10.5px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:8px; }
.qualify-formula-code {
    display:block; font-size:11px; color:var(--amber);
    background:var(--navy-950); border-radius:8px; padding:8px 12px;
    font-family:monospace; margin-bottom:10px;
}
.qualify-thresholds { display:flex; flex-wrap:wrap; gap:6px; }
.qualify-override-card {
    background:var(--navy-900); border:1px solid var(--amber-border);
    border-radius:var(--radius); padding:16px;
}

/* Lien urgence 72h */
.qualify-urgence-link {
    display:flex; align-items:center; gap:10px;
    background:var(--navy-900); border:1px solid var(--border);
    border-radius:var(--radius); padding:12px 14px; text-decoration:none;
    color:var(--text-dim); transition:border-color .2s;
}
.qualify-urgence-link:hover { border-color:rgba(239,68,68,.3); }
.qualify-urgence-link--active { border-color:rgba(239,68,68,.35); background:rgba(239,68,68,.04); }

/* Misc */
.w-full { width:100%; }
.justify-center { justify-content:center; }
.font-700 { font-weight:700; }
</style>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {

    // ── Modal de rejet ─────────────────────────────────────────────────────────
    const modal          = document.getElementById('rejectModal');
    const openBtn        = document.getElementById('openRejectModal');
    const closeBtn       = document.getElementById('closeRejectModal');
    const cancelBtn      = document.getElementById('cancelRejectModal');
    const rejectForm     = document.getElementById('rejectForm');
    const rejectComment  = document.getElementById('rejectCommentaire');
    const rejectError    = document.getElementById('rejectError');

    function openModal()  { modal?.classList.remove('hidden'); rejectComment?.focus(); }
    function closeModal() { modal?.classList.add('hidden'); }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    rejectForm?.addEventListener('submit', (e) => {
        const val = rejectComment?.value.trim() ?? '';
        if (!val) {
            e.preventDefault();
            rejectError?.classList.remove('hidden');
            rejectComment?.focus();
        } else {
            rejectError?.classList.add('hidden');
        }
    });

    // ── Score live (uniquement pour l'Agent — canDecide:false) ───────────────
    const scoreEl    = document.getElementById('liveScore');
    const prioEl     = document.getElementById('livePriorite');
    const formulaEl  = document.getElementById('liveFormula');
    const formulaTxt = document.getElementById('liveFormulaText');

    if (!scoreEl) return; // Si pas de widget score, rien à faire

    const prioColors = {
        critique: { bg:'rgba(239,68,68,.1)',  color:'#f87171', border:'rgba(239,68,68,.25)' },
        eleve:    { bg:'rgba(251,146,60,.1)', color:'#fb923c', border:'rgba(251,146,60,.25)' },
        modere:   { bg:'rgba(251,191,36,.1)', color:'#fbbf24', border:'rgba(251,191,36,.25)' },
        faible:   { bg:'rgba(52,211,153,.1)', color:'#34d399', border:'rgba(52,211,153,.25)' },
    };
    const scoreClasses = ['score-critique','score-eleve','score-modere','score-faible','text-slate-500'];

    const FIAB_SCORES = { 'A':4,'B':3,'C':2,'D':1 };
    const CRED_SCORES = { '1':4,'2':3,'3':2,'4':1 };
    const URG_SCORES  = { 'immediat':3,'72h':2,'routine':1 };
    const IMP_SCORES  = { 'eleve':3,'moyen':2,'faible':1 };
    const EXP_SCORES  = { 'actionnable':3,'exploitable':3,'a_analyser':2,'a_surveiller':2,'a_completer':2,'archivage':1 };

    function renderScore(score, niveau, niveauLabel, formulaStr) {
        scoreEl.textContent = score;
        scoreClasses.forEach(c => scoreEl.classList.remove(c));
        const cls = score >= 18 ? 'score-critique' : score >= 14 ? 'score-eleve' : score >= 10 ? 'score-modere' : 'score-faible';
        scoreEl.classList.add(cls);
        if (prioEl) {
            prioEl.textContent = niveauLabel;
            const pc = prioColors[niveau] || prioColors.faible;
            prioEl.style.background  = pc.bg;
            prioEl.style.color       = pc.color;
            prioEl.style.borderColor = pc.border;
        }
        if (formulaEl && formulaTxt && formulaStr) {
            formulaTxt.textContent = formulaStr;
            formulaEl.classList.remove('hidden');
        }
    }

    function updatePreview() {
        const fiabEl  = document.getElementById('qualification_fiabiliteSource');
        const credEl  = document.getElementById('qualification_credibiliteContenu');
        const urgEl   = document.getElementById('qualification_urgence');
        const impEl   = document.getElementById('qualification_impact');
        const expEl   = document.getElementById('qualification_exploitabilite');

        if (!fiabEl && !credEl) return; // pas de formulaire Agent sur cet écran

        const fiabilite      = fiabEl?.value  || '{{ alert.fiabiliteSource ? alert.fiabiliteSource.value : "C" }}';
        const credibilite    = credEl?.value  || '';
        const urgence        = urgEl?.value   || '';
        const impact         = impEl?.value   || '';
        const exploitabilite = expEl?.value   || '';

        const missing = [!fiabilite&&'Fiabilité',!credibilite&&'Crédibilité',!urgence&&'Urgence',!impact&&'Impact',!exploitabilite&&'Exploitabilité'].filter(Boolean);
        if (missing.length > 0) {
            if (prioEl && (5 - missing.length) > 0) {
                prioEl.textContent = `Partiel (${5 - missing.length}/5) — ${missing.join(', ')}`;
                prioEl.style.background = 'rgba(245,158,11,.1)';
                prioEl.style.color = '#fbbf24';
                prioEl.style.borderColor = 'rgba(245,158,11,.25)';
            }
            return;
        }

        const fS = FIAB_SCORES[fiabilite] || 2;
        const cS = CRED_SCORES[credibilite] || 3;
        const uS = URG_SCORES[urgence]  || 1;
        const iS = IMP_SCORES[impact]   || 2;
        const eS = EXP_SCORES[exploitabilite] || 2;
        const total = (fS * cS) + uS + iS + eS;
        const niveau = total >= 18 ? 'critique' : total >= 14 ? 'eleve' : total >= 10 ? 'modere' : 'faible';
        const labels = { critique:'Critique', eleve:'Élevé', modere:'Modéré', faible:'Faible' };
        const formula = `(Fiab. ${fiabilite}=${fS} × Créd.=${cS}) + Urg.=${uS} + Imp.=${iS} + Exp.=${eS} = ${total}`;

        renderScore(total, niveau, labels[niveau], formula);

        fetch('{{ path("app_alert_preview_score") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fiabilite, credibilite, urgence, impact, exploitabilite })
        })
        .then(r => r.ok && r.headers.get('Content-Type')?.includes('application/json') ? r.json() : null)
        .then(data => { if (data?.score !== undefined) renderScore(data.score, data.niveau, data.niveau_label, formula); })
        .catch(() => {});
    }

    document.querySelectorAll('.js-score-trigger').forEach(el => {
        el.addEventListener('change', updatePreview);
        el.addEventListener('input', updatePreview);
    });
    updatePreview();
});
</script>
{% endblock %}
