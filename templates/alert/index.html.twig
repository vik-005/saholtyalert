{% extends 'base.html.twig' %}

{% block title %}Registre des alertes — GEI{% endblock %}
{% block header_title %}Registre des alertes{% endblock %}

{% block body %}
<section class="registry-page">
    <header class="registry-hero">
        <div>
            <p class="registry-kicker"><i class="fa-solid fa-shield-halved me-1"></i>Suivi opérationnel</p>
            <h1 class="registry-title">Registre national & régional</h1>
            <p class="registry-subtitle">Centralisez, qualifiez et suivez les fiches d’alerte GEI en toute clarté.</p>
        </div>
        <div class="registry-actions">
            <a href="{{ path('app_alert_import') }}" class="registry-action"><i class="fa-solid fa-file-arrow-up"></i><span>Importer Excel</span></a>
            <a href="{{ path('app_export_registre') }}" class="registry-action"><i class="fa-solid fa-file-excel"></i><span>Exporter</span></a>
            <a href="{{ path('app_export_registre_pdf') }}" class="registry-action"><i class="fa-solid fa-file-pdf"></i><span>Rapport PDF</span></a>
            <a href="{{ path('app_alert_new') }}" class="registry-action registry-action-primary"><i class="fa-solid fa-plus"></i><span>Nouvelle alerte</span></a>
        </div>
    </header>

    <div class="registry-card">
        <div class="registry-toolbar">
            <span class="registry-count">{{ alerts|length }} alerte{{ alerts|length > 1 ? 's' : '' }} enregistrée{{ alerts|length > 1 ? 's' : '' }}</span>
            <span class="registry-hint"><i class="fa-solid fa-circle-info me-1"></i>Ouvrez une ligne pour consulter les informations détaillées.</span>
        </div>
        <div class="registry-table-wrap">
            <table class="registry-table">
                <thead><tr>
                    <th>Détails</th><th>Code GEI</th><th>Date</th><th>Zone / pays</th><th>Catégorie</th><th>Résumé</th><th>Score</th><th>Priorité</th><th>Statut</th><th></th>
                </tr></thead>
                <tbody>
                {% for alert in alerts %}
                    <tr>
                        <td><button type="button" onclick="toggleDetailsIndex({{ alert.id }})" id="btn-idx-toggle-{{ alert.id }}" class="registry-expand" aria-label="Afficher les détails">+</button></td>
                        <td><a class="registry-code" href="{{ path('app_alert_show', {id: alert.id}) }}">{{ alert.codeGei ?? 'BROUILLON' }}</a></td>
                        <td>{{ alert.dateCreation|date('d/m/Y') }}</td>
                        <td>{{ alert.market.nom }}</td>
                        <td>{{ alert.categorie ? alert.categorie.label : '—' }}</td>
                        <td><div class="registry-summary">{{ alert.resumeExecutif ?: 'Aucun résumé renseigné' }}</div></td>
                        <td><span class="registry-score">{{ alert.effectiveScore ?? '—' }}</span></td>
                        <td>{% include 'components/_alert_badge.html.twig' with {priority: alert.effectiveNiveauPriorite} %}</td>
                        <td>{% include 'components/_alert_badge.html.twig' with {status: alert.statut} %}</td>
                        <td><div class="registry-buttons">
                            <a class="registry-icon-btn" title="Consulter" href="{{ path('app_alert_show', {id: alert.id}) }}"><i class="fa-solid fa-eye"></i></a>
                            {% if is_granted('ALERT_QUALIFY', alert) %}<a class="registry-icon-btn" title="Qualifier" href="{{ path('app_alert_qualify', {id: alert.id}) }}"><i class="fa-solid fa-pen-to-square"></i></a>{% endif %}
                        </div></td>
                    </tr>
                    <tr id="idx-details-row-{{ alert.id }}" class="registry-detail hidden">
                        <td colspan="10"><div class="registry-detail-grid">
                            <div class="registry-detail-block"><span class="registry-detail-label">Éléments factuels</span>{{ alert.elementsFactuels ?: 'Non renseigné' }}</div>
                            <div class="registry-detail-block"><span class="registry-detail-label">Hypothèses analytiques</span>{{ alert.hypothesesAnalytiques ?: 'Non renseigné' }}</div>
                            <div class="registry-detail-block"><span class="registry-detail-label">Informations de suivi</span><strong>Corridor :</strong> {{ alert.portCorridor ?? '—' }}<br><strong>Source :</strong> {{ alert.typeSource ? alert.typeSource.label : '—' }}<br><strong>Transmission :</strong> {{ alert.transmission.label }}<br><strong>Sensibilité :</strong> {{ alert.sensibilite.label }}</div>
                        </div></td>
                    </tr>
                {% else %}
                    <tr><td colspan="10" class="registry-empty"><i class="fa-regular fa-folder-open fa-2x"></i><p class="mt-2">Aucune alerte ne correspond aux critères actuels.</p></td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
function toggleDetailsIndex(id) {
    const row = document.getElementById('idx-details-row-' + id);
    const button = document.getElementById('btn-idx-toggle-' + id);
    const isHidden = row.classList.contains('hidden');
    row.classList.toggle('hidden', !isHidden);
    button.textContent = isHidden ? '−' : '+';
    button.setAttribute('aria-label', isHidden ? 'Masquer les détails' : 'Afficher les détails');
}
</script>
{% endblock %}
