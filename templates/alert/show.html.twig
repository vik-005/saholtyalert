{% extends 'base.html.twig' %}

{% block title %}Alerte {{ alert.codeGei }} — GEI{% endblock %}
{% block header_title %}Fiche {{ alert.codeGei ?? 'BROUILLON' }}{% endblock %}

{% block body %}
{% set alertToken = encrypt_id(alert.id, 'alert') %}
<div class="db-wrapper">

    {# ── BANDEAU ÉTAT — workflow visible ── #}
    <div class="show-header-card">
        <div class="show-header-left">
            <h2 class="show-code">
                <i class="bi bi-shield-check me-2 text-amber-400"></i>
                {{ alert.codeGei ?? 'BROUILLON' }}
            </h2>
            <div class="show-badges">
                {# Badge priorité #}
                {% set prio = alert.effectiveNiveauPriorite %}
                {% if prio %}
                    <span class="priority-badge priority-{{ prio.value }}">
                        {% if prio.value == 'critique' %}<i class="bi bi-broadcast me-1"></i>
                        {% elseif prio.value == 'eleve' %}<i class="bi bi-fire me-1"></i>
                        {% elseif prio.value == 'modere' %}<i class="bi bi-exclamation-circle me-1"></i>
                        {% else %}<i class="bi bi-check-circle me-1"></i>{% endif %}
                        {{ prio.label() }}
                    </span>
                {% endif %}
                {# Badge statut #}
                <span class="status-pill status-{{ alert.statut.value }}">
                    <span class="status-dot"></span>{{ alert.statut.label() }}
                </span>
                {# Flags #}
                {% if alert.surveillanceRenforcee %}
                    <span class="show-flag show-flag-amber">
                        <i class="bi bi-eye me-1"></i>Surveillance renforcée
                    </span>
                {% endif %}
                {% if alert.transmissionPrioritaire %}
                    <span class="show-flag show-flag-red">
                        <i class="bi bi-lightning-charge me-1"></i>Transmission prioritaire
                    </span>
                {% endif %}
            </div>
            <p class="show-meta">
                <i class="bi bi-globe2 me-1.5 text-amber-400"></i>
                {{ alert.market.nom }}
                {% if alert.typeLocalisation %}
                    <span class="mx-2 text-slate-400">·</span>
                    <span class="loc-type loc-type-{{ alert.typeLocalisation.value }}">
                        <i class="bi bi-{{ alert.typeLocalisation.icon() }}"></i>
                        {{ alert.typeLocalisation.label() }}
                    </span>
                {% endif %}
                {% if alert.portCorridor %}
                    <span class="mx-2 text-slate-400">·</span>
                    <i class="bi bi-signpost me-1 opacity-60"></i>{{ alert.portCorridor }}
                {% endif %}
                <span class="mx-2 text-slate-400">·</span>
                <i class="bi bi-calendar3 me-1 opacity-60"></i>{{ alert.dateCreation|date('d/m/Y') }}
                <span class="mx-2 text-slate-400">·</span>
                <i class="bi bi-person me-1 opacity-60"></i>{{ alert.emetteur.nomComplet }}
            </p>
        </div>

        {# Boutons d'action #}
        <div class="show-actions">
            <a href="{{ path('app_alert_edit', {token: alertToken}) }}" class="db-btn db-btn-ghost">
                <i class="bi bi-pencil-square me-1.5"></i>Modifier
            </a>
            {% if is_granted('ALERT_QUALIFY', alert) %}
                <a href="{{ path('app_alert_qualify', {token: alertToken}) }}" class="db-btn db-btn-amber">
                    <i class="bi bi-star-half me-1.5"></i>
                    {% if alert.scoreGei %}Requalifier{% else %}Qualifier{% endif %}
                </a>
            {% endif %}
            {% if is_granted('ROLE_PFT') and is_granted('ALERT_TRANSMIT', alert) and alert.scoreGei %}
                <a href="{{ path('app_alert_transmit', {token: alertToken}) }}" class="db-btn db-btn-ghost">
                    <i class="bi bi-send me-1.5"></i>Transmettre
                </a>
            {% endif %}
            {% if is_granted('ALERT_DECIDE', alert) %}
                <form method="post" action="{{ path('app_alert_delete', {token: alertToken}) }}" class="inline-delete-form" onsubmit="return window.confirm('Confirmer la suppression de cette alerte ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete') }}">
                    <button type="submit" class="db-btn db-btn-danger delete-trigger" data-delete-url="{{ path('app_alert_delete', {token: alertToken}) }}" data-delete-token="{{ csrf_token('delete')|e('html_attr') }}">
                        <i class="bi bi-trash me-1.5"></i>Supprimer
                    </button>
                </form>
            {% endif %}
            <a href="{{ path('app_alert_pdf', {token: alertToken}) }}" target="_blank" rel="noopener noreferrer" data-turbo="false" class="db-btn db-btn-ghost">
                <i class="bi bi-file-earmark-pdf me-1.5 text-red-500"></i>PDF
            </a>
        </div>
    </div>

    {# ── BANNIÈRE D'ÉTAT WORKFLOW — guide utilisateur ── #}
    {% if not alert.scoreGei %}
    <div class="workflow-banner workflow-banner-amber">
        <i class="bi bi-exclamation-triangle text-amber-500 flex-shrink-0" style="font-size: 1.25rem;"></i>
        <div>
            <p class="workflow-banner-title">Score non calculé — Qualification Manager requise</p>
            <p class="workflow-banner-sub">
                Cette fiche a été soumise par l'Agent. Un Manager doit remplir les sections de qualification
                (Crédibilité, Urgence, Impact, Exploitabilité) via le bouton <strong>Qualifier</strong> pour
                que le score GEI soit calculé automatiquement.
            </p>
        </div>
        {% if is_granted('ALERT_QUALIFY', alert) %}
        <a href="{{ path('app_alert_qualify', {token: alertToken}) }}" class="db-btn db-btn-amber flex-shrink-0">
            <i class="bi bi-star-half me-1.5"></i>Qualifier maintenant
        </a>
        {% endif %}
    </div>
    {% endif %}

    {% if alert.urgence72hCase and alert.urgence72hCase.isActive() %}
    <div class="workflow-banner workflow-banner-red">
        <span class="urgence-pulse"></span>
        <i class="bi bi-stopwatch text-red-500 flex-shrink-0" style="font-size: 1.25rem;"></i>
        <div>
            <p class="workflow-banner-title">⚠️ URGENCE 72h ACTIVE — {{ alert.urgence72hCase.heuresRestantes }} h restantes</p>
            <p class="workflow-banner-sub">Procédure d'urgence déclenchée automatiquement (score ≥ 18). Suivi requis.</p>
        </div>
        <a href="{{ path('app_dashboard_urgence') }}" class="db-btn db-btn-red flex-shrink-0">
            <i class="bi bi-stopwatch me-1.5"></i>Suivi SLA
        </a>
    </div>
    {% endif %}

    {# ── SCORE GEI (si calculé) ── #}
    {% if alert.effectiveScore %}
    <div class="show-score-bar">
        {% set score = alert.effectiveScore %}
        <div class="show-score-main">
            <span class="show-score-label">Score GEI</span>
            <span class="show-score-val score-badge {% if score >= 18 %}score-critique{% elseif score >= 14 %}score-eleve{% elseif score >= 10 %}score-modere{% else %}score-faible{% endif %}">
                {{ score }}
            </span>
            <span class="show-score-max">/25</span>
            {% if alert.scoreSurcharge %}
                <span class="show-score-surcharge">
                    <i class="bi bi-pencil-square me-1"></i>Surchargé par Manager
                </span>
            {% endif %}
        </div>
        <div class="show-score-details">
            {% if alert.legalStatus and alert.legalStatus.value == 'licite' %}
            <div class="show-score-item">
                <span class="show-score-item-label">Qualification</span>
                <span class="show-score-item-val">Licite — score fixe : 1</span>
            </div>
            {% else %}
            <div class="show-score-item">
                <span class="show-score-item-label">Fiabilité</span>
                <span class="show-score-item-val">{{ alert.fiabiliteSource ? alert.fiabiliteSource.value : '—' }}</span>
            </div>
            <span class="show-score-sep">×</span>
            <div class="show-score-item">
                <span class="show-score-item-label">Crédibilité</span>
                <span class="show-score-item-val">{{ alert.credibiliteContenu ?? '—' }}/4</span>
            </div>
            <span class="show-score-op">+</span>
            <div class="show-score-item">
                <span class="show-score-item-label">Urgence</span>
                <span class="show-score-item-val">{{ alert.urgence ? alert.urgence.label() : '—' }}</span>
            </div>
            <span class="show-score-op">+</span>
            <div class="show-score-item">
                <span class="show-score-item-label">Impact</span>
                <span class="show-score-item-val">{{ alert.impact ? alert.impact.label() : '—' }}</span>
            </div>
            <span class="show-score-op">+</span>
            <div class="show-score-item">
                <span class="show-score-item-label">Exploitabilité</span>
                <span class="show-score-item-val">{{ alert.exploitabilite ? alert.exploitabilite.label() : '—' }}</span>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# ── PARCOURS DES PAYS — indépendant des marchés GEI ── #}
    {% set parcoursCountries = alert.parcoursCountries|default([]) %}
    {% if parcoursCountries|length > 0 %}
    <div class="show-section show-route-section mt-3">
        <div class="show-route-heading">
            <div>
                <h3 class="show-section-title mb-1">
                    <i class="bi bi-signpost-2 me-1.5 text-emerald-400"></i>Parcours de l'alerte
                </h3>
                <p class="show-route-help">Marché principal et pays associés, dans l'ordre du trajet.</p>
            </div>
            <span class="status-pill status-pill-route">{{ parcoursCountries|length }} pays</span>
        </div>
        <div class="show-route-track" aria-label="Parcours {{ alert.market.nom }}">
            <div class="show-route-node show-route-node-main">
                <span class="show-route-dot"></span>
                <strong>{{ alert.market.nom }}</strong>
                <small>Principal · {{ alert.market.codeIso3 }}</small>
            </div>
            {% for countryCode in parcoursCountries %}
                <span class="show-route-line" aria-hidden="true"></span>
                <div class="show-route-node">
                    <span class="show-route-dot"></span>
                    <strong>{{ countryNames[countryCode]|default(countryCode) }}</strong>
                    <small>Étape {{ loop.index }} · {{ countryCode }}</small>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if alert.pieceJointes|length > 0 %}
    <div class="show-section mt-3">
        <h3 class="show-section-title">
            <i class="bi bi-paperclip me-1.5 text-emerald-400"></i>
            Documents justificatifs
            <span class="status-pill status-pill-route">{{ alert.pieceJointes|length }}</span>
        </h3>
        <div class="table-responsive">
            <table class="table table-sm mb-0" style="color:var(--dim)">
                <thead>
                    <tr><th>Document</th><th>Ajouté le</th><th>Taille</th><th class="text-end">Action</th></tr>
                </thead>
                <tbody>
                    {% for piece in alert.pieceJointes %}
                    <tr>
                        <td>
                            <i class="bi bi-file-earmark-text me-2 text-emerald-400"></i>
                            {{ piece.fichierNomOriginal }}
                        </td>
                        <td>{{ piece.uploadedAt|date('d/m/Y H:i') }}</td>
                        <td>{{ piece.tailleOctets ? (piece.tailleOctets / 1048576)|number_format(2, ',', ' ') ~ ' Mo' : '—' }}</td>
                        <td class="text-end">
                            <a class="db-btn db-btn-ghost db-btn-sm"
                               href="{{ path('app_alert_attachment_download', {token: alertToken, attachToken: encrypt_id(piece.id, 'attachment')}) }}">
                                <i class="bi bi-download me-1"></i>Télécharger
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {% if alert.qualificationHistories|length > 0 %}
    <div class="show-section mt-3">
        <h3 class="show-section-title">
            <i class="bi bi-clock-history me-1.5 text-amber-400"></i>
            Historique des scores
        </h3>
        <div class="table-responsive">
            <table class="table table-sm mb-0" style="color:var(--dim)">
                <thead><tr><th>Date</th><th>Ancien</th><th>Nouveau</th><th>Par</th></tr></thead>
                <tbody>
                {% for history in alert.qualificationHistories %}
                    <tr>
                        <td>{{ history.calculeLe|date('d/m/Y H:i') }}</td>
                        <td>{{ history.oldScore is not null ? history.oldScore : '—' }}</td>
                        <td class="font-700">{{ history.newScore is not null ? history.newScore : history.scoreGei }}</td>
                        <td>{{ history.calculePar }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# ── CONTENU 2 COLONNES ── #}
    <div class="show-grid">

        {# Colonne gauche #}
        <div class="show-col">

            <div class="show-section">
                <h3 class="show-section-title">
                    <span class="show-section-num">2</span>
                    Résumé Exécutif
                </h3>
                <p class="show-text">{{ alert.resumeExecutif ? alert.resumeExecutif|nl2br : '—' }}</p>
            </div>

            <div class="show-section">
                <h3 class="show-section-title">
                    <span class="show-section-num show-section-num-amber">4</span>
                    Éléments Factuels
                </h3>
                <p class="show-text">{{ alert.elementsFactuels ? alert.elementsFactuels|nl2br : '—' }}</p>
            </div>

            <div class="show-section">
                <h3 class="show-section-title">
                    <span class="show-section-num">5</span>
                    Hypothèses Analytiques
                </h3>
                <p class="show-text">{{ alert.hypothesesAnalytiques ? alert.hypothesesAnalytiques|nl2br : '—' }}</p>
            </div>

            {% if alert.recommandation or alert.actionsEnCours %}
            <div class="show-section">
                <h3 class="show-section-title">
                    <span class="show-section-num">7</span>
                    Recommandation & Actions
                </h3>
                {% if alert.recommandation %}
                    <p class="show-field-row">
                        <span class="show-field-label">Recommandation</span>
                        <span class="text-amber-400 font-600">{{ alert.recommandation.label() }}</span>
                    </p>
                {% endif %}
                {% if alert.actionsEnCours %}
                    <p class="show-text mt-2">{{ alert.actionsEnCours }}</p>
                {% endif %}
            </div>
            {% endif %}

        </div>

        {# Colonne droite — métadonnées #}
        <div class="show-col">

            <div class="show-section">
                <h3 class="show-section-title">
                    <span class="show-section-num">1</span>
                    Identification
                </h3>
                <div class="show-meta-grid">
                    <span class="show-field-label">Code GEI</span>
                    <span class="font-mono font-700 text-amber-400">{{ alert.codeGei ?? 'Non attribué' }}</span>
                    <span class="show-field-label">Catégorie</span>
                    <span>{{ alert.categorie ?: '—' }}</span>
                    <span class="show-field-label">Zone / Marché</span>
                    <span>{{ alert.market.nom }}</span>
                    <span class="show-field-label">Corridor</span>
                    <span>{{ alert.portCorridor ?: '—' }}</span>
                    <span class="show-field-label">Opérateur / Acteur</span>
                    <span>{{ alert.operateurActeur ?: '—' }}</span>
                    <span class="show-field-label">Créé le</span>
                    <span>{{ alert.dateCreation|date('d/m/Y') }}</span>
                    <span class="show-field-label">Réf. doc.</span>
                    <span class="font-mono text-xs">{{ alert.referenceDocumentaire ?: '—' }}</span>
                </div>
            </div>

            <div class="show-section">
                <h3 class="show-section-title">
                    <span class="show-section-num">3</span>
                    Source & Fiabilité
                </h3>
                <div class="show-meta-grid">
                    <span class="show-field-label">Type source</span>
                    <span>{{ alert.typeSource ?: '—' }}</span>
                    <span class="show-field-label">Anonymisation</span>
                    <span>{{ alert.anonymisation ?: '—' }}</span>
                    <span class="show-field-label">Statut juridique</span>
                    <span>{{ alert.legalStatus ? alert.legalStatus.label() : '—' }}</span>
                    <span class="show-field-label">Fiabilité (A–D)</span>
                    <span class="font-700" style="color:var(--text)">{{ alert.fiabiliteSource ? alert.fiabiliteSource.value : '—' }}</span>
                    {% if alert.historiqueSource %}
                    <span class="show-field-label">Historique source</span>
                    <span class="text-slate-400 text-xs">{{ alert.historiqueSource }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="show-section">
                <h3 class="show-section-title">
                    <span class="show-section-num">8</span>
                    Confidentialité
                </h3>
                <div class="show-meta-grid">
                    <span class="show-field-label">Sensibilité</span>
                    <span>{{ alert.sensibilite ? alert.sensibilite.label() : '—' }}</span>
                    <span class="show-field-label">Transmission</span>
                    <span>{{ alert.transmission ? alert.transmission.label() : '—' }}</span>
                    <span class="show-field-label">Pièces dispo.</span>
                    <span>{{ alert.piecesDisponibles ? ('Oui' ~ (alert.piecesType ? ' — ' ~ alert.piecesType : '')) : 'Non' }}</span>
                    {% if alert.responsableSuivi %}
                    <span class="show-field-label">Responsable</span>
                    <span>{{ alert.responsableSuivi.nomComplet }}</span>
                    {% endif %}
                </div>
            </div>

            {% if alert.commentaires %}
            <div class="show-section">
                <h3 class="show-section-title">
                    <i class="bi bi-chat-left-dots me-1.5 text-amber-400"></i>
                    Commentaires Manager
                </h3>
                <p class="show-text">{{ alert.commentaires }}</p>
            </div>
            {% endif %}

            {# ── Traçabilité nominative (Partie B) ─────────────────────────── #}
            <div class="show-section">
                <h3 class="show-section-title">
                    <i class="bi bi-person-badge me-1.5 text-amber-400"></i>
                    Traçabilité
                </h3>
                <div class="show-meta-grid">
                    <span class="show-field-label">Agent soumetteur</span>
                    <span class="font-700">
                        <i class="bi bi-person-fill me-1 text-amber-400 opacity-70"></i>
                        {{ alert.emetteur ? alert.emetteur.nomComplet : '—' }}
                    </span>
                    <span class="show-field-label">Soumis le</span>
                    <span>{{ alert.createdAt|date('d/m/Y à H:i') }}</span>
                    {% if alert.validatedBy %}
                    <span class="show-field-label">Manager validateur</span>
                    <span class="font-700">
                        <i class="bi bi-shield-check me-1 text-emerald-400 opacity-80"></i>
                        {{ alert.validatedBy.nomComplet }}
                    </span>
                    <span class="show-field-label">Validé le</span>
                    <span>{{ alert.dateValidation ? alert.dateValidation|date('d/m/Y à H:i') : '—' }}</span>
                    {% if alert.delaiTraitementHeures is not null %}
                    <span class="show-field-label">Délai traitement</span>
                    <span class="font-mono text-xs">{{ alert.delaiTraitementHeures }} h</span>
                    {% endif %}
                    {% else %}
                    <span class="show-field-label">Manager validateur</span>
                    <span class="text-slate-500">En attente de validation</span>
                    {% endif %}
                </div>
            </div>

            {# Commentaire de rejet — affiché en priorité si fiche rejetée #}
            {% if alert.commentaireRejet %}
            <div class="show-section" style="border-left: 3px solid rgba(239,68,68,.5);">
                <h3 class="show-section-title" style="color: #f87171;">
                    <i class="bi bi-exclamation-triangle me-1.5"></i>
                    Motif de rejet Manager
                </h3>
                <p class="show-text" style="color: #fca5a5;">{{ alert.commentaireRejet }}</p>
                {% if alert.statut.value == 'a_completer' %}
                <div class="mt-3">
                    <a href="{{ path('app_alert_edit', {token: alertToken}) }}" class="db-btn db-btn-amber">
                        <i class="bi bi-pencil-square me-1.5"></i>Corriger et resoumettre
                    </a>
                </div>
                {% endif %}
            </div>
            {% endif %}

        </div>
    </div>

</div>

<style>
.show-header-card {
    display:flex; align-items:flex-start; justify-content:space-between; gap:16px;
    background:var(--navy-900); border:1px solid var(--border);
    border-radius:var(--radius-lg); padding:22px 24px;
    flex-wrap:wrap;
}
.show-code { font-size:22px; font-weight:900; color:#fff; font-family:monospace; margin-bottom:8px; }
.show-badges { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
.show-flag { font-size:10.5px; font-weight:700; padding:3px 9px; border-radius:99px; }
.show-flag-amber { background:rgba(251,191,36,.1); color:var(--amber); border:1px solid var(--amber-border); }
.show-flag-red   { background:rgba(239,68,68,.1);  color:#f87171;    border:1px solid rgba(239,68,68,.2); }
.show-meta { font-size:11.5px; color:var(--text-muted); }
.show-actions { display:flex; gap:8px; flex-wrap:wrap; flex-shrink:0; }
@media(max-width:640px) {
    .show-header-card { align-items:stretch; padding:16px; }
    .show-header-left { width:100%; min-width:0; }
    .show-meta { overflow-wrap:anywhere; line-height:1.6; }
    .show-actions {
        display:grid;
        grid-template-columns:repeat(2, minmax(0, 1fr));
        width:100%;
        min-width:0;
        flex:1 1 100%;
    }
    .show-actions > .db-btn,
    .show-actions .inline-delete-form { width:100%; min-width:0; max-width:100%; }
    .show-actions .inline-delete-form { display:flex; margin:0; }
    .show-actions .db-btn {
        justify-content:center;
        padding-inline:8px;
        text-align:center;
        white-space:normal;
    }
    .show-actions .inline-delete-form > .db-btn { width:100%; }
}
@media(max-width:360px) {
    .show-actions { grid-template-columns:1fr; }
}
.show-route-section { border-left: 3px solid #34d399; }
.show-route-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
.show-route-help { color:var(--text-muted); font-size:11.5px; margin:0; }
.status-pill-route { color:#34d399; border-color:rgba(52,211,153,.3); background:rgba(52,211,153,.08); white-space:nowrap; }
.show-route-track { display:flex; align-items:stretch; gap:0; margin-top:18px; overflow-x:auto; padding:4px 2px 8px; }
.show-route-node { min-width:150px; display:flex; flex-direction:column; gap:3px; color:var(--text); }
.show-route-node small { color:var(--text-muted); font-size:10px; }
.show-route-node-main strong { color:#fbbf24; }
.show-route-dot { width:14px; height:14px; border-radius:50%; background:#34d399; border:3px solid var(--navy-900); box-shadow:0 0 0 2px #34d399; margin-bottom:8px; }
.show-route-node-main .show-route-dot { background:#fbbf24; box-shadow:0 0 0 2px #fbbf24; }
.show-route-line { min-width:48px; height:0; border-top:2px dashed rgba(52,211,153,.7); margin:6px 10px 0; }
@media(max-width:700px) { .show-route-heading { flex-direction:column; } .show-route-node { min-width:125px; } }

.workflow-banner {
    display:flex; align-items:center; gap:14px;
    border-radius:var(--radius); padding:14px 18px;
    flex-wrap:wrap;
}
.workflow-banner-amber { background:rgba(251,191,36,.06); border:1px solid rgba(251,191,36,.25); }
