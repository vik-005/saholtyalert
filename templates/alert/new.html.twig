{% extends 'base.html.twig' %}

{% block title %}{% if is_edit is defined and is_edit %}Éditer Fiche GEI{% else %}Nouvelle Fiche d'Alerte GEI{% endif %}{% endblock %}
{% block header_title %}{% if is_edit is defined and is_edit %}Éditer la Fiche{% else %}Saisie Fiche d'Alerte Standard{% endif %}{% endblock %}

{% block body %}
<div class="db-wrapper">
<div class="max-w-4xl mx-auto">

    {# En-tête #}
    <div class="page-header-row mb-6">
        <div>
            <p class="page-eyebrow">
                <i class="fa-solid fa-file-shield me-1.5 text-amber-400"></i>
                Annexe A — Fiche Standard GEI
            </p>
            <h2 class="page-title">
                {% if is_edit is defined and is_edit %}
                    Modification de {{ alert.codeGei ?? 'la fiche' }}
                {% else %}
                    Nouvelle Fiche d'Alerte
                {% endif %}
            </h2>
            <p class="page-subtitle">
                Remplissez les informations terrain (sections 1 à 5).
                Le score GEI sera calculé <strong class="text-amber-400">automatiquement</strong> à l'enregistrement.
            </p>
        </div>
        <a href="{{ path('app_dashboard_operationnel') }}" class="db-btn db-btn-ghost">
            <i class="fa-solid fa-arrow-left me-1.5"></i>Retour
        </a>
    </div>

    <ol class="form-progress" aria-label="Étapes de saisie de l’alerte">
        <li class="is-current"><span>1</span>Identification</li>
        <li><span>2</span>Résumé</li>
        <li><span>3</span>Source</li>
        <li><span>4</span>Faits</li>
        <li><span>5</span>Analyse</li>
    </ol>

    {{ form_start(form, {'attr': {'class': 'space-y-0', 'novalidate': 'novalidate'}}) }}

    {# ── SECTION 1 — Identification & Traçabilité ────────────────────────── #}
    <div class="form-section">
        <div class="form-section-header">
            <span class="form-section-num">1</span>
            <div>
                <h3 class="form-section-title">Identification & Traçabilité</h3>
                <p class="form-section-sub">ID GEI, date et statut sont générés automatiquement par le système</p>
            </div>
        </div>
        <div class="form-grid-2">
            <div class="form-field">
                {{ form_label(form.market, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.market, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.market) }}
            </div>
            <div class="form-field">
                {{ form_label(form.portCorridor, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.portCorridor, {'attr': {'class': 'form-input', 'placeholder': 'ex. Corridor Cotonou - Niamey, Port de Lomé'}}) }}
            </div>
        </div>
        <div class="form-field mt-4">
            {{ form_label(form.categorie, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.categorie, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.categorie) }}
        </div>
    </div>

    {# ── SECTION 2 — Résumé Exécutif ────────────────────────────────────── #}
    <div class="form-section">
        <div class="form-section-header">
            <span class="form-section-num">2</span>
            <div>
                <h3 class="form-section-title">Résumé Exécutif</h3>
                <p class="form-section-sub">Synthèse en 5 lignes maximum, description factuelle du constat</p>
            </div>
        </div>
        <div class="form-field">
            {{ form_label(form.resumeExecutif, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.resumeExecutif, {'attr': {'class': 'form-textarea', 'rows': 4, 'maxlength': 500, 'placeholder': 'Synthèse du constat terrain…'}}) }}
            {{ form_errors(form.resumeExecutif) }}
            <p class="form-help">Maximum 500 caractères</p>
        </div>
    </div>

    {# ── SECTION 3 — Source & Fiabilité ─────────────────────────────────── #}
    <div class="form-section">
        <div class="form-section-header">
            <span class="form-section-num">3</span>
            <div>
                <h3 class="form-section-title">Source & Fiabilité</h3>
                <p class="form-section-sub">Type de source, anonymisation et fiabilité déclarative (nourrit le score)</p>
            </div>
        </div>
        <div class="form-grid-3">
            <div class="form-field">
                {{ form_label(form.typeSource, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.typeSource, {'attr': {'class': 'form-select'}}) }}
            </div>
            <div class="form-field">
                {{ form_label(form.typeAlerte, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.typeAlerte, {'attr': {'class': 'form-select'}}) }}
            </div>
            <div class="form-field">
                {{ form_label(form.anonymisation, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.anonymisation, {'attr': {'class': 'form-select'}}) }}
            </div>
        </div>
        <div class="form-field mt-4">
            {{ form_label(form.historiqueSource, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.historiqueSource, {'attr': {'class': 'form-textarea', 'rows': 3}}) }}
        </div>
        <div class="form-field mt-4">
            {{ form_label(form.fiabiliteSource, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.fiabiliteSource, {'attr': {'class': 'form-select'}}) }}
            <p class="form-help">
                <i class="fa-solid fa-circle-info me-1 text-amber-400"></i>
                A = source connue et fiable — D = source non vérifiée. Ce champ nourrit directement la formule GEI (Annexe C).
            </p>
        </div>
    </div>

    {# ── SECTION 4 — Éléments Factuels ──────────────────────────────────── #}
    <div class="form-section form-section-warning">
        <div class="form-section-header">
            <span class="form-section-num form-section-num-amber">4</span>
            <div>
                <h3 class="form-section-title">Éléments Factuels & Analyse</h3>
                <p class="form-section-sub">Faits bruts uniquement — <strong>ne jamais mélanger avec les hypothèses</strong> (garde-fou Annexe C)</p>
            </div>
        </div>
        <div class="form-field">
            {{ form_label(form.elementsFactuels, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.elementsFactuels, {'attr': {'class': 'form-textarea', 'rows': 6, 'placeholder': 'Description détaillée : dates, conteneurs, volumes, marques, acteurs identifiés…'}}) }}
        </div>
        <div class="form-field mt-4">
            {{ form_label(form.referenceDocumentaire, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.referenceDocumentaire, {'attr': {'class': 'form-input', 'placeholder': 'ex. ALT-BJA02-2026-001'}}) }}
            <p class="form-help">Référence de classement interne propre à votre poste (champ texte libre optionnel)</p>
        </div>
    </div>

    {# ── SECTION 5 — Hypothèses Analytiques ─────────────────────────────── #}
    <div class="form-section">
        <div class="form-section-header">
            <span class="form-section-num">5</span>
            <div>
                <h3 class="form-section-title">Hypothèses Analytiques</h3>
                <p class="form-section-sub">Distinct des faits — le Manager peut compléter lors de la qualification</p>
            </div>
        </div>
        <div class="form-field">
            {{ form_label(form.hypothesesAnalytiques, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.hypothesesAnalytiques, {'attr': {'class': 'form-textarea', 'rows': 4, 'placeholder': 'Hypothèses sur les réseaux, modus operandi, destinations probables…'}}) }}
        </div>
    </div>

    {# ── Boutons ─────────────────────────────────────────────────────────── #}
    <div class="form-actions">
        <a href="{{ path('app_dashboard_operationnel') }}" class="db-btn db-btn-ghost">
            <i class="fa-solid fa-ban me-1.5"></i>Annuler
        </a>
        <button type="submit" class="auth-submit-btn" style="width:auto; padding: 0 28px;">
            <i class="fa-solid fa-{% if is_edit is defined and is_edit %}floppy-disk{% else %}circle-plus{% endif %} me-2"></i>
            {% if is_edit is defined and is_edit %}Enregistrer les modifications{% else %}Créer la fiche d'alerte{% endif %}
        </button>
    </div>

    {{ form_end(form) }}
</div>
</div>

<style>
.form-section {
    background: var(--navy-900);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 16px;
}
.form-section-warning {
    border-color: rgba(251,191,36,0.25);
    background: rgba(251,191,36,0.03);
}
.form-section-header {
    display: flex; align-items: flex-start; gap: 14px;
    margin-bottom: 20px; padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
}
.form-section-num {
    width: 28px; height: 28px;
    background: var(--navy-800); border: 1px solid var(--border);
    border-radius: 8px; display: grid; place-items: center;
    font-size: 12px; font-weight: 800; color: var(--text-muted);
    flex-shrink: 0; margin-top: 2px;
}
.form-section-num-amber {
    background: var(--amber-dim); border-color: var(--amber-border); color: var(--amber);
}
.form-section-title { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 3px; }
.form-section-sub   { font-size: 11.5px; color: var(--text-muted); line-height: 1.5; }
.form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
.form-field  { display: flex; flex-direction: column; gap: 6px; }
.form-label  { font-size: 12px; font-weight: 600; color: var(--text-muted); }
.form-help   { font-size: 11px; color: var(--text-muted); }
.form-actions {
    display: flex; justify-content: flex-end; gap: 12px;
    padding: 20px; background: var(--navy-900);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    margin-bottom: 32px;
}
@media(max-width:768px) {
    .form-grid-2, .form-grid-3 { grid-template-columns: 1fr; }
}
</style>
{% endblock %}
