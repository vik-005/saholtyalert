{% extends 'base.html.twig' %}

{% block title %}Suivi des transmissions · Plateforme GEI{% endblock %}
{% block header_title %}Suivi des transmissions{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête de page ── #}
    <div class="page-header-row mb-4">
        <div>
            <p class="page-eyebrow">
                <i class="bi bi-send me-1.5 text-blue-400"></i>
                <span class="transmission-eyebrow-role">{% if app.user.role.value == 'ROLE_SUPERADMIN' %}Vue globale · Superadministrateur{% else %}Coordination externe & partenaires{% endif %}</span>
            </p>
            <h2 class="page-title">Suivi des transmissions</h2>
            <p class="page-subtitle">
                Suivi post-transmission des alertes orientées vers les autorités et partenaires externes.
            </p>
        </div>
        <div class="header-actions-group transmission-header-actions">
            <span class="transmission-summary-pill transmission-summary-open">
                <span class="status-dot"></span>
                <strong>{{ nb_en_cours }}</strong><span>En cours</span>
            </span>
            <span class="transmission-summary-pill transmission-summary-closed">
                <span class="status-dot"></span>
                <strong>{{ nb_clotures }}</strong><span>Clôturées</span>
            </span>
            <a href="{{ path('app_alert_index') }}" class="db-btn db-btn-ghost">
                <i class="bi bi-journal-text me-1.5"></i>Registre des alertes
            </a>
        </div>
    </div>

    {# ── Filtres de statut + barre de recherche dynamique ── #}
    <div data-controller="table-filter" data-table-filter-table-id-value="trTransmissions">
    <div class="stats-filter-bar transmission-filter-bar mb-4">
        <div class="stats-filter-group transmission-filter-links">
            <span class="stats-filter-label" style="font-size:12px;font-weight:600;color:var(--muted)">
                <i class="bi bi-funnel me-1"></i>Filtrer :
            </span>
            <a href="{{ path('app_transmission_index') }}"
               class="stats-shortcut {% if not current_filter %}active{% endif %}">
                Toutes ({{ total }})
            </a>
            <a href="{{ path('app_transmission_index', {statut: 'en_cours'}) }}"
               class="stats-shortcut {% if current_filter == 'en_cours' %}active{% endif %}">
                En cours de résolution ({{ nb_en_cours }})
            </a>
            <a href="{{ path('app_transmission_index', {statut: 'cloture'}) }}"
               class="stats-shortcut {% if current_filter == 'cloture' %}active{% endif %}">
                Clôturées ({{ nb_clotures }})
            </a>
        </div>
        {# Recherche rapide côté client #}
        <div class="transmission-search">
            <div class="search-input-wrapper transmission-search-input">
                <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:13px"></i>
                <input type="text"
                       id="transmissionSearch"
                       data-table-filter-target="input"
                       class="form-input form-input-sm"
                       style="padding-left:32px;font-size:13px"
                       placeholder="Rechercher alerte, destinataire…"
                       aria-label="Recherche dans les transmissions">
            </div>
            <span data-table-filter-target="count" style="font-size:11px;color:var(--muted)"></span>
        </div>
    </div>

    {# ── Liste / Tableau des transmissions ── #}
    <div class="db-card">
        {% if transmissions|length > 0 %}
        <div class="table-responsive transmission-table-wrap">
            <table id="trTransmissions" class="db-table transmission-table">
                <thead>
                    <tr style="border-bottom:1px solid var(--border);color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:0.04em">
                        <th style="padding:12px 16px;text-align:left">Alerte</th>
                        <th style="padding:12px 16px;text-align:left">Destinataire</th>
                        <th style="padding:12px 16px;text-align:left">Note de transmission</th>
                        <th style="padding:12px 16px;text-align:left">Statut transmission</th>
                        <th style="padding:12px 16px;text-align:left">Date transmission</th>
                        <th style="padding:12px 16px;text-align:left">Transmis par</th>
                        <th class="transmission-action-heading" style="padding:12px 16px;text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in transmissions %}
                    <tr class="transmission-row">
                        {# Alerte #}
                        <td data-label="Alerte">
                            <div style="font-weight:700">
                                <a href="{{ path('app_alert_show', {id: t.alert.id}) }}" class="code-gei-link" style="font-size:13px">
                                    {{ t.alert.codeGei ?? ('#GEI-' ~ t.alert.id) }}
                                </a>
                            </div>
                            <div style="font-size:11px;color:var(--muted);margin-top:2px;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                {{ t.alert.resumeExecutif }}
                            </div>
                        </td>

                        {# Destinataire #}
                        <td data-label="Destinataire">
                            <span style="font-weight:600;color:var(--text);font-size:12.5px">
                                <i class="bi bi-building me-1.5" style="color:var(--muted)"></i>
                                {{ t.destinataire }}
                            </span>
                        </td>

                        {# Note de transmission (tronquée si > 120 chars) #}
                        <td data-label="Note de transmission" class="transmission-note-cell">
                            {% if t.noteTransmission %}
                                {% set note = t.noteTransmission %}
                                {% if note|length > 120 %}
                                <span class="note-truncated" id="note-short-{{ t.id }}"
                                      style="font-size:12px;color:var(--text);display:block;line-height:1.4">
                                    {{ note|slice(0, 120) }}&hellip;
                                    <button type="button" onclick="document.getElementById('note-short-{{ t.id }}').style.display='none';document.getElementById('note-full-{{ t.id }}').style.display='block'" style="background:none;border:none;color:var(--accent,#60a5fa);font-size:11px;cursor:pointer;padding:0 0 0 4px;text-decoration:underline">Voir plus</button>
                                </span>
                                <span id="note-full-{{ t.id }}" style="display:none;font-size:12px;color:var(--text);line-height:1.4">
                                    {{ note }}
                                    <button type="button" onclick="document.getElementById('note-full-{{ t.id }}').style.display='none';document.getElementById('note-short-{{ t.id }}').style.display='block'" style="background:none;border:none;color:var(--accent,#60a5fa);font-size:11px;cursor:pointer;padding:0 0 0 4px;text-decoration:underline">Voir moins</button>
                                </span>
                                {% else %}
                                <span style="font-size:12px;color:var(--text);display:block;line-height:1.4">{{ note }}</span>
                                {% endif %}
                            {% else %}
                                <span style="font-size:11px;color:var(--muted);font-style:italic">—</span>
                            {% endif %}
                        </td>

                        {# Statut de la transmission #}
                        <td data-label="Statut">
                            {% if t.isCloture %}
                                <span class="status-pill status-clos" title="Dossier traité et clôturé par le destinataire">
                                    <span class="status-dot"></span>Clôturé
                                </span>
                                {% if t.dateCloture %}
                                <div style="font-size:10px;color:var(--muted);margin-top:4px">
                                    le {{ t.dateCloture|date('d/m/Y à H:i') }}
                                </div>
                                {% endif %}
                            {% else %}
                                <span class="status-pill status-en_cours" title="En cours de résolution par le destinataire">
                                    <span class="status-dot"></span>En cours de résolution
                                </span>
                            {% endif %}
                        </td>

                        {# Date transmission #}
                        <td data-label="Date de transmission" class="transmission-date-cell">
                            <i class="bi bi-calendar3 me-1 opacity-60"></i>
                            {{ t.transmisLe|date('d/m/Y') }}
                            <span style="font-size:10px;display:block;opacity:0.75">à {{ t.transmisLe|date('H:i') }}</span>
                        </td>

                        {# Transmis par (Manager) #}
                        <td data-label="Transmis par" class="transmission-sender-cell">
                            <i class="bi bi-person me-1" style="color:var(--muted)"></i>
                            {{ t.manager ? t.manager.nomComplet : 'Manager' }}
                        </td>

                        {# Actions #}
                        <td data-label="Actions" class="transmission-action-cell">
                            <div class="transmission-row-actions">
                                <a href="{{ path('app_alert_show', {id: t.alert.id}) }}" class="transmission-view-btn" title="Consulter la fiche alerte">
                                    <i class="bi bi-eye"></i><span>Voir l’alerte</span>
                                </a>
                                {% if not t.isCloture %}
                                <form method="post" action="{{ path('app_transmission_cloturer', {id: t.id}) }}" onsubmit="return confirm('Confirmez-vous la clôture du suivi de cette transmission ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cloturer-transmission-' ~ t.id) }}">
                                    <button type="submit" class="transmission-close-btn" title="Clôturer le suivi" id="btn-cloturer-{{ t.id }}">
                                        <i class="bi bi-check2-circle"></i><span>Clôturer le suivi</span>
                                    </button>
                                </form>
                                {% else %}
                                <form method="post" action="{{ path('app_transmission_rouvrir', {id: t.id}) }}" onsubmit="return confirm('Rouvrir cette transmission ? Elle repassera au statut « En cours ».');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('rouvrir-transmission-' ~ t.id) }}">
                                    <button type="submit" class="transmission-reopen-btn" title="Rouvrir le suivi" id="btn-rouvrir-{{ t.id }}">
                                        <i class="bi bi-arrow-counterclockwise"></i><span>Rouvrir le suivi</span>
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        {# État vide soigné #}
        <div class="db-card-body text-center py-12" style="padding:48px 20px">
            <i class="bi bi-send-check text-slate-500 fa-2x mb-3" style="font-size:40px;color:var(--muted);display:block"></i>
            <p style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:6px">
                Aucune transmission enregistrée
            </p>
            <p style="font-size:12px;color:var(--muted);max-width:440px;margin:0 auto 20px;line-height:1.6">
                {% if current_filter %}
                    Aucune transmission ne correspond au filtre sélectionné.
                {% else %}
                    Les alertes validées peuvent être transmises aux autorités et partenaires par un Manager depuis leur fiche respective.
                {% endif %}
            </p>
            {% if current_filter %}
            <a href="{{ path('app_transmission_index') }}" class="db-btn db-btn-ghost">
                <i class="bi bi-arrow-clockwise me-1.5"></i>Afficher toutes les transmissions
            </a>
            {% else %}
            <a href="{{ path('app_alert_index') }}" class="db-btn db-btn-top-dashboard">
                <i class="bi bi-journal-text me-1.5"></i>Consulter le registre des alertes
            </a>
            {% endif %}
        </div>
        {% endif %}
    </div>{# fin db-card #}
    </div>{# fin data-controller="table-filter" #}

</div>
<style>
.transmission-table { min-width: 1080px; }
.transmission-row { border-bottom: 1px solid var(--border); transition: background .15s ease; }
.transmission-row:hover { background: var(--card2); }
.transmission-table td { padding: 13px 14px; }
.transmission-note-cell { max-width: 290px; }
.transmission-date-cell, .transmission-sender-cell { white-space: nowrap; }
.transmission-action-cell { width: 1%; min-width: 190px; }
.transmission-row-actions { display: flex; align-items: center; justify-content: flex-end; gap: 7px; }
.transmission-row-actions form { margin: 0; }
.transmission-view-btn, .transmission-close-btn, .transmission-reopen-btn {
    display: inline-flex; min-height: 36px; align-items: center; justify-content: center; gap: 7px;
    padding: 7px 10px; border: 1px solid var(--border); border-radius: 8px;
    font-size: 11px; font-weight: 700; line-height: 1.2; text-decoration: none;
    white-space: nowrap; cursor: pointer; transition: background .15s, border-color .15s, transform .15s;
}
.transmission-view-btn { background: var(--card2); color: var(--text); }
.transmission-view-btn:hover { border-color: var(--border2); background: var(--card); }
.transmission-close-btn { border-color: #16856b; background: #16856b; color: #fff; }
.transmission-close-btn:hover { border-color: #0d715b; background: #0d715b; transform: translateY(-1px); }
.transmission-reopen-btn { border-color: var(--border); background: var(--card2); color: var(--dim); }
.transmission-reopen-btn:hover { border-color: var(--amber); color: var(--amber); }
.transmission-row-actions button:focus-visible, .transmission-row-actions a:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }
.transmission-header-actions { flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; }
.transmission-summary-pill { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid var(--border); border-radius: 9px; background: var(--card); font-size: 10px; }
.transmission-summary-pill strong { color: var(--text); font-size: 14px; }
.transmission-summary-pill > span:last-child { color: var(--muted); }
.transmission-summary-pill .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #16856b; }
.transmission-summary-closed .status-dot { background: #64748b; }
.transmission-filter-bar { justify-content: space-between; gap: 12px; }
.transmission-filter-links { flex-wrap: wrap; gap: 8px; }
.transmission-search { display: flex; align-items: center; gap: 8px; }
.transmission-search-input { position: relative; width: min(290px, 100%); }
.transmission-search-input input { width: 100%; min-height: 40px; }
.transmission-eyebrow-role { display: inline-flex; align-items: center; gap: 5px; }
body.dark .transmission-close-btn { color: #fff; }
body.dark .transmission-view-btn { background: var(--card2); color: var(--text); }
@media (max-width: 1050px) {
    .transmission-filter-bar { align-items: stretch; flex-direction: column; }
    .transmission-search { width: 100%; }
    .transmission-search-input { width: min(360px, 100%); }
}
@media (max-width: 760px) {
    .transmission-header-actions { width: 100%; justify-content: flex-start; }
    .transmission-table-wrap { overflow: visible; }
    .transmission-table { display: block; min-width: 0; border-collapse: separate !important; }
    .transmission-table thead { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    .transmission-table tbody { display: grid; gap: 12px; }
    .transmission-table tbody tr.transmission-row { display: block; overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: var(--card); box-shadow: 0 5px 18px rgba(15,23,42,.06); }
    .transmission-table td { display: grid; grid-template-columns: minmax(104px, 31%) minmax(0, 1fr); align-items: start; gap: 10px; width: 100%; max-width: none; min-width: 0; padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: normal; overflow-wrap: anywhere; }
    .transmission-table td::before { content: attr(data-label); color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
    .transmission-table td:first-child { padding-top: 13px; }
    .transmission-table td:last-child { display: block; border-bottom: 0; padding-top: 12px; }
    .transmission-table td:last-child::before { display: block; margin-bottom: 9px; }
    .transmission-note-cell { max-width: none; }
    .transmission-row-actions { grid-column: 1 / -1; flex-wrap: wrap; justify-content: flex-start; gap: 8px; }
    .transmission-row-actions form { flex: 1 1 140px; min-width: 0; }
    .transmission-view-btn, .transmission-close-btn, .transmission-reopen-btn { width: 100%; min-height: 46px; padding: 9px 12px; font-size: 12px; }
}
@media (max-width: 420px) {
    .transmission-table td { grid-template-columns: 1fr; gap: 5px; }
    .transmission-row-actions { flex-direction: column; }
    .transmission-row-actions form, .transmission-row-actions button, .transmission-view-btn { width: 100%; flex-basis: auto; }
    .transmission-search { align-items: stretch; flex-direction: column; }
    .transmission-search-input { width: 100%; }
}
</style>
{% endblock %}
