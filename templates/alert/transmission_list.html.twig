{% extends 'base.html.twig' %}

{% block title %}Suivi des transmissions · Plateforme GEI{% endblock %}
{% block header_title %}Suivi des transmissions{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête de page ── #}
    <div class="page-header-row mb-4">
        <div>
            <p class="page-eyebrow">
                <i class="bi bi-send me-1.5 text-blue-400"></i>
                <span class="transmission-eyebrow-role">
                    {% if app.user.role.value == 'ROLE_SUPERADMIN' %}Vue globale · Superadministrateur{% else %}Coordination externe &amp; partenaires{% endif %}
                </span>
            </p>
            <h2 class="page-title">Suivi des transmissions</h2>
            <p class="page-subtitle">
                Suivi post-transmission des alertes orientées vers les autorités et partenaires externes.
            </p>
        </div>
        <div class="header-actions-group transmission-header-actions">
            <span class="transmission-summary-pill transmission-summary-open">
                <span class="status-dot"></span>
                <strong>{{ nb_en_cours }}</strong><span>En cours</span>
            </span>
            <span class="transmission-summary-pill transmission-summary-closed">
                <span class="status-dot"></span>
                <strong>{{ nb_clotures }}</strong><span>Clôturées</span>
            </span>
            <a href="{{ path('app_alert_index') }}" class="db-btn db-btn-ghost">
                <i class="bi bi-journal-text me-1.5"></i>Registre des alertes
            </a>
        </div>
    </div>

    {# ── Filtres de statut + barre de recherche dynamique ── #}
    <div data-controller="table-filter" data-table-filter-table-id-value="trTransmissions">
    <div class="stats-filter-bar transmission-filter-bar mb-4">
        <div class="stats-filter-group transmission-filter-links">
            <span class="stats-filter-label" style="font-size:12px;font-weight:600;color:var(--muted)">
                <i class="bi bi-funnel me-1"></i>Filtrer :
            </span>
            <a href="{{ path('app_transmission_index') }}"
               class="stats-shortcut {% if not current_filter %}active{% endif %}">
                Toutes ({{ total }})
            </a>
            <a href="{{ path('app_transmission_index', {statut: 'en_cours'}) }}"
               class="stats-shortcut {% if current_filter == 'en_cours' %}active{% endif %}">
                En cours ({{ nb_en_cours }})
            </a>
            <a href="{{ path('app_transmission_index', {statut: 'cloture'}) }}"
               class="stats-shortcut {% if current_filter == 'cloture' %}active{% endif %}">
                Clôturées ({{ nb_clotures }})
            </a>
        </div>
        {# Recherche rapide côté client #}
        <div class="transmission-search">
            <div class="search-input-wrapper transmission-search-input">
                <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:13px"></i>
                <input type="text"
                       id="transmissionSearch"
                       data-table-filter-target="input"
                       class="form-input form-input-sm"
                       style="padding-left:32px;font-size:13px"
                       placeholder="Rechercher alerte, destinataire…"
                       aria-label="Recherche dans les transmissions">
            </div>
            <span data-table-filter-target="count" style="font-size:11px;color:var(--muted)"></span>
        </div>
    </div>

    {# ── Tableau des transmissions ── #}
    <div class="db-card">
        {% if transmissions|length > 0 %}
        <div class="table-responsive transmission-table-wrap">
            <table id="trTransmissions" class="db-table transmission-table">
                <thead>
                    <tr class="transmission-thead-row">
                        <th style="padding:12px 16px;text-align:left">Alerte</th>
                        <th style="padding:12px 16px;text-align:left">Destinataire</th>
                        <th style="padding:12px 16px;text-align:left">Note de transmission</th>
                        <th style="padding:12px 16px;text-align:left">Statut</th>
                        <th style="padding:12px 16px;text-align:left">Date</th>
                        <th style="padding:12px 16px;text-align:left">Transmis par</th>
                        <th class="transmission-action-heading" style="padding:12px 16px;text-align:right;white-space:nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in transmissions %}
                    <tr class="transmission-row">

                        {# Alerte #}
                        <td data-label="Alerte">
                            <div style="font-weight:700">
                                <a href="{{ path('app_alert_show', {token: encrypt_id(t.alert.id, 'alert')}) }}"
                                   class="code-gei-link" style="font-size:13px">
                                    {{ t.alert.codeGei ?? ('#GEI-' ~ t.alert.id) }}
                                </a>
                            </div>
                            <div class="transmission-alert-resume">
                                {{ t.alert.resumeExecutif }}
                            </div>
                        </td>

                        {# Destinataire #}
                        <td data-label="Destinataire">
                            <span style="font-weight:600;color:var(--text);font-size:12.5px">
                                <i class="bi bi-building me-1.5" style="color:var(--muted)"></i>
                                {{ t.destinataire }}
                            </span>
                        </td>

                        {# Note de transmission (tronquée si > 120 chars) #}
                        <td data-label="Note de transmission" class="transmission-note-cell">
                            {% if t.noteTransmission %}
                                {% set note = t.noteTransmission %}
                                {% if note|length > 120 %}
                                <span id="note-short-{{ t.id }}"
                                      style="font-size:12px;color:var(--text);display:block;line-height:1.4">
                                    {{ note|slice(0, 120) }}&hellip;
                                    <button type="button"
                                            onclick="document.getElementById('note-short-{{ t.id }}').style.display='none';document.getElementById('note-full-{{ t.id }}').style.display='block'"
                                            style="background:none;border:none;color:var(--accent,#60a5fa);font-size:11px;cursor:pointer;padding:0 0 0 4px;text-decoration:underline">
                                        Voir plus
                                    </button>
                                </span>
                                <span id="note-full-{{ t.id }}"
                                      style="display:none;font-size:12px;color:var(--text);line-height:1.4">
                                    {{ note }}
                                    <button type="button"
                                            onclick="document.getElementById('note-full-{{ t.id }}').style.display='none';document.getElementById('note-short-{{ t.id }}').style.display='block'"
                                            style="background:none;border:none;color:var(--accent,#60a5fa);font-size:11px;cursor:pointer;padding:0 0 0 4px;text-decoration:underline">
                                        Voir moins
                                    </button>
                                </span>
                                {% else %}
                                <span style="font-size:12px;color:var(--text);display:block;line-height:1.4">{{ note }}</span>
                                {% endif %}
                            {% else %}
                                <span style="font-size:11px;color:var(--muted);font-style:italic">—</span>
                            {% endif %}
                        </td>

                        {# Statut de la transmission #}
                        <td data-label="Statut">
                            {% if t.isCloture %}
                                <span class="status-pill status-clos" title="Dossier clôturé">
                                    <span class="status-dot"></span>Clôturé
                                </span>
                                {% if t.dateCloture %}
                                <div style="font-size:10px;color:var(--muted);margin-top:4px">
                                    le {{ t.dateCloture|date('d/m/Y à H:i') }}
                                </div>
                                {% endif %}
                            {% else %}
                                <span class="status-pill status-en_cours" title="En cours de résolution">
                                    <span class="status-dot"></span>En cours
                                </span>
                            {% endif %}
                        </td>

                        {# Date transmission #}
                        <td data-label="Date de transmission" class="transmission-date-cell">
                            <i class="bi bi-calendar3 me-1 opacity-60"></i>
                            {{ t.transmisLe|date('d/m/Y') }}
                            <span style="font-size:10px;display:block;opacity:0.75">à {{ t.transmisLe|date('H:i') }}</span>
                        </td>

                        {# Transmis par #}
                        <td data-label="Transmis par" class="transmission-sender-cell">
                            <i class="bi bi-person me-1" style="color:var(--muted)"></i>
                            {{ t.manager ? t.manager.nomComplet : 'Manager' }}
                        </td>

                        {# ── Actions ────────────────────────────────────────────────── #}
                        <td data-label="Actions" class="transmission-action-cell">
                            <div class="transmission-row-actions">

                                {# Voir l'alerte #}
                                <a href="{{ path('app_alert_show', {token: encrypt_id(t.alert.id, 'alert')}) }}"
                                   class="tr-btn tr-btn-view"
                                   title="Consulter la fiche alerte">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                    <span class="tr-btn-label">Voir</span>
                                </a>

                                {% if not t.isCloture %}
                                {# Clôturer #}
                                <form method="post"
                                      action="{{ path('app_transmission_cloturer', {id: t.id}) }}"
                                      onsubmit="return confirm('Confirmez-vous la clôture du suivi de cette transmission ?');"
                                      class="tr-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cloturer-transmission-' ~ t.id) }}">
                                    <button type="submit"
                                            class="tr-btn tr-btn-close"
                                            title="Clôturer le suivi de cette transmission">
                                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                        <span class="tr-btn-label">Clôturer</span>
                                    </button>
                                </form>

                                {% else %}
                                {# Rouvrir #}
                                <form method="post"
                                      action="{{ path('app_transmission_rouvrir', {id: t.id}) }}"
                                      onsubmit="return confirm('Rouvrir cette transmission ? Elle repassera au statut « En cours ».');"
                                      class="tr-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('rouvrir-transmission-' ~ t.id) }}">
                                    <button type="submit"
                                            class="tr-btn tr-btn-reopen"
                                            title="Rouvrir le suivi de cette transmission">
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                        <span class="tr-btn-label">Rouvrir</span>
                                    </button>
                                </form>
                                {% endif %}

                            </div>
                        </td>
                        {# ── /Actions ────────────────────────────────────────────────── #}

                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% else %}
        {# État vide #}
        <div style="padding:48px 20px;text-align:center">
            <i class="bi bi-send-check" style="font-size:40px;color:var(--muted);display:block;margin-bottom:12px"></i>
            <p style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:6px">
                Aucune transmission enregistrée
            </p>
            <p style="font-size:12px;color:var(--muted);max-width:440px;margin:0 auto 20px;line-height:1.6">
                {% if current_filter %}
                    Aucune transmission ne correspond au filtre sélectionné.
                {% else %}
                    Les alertes validées peuvent être transmises aux autorités et partenaires par un Manager depuis leur fiche respective.
                {% endif %}
            </p>
            {% if current_filter %}
            <a href="{{ path('app_transmission_index') }}" class="db-btn db-btn-ghost">
                <i class="bi bi-arrow-clockwise me-1.5"></i>Afficher toutes les transmissions
            </a>
            {% else %}
            <a href="{{ path('app_alert_index') }}" class="db-btn db-btn-top-dashboard">
                <i class="bi bi-journal-text me-1.5"></i>Consulter le registre des alertes
            </a>
            {% endif %}
        </div>
        {% endif %}

    </div>{# /db-card #}
    </div>{# /data-controller #}

</div>

<style>
/* ════════════════════════════════════════════════════
   TABLE TRANSMISSIONS — Responsive complète
   Breakpoints :
     > 1200px  : table normale, labels visibles
     768–1200  : icônes seules dans la colonne Actions
     < 768px   : mise en carte (card layout)
     < 420px   : empilement total
════════════════════════════════════════════════════ */

/* ── Structure de la table ── */
.transmission-table {
    min-width: 900px;
    width: 100%;
    border-collapse: collapse;
}
.transmission-thead-row {
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.transmission-row {
    border-bottom: 1px solid var(--border);
    transition: background .15s ease;
}
.transmission-row:hover { background: var(--card2); }
.transmission-table td {
    padding: 13px 14px;
    vertical-align: middle;
    font-size: 12.5px;
}
.transmission-note-cell  { max-width: 260px; }
.transmission-date-cell,
.transmission-sender-cell { white-space: nowrap; }
.transmission-alert-resume {
    font-size: 11px;
    color: var(--muted);
    margin-top: 3px;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ── Cellule Actions ── */
.transmission-action-heading,
.transmission-action-cell {
    width: 1%;
    white-space: nowrap;
    text-align: right;
}
.transmission-action-cell { padding-right: 16px; }

/* ── Groupe d'actions ── */
.transmission-row-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: nowrap;
}
/* Le form ne prend pas de place dans le flux flex */
.tr-form {
    margin: 0;
    display: contents;
}

/* ── Boutons (style de base — desktop) ── */
.tr-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 34px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background .14s, border-color .14s, transform .12s, box-shadow .12s;
}
.tr-btn:focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 2px;
}

/* Voir */
.tr-btn-view {
    background: var(--card2);
    border-color: var(--border);
    color: var(--text);
}
.tr-btn-view:hover {
    border-color: var(--border2);
    background: var(--card);
}

/* Clôturer */
.tr-btn-close {
    background: #16856b;
    border-color: #16856b;
    color: #fff;
}
.tr-btn-close:hover {
    background: #0c6b56;
    border-color: #0c6b56;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(22,133,107,.3);
}
body.dark .tr-btn-close { color: #fff; }

/* Rouvrir */
.tr-btn-reopen {
    background: var(--card2);
    border-color: var(--border);
    color: var(--dim);
}
.tr-btn-reopen:hover {
    border-color: var(--amber);
    color: var(--amber);
    background: var(--card);
}

/* ── En-tête page ── */
.transmission-header-actions {
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}
.transmission-summary-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--card);
    font-size: 10px;
}
.transmission-summary-pill strong { color: var(--text); font-size: 14px; }
.transmission-summary-pill > span:last-child { color: var(--muted); }
.transmission-summary-pill .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #16856b; }
.transmission-summary-closed .status-dot { background: #64748b; }

/* ── Filtres ── */
.transmission-filter-bar  { justify-content: space-between; gap: 12px; }
.transmission-filter-links { flex-wrap: wrap; gap: 8px; }
.transmission-search { display: flex; align-items: center; gap: 8px; }
.transmission-search-input { position: relative; width: min(290px, 100%); }
.transmission-search-input input { width: 100%; min-height: 40px; }
.transmission-eyebrow-role { display: inline-flex; align-items: center; gap: 5px; }

/* ════════════════════
   Tablette (≤ 1200px)
   Actions : icônes seules, carré 36px
════════════════════ */
@media (max-width: 1200px) {
    .tr-btn-label { display: none; }
    .tr-btn {
        width: 36px;
        height: 36px;
        padding: 0;
        font-size: 14px;
        border-radius: 8px;
    }
    .transmission-action-cell { min-width: 100px; }
    .transmission-row-actions { gap: 5px; }
}

/* ── Filtres : passage colonne 1050px ── */
@media (max-width: 1050px) {
    .transmission-filter-bar { flex-direction: column; align-items: stretch; }
    .transmission-search { width: 100%; }
    .transmission-search-input { width: min(360px, 100%); }
}

/* ════════════════════
   Mobile (≤ 768px)
   Mise en carte card-layout
════════════════════ */
@media (max-width: 768px) {
    .transmission-header-actions { width: 100%; justify-content: flex-start; }
    .transmission-table-wrap { overflow: visible; }

    /* Transformer table → cartes */
    .transmission-table     { display: block; min-width: 0; }
    .transmission-table thead {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0,0,0,0);
        white-space: nowrap; border: 0;
    }
    .transmission-table tbody { display: grid; gap: 12px; }
    .transmission-table tbody tr.transmission-row {
        display: block;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--card);
        box-shadow: 0 4px 14px rgba(15,23,42,.06);
        overflow: hidden;
    }

    /* Chaque cellule = ligne label + valeur */
    .transmission-table td {
        display: grid;
        grid-template-columns: minmax(90px, 28%) 1fr;
        align-items: start;
        gap: 8px;
        width: 100%;
        max-width: none;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
        white-space: normal;
        overflow-wrap: anywhere;
    }
    .transmission-table td::before {
        content: attr(data-label);
        color: var(--muted);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding-top: 2px;
    }
    .transmission-table td:first-child { padding-top: 14px; }
    .transmission-note-cell  { max-width: none; }
    .transmission-date-cell,
    .transmission-sender-cell { white-space: normal; }
    .transmission-alert-resume { max-width: none; white-space: normal; }

    /* Cellule Actions : bloc plein largeur sans label */
    .transmission-action-cell {
        display: block;
        border-bottom: none;
        padding: 10px 14px 14px;
        white-space: normal;
        width: auto;
        text-align: left;
    }
    .transmission-action-cell::before { display: none; }

    /* Réafficher le label texte sur les boutons */
    .tr-btn-label { display: inline; }

    /* Boutons : pleine largeur, hauteur généreuse */
    .transmission-row-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: stretch;
        gap: 8px;
        width: 100%;
    }
    .tr-form { display: block; flex: 1 1 calc(50% - 4px); min-width: 0; }
    .tr-btn {
        width: 100%;
        height: 44px;
        padding: 0 12px;
        font-size: 12.5px;
        border-radius: 9px;
        justify-content: center;
    }
    .tr-btn-view { flex: 1 1 calc(50% - 4px); }
}

/* ════════════════════
   Très petits écrans (≤ 420px)
   Empilement vertical
════════════════════ */
@media (max-width: 420px) {
    .transmission-table td { grid-template-columns: 1fr; gap: 4px; }
    .transmission-row-actions { flex-direction: column; }
    .tr-form,
    .tr-btn-view { flex: 1 1 auto; width: 100%; }
    .tr-btn { height: 48px; font-size: 13px; }
    .transmission-search { flex-direction: column; align-items: stretch; }
    .transmission-search-input { width: 100%; }
}
</style>

{% endblock %}
