{% extends 'base.html.twig' %}

{% block title %}Transmission — {{ alert.codeGei }}{% endblock %}
{% block header_title %}Décision de Transmission{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête ── #}
    <div class="page-header-row">
        <div>
            <p class="page-eyebrow">
                <i class="fa-solid fa-paper-plane me-1.5"></i>Transmission institutionnelle
            </p>
            <h2 class="page-title">Transmettre {{ alert.codeGei }}</h2>
            <p class="page-subtitle">Transmettre l'information qualifiée aux autorités compétentes.</p>
        </div>
        <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="db-btn db-btn-ghost">
            <i class="fa-solid fa-arrow-left me-1.5"></i>Retour à la fiche
        </a>
    </div>

    <div class="transmission-layout">

        {# ── Formulaire ── #}
        <div class="form-section">
            <div class="form-section-header">
                <div class="form-section-num form-section-num-amber">
                    <i class="fa-solid fa-paper-plane fa-xs"></i>
                </div>
                <div>
                    <p class="form-section-title">Décision de transmission</p>
                    <p class="form-section-sub">Renseignez le destinataire et la note d'accompagnement.</p>
                </div>
            </div>

            {{ form_start(form, {'attr': {'class': 'transmission-form', 'id': 'transmissionForm'}}) }}

                <div class="form-field mb-3">
                    {{ form_label(form.destinataire, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.destinataire, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.destinataire) }}
                </div>

                <div class="form-field mb-3">
                    {{ form_label(form.noteTransmission, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.noteTransmission, {'attr': {
                        'class': 'form-textarea',
                        'rows': 5,
                        'placeholder': 'Note d\'accompagnement, contexte, instructions particulières…'
                    }}) }}
                    {{ form_errors(form.noteTransmission) }}
                </div>

                <div class="form-actions" style="margin-bottom:0; border-radius: 0 0 var(--r) var(--r);">
                    <a href="{{ path('app_alert_show', {id: alert.id}) }}" class="db-btn db-btn-ghost">
                        <i class="fa-solid fa-ban me-1.5"></i>Annuler
                    </a>
                    <button type="submit" class="db-btn db-btn-amber">
                        <i class="fa-solid fa-paper-plane me-1.5"></i>Confirmer la Transmission
                    </button>
                </div>

            {{ form_end(form) }}
        </div>

        {# ── Récapitulatif alerte ── #}
        <div class="transmission-recap">
            <div class="form-section">
                <p class="db-card-eyebrow mb-3">
                    <i class="fa-solid fa-file-shield me-1.5"></i>Alerte transmise
                </p>
                <div class="qualify-recap-grid">
                    <span class="qualify-recap-label">Code GEI</span>
                    <span class="qualify-recap-val" style="color:var(--amber)">{{ alert.codeGei }}</span>

                    <span class="qualify-recap-label">Zone / Pays</span>
                    <span class="qualify-recap-text">{{ alert.market.nom }}</span>

                    <span class="qualify-recap-label">Catégorie</span>
                    <span class="qualify-recap-text">{{ alert.categorie ? alert.categorie.label : '—' }}</span>

                    <span class="qualify-recap-label">Score GEI</span>
                    <span class="qualify-recap-val">{{ alert.effectiveScore ?? '—' }} / 25</span>

                    <span class="qualify-recap-label">Priorité</span>
                    <span>
                        {% if alert.effectiveNiveauPriorite %}
                            <span class="priority-badge priority-{{ alert.effectiveNiveauPriorite.value }}">
                                {{ alert.effectiveNiveauPriorite.label }}
                            </span>
                        {% else %}—{% endif %}
                    </span>

                    <span class="qualify-recap-label">Résumé</span>
                    <span class="qualify-recap-text">{{ alert.resumeExecutif|slice(0,140) }}{% if alert.resumeExecutif|length > 140 %}…{% endif %}</span>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
.transmission-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 20px;
    align-items: start;
}
@media(max-width:900px) {
    .transmission-layout { grid-template-columns: 1fr; }
    .transmission-recap  { order: -1; }
}
.transmission-form { display: flex; flex-direction: column; }
</style>
{% endblock %}
