<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Plateforme GEI — Renseignement Opérationnel{% endblock %}</title>
    <meta name="description" content="Plateforme GEI de renseignement opérationnel, suivi des alertes et tableaux de bord stratégiques.">
    <meta name="csrf-token" content="{{ csrf_token('app') }}">
    <meta name="push-csrf-token" content="{{ csrf_token('push_subscription') }}">
    <meta name="turbo-cache-control" content="no-cache">
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('icons/gei-180.png') }}">
    <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
    <meta name="theme-color" content="#123f35">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    {# ── Google Fonts — Inter ── #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    {# ══ Bootstrap Icons 1.11 ══ #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {# ── Chart.js ── #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    {# ── CSS principal — chargé EN DERNIER pour avoir la priorité maximale ── #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body{% block body_attributes %} data-turbo-cache="false"{% endblock %}>

{% set is2faPage = app.request.attributes.get('_route') starts with '2fa' %}

{% if app.user and not is2faPage %}
    <div class="gei-shell">
        {# Sidebar #}
        {% include 'partials/_sidebar.html.twig' %}

        {# Zone principale #}
        <div class="gei-main">
            {# Topbar #}
            {% include 'partials/_navbar.html.twig' %}

            {# Contenu #}
            <main class="gei-content">

                {# Flash messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-msg flash-{{ label }}">
                            <div class="flash-inner">
                                {% if label == 'success' %}
                                    <i class="bi bi-check-circle flash-icon"></i>
                                {% elseif label == 'danger' or label == 'error' %}
                                    <i class="bi bi-x-circle flash-icon"></i>
                                {% elseif label == 'warning' %}
                                    <i class="bi bi-exclamation-triangle flash-icon"></i>
                                {% else %}
                                    <i class="bi bi-info-circle flash-icon"></i>
                                {% endif %}
                                <span>{{ message }}</span>
                            </div>
                            <button onclick="this.parentElement.remove()" class="flash-close">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

{% else %}
    {# Pas connecté OU page 2FA (token partiel) → layout auth #}
    <main class="auth-main">
        {% block body_login %}{% endblock %}
    </main>
{% endif %}

{# ── Modale de confirmation ── #}
<div id="confirmModal" class="modal-backdrop hidden">
    <div class="modal-box">
        <div class="modal-header">
            <div>
                <p class="modal-eyebrow"><i class="bi bi-exclamation-triangle me-1.5"></i>Confirmation requise</p>
                <h3 class="modal-title">Confirmer la suppression ?</h3>
            </div>
            <button class="modal-close-btn modal-close"><i class="bi bi-x"></i></button>
        </div>
        <p class="modal-body-text">Cette action est irréversible. L'élément sera définitivement supprimé.</p>
        <form id="deleteConfirmForm" method="post" class="modal-actions">
            <input type="hidden" name="_token" id="deleteTokenInput" value="">
            <button type="button" class="btn-secondary modal-close">
                                <i class="bi bi-ban me-1.5"></i>Annuler
            </button>
            <button type="submit" class="btn-danger">
                                <i class="bi bi-trash me-1.5"></i>Supprimer
            </button>
        </form>
    </div>
</div>

{{ importmap('app') }}

{# ── Turbo Drive est désactivé dans app.js via Turbo.session.drive = false ── #}
{# Le meta tag ci-dessus prévient le cache. L'inclusion d'app.js désactive Drive avant toute navigation. ── #}

{# ── Scripts globaux ── #}
<script>
/* ─── Sous-menus sidebar dépliables ─── */
function toggleSubmenu(id) {
    const menu  = document.getElementById(id);
    const arrow = document.getElementById('arrow-' + id.replace('submenu-', ''));
    if (!menu) return;
    const isHidden = menu.classList.contains('hidden');
    menu.classList.toggle('hidden', !isHidden);
    if (arrow) arrow.classList.toggle('rotated', isHidden);
    document.querySelector(`[aria-controls="${id}"]`)?.setAttribute('aria-expanded', String(isHidden));
    localStorage.setItem('menu-' + id + '-open', isHidden ? '1' : '0');
}

// Restore submenu states on load
document.addEventListener('DOMContentLoaded', () => {
    ['submenu-alertes', 'submenu-statistiques', 'submenu-admin', 'submenu-espace'].forEach(id => {
        const menu = document.getElementById(id);
        const arrow = document.getElementById('arrow-' + id.replace('submenu-', ''));
        const trigger = document.querySelector(`[aria-controls="${id}"]`);
        if (menu) {
            const isOpen = localStorage.getItem('menu-' + id + '-open');
            const open = Boolean(trigger?.classList.contains('active')) || isOpen === '1';
            menu.classList.toggle('hidden', !open);
            if (arrow) arrow.classList.toggle('rotated', open);
            trigger?.setAttribute('aria-expanded', String(open));
        }
    });

    const shell = document.querySelector('.gei-shell');
    const collapseButton = document.getElementById('sidebarCollapseBtn');
    if (shell && collapseButton) syncSidebarCollapseMode();
    document.querySelectorAll('#gei-sidebar .sidebar-link, #gei-sidebar .sidebar-sublink').forEach(link => {
        if (!link.title) link.title = link.textContent.trim();
    });
});

/* ─── Sidebar toggle ─── */
function toggleSidebar() {
    const shell = document.querySelector('.gei-shell');
    const overlay = document.getElementById('sidebarOverlay');
    if (!shell || !overlay) return;
    const open = !shell.classList.contains('sidebar-collapsed');
    shell.classList.toggle('sidebar-collapsed', open);
    overlay.classList.toggle('hidden', !open);
    const button = document.getElementById('sidebarToggleBtn');
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    syncSidebarCollapseMode();
}
function closeSidebar() {
    document.querySelector('.gei-shell')?.classList.remove('sidebar-collapsed');
    document.getElementById('sidebarOverlay')?.classList.add('hidden');
    const button = document.getElementById('sidebarToggleBtn');
    button?.setAttribute('aria-expanded', 'false');
    button?.setAttribute('aria-label', 'Ouvrir le menu');
    syncSidebarCollapseMode();
}
function setSidebarMini(collapsed) {
    const shell = document.querySelector('.gei-shell');
    const button = document.getElementById('sidebarCollapseBtn');
    const icon = button?.querySelector('i');
    if (!shell || !button || !icon) return;
    shell.classList.toggle('sidebar-mini', collapsed);
    icon.classList.toggle('bi-chevron-left', !collapsed);
    icon.classList.toggle('bi-chevron-right', collapsed);
    button.setAttribute('aria-expanded', String(!collapsed));
    button.setAttribute('aria-label', collapsed ? 'Développer le menu' : 'Réduire le menu');
    button.title = collapsed ? 'Développer le menu' : 'Réduire le menu';
    localStorage.setItem('sidebar-mini', collapsed ? '1' : '0');
}
function syncSidebarCollapseMode() {
    const shell = document.querySelector('.gei-shell');
    const button = document.getElementById('sidebarCollapseBtn');
    const icon = button?.querySelector('i');
    if (!shell || !button || !icon) return;

    if (window.matchMedia('(max-width: 1024px)').matches) {
        shell.classList.remove('sidebar-mini');
        const drawerOpen = shell.classList.contains('sidebar-collapsed');
        icon.classList.toggle('bi-chevron-left', drawerOpen);
        icon.classList.toggle('bi-chevron-right', !drawerOpen);
        button.setAttribute('aria-expanded', String(drawerOpen));
        button.setAttribute('aria-label', drawerOpen ? 'Fermer le menu' : 'Ouvrir le menu');
        button.title = drawerOpen ? 'Fermer le menu' : 'Ouvrir le menu';
        return;
    }

    setSidebarMini(localStorage.getItem('sidebar-mini') === '1');
}
function handleSidebarHeaderAction() {
    if (window.matchMedia('(max-width: 1024px)').matches) {
        closeSidebar();
        return;
    }
    setSidebarMini(!document.querySelector('.gei-shell')?.classList.contains('sidebar-mini'));
}
document.getElementById('sidebarCollapseBtn')?.addEventListener('click', handleSidebarHeaderAction);
window.addEventListener('resize', syncSidebarCollapseMode);

/* ─── Polling notifications (toutes les 30s — badge sans rechargement) ─── */
let notifPollInterval;
let _seenNotifIds = new Set();
let _notifInitialized = false;
async function pollNotifications() {
    try {
        const r = await fetch('/api/notifications/count', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (r.status === 401 || r.redirected || !r.headers.get('content-type')?.includes('application/json')) {
            clearInterval(notifPollInterval);
            if (r.status === 401) {
                window.location.href = '/login';
            }
            return;
        }
        if (!r.ok) {
            console.error(`Le chargement des notifications a échoué (HTTP ${r.status}).`);
            return;
        }
        const data = await r.json();

        // Badge topbar
        const badge = document.getElementById('topbarNotifBadge');
        if (badge) {
            if (data.count > 0) {
                badge.textContent = data.count > 99 ? '99+' : data.count;
                badge.style.display = 'grid';
            } else {
                badge.style.display = 'none';
            }
        }

        // Badge sidebar
        const sidebarBadge = document.getElementById('sidebarNotifBadge');
        if (sidebarBadge) {
            sidebarBadge.textContent = data.count > 0 ? data.count : '0';
        }

        // Marquer les notifications existantes comme vues (pas de toast)
        if (!_notifInitialized && data.notifications) {
            data.notifications.forEach(n => _seenNotifIds.add(n.id));
            _notifInitialized = true;
        }

        // Toasts pour nouvelles notifications
        if (data.notifications && data.notifications.length > 0) {
            data.notifications.forEach(n => {
                if (!_seenNotifIds.has(n.id)) {
                    _seenNotifIds.add(n.id);
                    showToast(n.contenu, n.type, n.alertToken || n.alertId);
                }
            });
        }

        // Mettre à jour la liste sidebar
        const sidebarList = document.getElementById('sidebarNotifList');
        if (sidebarList && data.notifications && data.notifications.length > 0) {
            sidebarList.innerHTML = data.notifications.slice(0, 2).map(n => {
                const dot = n.type === 'urgence' ? 'notif-dot-red' : 'notif-dot-amber';
                const text = n.contenu ? n.contenu.replace(/<[^>]*>/g, '').slice(0, 45) + '…' : '';
                return `<div class="sidebar-notif-item">
                    <span class="notif-dot ${dot}"></span>
                    <span>${escapeHtml(text)}</span>
                </div>`;
            }).join('');
        } else if (sidebarList) {
            sidebarList.innerHTML = '<div class="sidebar-notif-item"><span class="text-slate-500 text-xs">Aucune notification</span></div>';
        }

        // Mettre à jour le panel dropdown topbar
        if (Array.isArray(data.notifications)) {
            const list = document.querySelector('#notifPanel .notif-list');
            if (list && data.notifications.length > 0) {
                list.innerHTML = data.notifications.map(n => {
                    const is72h = n.type === 'sla_proche' || n.urgence === '72h';
                    const isUrgent = Number(n.priorite) > 0 || n.type === 'urgence' || n.type === 'escalade';
                    const iconClass = is72h ? 'notif-icon-amber' : isUrgent ? 'notif-icon-red' : n.type === 'tache' ? 'notif-icon-amber' : 'notif-icon-emerald';
                    const icon = is72h ? 'bi-clock-history' : isUrgent ? 'bi-exclamation-triangle' : n.type === 'tache' ? 'bi-clipboard-check' : n.type === 'escalade' ? 'bi-arrow-up-right-square' : n.type === 'validation' ? 'bi-check-circle' : n.type === 'statut_change' ? 'bi-arrow-clockwise' : 'bi-info-circle';
                    const category = is72h ? 'Urgence 72 h' : isUrgent ? 'Prioritaire' : 'Information';
                    const href = `/notification/${encodeURIComponent(n.id)}/read`;
                    return `<a href="${href}" class="notif-item ${n.lu ? '' : 'notif-unread'} ${isUrgent ? 'notif-item-urgent' : ''} ${is72h ? 'notif-item-72h' : ''}">
                        <span class="notif-icon-wrap ${iconClass}"><i class="bi ${icon}"></i></span>
                        <div class="notif-body">
                            <span class="notif-category">${category}</span>
                            <p class="notif-title">${escapeHtml(n.contenu ? n.contenu.replace(/<[^>]*>/g, '').slice(0, 70) : '—')}</p>
                            <span class="notif-meta">${n.codeGei ? escapeHtml(n.codeGei) + ' · ' : ''}${escapeHtml(n.date)}</span>
                        </div>
                    </a>`;
                }).join('');
            } else if (list) {
                list.innerHTML = '<p class="notif-empty">Vous êtes à jour. Aucune nouvelle notification.</p>';
            }
        }
    } catch (error) {
        console.error('Impossible de récupérer les notifications.', error);
    }
}

async function initializeRealtimeNotifications() {
    try {
        const response = await fetch('/api/ably/config', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });
        if (!response.ok) {
            throw new Error(`Configuration Ably indisponible (HTTP ${response.status}).`);
        }

        const config = await response.json();
        if (!config.enabled || !config.channel) return;

        await new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = 'https://cdn.ably.com/lib/ably.min-2.js';
            script.async = true;
            script.onload = resolve;
            script.onerror = () => reject(new Error('Le SDK Ably n’a pas pu être chargé.'));
            document.head.appendChild(script);
        });

        const realtime = new window.Ably.Realtime({
            authUrl: '/api/ably/auth',
            authMethod: 'GET',
        });
        realtime.channels.get(config.channel).subscribe('notification.created', () => {
            pollNotifications();
        });
        realtime.connection.on('failed', state => {
            console.error('La connexion Ably aux notifications a échoué.', state.reason);
        });
        window.addEventListener('pagehide', () => realtime.close(), { once: true });
    } catch (error) {
        console.error('Impossible d’initialiser les notifications temps réel Ably; le polling reste actif.', error);
    }
}

function showToast(contenu, type, alertRef) {
    const container = document.getElementById('toastContainer');
    if (!container) return;

    const is72h = type === 'sla_proche';
    const toast = document.createElement('div');
    toast.className = `gei-toast toast-${type || 'info'}`;
    const icon = is72h ? 'bi-clock-history' : type === 'urgence' ? 'bi-exclamation-triangle' : type === 'tache' ? 'bi-clipboard-check' : type === 'escalade' ? 'bi-arrow-up-right-square' : type === 'validation' ? 'bi-check-circle' : type === 'statut_change' ? 'bi-arrow-clockwise' : 'bi-info-circle';
    const href = alertRef ? `/alert/${encodeURIComponent(alertRef)}` : '/notifications';
    toast.innerHTML = `
        <a href="${href}" class="gei-toast-link">
            <span class="gei-toast-icon"><i class="bi ${icon}"></i></span>
            <span class="gei-toast-text">${is72h ? '<strong class="gei-toast-category">Urgence 72 h · </strong>' : ''}${escapeHtml(contenu)}</span>
        </a>
        <button class="gei-toast-close" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
    `;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 6000);
}

function escapeHtml(value) {
    const element = document.createElement('span');
    element.textContent = value;
    return element.innerHTML;
}

// Premier appel immédiat + polling toutes les 30s
document.addEventListener('DOMContentLoaded', () => {
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker.js', { scope: '/' }).catch(error => {
            console.error('Impossible d’enregistrer le service worker GEI.', error);
        });
    }
    pollNotifications();
    notifPollInterval = setInterval(pollNotifications, 30000);
    initializeRealtimeNotifications();
    initializePushNotifications();
});

async function initializePushNotifications() {
    const button = document.getElementById('pushNotificationButton');
    const status = document.getElementById('pushNotificationStatus');
    if (!button || !status) return;

    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
        status.textContent = 'Les notifications push ne sont pas prises en charge par ce navigateur.';
        return;
    }

    try {
        const response = await fetch('/api/push/config', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (!response.ok) throw new Error(`Configuration Push indisponible (HTTP ${response.status}).`);
        const config = await response.json();
        if (!config.enabled || !config.publicKey) {
            status.textContent = 'Les clés Web Push doivent être configurées par l’administrateur.';
            return;
        }

        const registration = await navigator.serviceWorker.register('/service-worker.js');
        const subscription = await registration.pushManager.getSubscription();
        const isAppleMobile = /iPhone|iPad|iPod/.test(navigator.userAgent)
            || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const isInstalledApp = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
        if (isAppleMobile && !isInstalledApp) {
            status.textContent = 'Sur iPhone/iPad, ajoutez d’abord la plateforme à l’écran d’accueil depuis Safari.';
            return;
        }
        button.disabled = false;
        button.textContent = subscription ? 'Désactiver' : 'Activer';
        status.textContent = subscription
            ? 'Cet appareil recevra les notifications, même lorsque la page est fermée.'
            : Notification.permission === 'denied'
                ? 'Autorisation bloquée dans les réglages du navigateur.'
                : 'Activez les notifications sur cet appareil.';

        button.addEventListener('click', async () => {
            button.disabled = true;
            try {
                const current = await registration.pushManager.getSubscription();
                if (current) {
                    const removed = await fetch('/api/push/subscriptions/remove', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': pushCsrfToken() },
                        body: JSON.stringify({ endpoint: current.endpoint }),
                    });
                    if (!removed.ok) throw new Error(await responseError(removed));
                    await current.unsubscribe();
                    button.textContent = 'Activer';
                    status.textContent = 'Notifications désactivées sur cet appareil.';
                    return;
                }

                const permission = await Notification.requestPermission();
                if (permission !== 'granted') {
                    status.textContent = 'Autorisation non accordée. Vous pouvez la modifier dans les réglages du navigateur.';
                    return;
                }

                const created = await registration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey: decodeVapidKey(config.publicKey),
                });
                const saved = await fetch('/api/push/subscriptions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': pushCsrfToken() },
                    body: JSON.stringify(created.toJSON()),
                });
                if (!saved.ok) {
                    await created.unsubscribe();
                    throw new Error(await responseError(saved));
                }
                button.textContent = 'Désactiver';
                status.textContent = 'Cet appareil recevra les notifications, même lorsque la page est fermée.';
                showToast('Notifications activées sur cet appareil.', 'success');
            } catch (error) {
                console.error('Impossible de modifier les notifications sur cet appareil.', error);
                status.textContent = error.message || 'Échec de la configuration des notifications.';
            } finally {
                button.disabled = false;
            }
        });
    } catch (error) {
        console.error('Impossible d’initialiser les notifications Web Push.', error);
        status.textContent = 'Impossible de vérifier la configuration des notifications.';
    }
}

function pushCsrfToken() {
    return document.querySelector('meta[name="push-csrf-token"]')?.content || '';
}

function decodeVapidKey(value) {
    const padding = '='.repeat((4 - value.length % 4) % 4);
    const base64 = (value + padding).replace(/-/g, '+').replace(/_/g, '/');
    return Uint8Array.from(atob(base64), character => character.charCodeAt(0));
}

async function responseError(response) {
    const data = await response.json().catch(() => ({}));
    return data.error || `La requête a échoué (HTTP ${response.status}).`;
}

function toggleNotifPanel() {
    const panel = document.getElementById('notifPanel');
    const button = document.getElementById('notifBtn');
    if (!panel || !button) return;
    const open = panel.classList.contains('hidden');
    panel.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    window._notifPanelOpen = open;
    if (open) pollNotifications();
}
function closeNotifPanel() {
    const panel = document.getElementById('notifPanel');
    if (panel && !panel.classList.contains('hidden')) {
        panel.classList.add('hidden');
        window._notifPanelOpen = false;
        document.getElementById('notifBtn')?.setAttribute('aria-expanded', 'false');
    }
}
function toggleProfileMenu() {
    const menu = document.getElementById('profileMenu');
    const button = document.getElementById('userMenuBtn');
    if (!menu || !button) return;
    const open = menu.classList.contains('hidden');
    menu.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
}
function closeProfileMenu() {
    document.getElementById('profileMenu')?.classList.add('hidden');
    document.getElementById('userMenuBtn')?.setAttribute('aria-expanded', 'false');
}
document.getElementById('userMenuBtn')?.addEventListener('click', toggleProfileMenu);
document.getElementById('userMenuBtn')?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (document.getElementById('profileMenu')?.classList.contains('hidden')) toggleProfileMenu();
        document.querySelector('#profileMenu a, #profileMenu button')?.focus();
    }
});
document.getElementById('profileMenu')?.addEventListener('keydown', (event) => {
    if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
    const items = [...document.querySelectorAll('#profileMenu a[href], #profileMenu button:not([disabled])')];
    if (!items.length) return;
    event.preventDefault();
    const currentIndex = items.indexOf(document.activeElement);
    const nextIndex = event.key === 'Home' ? 0
        : event.key === 'End' ? items.length - 1
        : (currentIndex + (event.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
    items[nextIndex].focus();
});
document.addEventListener('click', (e) => {
    const wrap = document.getElementById('notifDropdownWrap');
    if (wrap && !wrap.contains(e.target)) {
        closeNotifPanel();
    }
    const profileWrap = document.getElementById('profileMenuWrap');
    if (profileWrap && !profileWrap.contains(e.target)) closeProfileMenu();
});
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        const profileWasOpen = !document.getElementById('profileMenu')?.classList.contains('hidden');
        closeNotifPanel();
        closeProfileMenu();
        closeSidebar();
        if (profileWasOpen) document.getElementById('userMenuBtn')?.focus();
    }
});

/* ─── Dark / Night mode ─── */
(function() {
    if (localStorage.getItem('gei-dark') === '1') {
        document.documentElement.classList.add('dark');
        document.body.classList.add('dark');
    }
})();
document.addEventListener('DOMContentLoaded', function() {
    const btn  = document.getElementById('darkModeBtn');
    const icon = document.getElementById('darkModeIcon');
    if (!btn) return;
    function applyDark(on) {
        document.documentElement.classList.toggle('dark', on);
        document.body.classList.toggle('dark', on);
        if (icon) {
            icon.className = on ? 'bi bi-sun' : 'bi bi-moon';
        }
        localStorage.setItem('gei-dark', on ? '1' : '0');
        // Notifier les autres composants (ex: carte Leaflet, Chart.js)
        document.dispatchEvent(new CustomEvent('dark-mode-changed', { detail: { dark: on } }));
    }
    // Init icon on page load
    const isDark = document.body.classList.contains('dark') || document.documentElement.classList.contains('dark');
    if (icon) icon.className = isDark ? 'bi bi-sun' : 'bi bi-moon';
    btn.addEventListener('click', function() {
        const currentlyDark = document.body.classList.contains('dark') || document.documentElement.classList.contains('dark');
        applyDark(!currentlyDark);
    });
});

/* ─── Modale confirm (générale) ─── */
document.querySelectorAll('.modal-close').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('confirmModal').classList.add('hidden');
    });
});

/* ─── Modale de rejet (spécifique à la qualification) ─── */
document.addEventListener('DOMContentLoaded', () => {
    const rejectBtns = document.querySelectorAll('.action-rejet');
    const rejectModal = document.getElementById('rejectModal');
    const rejectCommentaire = document.getElementById('rejectCommentaire');
    const rejectForm = document.getElementById('rejectForm');
    const rejectTokenInput = document.getElementById('rejectTokenInput');

    // Initialiser le token CSRF
    if (rejectTokenInput) {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (csrfToken) rejectTokenInput.value = csrfToken;
    }

    rejectBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const alertToken = btn.getAttribute('data-alert-token') || btn.getAttribute('data-alert-id');
            if (rejectForm) {
                rejectForm.action = `/alert/${encodeURIComponent(alertToken)}/qualify`;
            }
            if (rejectModal) rejectModal.classList.remove('hidden');
            if (rejectCommentaire) rejectCommentaire.focus();
        });
    });

    // Fermer le modal au clic sur le boutonAnnuler ou overlay
    document.querySelectorAll('[data-modal="rejectModal"]').forEach(btn => {
        btn.addEventListener('click', () => {
            if (rejectModal) rejectModal.classList.add('hidden');
        });
    });

    // Soumission du rejet
    if (rejectForm) {
        rejectForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const commentaire = rejectCommentaire?.value?.trim();
            if (!commentaire) {
                alert('Un commentaire est obligatoire pour rejeter la fiche.');
                return;
            }

            const formData = new FormData(rejectForm);
            formData.append('action_rejet', '1');
            formData.append('commentaire_rejet', commentaire);

            fetch(rejectForm.action, {
                method: 'POST',
                body: formData,
            }).then(r => r.ok ? window.location.href = '/alert' : null);
        });
    }
});
</script>

