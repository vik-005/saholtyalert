<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Plateforme GEI — Renseignement Opérationnel{% endblock %}</title>
    <meta name="description" content="Plateforme GEI de renseignement opérationnel, suivi des alertes et tableaux de bord stratégiques.">
    <meta name="csrf-token" content="{{ csrf_token('app') }}">
    <meta name="turbo-cache-control" content="no-cache">
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">

    {# ── Google Fonts — Inter ── #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    {# ── Tailwind CDN — chargé AVANT les icônes pour éviter que preflight écrase les classes bi-* ── #}
    <script>
        window.tailwind = window.tailwind || {};
        tailwind.config = {
            corePlugins: { preflight: false },
            theme: {
                extend: {
                    colors: {
                        navy: {
                            '50': '#f0f4f9', '100': '#dfe7f1', '200': '#bfd3e3',
                            '300': '#9fbace', '400': '#6e8fb3', '500': '#4a6fa5',
                            '600': '#38568e', '700': '#2d4575', '800': '#1f3a61',
                            '900': '#0f1729', '950': '#090e1a',
                        },
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                }
            }
        };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>

    {# ══ Bootstrap Icons 1.11 — chargé APRÈS Tailwind pour éviter le reset ══ #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {# ── Font Awesome 6 Free — chargé APRÈS Tailwind ── #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer">

    {# ── Chart.js ── #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    {# ── CSS principal — chargé EN DERNIER pour avoir la priorité maximale ── #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body{% block body_attributes %} data-turbo-cache="false"{% endblock %}>

{% if app.user %}
    <div class="gei-shell">
        {# Sidebar #}
        {% include 'partials/_sidebar.html.twig' %}

        {# Zone principale #}
        <div class="gei-main">
            {# Topbar #}
            {% include 'partials/_navbar.html.twig' %}

            {# Contenu #}
            <main class="gei-content">

                {# Flash messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-msg flash-{{ label }}">
                            <div class="flash-inner">
                                {% if label == 'success' %}
                                    <i class="bi bi-check-circle flash-icon"></i>
                                {% elseif label == 'danger' or label == 'error' %}
                                    <i class="bi bi-x-circle flash-icon"></i>
                                {% elseif label == 'warning' %}
                                    <i class="bi bi-exclamation-triangle flash-icon"></i>
                                {% else %}
                                    <i class="bi bi-info-circle flash-icon"></i>
                                {% endif %}
                                <span>{{ message }}</span>
                            </div>
                            <button onclick="this.parentElement.remove()" class="flash-close">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

{% else %}
    <main class="auth-main">
        {% block body_login %}{% endblock %}
    </main>
{% endif %}

{# ── Modale de confirmation ── #}
<div id="confirmModal" class="modal-backdrop hidden">
    <div class="modal-box">
        <div class="modal-header">
            <div>
                <p class="modal-eyebrow"><i class="bi bi-exclamation-triangle me-1.5"></i>Confirmation requise</p>
                <h3 class="modal-title">Confirmer la suppression ?</h3>
            </div>
            <button class="modal-close-btn modal-close"><i class="bi bi-x"></i></button>
        </div>
        <p class="modal-body-text">Cette action est irréversible. L'élément sera définitivement supprimé.</p>
        <form id="deleteConfirmForm" method="post" class="modal-actions">
            <input type="hidden" name="_token" id="deleteTokenInput" value="">
            <button type="button" class="btn-secondary modal-close">
                                <i class="bi bi-ban me-1.5"></i>Annuler
            </button>
            <button type="submit" class="btn-danger">
                                <i class="bi bi-trash me-1.5"></i>Supprimer
            </button>
        </form>
    </div>
</div>

{{ importmap('app') }}

{# ── Turbo Drive est désactivé dans app.js via Turbo.session.drive = false ── #}
{# Le meta tag ci-dessus prévient le cache. L'inclusion d'app.js désactive Drive avant toute navigation. ── #}

{# ── Scripts globaux ── #}
<script>
/* ─── Sous-menus sidebar dépliables ─── */
function toggleSubmenu(id) {
    const menu  = document.getElementById(id);
    const arrow = document.getElementById('arrow-' + id.replace('submenu-', ''));
    if (!menu) return;
    const isHidden = menu.classList.contains('hidden');
    menu.classList.toggle('hidden', !isHidden);
    if (arrow) arrow.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
    localStorage.setItem('menu-' + id + '-open', isHidden ? '1' : '0');
}

// Restore submenu states on load
document.addEventListener('DOMContentLoaded', () => {
    ['submenu-alertes', 'submenu-statistiques', 'submenu-admin', 'submenu-espace'].forEach(id => {
        const menu = document.getElementById(id);
        const arrow = document.getElementById('arrow-' + id.replace('submenu-', ''));
        if (menu) {
            const isOpen = localStorage.getItem('menu-' + id + '-open');
            if (isOpen !== null) {
                const open = isOpen === '1';
                menu.classList.toggle('hidden', !open);
                if (arrow) arrow.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        }
    });
});

/* ─── Sidebar toggle ─── */
function toggleSidebar() {
    const shell = document.querySelector('.gei-shell');
    const overlay = document.getElementById('sidebarOverlay');
    shell.classList.toggle('sidebar-collapsed');
    overlay.classList.toggle('hidden');
}
function closeSidebar() {
    document.querySelector('.gei-shell').classList.remove('sidebar-collapsed');
    document.getElementById('sidebarOverlay').classList.add('hidden');
}
document.getElementById('sidebarCollapseBtn')?.addEventListener('click', () => {
    document.querySelector('.gei-shell').classList.toggle('sidebar-mini');
    const btn = document.getElementById('sidebarCollapseBtn');
    const icon = btn.querySelector('i');
    icon.classList.toggle('bi-chevron-double-left');
    icon.classList.toggle('bi-chevron-double-right');
});

/* ─── Polling notifications (toutes les 30s — badge sans rechargement) ─── */
let notifPollInterval;
let _seenNotifIds = new Set();
let _notifInitialized = false;
async function pollNotifications() {
    try {
        const r = await fetch('/api/notifications/count', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!r.ok) return;
        const data = await r.json();

        // Badge topbar
        const badge = document.getElementById('topbarNotifBadge');
        if (badge) {
            if (data.count > 0) {
                badge.textContent = data.count > 99 ? '99+' : data.count;
                badge.style.display = 'grid';
            } else {
                badge.style.display = 'none';
            }
        }

        // Badge sidebar
        const sidebarBadge = document.getElementById('sidebarNotifBadge');
        if (sidebarBadge) {
            sidebarBadge.textContent = data.count > 0 ? data.count : '0';
        }

        // Marquer les notifications existantes comme vues (pas de toast)
        if (!_notifInitialized && data.notifications) {
            data.notifications.forEach(n => _seenNotifIds.add(n.id));
            _notifInitialized = true;
        }

        // Toasts pour nouvelles notifications
        if (data.notifications && data.notifications.length > 0) {
            data.notifications.forEach(n => {
                if (!_seenNotifIds.has(n.id)) {
                    _seenNotifIds.add(n.id);
                    showToast(n.contenu, n.type, n.alertId);
                }
            });
        }

        // Mettre à jour la liste sidebar
        const sidebarList = document.getElementById('sidebarNotifList');
        if (sidebarList && data.notifications && data.notifications.length > 0) {
            sidebarList.innerHTML = data.notifications.slice(0, 2).map(n => {
                const dot = n.type === 'urgence' ? 'notif-dot-red' : 'notif-dot-amber';
                const text = n.contenu ? n.contenu.replace(/<[^>]*>/g, '').slice(0, 45) + '…' : '';
                return `<div class="sidebar-notif-item">
                    <span class="notif-dot ${dot}"></span>
                    <span>${escapeHtml(text)}</span>
                </div>`;
            }).join('');
        } else if (sidebarList) {
            sidebarList.innerHTML = '<div class="sidebar-notif-item"><span class="text-slate-500 text-xs">Aucune notification</span></div>';
        }

        // Mettre à jour le panel dropdown topbar
        if (data.notifications && window._notifPanelOpen !== true) {
            const list = document.querySelector('.notif-list');
            if (list && data.notifications.length > 0) {
                list.innerHTML = data.notifications.map(n => {
                    const iconClass = n.type === 'urgence' ? 'notif-icon-red' : n.type === 'tache' ? 'notif-icon-amber' : 'notif-icon-emerald';
                    const icon = n.type === 'urgence' ? 'bi-exclamation-triangle' : n.type === 'tache' ? 'bi-clipboard-check' : n.type === 'escalade' ? 'bi-arrow-up-right-square' : n.type === 'validation' ? 'bi-check-circle' : n.type === 'statut_change' ? 'bi-arrow-clockwise' : 'bi-info-circle';
                    const href = n.alertId ? `/notification/${n.id}/read` : '/notification/' + n.id + '/read';
                    return `<a href="${href}" class="notif-item ${n.lu ? '' : 'notif-unread'}">
                        <span class="notif-icon-wrap ${iconClass}"><i class="bi ${icon}"></i></span>
                        <div class="notif-body">
                            <p class="notif-title">${escapeHtml(n.contenu ? n.contenu.replace(/<[^>]*>/g, '').slice(0, 70) : '—')}</p>
                            <span class="notif-meta">${n.codeGei ? escapeHtml(n.codeGei) + ' · ' : ''}${escapeHtml(n.date)}</span>
                        </div>
                    </a>`;
                }).join('');
            }
        }
    } catch (e) { /* Silencieux — pas critique */ }
}

function showToast(contenu, type, alertId) {
    const container = document.getElementById('toastContainer');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `gei-toast toast-${type || 'info'}`;
    const icon = type === 'urgence' ? 'bi-exclamation-triangle' : type === 'tache' ? 'bi-clipboard-check' : type === 'escalade' ? 'bi-arrow-up-right-square' : type === 'validation' ? 'bi-check-circle' : type === 'statut_change' ? 'bi-arrow-clockwise' : 'bi-info-circle';
    const href = alertId ? `/alert/${alertId}` : '/notifications';
    toast.innerHTML = `
        <a href="${href}" class="gei-toast-link">
            <span class="gei-toast-icon"><i class="bi ${icon}"></i></span>
            <span class="gei-toast-text">${escapeHtml(contenu)}</span>
        </a>
        <button class="gei-toast-close" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
    `;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 6000);
}

function escapeHtml(value) {
    const element = document.createElement('span');
    element.textContent = value;
    return element.innerHTML;
}

// Premier appel immédiat + polling toutes les 30s
document.addEventListener('DOMContentLoaded', () => {
    pollNotifications();
    notifPollInterval = setInterval(pollNotifications, 30000);
});

function toggleNotifPanel() {
    const panel = document.getElementById('notifPanel');
    panel.classList.toggle('hidden');
    window._notifPanelOpen = !panel.classList.contains('hidden');
}

/* ─── Dark / Night mode ─── */
(function() {
    if (localStorage.getItem('gei-dark') === '1') {
        document.body.classList.add('dark');
    }
})();
document.addEventListener('DOMContentLoaded', function() {
    const btn  = document.getElementById('darkModeBtn');
    const icon = document.getElementById('darkModeIcon');
    if (!btn) return;
    function applyDark(on) {
        document.body.classList.toggle('dark', on);
        if (icon) {
                    icon.className = on ? 'bi bi-sun' : 'bi bi-moon';
        }
        localStorage.setItem('gei-dark', on ? '1' : '0');
        // Notifier les autres composants (ex: carte Leaflet)
        document.dispatchEvent(new CustomEvent('dark-mode-changed', { detail: { dark: on } }));
    }
    // Init icon on page load
    const isDark = document.body.classList.contains('dark');
    if (icon) icon.className = isDark ? 'bi bi-sun' : 'bi bi-moon';
    btn.addEventListener('click', function() {
        applyDark(!document.body.classList.contains('dark'));
    });
});

/* ─── Modale confirm (générale) ─── */
document.querySelectorAll('.modal-close').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('confirmModal').classList.add('hidden');
    });
});

/* ─── Modale de rejet (spécifique à la qualification) ─── */
document.addEventListener('DOMContentLoaded', () => {
    const rejectBtns = document.querySelectorAll('.action-rejet');
    const rejectModal = document.getElementById('rejectModal');
    const rejectCommentaire = document.getElementById('rejectCommentaire');
    const rejectForm = document.getElementById('rejectForm');
    const rejectTokenInput = document.getElementById('rejectTokenInput');

    // Initialiser le token CSRF
    if (rejectTokenInput) {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (csrfToken) rejectTokenInput.value = csrfToken;
    }

    rejectBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const alertId = btn.getAttribute('data-alert-id');
            if (rejectForm) {
                rejectForm.action = `/alert/${alertId}/qualify`;
            }
            if (rejectModal) rejectModal.classList.remove('hidden');
            if (rejectCommentaire) rejectCommentaire.focus();
        });
    });

    // Fermer le modal au clic sur le boutonAnnuler ou overlay
    document.querySelectorAll('[data-modal="rejectModal"]').forEach(btn => {
        btn.addEventListener('click', () => {
            if (rejectModal) rejectModal.classList.add('hidden');
        });
    });

    // Soumission du rejet
    if (rejectForm) {
        rejectForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const commentaire = rejectCommentaire?.value?.trim();
            if (!commentaire) {
                alert('Un commentaire est obligatoire pour rejeter la fiche.');
                return;
            }

            const formData = new FormData(rejectForm);
            formData.append('action_rejet', '1');
            formData.append('commentaire_rejet', commentaire);

            fetch(rejectForm.action, {
                method: 'POST',
                body: formData,
            }).then(r => r.ok ? window.location.href = '/alert' : null);
        });
    }
});
</script>

{% block javascripts %}{% endblock %}

{# ── Container toasts notifications ── #}
<div id="toastContainer" class="gei-toast-container"></div>

</body>
</html>
