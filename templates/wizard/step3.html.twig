{# Étape 3 — Classification (champs 9 et 10) #}

<form id="wizardForm" method="post" action="{{ path('app_wizard_new', {step: 3}) }}" novalidate>
    <input type="hidden" name="wizard_step" value="3">

    <div class="db-card mb-4">
        <div class="db-card-header">
            <p class="db-card-eyebrow">
                <i class="bi bi-tags me-1.5 text-amber-400"></i>
                Étape 3 sur 6 — Classification
            </p>
            <p class="text-xs text-slate-500">Champs 9 et 10 du formulaire Agent</p>
        </div>
        <div class="db-card-body space-y-4">

            {# Champ 9 — Catégorie (liste administrable) #}
            <div class="form-field">
                <label class="form-label" for="w_categorie">
                    Catégorie <span class="text-red-400">*</span>
                </label>
                <select name="alert[categorie]" id="w_categorie" class="form-select" required>
                    <option value="">Sélectionnez une catégorie</option>
                    {% for cat in categories %}
                        <option value="{{ cat.libelle }}"
                            {% if draftData and (draftData['alert[categorie]'] ?? null) == cat.libelle %}selected{% endif %}>
                            {{ cat.libelle }}
                        </option>
                    {% endfor %}
                </select>
                <p class="form-help">Nature principale de l'alerte. Cette liste est administrable par le Manager.</p>
            </div>

            {# Champ 10 — Type d'alerte (radio) #}
            {% set currentTypeAlerte = draftData['alert[typeAlerte]']|default(draftData['typeAlerte']|default(alert.typeAlerte ? alert.typeAlerte.value : '')) %}
            <div class="form-field">
                <label class="form-label">
                    Type d'alerte <span class="text-red-400">*</span>
                </label>
                <div class="radio-group" id="typeAlerteGroup">
                    <label class="radio-option {% if currentTypeAlerte == 'operationnelle' %}radio-option-active{% endif %}" data-val="operationnelle">
                        <input type="radio" name="alert[typeAlerte]" value="operationnelle"
                               {% if currentTypeAlerte == 'operationnelle' %}checked{% endif %} required>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-amber-500/10 border border-amber-500/20 text-amber-400 flex-shrink-0">
                                    <i class="bi-lightning-charge text-xl"></i>
                                </div>
                                <div>
                                    <div class="radio-option-title text-sm font-bold text-white">Opérationnelle</div>
                                    <div class="text-xs text-slate-400 font-normal">Action immédiate, saisie terrain, interception</div>
                                </div>
                            </div>
                        </div>
                        <span class="radio-selected-pill">
                            <i class="bi bi-check-lg"></i>Sélectionné
                        </span>
                    </label>
                    <label class="radio-option {% if currentTypeAlerte == 'strategique' %}radio-option-active{% endif %}" data-val="strategique">
                        <input type="radio" name="alert[typeAlerte]" value="strategique"
                               {% if currentTypeAlerte == 'strategique' %}checked{% endif %}>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex-shrink-0">
                                    <i class="bi-diagram-3 text-xl"></i>
                                </div>
                                <div>
                                    <div class="radio-option-title text-sm font-bold text-white">Stratégique</div>
                                    <div class="text-xs text-slate-400 font-normal">Tendance, schéma de fraude, analyse de fond</div>
                                </div>
                            </div>
                        </div>
                        <span class="radio-selected-pill">
                            <i class="bi bi-check-lg"></i>Sélectionné
                        </span>
                    </label>
                </div>
                <p class="form-help">Sélectionnez la finalité opérationnelle de cette alerte.</p>
            </div>

        </div>
    </div>

    {# Navigation sticky #}
    <div class="wizard-step-buttons">
        <button type="submit" name="_action" value="prev" class="db-btn db-btn-ghost">
            <i class="bi bi-arrow-left me-2"></i>Précédent
        </button>
        <button type="submit" name="_action" value="next" class="db-btn db-btn-amber">
            Suivant — Source<i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>

</form>

<script>
(function() {
    function syncTypeAlerte() {
        const group = document.getElementById('typeAlerteGroup');
        if (!group) return;
        group.querySelectorAll('.radio-option').forEach(function(card) {
            const input = card.querySelector('input[type="radio"]');
            if (input && input.checked) {
                card.classList.add('radio-option-active');
            } else {
                card.classList.remove('radio-option-active');
            }
        });
    }

    document.querySelectorAll('#typeAlerteGroup .radio-option').forEach(function(card) {
        card.addEventListener('click', function(e) {
            const input = card.querySelector('input[type="radio"]');
            if (input && !input.checked) {
                input.checked = true;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
            syncTypeAlerte();
        });
    });

    document.querySelectorAll('#typeAlerteGroup input[type="radio"]').forEach(function(input) {
        input.addEventListener('change', syncTypeAlerte);
    });

    // Synchronisation immédiate au chargement
    syncTypeAlerte();
})();
</script>
