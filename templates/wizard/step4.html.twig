{# Étape 4 — Source (champs 11 à 12) #}

<form id="wizardForm" method="post" action="{{ path('app_wizard_new', {step: 4}) }}" novalidate>
    <input type="hidden" name="wizard_step" value="4">

    <div class="db-card mb-4">
        <div class="db-card-header">
            <p class="db-card-eyebrow">
                <i class="bi bi-eye-slash me-1.5 text-amber-400"></i>
                Étape 4 sur 6 — Source
            </p>
            <p class="text-xs text-slate-500">Champs 11 à 12 du formulaire Agent</p>
        </div>
        <div class="db-card-body space-y-4">

            {# Champ 11 — Type de source (liste administrable) #}
            <div class="form-field">
                <label class="form-label" for="w_typeSource">
                    Type de source <span class="text-red-400">*</span>
                </label>
                <select name="alert[typeSource]" id="w_typeSource" class="form-select" required>
                    <option value="">Sélectionnez le type de source</option>
                    {% for s in typeSources %}
                        <option value="{{ s.libelle }}"
                            {% if draftData and (draftData['alert[typeSource]'] ?? null) == s.libelle %}selected{% endif %}>
                            {{ s.libelle }}
                        </option>
                    {% endfor %}
                </select>
                <p class="form-help">Origine de l'information. Cette liste est administrable par le Manager.</p>
            </div>

            {# Champ 12 — Niveau d'anonymisation (Oui / Non) #}
            {% set currentAnon = draftData['alert[anonymisation]']|default(draftData['anonymisation']|default(alert.anonymisation|default('')))|lower %}
            <div class="form-field">
                <label class="form-label">
                    Niveau d'anonymisation <span class="text-red-400">*</span>
                </label>
                <div class="radio-group" id="anonymisationGroup">
                    <label class="radio-option radio-option-emerald {% if currentAnon == 'oui' %}radio-option-active{% endif %}" data-val="oui">
                        <input type="radio" name="alert[anonymisation]" value="oui"
                               {% if currentAnon == 'oui' %}checked{% endif %} required>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex-shrink-0">
                                    <i class="bi bi-shield-check text-xl"></i>
                                </div>
                                <div>
                                    <div class="radio-option-title text-sm font-bold text-white">Oui (Source protégée)</div>
                                    <div class="text-xs text-slate-400 font-normal">Identité caviardée dans toute diffusion</div>
                                </div>
                            </div>
                        </div>
                        <span class="radio-selected-pill">
                            <i class="bi bi-check-lg"></i>Sélectionné
                        </span>
                    </label>
                    <label class="radio-option {% if currentAnon == 'non' %}radio-option-active{% endif %}" data-val="non">
                        <input type="radio" name="alert[anonymisation]" value="non"
                               {% if currentAnon == 'non' %}checked{% endif %}>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-slate-500/10 border border-slate-500/20 text-slate-300 flex-shrink-0">
                                    <i class="bi bi-shield-slash text-xl"></i>
                                </div>
                                <div>
                                    <div class="radio-option-title text-sm font-bold text-white">Non (Source ouverte / officielle)</div>
                                    <div class="text-xs text-slate-400 font-normal">Renseignement issu d'un canal public ou officiel</div>
                                </div>
                            </div>
                        </div>
                        <span class="radio-selected-pill">
                            <i class="bi bi-check-lg"></i>Sélectionné
                        </span>
                    </label>
                </div>
                <p class="form-help">La source doit-elle être protégée (anonymisée) dans les communications ?</p>
            </div>

        </div>
    </div>

    {# Navigation sticky #}
    <div class="wizard-step-buttons">
        <button type="submit" name="_action" value="prev" class="db-btn db-btn-ghost">
            <i class="bi bi-arrow-left me-2"></i>Précédent
        </button>
        <button type="submit" name="_action" value="next" class="db-btn db-btn-amber">
            Suivant — Qualification<i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>

</form>

<script>
(function() {
    function syncAnonymisation() {
        const group = document.getElementById('anonymisationGroup');
        if (!group) return;
        group.querySelectorAll('.radio-option').forEach(function(card) {
            const input = card.querySelector('input[type="radio"]');
            if (input && input.checked) {
                card.classList.add('radio-option-active');
            } else {
                card.classList.remove('radio-option-active');
            }
        });
    }

    document.querySelectorAll('#anonymisationGroup .radio-option').forEach(function(card) {
        card.addEventListener('click', function(e) {
            const input = card.querySelector('input[type="radio"]');
            if (input && !input.checked) {
                input.checked = true;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
            syncAnonymisation();
        });
    });

    document.querySelectorAll('#anonymisationGroup input[type="radio"]').forEach(function(input) {
        input.addEventListener('change', syncAnonymisation);
    });

    // Synchronisation immédiate au chargement
    syncAnonymisation();
})();
</script>
