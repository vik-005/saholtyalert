{# Étape 1 — Identification (champs 1 à 4) #}

<form id="wizardForm" class="wizard-form" method="post" action="{{ path('app_wizard_new', {step: 1}) }}" novalidate>
    <input type="hidden" name="wizard_step" value="1">

    <div class="db-card mb-4">
        <div class="db-card-header">
            <p class="db-card-eyebrow">
                <i class="bi bi-geo-alt me-1.5 text-amber-400"></i>
                Étape 1 sur 6 — Identification
            </p>
            <p class="text-xs text-slate-500">Champs 1 à 4 du formulaire Agent</p>
        </div>
        <div class="db-card-body space-y-4 wizard-fields-grid">

            {# Champ 1 — Date de réception #}
            <div class="form-field">
                <label class="form-label" for="w_date">
                    Date de réception <span class="text-red-400">*</span>
                </label>
                  <input type="date" name="alert[dateCreation]" id="w_date" class="form-input" required
                      value="{{ draftData['alert[dateCreation]']|default(alert.dateCreation|date('Y-m-d')) }}">
                <p class="form-help">Date à laquelle l'information a été reçue ou créée.</p>
            </div>

            {# Champ 2 — Marché émetteur #}
            <div class="form-field">
                <label class="form-label" for="w_market">
                    Marché émetteur <span class="text-red-400">*</span>
                </label>
                <select name="alert[market]" id="w_market" class="form-select" required>
                    <option value="">Sélectionnez un pays / marché</option>
                    {% for market in markets %}
                        <option value="{{ market.id }}"
                            {% if (draftData['alert[market]']|default(alert.market ? alert.market.id : null)) == market.id %}selected{% endif %}>
                            {{ market.nom }}
                        </option>
                    {% endfor %}
                </select>
                <p class="form-help">Marché principal de l’alerte, limité aux marchés attribués à votre compte.</p>
            </div>

            <div class="form-field wizard-field-wide">
                  <label class="form-label" for="w_parcours_markets_search">Pays et marchés du parcours</label>
                <div class="country-picker" id="countryPicker">
                      <div class="country-picker-selected" id="countryPickerSelected" aria-live="polite"></div>
                    <input type="search" id="w_parcours_markets_search" class="form-input"
                          placeholder="Rechercher un pays puis le sélectionner..." autocomplete="off"
                           aria-label="Rechercher un pays dans les marchés du parcours"
                          aria-controls="countryPickerOptions" aria-autocomplete="list"
                          aria-expanded="false" role="combobox">
                    <div class="country-picker-options" id="countryPickerOptions" role="listbox"
                        aria-label="Tous les pays disponibles" aria-multiselectable="true">
                        {% for countryCode, countryName in parcoursCountries %}
                            <button type="button" class="country-picker-option"
                                    data-country-code="{{ countryCode }}"
                                    data-country-name="{{ countryName }}"
                                    role="option">{{ countryName }}</button>
                        {% endfor %}
                    </div>
                </div>
                {% set parcours = draftData['alert[parcoursCountries]']|default(alert.parcoursCountries|default([])) %}
                {% if parcours is not iterable %}{% set parcours = [parcours] %}{% endif %}
                <input type="hidden" name="alert[parcoursCountriesOrder]" id="w_parcours_markets_order"
                       value="{{ draftData['alert[parcoursCountriesOrder]']|default(parcours|json_encode) }}">
                <select name="alert[parcoursCountries][]" id="w_parcours_markets" class="country-picker-native" multiple tabindex="-1">
                    {% for countryCode, countryName in parcoursCountries %}
                        <option value="{{ countryCode }}" {% if countryCode in parcours %}selected{% endif %}>{{ countryName }}</option>
                    {% endfor %}
                </select>
                <p class="form-help">Facultatif : sélectionnez un ou plusieurs pays, puis retirez-les avec ×. Tous les pays sont proposés, indépendamment de votre marché principal.</p>
            </div>

            {# Champ 3 — Port / Corridor / Aéroport (radio) #}
            {% set currentTypeLoc = draftData['alert[typeLocalisation]']|default(draftData['typeLocalisation']|default(alert.typeLocalisation ? alert.typeLocalisation.value : '')) %}
            <div class="form-field wizard-field-wide">
                <label class="form-label">
                    Type de localisation <span class="text-red-400">*</span>
                </label>
                <div class="radio-group" id="typeLocalisationGroup">
                    <label class="radio-option {% if currentTypeLoc == 'port' %}radio-option-active{% endif %}" data-val="port">
                        <input type="radio" name="alert[typeLocalisation]" value="port"
                               {% if currentTypeLoc == 'port' %}checked{% endif %} required>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <span class="radio-option-title">Port maritime</span>
                            </div>
                        </div>
                    </label>
                    <label class="radio-option {% if currentTypeLoc == 'corridor' %}radio-option-active{% endif %}" data-val="corridor">
                        <input type="radio" name="alert[typeLocalisation]" value="corridor"
                               {% if currentTypeLoc == 'corridor' %}checked{% endif %}>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <span class="radio-option-title">Corridor de transit</span>
                            </div>
                        </div>
                    </label>
                    <label class="radio-option {% if currentTypeLoc == 'aeroport' %}radio-option-active{% endif %}" data-val="aeroport">
                        <input type="radio" name="alert[typeLocalisation]" value="aeroport"
                               {% if currentTypeLoc == 'aeroport' %}checked{% endif %}>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <span class="radio-option-title">Aéroport international</span>
                            </div>
                        </div>
                    </label>
                    <label class="radio-option {% if currentTypeLoc == 'localite' %}radio-option-active{% endif %}" data-val="localite">
                        <input type="radio" name="alert[typeLocalisation]" value="localite"
                               {% if currentTypeLoc == 'localite' %}checked{% endif %}>
                        <div class="flex items-center gap-3">
                            <span class="radio-disc"><span class="radio-disc-dot"></span></span>
                            <div class="flex items-center gap-3">
                                <span class="radio-option-title">Localité (ville / village)</span>
                            </div>
                        </div>
                    </label>
                </div>
                <button type="button" class="wizard-choice-clear" data-clear-radio="typeLocalisationGroup" hidden>
                    Effacer la sélection
                </button>
                <p class="form-help">Choisissez un port, un corridor, un aéroport ou une localité.</p>
            </div>

            {# Champ 4 — Nom (label dynamique) #}
            <div class="form-field wizard-field-wide" id="portCorridorField">
                <label class="form-label" for="w_corridor" id="label_corridor">
                    Nom <span class="text-red-400">*</span>
                </label>
                <input type="text" name="alert[portCorridor]" id="w_corridor"
                       class="form-input"
                       placeholder=""
                       value="{{ draftData['alert[portCorridor]']|default(alert.portCorridor|default('')) }}">
                <p class="form-help" id="help_corridor">Nom du port, corridor ou aéroport concerné.</p>
            </div>

            <div class="form-field wizard-field-wide" id="localiteFields" hidden>
                <label class="form-label" for="w_localite">Nom de la localité <span class="text-red-400">*</span></label>
                <input type="text" name="alert[localite]" id="w_localite" class="form-input"
                       maxlength="150" placeholder="Ex. Cotonou, Kandi, Dapaong"
                       value="{{ draftData['alert[localite]']|default(alert.localite|default('')) }}">
                <p class="form-help">Saisissez librement le nom de la ville ou du village.</p>
                <div class="wizard-fields-grid">
                    <div class="form-field">
                        <label class="form-label" for="w_type_localite">Type de localité <span class="text-red-400">*</span></label>
                        {% set currentTypeLocalite = draftData['alert[typeLocalite]']|default(alert.typeLocalite|default('')) %}
                        <select name="alert[typeLocalite]" id="w_type_localite" class="form-select">
                            <option value="">Sélectionnez</option>
                            <option value="ville" {% if currentTypeLocalite == 'ville' %}selected{% endif %}>Ville</option>
                            <option value="village" {% if currentTypeLocalite == 'village' %}selected{% endif %}>Village</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label" for="w_localite_latitude">Latitude (facultative)</label>
                        <input type="number" name="alert[localiteLatitude]" id="w_localite_latitude" class="form-input"
                               min="-90" max="90" step="any"
                               value="{{ draftData['alert[localiteLatitude]']|default(alert.localiteLatitude|default('')) }}">
                    </div>
                    <div class="form-field">
                        <label class="form-label" for="w_localite_longitude">Longitude (facultative)</label>
                        <input type="number" name="alert[localiteLongitude]" id="w_localite_longitude" class="form-input"
                               min="-180" max="180" step="any"
                               value="{{ draftData['alert[localiteLongitude]']|default(alert.localiteLongitude|default('')) }}">
                    </div>
                </div>
                <p class="form-help">Pour afficher la localité précisément sur la carte, renseignez latitude et longitude.</p>
            </div>

        </div>
    </div>

    {# Navigation sticky #}
    <div class="wizard-step-buttons">
        <a href="{{ path('app_dashboard_operationnel') }}" class="db-btn db-btn-ghost">
            <i class="bi bi-ban me-1.5"></i>Annuler
        </a>
        <button type="submit" name="_action" value="next" class="db-btn db-btn-amber">
            Suivant<i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>

</form>

<script>
const labelEl = document.getElementById('label_corridor');
const helpEl  = document.getElementById('help_corridor');
const inputEl = document.getElementById('w_corridor');
const portCorridorField = document.getElementById('portCorridorField');
const localiteFields = document.getElementById('localiteFields');
const localiteInput = document.getElementById('w_localite');
const typeLocaliteInput = document.getElementById('w_type_localite');
const radios  = document.querySelectorAll('input[name="alert[typeLocalisation]"]');
const options = document.querySelectorAll('.radio-option');
const parcoursSearch = document.getElementById('w_parcours_markets_search');
const parcoursSelect = document.getElementById('w_parcours_markets');
const parcoursOrderInput = document.getElementById('w_parcours_markets_order');
const countryPicker = document.getElementById('countryPicker');
const countryPickerSelected = document.getElementById('countryPickerSelected');
const countryPickerOptions = document.getElementById('countryPickerOptions');

// ── CONSERVATION DE L'ORDRE DE SAISIE ───────────────────────────────────────
// Tableau qui conserve l'ordre exact de sélection par l'utilisateur
// (le <select> natif trie automatiquement ses options par ordre DOM)
let selectionOrder = [];

// Le select natif émet ses options dans l'ordre du DOM, pas dans l'ordre de sélection.
if (parcoursSelect) {
    try {
        const savedOrder = JSON.parse(parcoursOrderInput?.value || '[]');
        if (Array.isArray(savedOrder)) {
            selectionOrder = savedOrder.filter(code =>
                Array.from(parcoursSelect.selectedOptions).some(option => option.value === code)
            );
        }
    } catch (error) {
        console.error('Impossible de restaurer l’ordre du parcours enregistré.', error);
    }
    Array.from(parcoursSelect.selectedOptions).forEach(option => {
        if (!selectionOrder.includes(option.value)) selectionOrder.push(option.value);
    });
}

function selectedCountryCodes() {
    return new Set(Array.from(parcoursSelect?.selectedOptions ?? []).map(option => option.value));
}

function saveSelectionOrder() {
    if (!parcoursSelect || !parcoursOrderInput) return;
    const selected = selectedCountryCodes();
    selectionOrder = selectionOrder.filter(code => selected.has(code));
    Array.from(parcoursSelect.selectedOptions).forEach(option => {
        if (!selectionOrder.includes(option.value)) selectionOrder.push(option.value);
    });
    parcoursOrderInput.value = JSON.stringify(selectionOrder);
}

function updateLabel() {
    const selected = document.querySelector('input[name="alert[typeLocalisation]"]:checked');
    const isLocalite = selected?.value === 'localite';
    portCorridorField.style.display = isLocalite ? 'none' : '';
    localiteFields.style.display = isLocalite ? '' : 'none';
    inputEl.required = !isLocalite;
    localiteInput.required = isLocalite;
    typeLocaliteInput.required = isLocalite;
    if (!selected) {
        labelEl.innerHTML = 'Nom <span class="text-red-400">*</span>';
        helpEl.textContent = 'Nom du port, corridor ou aéroport concerné.';
        inputEl.placeholder = '';
        return;
    }
    switch (selected.value) {
        case 'port':
            labelEl.innerHTML = 'Nom du port <span class="text-red-400">*</span>';
            helpEl.textContent = 'Nom du port concerné.';
            inputEl.placeholder = 'ex. Port de Lomé, Port de Cotonou';
            break;
        case 'corridor':
            labelEl.innerHTML = 'Nom du corridor <span class="text-red-400">*</span>';
            helpEl.textContent = 'Nom du corridor de transit concerné.';
            inputEl.placeholder = 'ex. Corridor Cotonou - Niamey';
            break;
        case 'aeroport':
            labelEl.innerHTML = 'Nom de l\'aéroport <span class="text-red-400">*</span>';
            helpEl.textContent = 'Nom de l\'aéroport concerné.';
            inputEl.placeholder = 'ex. Aéroport de Lomé, Aéroport de Cotonou';
            break;
        case 'localite':
            labelEl.innerHTML = 'Nom de la localité <span class="text-red-400">*</span>';
            helpEl.textContent = 'Saisissez une ville ou un village dans les champs dédiés.';
            inputEl.placeholder = '';
            break;
        default:
            labelEl.innerHTML = 'Nom <span class="text-red-400">*</span>';
            helpEl.textContent = 'Nom du port, corridor ou aéroport concerné.';
            inputEl.placeholder = '';
    }
}

function updateActiveClass() {
    options.forEach(opt => opt.classList.remove('radio-option-active'));
    const selected = document.querySelector('input[name="alert[typeLocalisation]"]:checked');
    if (selected) {
        const parent = selected.closest('.radio-option');
        if (parent) parent.classList.add('radio-option-active');
    }
}

options.forEach(card => {
    card.addEventListener('click', () => {
        const input = card.querySelector('input[type="radio"]');
        if (input && !input.checked) {
            input.checked = true;
            input.dispatchEvent(new Event('change', { bubbles: true }));
        }
        updateActiveClass();
        updateLabel();
    });
});

radios.forEach(r => {
    r.addEventListener('change', () => {
        updateLabel();
        updateActiveClass();
    });
});
updateLabel();
updateActiveClass();

function renderCountryPicker() {
    if (!parcoursSelect || !countryPickerSelected || !countryPickerOptions) return;
    const selected = selectedCountryCodes();
    countryPickerSelected.innerHTML = '';
    if (selected.size === 0) {
        const empty = document.createElement('span');
        empty.className = 'country-picker-empty';
        empty.textContent = 'Aucun pays sélectionné';
        countryPickerSelected.appendChild(empty);
    }
    // ── AFFICHER LES PAYS DANS L'ORDRE DE SÉLECTION (pas alphabétique) ─────────
    // Utiliser selectionOrder au lieu de parcoursSelect.selectedOptions
    selectionOrder.forEach(countryCode => {
        const option = Array.from(parcoursSelect.options).find(opt => opt.value === countryCode);
        if (!option || !selected.has(countryCode)) return;
        
        const tag = document.createElement('span');
        tag.className = 'country-picker-tag';
        tag.textContent = option.textContent.trim();
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'country-picker-remove';
        remove.setAttribute('aria-label', `Retirer ${option.textContent.trim()}`);
        remove.textContent = '×';
        remove.addEventListener('click', () => {
            option.selected = false;
            // Retirer du tableau d'ordre
            selectionOrder = selectionOrder.filter(code => code !== countryCode);
            saveSelectionOrder();
            renderCountryPicker();
            parcoursSearch?.focus();
        });
        tag.appendChild(remove);
        countryPickerSelected.appendChild(tag);
    });
    Array.from(countryPickerOptions.querySelectorAll('.country-picker-option')).forEach(button => {
        const isSelected = selected.has(button.dataset.countryCode);
        button.hidden = isSelected;
        button.setAttribute('aria-selected', isSelected ? 'true' : 'false');
    });
}

function filterCountryPicker() {
    const search = parcoursSearch?.value.trim().toLocaleLowerCase() ?? '';
    const selected = selectedCountryCodes();
    Array.from(countryPickerOptions?.querySelectorAll('.country-picker-option') ?? []).forEach(button => {
        const matches = button.dataset.countryName.toLocaleLowerCase().includes(search);
        button.hidden = selected.has(button.dataset.countryCode) || !matches;
    });
}

countryPickerOptions?.querySelectorAll('.country-picker-option').forEach(button => {
    button.addEventListener('click', () => {
        const option = Array.from(parcoursSelect.options).find(item => item.value === button.dataset.countryCode);
        if (option) {
            option.selected = true;
            // Ajouter à la fin du tableau d'ordre si pas déjà présent
            if (!selectionOrder.includes(button.dataset.countryCode)) {
                selectionOrder.push(button.dataset.countryCode);
            }
        }
        saveSelectionOrder();
        parcoursSearch.value = '';
        renderCountryPicker();
        filterCountryPicker();
        parcoursSearch.focus();
    });
});

parcoursSearch?.addEventListener('input', filterCountryPicker);
parcoursSearch?.addEventListener('focus', () => parcoursSearch.setAttribute('aria-expanded', 'true'));
parcoursSearch?.addEventListener('blur', () => parcoursSearch.setAttribute('aria-expanded', 'false'));
parcoursSearch?.addEventListener('keydown', event => {
    if (event.key === 'ArrowDown') {
        const firstOption = Array.from(countryPickerOptions?.querySelectorAll('.country-picker-option') ?? [])
            .find(option => !option.hidden);
        if (firstOption) {
            event.preventDefault();
            firstOption.focus();
        }
    }
    if (event.key === 'Escape') {
        parcoursSearch.value = '';
        filterCountryPicker();
    }
    if (event.key === 'Backspace' && parcoursSearch.value === '' && parcoursSelect.selectedOptions.length > 0) {
        // Retirer le dernier pays sélectionné (selon l'ordre de saisie)
        const lastCountryCode = selectionOrder[selectionOrder.length - 1];
        const lastOption = Array.from(parcoursSelect.options).find(opt => opt.value === lastCountryCode);
        if (lastOption) {
            lastOption.selected = false;
            selectionOrder.pop(); // Retirer du tableau d'ordre
        }
        saveSelectionOrder();
        renderCountryPicker();
    }
});

document.addEventListener('click', event => {
    if (countryPicker && !countryPicker.contains(event.target)) {
        parcoursSearch?.blur();
    }
});

document.getElementById('wizardForm')?.addEventListener('submit', saveSelectionOrder);

renderCountryPicker();
filterCountryPicker();
</script>
