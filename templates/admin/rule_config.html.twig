{% extends 'base.html.twig' %}

{% block title %}Modifier Règle — {{ rule.cle }}{% endblock %}
{% block header_title %}Configuration du Seuil : {{ rule.cle }}{% endblock %}

{% block body %}
<div class="db-wrapper">

    <div class="page-header-row">
        <div>
            <p class="page-eyebrow">
                <i class="bi bi-sliders me-1.5 text-amber-400"></i>
                Administration · Règles de scoring
            </p>
            <h2 class="page-title">Modifier — {{ rule.cle }}</h2>
            <p class="page-subtitle">
                Catégorie : <span class="font-mono text-amber-400">{{ rule.categorie }}</span>
            </p>
        </div>
        <a href="{{ path('app_admin_rule_index') }}" class="db-btn db-btn-ghost">
            <i class="bi bi-arrow-left me-1.5"></i>Retour
        </a>
    </div>

    {{ form_start(form, {'attr': {'class': 'db-card'}}) }}
        <div class="db-card-header">
            <p class="db-card-eyebrow">
                <i class="bi bi-pencil me-1.5"></i>
                Paramètres de la règle
            </p>
        </div>
        <div class="db-card-body">
            <div class="form-grid-2">

                <div class="form-field">
                    <label class="form-label">Clé de configuration</label>
                    <input type="text" value="{{ rule.cle }}" disabled class="form-input font-mono" style="opacity:.6">
                    <p class="form-help">Identifiant technique de la règle. Non modifiable.</p>
                </div>

                <div class="form-field">
                    {{ form_label(form.valeur, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.valeur, {'attr': {'class': 'form-input', 'placeholder': 'ex. 18, 72, 6...'}}) }}
                    {{ form_help(form.valeur) }}
                </div>

                <div class="form-field" style="grid-column: 1 / -1;">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-input', 'placeholder': 'Description métier de la règle...'}}) }}
                    {{ form_help(form.description) }}
                </div>

            </div>
        </div>

        <div class="db-card-body" style="border-top: 1px solid var(--border);">
            <div class="flex gap-3 justify-end">
                <a href="{{ path('app_admin_rule_index') }}" class="db-btn db-btn-ghost">Annuler</a>
                <button type="submit" class="db-btn db-btn-amber">
                    <i class="bi bi-check-lg me-1.5"></i>Enregistrer
                </button>
            </div>
        </div>
    {{ form_end(form) }}

</div>
{% endblock %}
