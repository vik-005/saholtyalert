{% extends 'base.html.twig' %}

{% block title %}Modifier Règle — {{ rule.cle }}{% endblock %}
{% block header_title %}Configuration du Seuil : {{ rule.cle }}{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl">
    {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
        <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase">Clé de configuration</label>
            <input type="text" value="{{ rule.cle }}" disabled class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded text-slate-500 text-xs font-mono">
        </div>

        <div>
            {{ form_label(form.valeur) }}
            {{ form_widget(form.valeur) }}
        </div>

        <div>
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
        </div>

        <div class="pt-4 border-t border-slate-800 flex justify-end gap-3">
            <a href="{{ path('app_dashboard_superadmin') }}" class="px-4 py-2 bg-slate-800 text-slate-300 text-xs rounded-lg">Annuler</a>
            <button type="submit" class="px-6 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-lg shadow">
                Enregistrer la Modification
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
