{% extends 'base.html.twig' %}

{% block title %}Espace Automatisations — GEI{% endblock %}
{% block header_title %}Automatisations & Moteur de Règles{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête centré ── #}
    <div class="page-header-row">
        <div class="text-center" style="flex:1">
            <p class="page-eyebrow">
                <i class="bi bi-robot me-1.5 text-amber-400"></i>
                Administration · Spec B.1
            </p>
            <h2 class="page-title">Espace Automatisations & Moteur de Règles</h2>
            <p class="page-subtitle mx-auto" style="max-width:600px">
                Gérez les règles d'escalade, les seuils paramétrables et l'historique des déclenchements automatiques.
            </p>
        </div>
    </div>

    {# ── Scheduler SLA Health Status ── #}
    <div class="db-card mb-4">
        <div class="db-card-body text-center py-4">
            <div class="d-inline-flex align-items-center gap-3 flex-wrap justify-content-center">
                <div class="kpi-icon-wrap kpi-icon-emerald" style="width:48px;height:48px;border-radius:12px">
                    <i class="bi bi-bolt" style="font-size:20px"></i>
                </div>
                <div>
                    <p style="font-size:14px;font-weight:700;color:var(--text)">État du Scheduler SLA & Automatisations</p>
                    <p style="font-size:11px;color:var(--muted)">Exécution en arrière-plan toutes les 15 minutes</p>
                </div>
                <div class="d-inline-flex align-items-center gap-2">
                    <span class="status-pill status-active" style="font-size:11px">
                        <span class="status-dot"></span>OPÉRATIONNEL
                    </span>
                    <span style="font-size:11px;color:var(--muted)">Dernier passage :</span>
                    <code style="font-size:12px;font-weight:700;color:var(--amber)">{{ last_scheduler_run|date('H:i:s') }}</code>
                </div>
            </div>
        </div>
    </div>

    {# ── Règles d'Escalade ── #}
    <div class="db-card mb-4">
        <div class="db-card-header">
            <div class="text-center" style="flex:1">
                <p class="db-card-eyebrow"><i class="bi bi-funnel me-1.5"></i>Règles & Seuils</p>
                <p class="db-card-title">Règles d'Escalade et Seuils Paramétrables</p>
            </div>
        </div>
        <div class="db-card-body">
            <div class="form-grid-2">
                {% for rule in rules %}
                <div class="form-section" style="margin-bottom:0">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <div class="d-flex align-items-center gap-2">
                            <code style="font-size:11px;font-weight:700;color:var(--amber)">{{ rule.cle }}</code>
                            {% if rule.isActif %}
                                <span class="status-pill status-active" style="font-size:9px"><span class="status-dot"></span>ACTIF</span>
                            {% else %}
                                <span class="status-pill status-inactive" style="font-size:9px"><span class="status-dot"></span>INACTIF</span>
                            {% endif %}
                        </div>
                        <form method="post" action="{{ path('app_admin_automation_rule_toggle', {id: rule.id}) }}">
                            <button type="submit" class="db-btn {% if rule.isActif %}db-btn-ghost{% else %}db-btn-emerald{% endif %} db-btn-sm">
                                {% if rule.isActif %}Désactiver{% else %}Activer{% endif %}
                            </button>
                        </form>
                    </div>

                    <p style="font-size:11px;color:var(--dim);line-height:1.6;text-align:center">{{ rule.description }}</p>

                    <form method="post" action="{{ path('app_admin_automation_rule_update', {id: rule.id}) }}" class="d-flex align-items-center gap-2 justify-content-center">
                        <label style="font-size:10px;color:var(--muted);font-weight:600">Seuil :</label>
                        <input type="text" name="valeur" value="{{ rule.valeur }}" class="form-input" style="width:80px;padding:4px 8px;font-size:11px;font-family:monospace;text-align:center">
                        <button type="submit" class="db-btn db-btn-amber db-btn-sm">
                            <i class="bi bi-save"></i>
                        </button>
                    </form>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ── Institutions de Transition / Transmission ── #}
    <div class="db-card mb-4">
        <div class="db-card-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <p class="db-card-eyebrow"><i class="bi bi-building-check me-1.5 text-emerald-400"></i>Paramètres &amp; Workflow</p>
                <p class="db-card-title">Institutions de Transition / Transmission ({{ institutions|length }})</p>
            </div>
            <button type="button" class="db-btn db-btn-emerald db-btn-sm" onclick="document.getElementById('addInstModal').classList.remove('hidden')">
                <i class="bi bi-plus-lg me-1"></i>Ajouter une institution
            </button>
        </div>
        <div class="db-card-body">
            <p style="font-size:12px;color:var(--dim);margin-bottom:16px;">
                Liste des institutions destinataires configurées manuellement par l'administrateur. Ces autorités apparaissent automatiquement dans le formulaire de transmission des alertes validées.
            </p>

            <div class="table-scroll">
                <table class="gei-table">
                    <thead>
                        <tr>
                            <th>Nom de l'Institution</th>
                            <th class="text-center" style="width:100px;">Ordre</th>
                            <th class="text-center" style="width:120px;">Statut</th>
                            <th class="text-center" style="width:130px;">Créée le</th>
                            <th class="text-end" style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for inst in institutions %}
                        <tr class="db-tr">
                            <td style="font-weight:600;color:var(--text);">
                                <i class="bi bi-building me-2 text-emerald-400"></i>{{ inst.libelle }}
                            </td>
                            <td class="text-center font-mono" style="font-size:11px;">{{ inst.ordreAffichage }}</td>
                            <td class="text-center">
                                {% if inst.actif %}
                                    <span class="status-pill status-active" style="font-size:9px"><span class="status-dot"></span>ACTIF</span>
                                {% else %}
                                    <span class="status-pill status-inactive" style="font-size:9px"><span class="status-dot"></span>INACTIF</span>
                                {% endif %}
                            </td>
                            <td class="text-center font-mono" style="font-size:11px;color:var(--muted);">{{ inst.createdAt|date('d/m/Y') }}</td>
                            <td class="text-end">
                                <form method="post" action="{{ path('app_admin_automation_institution_toggle', {id: inst.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_institution_' ~ inst.id) }}">
                                    <button type="submit" class="tbl-btn tbl-btn-ghost" title="{{ inst.actif ? 'Désactiver' : 'Activer' }}">
                                        <i class="bi bi-{{ inst.actif ? 'eye-slash' : 'eye' }}"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5">
                                <div class="db-empty-state" style="padding:24px;">
                                    <i class="bi bi-building text-slate-500 mb-2" style="font-size:24px;display:block;"></i>
                                    <p>Aucune institution personnalisée enregistrée pour le moment. Vous pouvez en ajouter une ci-dessus.</p>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Modal Ajout Institution ── #}
    <div id="addInstModal" class="modal-backdrop hidden" role="dialog" aria-modal="true">
        <div class="modal-box" style="max-width:480px;background:var(--navy-900);border:1px solid var(--border);border-radius:12px;padding:24px;">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <div>
                    <p class="modal-eyebrow" style="font-size:11px;color:var(--emerald);margin:0;"><i class="bi bi-plus-circle me-1"></i>Configuration</p>
                    <h3 class="modal-title" style="font-size:16px;font-weight:700;color:#fff;margin:0;">Ajouter une institution de transition</h3>
                </div>
                <button type="button" class="modal-close-btn" onclick="document.getElementById('addInstModal').classList.add('hidden')" aria-label="Fermer" style="background:none;border:none;color:var(--muted);font-size:20px;cursor:pointer;">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <form method="post" action="{{ path('app_admin_automation_institution_new') }}" class="space-y-4">
                <input type="hidden" name="_token" value="{{ csrf_token('add_institution_auto') }}">
                <div class="mb-3">
                    <label class="form-label" style="font-size:12px;font-weight:600;display:block;margin-bottom:6px;">Nom complet de l'Institution <span class="text-red-400">*</span></label>
                    <input type="text" name="libelle" class="form-input" style="width:100%;padding:8px 12px;" placeholder="ex. Haute Autorité Portuaire, Douanes du Niger..." required>
                </div>
                <div class="mb-4">
                    <label class="form-label" style="font-size:12px;font-weight:600;display:block;margin-bottom:6px;">Ordre d'affichage (optionnel)</label>
                    <input type="number" name="ordre_affichage" class="form-input" value="10" min="0" style="width:100%;padding:8px 12px;">
                </div>
                <div class="mb-4">
                    <label class="form-label" style="font-size:12px;font-weight:600;display:block;margin-bottom:6px;">Disponibilité dans les transmissions</label>
                    <select name="actif" class="form-select" style="width:100%;padding:8px 12px;">
                        <option value="1" selected>Active — proposée dans les choix</option>
                        <option value="0">Inactive — conservée, mais masquée des choix</option>
                    </select>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="db-btn db-btn-ghost db-btn-sm" onclick="document.getElementById('addInstModal').classList.add('hidden')">Annuler</button>
                    <button type="submit" class="db-btn db-btn-emerald db-btn-sm"><i class="bi bi-check-lg me-1"></i>Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    {# ── Historique des Déclenchements ── #}
    <div class="db-card">
        <div class="db-card-header">
            <div class="text-center" style="flex:1">
                <p class="db-card-eyebrow"><i class="bi bi-clock me-1.5"></i>Historique</p>
                <p class="db-card-title">Déclenchements Automatiques Récents</p>
            </div>
        </div>
        <div class="db-card-body">
            {# Barre de recherche centrée #}
            <div class="mb-3" style="max-width:500px;margin-left:auto;margin-right:auto">
                <div class="db-search-wrap" style="flex:1">
                    <i class="bi bi-search db-search-icon"></i>
                    <input type="text" placeholder="Rechercher par action, code alerte…"
                           class="db-search-input" style="width:100%"
                           id="triggerSearchInput" oninput="filterTriggers(this.value)">
                </div>
            </div>

            <div class="table-scroll">
                <table class="gei-table" id="triggersTable">
                    <thead>
                        <tr>
                            <th class="text-center"><i class="bi bi-calendar me-1 opacity-50"></i>Horodatage</th>
                            <th class="text-center"><i class="bi bi-bolt me-1 opacity-50"></i>Action Automatique</th>
                            <th class="text-center"><i class="bi bi-file-shield me-1 opacity-50"></i>Alerte concernée</th>
                            <th class="text-center"><i class="bi bi-bullseye me-1 opacity-50"></i>Résultat</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tr in triggers %}
                        <tr class="db-tr trigger-row"
                            data-action="{{ tr.action|lower }}"
                            data-code="{{ tr.alert ? tr.alert.codeGei|lower : '' }}">
                            <td class="font-mono text-center" style="color:var(--muted);font-size:11px;white-space:nowrap">
                                {{ tr.dateAction|date('d/m/Y H:i:s') }}
                            </td>
                            <td class="text-center">
                                <span style="font-weight:700;color:var(--amber)">{{ tr.action }}</span>
                            </td>
                            <td class="font-mono text-center" style="font-size:11px">
                                {% if tr.alert %}
                                    <a href="{{ path('app_alert_show', {token: encrypt_id(tr.alert.id, 'alert')}) }}" class="code-gei-link">
                                        {{ tr.alert.codeGei }}
                                    </a>
                                {% else %}
                                    <span style="color:var(--muted)">—</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <span class="status-pill status-active mx-auto" style="font-size:9px">
                                    <span class="status-dot"></span>Succès
                                </span>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4">
                                <div class="db-empty-state" style="padding:30px">
                                    <i class="bi bi-robot fa-2x" style="color:var(--muted);margin-bottom:8px;display:block"></i>
                                    <p>Aucun déclenchement récent enregistré.</p>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
/* ── Filtrage live des déclenchements ── */
let _triggerTimer;
function filterTriggers(q) {
    clearTimeout(_triggerTimer);
    _triggerTimer = setTimeout(() => {
        const term = q.toLowerCase().trim();
        document.querySelectorAll('.trigger-row').forEach(row => {
            const text = (row.dataset.action || '') + ' ' + (row.dataset.code || '');
            row.style.display = !term || text.includes(term) ? '' : 'none';
        });
    }, 250);
}
</script>
{% endblock %}
