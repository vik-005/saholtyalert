{% extends 'base.html.twig' %}

{% block title %}Espace Automatisations — GEI{% endblock %}
{% block header_title %}Espace Dédié Automatisations & Moteur de Règles (Spec B.1){% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Scheduler SLA Health Status Widget -->
    <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-extrabold text-xl">
                ⚡
            </div>
            <div>
                <h3 class="font-bold text-white text-base">État du Scheduler SLA & Automatisations</h3>
                <p class="text-xs text-slate-400">Exécution en arrière-plan toutes les 15 minutes (`messenger:consume` active)</p>
            </div>
        </div>

        <div class="flex items-center gap-4 text-xs">
            <div class="px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg">
                <span class="text-slate-500 font-medium">Dernier passage :</span>
                <span class="text-emerald-400 font-mono font-bold ml-1">{{ last_scheduler_run|date('H:i:s') }}</span>
            </div>
            <div class="px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg">
                <span class="text-slate-500 font-medium">Statut :</span>
                <span class="text-emerald-400 font-bold ml-1">✓ OPÉRATIONNEL</span>
            </div>
        </div>
    </div>

    <!-- Active Rules & Thresholds (Editable inline) -->
    <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-4">
        <div>
            <h3 class="text-lg font-bold text-white">Règles d'Escalade et Seuils Paramétrables</h3>
            <p class="text-xs text-slate-400">Modifier les valeurs ou basculer l'interrupteur marche/arrêt sans toucher au code</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for rule in rules %}
                <div class="p-5 bg-slate-950 border border-slate-800 rounded-xl flex flex-col justify-between space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-mono font-bold text-amber-400 text-xs">{{ rule.cle }}</span>
                            {% if rule.isActif %}
                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">ACTIF</span>
                            {% else %}
                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-red-500/10 text-red-400 border border-red-500/20">INACTIF</span>
                            {% endif %}
                        </div>

                        <!-- Toggle ON/OFF Switch -->
                        <form method="post" action="{{ path('app_admin_automation_rule_toggle', {id: rule.id}) }}">
                            <button type="submit" class="px-3 py-1 text-2xs font-bold rounded-lg border transition 
                                {% if rule.isActif %}
                                    bg-red-500/10 text-red-400 border-red-500/20 hover:bg-red-500/20
                                {% else %}
                                    bg-emerald-500/10 text-emerald-400 border-emerald-500/20 hover:bg-emerald-500/20
                                {% endif %}">
                                {% if rule.isActif %}Désactiver{% else %}Activer{% endif %}
                            </button>
                        </form>
                    </div>

                    <p class="text-xs text-slate-400">{{ rule.description }}</p>

                    <!-- Inline Value Update Form -->
                    <form method="post" action="{{ path('app_admin_automation_rule_update', {id: rule.id}) }}" class="flex items-center gap-2 pt-2 border-t border-slate-800">
                        <label class="text-2xs text-slate-400 font-semibold">Seuil :</label>
                        <input type="text" name="valeur" value="{{ rule.valeur }}" class="w-24 px-3 py-1 bg-slate-900 border border-slate-700 rounded text-xs text-white font-mono focus:border-amber-500">
                        <button type="submit" class="px-3 py-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-2xs rounded">Enregistrer</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- History of Automated Triggers -->
    <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-4">
        <h3 class="text-lg font-bold text-white">Historique des Déclenchements Automatiques Récentes</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300">
                <thead class="bg-slate-950 text-slate-400 uppercase font-semibold border-b border-slate-800">
                    <tr>
                        <th class="p-3">Horodatage</th>
                        <th class="p-3">Action Automatique</th>
                        <th class="p-3">Alerte concernée</th>
                        <th class="p-3">Résultat</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    {% for tr in triggers %}
                        <tr class="hover:bg-slate-800/40">
                            <td class="p-3 text-slate-400 font-mono whitespace-nowrap">{{ tr.dateAction|date('d/m/Y H:i:s') }}</td>
                            <td class="p-3 font-bold text-amber-400">{{ tr.action }}</td>
                            <td class="p-3 font-mono text-slate-200">{{ tr.alert ? tr.alert.codeGei : '-' }}</td>
                            <td class="p-3"><span class="text-emerald-400 font-bold">Succès</span></td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="p-6 text-center text-slate-500 italic">Aucun déclenchement récent enregistré.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
