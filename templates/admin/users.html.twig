{% extends 'base.html.twig' %}

{% block title %}Gestion Utilisateurs — GEI{% endblock %}
{% block header_title %}Gestion des Utilisateurs GEI{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-amber-400 font-bold">Utilisateurs</p>
            <h3 class="text-xl font-bold text-white mt-2">Utilisateurs enregistrés</h3>
        </div>
        <a href="{{ path('app_admin_user_new') }}" class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold text-xs rounded-2xl shadow-[0_18px_30px_-18px_rgba(251,191,36,0.9)]">
            <span class="text-lg leading-none">+</span>
            Créer un Utilisateur
        </a>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-[1.5rem] overflow-hidden shadow-[0_30px_80px_-35px_rgba(15,23,42,1)]">
        <div class="p-4 border-b border-slate-800 bg-slate-950/60">
            <div class="flex flex-col sm:flex-row gap-3">
                <input type="text" placeholder="Rechercher un utilisateur..." class="w-full rounded-2xl border border-slate-700 bg-slate-900 px-3 py-2.5 text-xs text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
                <select class="rounded-2xl border border-slate-700 bg-slate-900 px-3 py-2.5 text-xs text-white focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                    <option value="">Tous les statuts</option>
                    <option value="actif">Actif</option>
                    <option value="inactif">Inactif</option>
                    <option value="en-attente">En attente</option>
                </select>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300">
                <thead class="bg-slate-950 text-slate-400 uppercase font-semibold border-b border-slate-800">
                    <tr>
                        <th class="p-3">Nom Complet</th>
                        <th class="p-3">Email</th>
                        <th class="p-3">Rôle GEI</th>
                        <th class="p-3">Marché</th>
                        <th class="p-3">Statut</th>
                        <th class="p-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    {% for u in users %}
                        <tr class="hover:bg-slate-800/40 transition">
                            <td class="p-3 font-bold text-white">{{ u.nomComplet }}</td>
                            <td class="p-3 text-slate-400 font-mono">{{ u.email }}</td>
                            <td class="p-3"><span class="px-2.5 py-1 bg-amber-500/10 text-amber-400 font-bold rounded-full border border-amber-500/20">{{ u.role.label }}</span></td>
                            <td class="p-3">{{ u.market ? u.market.nom : 'Global' }}</td>
                            <td class="p-3">
                                {% if u.actif is same as(true) %}
                                    <span class="status-badge status-active">Actif</span>
                                {% elseif u.actif is same as(false) %}
                                    <span class="status-badge status-inactive">Inactif</span>
                                {% else %}
                                    <span class="status-badge status-pending">En attente</span>
                                {% endif %}
                            </td>
                            <td class="p-3 text-right">
                                <div class="inline-flex items-center gap-2">
                                    <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="inline-flex items-center justify-center px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl border border-slate-700 text-2xs font-semibold">Éditer</a>
                                    <button type="button" class="delete-trigger inline-flex items-center justify-center px-2.5 py-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-300 rounded-xl border border-red-500/20 text-2xs font-semibold" data-delete-url="{{ path('app_admin_user_delete', {id: u.id}) }}" data-delete-token="{{ csrf_token('delete-user-' ~ u.id) }}">Supprimer</button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
