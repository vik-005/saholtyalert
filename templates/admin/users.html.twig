{% extends 'base.html.twig' %}
{% block title %}Utilisateurs — GEI{% endblock %}
{% block header_title %}Utilisateurs{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête ── #}
    <div class="page-header-row">
        <div>
            <p class="page-eyebrow"><i class="bi-people me-1.5"></i>Administration · RBAC Annexe D</p>
            <h2 class="page-title">Gestion des utilisateurs</h2>
            <p class="page-subtitle">
                {{ users|length }} utilisateur{{ users|length > 1 ? 's' : '' }} enregistré{{ users|length > 1 ? 's' : '' }}
                sur la plateforme GEI.
            </p>
        </div>
        <a href="{{ path('app_admin_user_new') }}" class="db-btn db-btn-amber">
            <i class="bi-person-plus me-1.5"></i>Créer un utilisateur
        </a>
    </div>

    {# ── Barre de recherche ── #}
    <div class="db-chart-card" style="padding:12px 16px">
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <div class="db-search-wrap" style="flex:1;min-width:200px">
                <i class="bi-search db-search-icon"></i>
                <input type="text" placeholder="Rechercher par nom, email, rôle…"
                       class="db-search-input" style="width:100%"
                       id="userSearchInput" oninput="filterUsers(this.value)">
            </div>
            <select class="db-select" id="userRoleFilter" onchange="filterUsers()">
                <option value="">Tous les rôles</option>
                <option value="émetteur terrain">Agent (Émetteur Terrain)</option>
                <option value="point focal technique">Manager (PFT)</option>
                <option value="saholty">Analyste SAHOLTY</option>
                <option value="super administrateur">Super Administrateur</option>
                <option value="secrétariat gei">Secrétariat GEI</option>
                <option value="comité ait">Comité AIT</option>
            </select>
            <select class="db-select" id="userStatusFilter" onchange="filterUsers()">
                <option value="">Tous les statuts</option>
                <option value="actif">Actif</option>
                <option value="inactif">Inactif</option>
            </select>
        </div>
    </div>

    {# ── Tableau ── #}
    <div class="db-table-card">
        <div class="db-table-wrap">
            <table class="db-table" id="usersTable">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Rôle GEI</th>
                        <th>Marché(s)</th>
                        <th>2FA</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                    <tr class="db-tr user-row"
                        data-name="{{ u.nomComplet|lower }}"
                        data-email="{{ u.email|lower }}"
                        data-role="{{ u.role.label()|lower }}"
                        data-status="{{ u.actif ? 'actif' : 'inactif' }}">

                        <td>
                            <div class="adm-user-cell">
                                <div class="profile-avatar adm-avatar">
                                    {{ u.prenom|slice(0,1) }}{{ u.nom|slice(0,1) }}
                                </div>
                                <div>
                                    <span class="adm-user-name">{{ u.nomComplet }}</span>
                                    {% if u.fonction %}
                                        <span class="adm-user-sub">{{ u.fonction }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </td>

                        <td class="adm-mono">{{ u.email }}</td>

                        <td>
                            {% set roleColor = {
                                'ROLE_SUPERADMIN':     'priority-critique',
                                'ROLE_SAHOLTY':        'priority-eleve',
                                'ROLE_PFT':            'priority-modere',
                                'ROLE_EMETTEUR_TERRAIN':'priority-faible',
                                'ROLE_COMITE_AIT':     'priority-modere',
                                'ROLE_SECRETARIAT_GEI':'priority-faible',
                            } %}
                            <span class="priority-badge {{ roleColor[u.role.value] ?? 'priority-faible' }} adm-role-badge">
                                {{ u.role.label() }}
                            </span>
                        </td>

                        <td>
                            {% if u.agentMarkets is defined and u.agentMarkets|length > 0 %}
                                <div class="adm-markets">
                                    {% for m in u.agentMarkets %}
                                        <span class="adm-market-tag">{{ m.codeIso3 }}</span>
                                    {% endfor %}
                                </div>
                            {% elseif u.market %}
                                <span class="adm-text-dim">{{ u.market.nom }}</span>
                            {% else %}
                                <span class="adm-text-muted">Global</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if u.totpEnabled %}
                                <span class="adm-2fa-on">
                                    <i class="bi-shield-check-fill me-1"></i>Actif
                                </span>
                            {% else %}
                                <span class="adm-2fa-off">
                                    <i class="bi-shield-slash me-1"></i>Off
                                </span>
                            {% endif %}
                        </td>

                        <td>
                            {% if u.actif is same as(true) %}
                                <span class="status-pill status-transmis">
                                    <span class="status-dot"></span>Actif
                                </span>
                            {% else %}
                                <span class="status-pill status-archive">
                                    <span class="status-dot"></span>Inactif
                                </span>
                            {% endif %}
                        </td>

                        <td>
                            <div class="table-actions">
                                <a href="{{ path('app_admin_user_edit', {id: u.id}) }}"
                                   class="tbl-btn tbl-btn-ghost" title="Éditer">
                                    <i class="bi-pencil-square"></i>
                                </a>
                                <button type="button"
                                        class="delete-trigger tbl-btn tbl-btn-red"
                                        title="Supprimer"
                                        data-delete-url="{{ path('app_admin_user_delete', {id: u.id}) }}"
                                        data-delete-token="{{ csrf_token('delete-user-' ~ u.id) }}">
                                    <i class="bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7">
                            <div class="db-empty-state">
                                <i class="bi-person fa-2x" style="color:var(--muted);margin-bottom:8px;display:block"></i>
                                <p>Aucun utilisateur enregistré.</p>
                                <a href="{{ path('app_admin_user_new') }}" class="db-btn db-btn-amber" style="margin-top:12px">
                                    <i class="bi-plus me-1.5"></i>Créer le premier utilisateur
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

{% block javascripts %}
{{ parent() }}
<style>
/* ── Tableau utilisateurs ── */
.adm-user-cell { display:flex; align-items:center; gap:10px; }
.adm-avatar    { width:32px; height:32px; font-size:11px; font-weight:800; border-radius:9px; flex-shrink:0; }
.adm-user-name { display:block; font-weight:700; color:var(--text); font-size:12.5px; line-height:1.3; }
.adm-user-sub  { display:block; font-size:10.5px; color:var(--text-muted); margin-top:1px; }
.adm-mono      { font-family:'JetBrains Mono',monospace; color:var(--dim); font-size:11px; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.adm-role-badge { font-size:10.5px !important; white-space:nowrap; }
.adm-markets   { display:flex; flex-wrap:wrap; gap:4px; }
.adm-market-tag {
    display:inline-flex; align-items:center; gap:2px;
    font-size:10px; font-weight:700;
    background:rgba(251,191,36,.1); color:var(--amber);
    padding:2px 7px; border-radius:99px;
    border:1px solid rgba(251,191,36,.25);
}
.adm-text-dim  { font-size:12px; color:var(--dim); }
.adm-text-muted { font-size:12px; color:var(--text-muted); font-style:italic; }
.adm-2fa-on  { display:inline-flex; align-items:center; font-size:10.5px; font-weight:700; color:#6ee7b7; }
.adm-2fa-off { display:inline-flex; align-items:center; font-size:10.5px; color:var(--text-muted); }
/* En-têtes tableau : visibles et centrés */
.db-table thead th {
    font-size:10px !important; font-weight:700 !important;
    letter-spacing:.06em; text-transform:uppercase;
    color:var(--text-muted) !important; padding:12px 14px !important;
    white-space:nowrap; background:var(--card2);
    border-bottom:1px solid var(--border);
}
.db-table tbody td {
    font-size:12px; color:var(--dim); padding:11px 14px;
    border-bottom:1px solid rgba(148,163,184,.06);
    vertical-align:middle;
}
.db-table .db-tr:last-child td { border-bottom:none; }
</style>
<script>
/* ── Filtrage live côté client ── */
function filterUsers(val) {
    const search = (document.getElementById('userSearchInput').value || '').toLowerCase().trim();
    const role   = (document.getElementById('userRoleFilter').value || '').toLowerCase();
    const status = (document.getElementById('userStatusFilter').value || '').toLowerCase();

    document.querySelectorAll('.user-row').forEach(row => {
        const name   = row.dataset.name   || '';
        const email  = row.dataset.email  || '';
        const rLabel = row.dataset.role   || '';
        const rVal   = row.dataset.status || '';

        const matchSearch = !search || name.includes(search) || email.includes(search) || rLabel.includes(search);
        const matchRole   = !role   || rLabel.includes(role);
        const matchStatus = !status || rVal === status;

        row.style.display = (matchSearch && matchRole && matchStatus) ? '' : 'none';
    });
}

/* ── Modale de confirmation suppression ── */
document.querySelectorAll('.delete-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
        const url   = btn.dataset.deleteUrl;
        const token = btn.dataset.deleteToken;
        const form  = document.getElementById('deleteConfirmForm');
        const inp   = document.getElementById('deleteTokenInput');
        if (form && url) {
            form.action = url;
            if (inp) inp.value = token ?? '';
            document.getElementById('confirmModal').classList.remove('hidden');
        }
    });
});
</script>
{% endblock %}
{% endblock %}
