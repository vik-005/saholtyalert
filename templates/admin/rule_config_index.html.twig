{% extends 'base.html.twig' %}

{% block title %}Règles de Scoring — Administration GEI{% endblock %}
{% block header_title %}Règles de Scoring{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# En-tête #}
    <div class="page-header-row">
        <div>
            <p class="page-eyebrow">
                <i class="bi bi-sliders me-1.5 text-amber-400"></i>
                Administration · Configuration
            </p>
            <h2 class="page-title">Règles de scoring & seuils</h2>
            <p class="page-subtitle">
                Gérez les seuils de priorité GEI (Annexe C). Les modifications sont prises en compte immédiatement.
            </p>
        </div>
        <a href="{{ path('app_dashboard_superadmin') }}" class="db-btn db-btn-ghost">
            <i class="bi bi-arrow-left me-1.5"></i>Retour Admin
        </a>
    </div>

    {# KPIs #}
    <div class="kpi-row mb-4">
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-list-ul text-amber-400"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ rules|length }}</p>
                <p class="kpi-card-label">Total règles</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-check-circle text-emerald-400"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ rules|filter(r => r.actif)|length }}</p>
                <p class="kpi-card-label">Actives</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-stars text-blue-400"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ rules|filter(r => r.categorie == 'scoring')|length }}</p>
                <p class="kpi-card-label">Scoring</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-stopwatch text-orange-400"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ rules|filter(r => r.categorie == 'sla')|length }}</p>
                <p class="kpi-card-label">SLA</p>
            </div>
        </div>
    </div>

    {# Recherche #}
    <div class="db-card mb-4">
        <div class="db-card-body" style="padding:12px 16px;">
            <div class="db-search-wrap" style="flex:1">
                <i class="bi-search db-search-icon"></i>
                <input type="text" placeholder="Rechercher une règle par clé, description, catégorie…"
                       class="db-search-input" style="width:100%"
                       id="ruleSearchInput" oninput="filterRules(this.value)">
            </div>
        </div>
    </div>

    {# Groupement par catégorie #}
    {% set categories = {} %}
    {% for rule in rules %}
        {% set cat = rule.categorie ?? 'general' %}
        {% if categories[cat] is not defined %}
            {% set categories = categories|merge({(cat): []}) %}
        {% endif %}
        {% set categories = categories|merge({(cat): categories[cat]|merge([rule])}) %}
    {% endfor %}

    {% for categorie, catRules in categories %}
    <div class="db-card mb-4">
        <div class="db-card-header">
            <p class="db-card-eyebrow">
                {% if categorie == 'scoring' %}
                    <i class="bi bi-stars text-amber-400 me-1.5"></i>Scoring
                {% elseif categorie == 'sla' %}
                    <i class="bi bi-stopwatch text-blue-400 me-1.5"></i>SLA
                {% else %}
                    <i class="bi bi-funnel text-slate-400 me-1.5"></i>{{ categorie|capitalize }}
                {% endif %}
            </p>
            <span class="text-xs text-slate-500">{{ catRules|length }} règle{{ catRules|length > 1 ? 's' : '' }}</span>
        </div>
        <div class="db-card-body p-0">
            <div class="table-scroll">
                <table class="gei-table">
                    <thead>
                        <tr>
                            <th>Clé</th>
                            <th>Valeur</th>
                            <th>Description</th>
                            <th>Statut</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for rule in catRules %}
                        <tr class="{% if not rule.actif %}opacity-50{% endif %}"
                            data-key="{{ rule.cle|lower }}"
                            data-desc="{{ rule.description|lower }}"
                            data-cat="{{ categorie|lower }}">
                            <td>
                                <span class="font-mono text-amber-400 text-xs">{{ rule.cle }}</span>
                            </td>
                            <td>
                                <span class="text-white font-semibold">{{ rule.valeur }}</span>
                                {% if categorie == 'scoring' %}
                                    <span class="text-xs text-slate-500 ms-1">points</span>
                                {% elseif categorie == 'sla' %}
                                    <span class="text-xs text-slate-500 ms-1">heures</span>
                                {% endif %}
                            </td>
                            <td class="text-slate-300 text-sm">{{ rule.description }}</td>
                            <td>
                                {% if rule.modifiable %}
                                    <span class="status-pill status-active">
                                        <span class="status-dot"></span>Modifiable
                                    </span>
                                {% else %}
                                    <span class="status-pill status-closed">
                                        <span class="status-dot"></span>Fixe
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-right">
                                {% if rule.modifiable %}
                                    <a href="{{ path('app_admin_rule_edit', {id: rule.id}) }}" class="db-btn db-btn-ghost db-btn-sm">
                                        <i class="bi bi-pencil me-1"></i>Modifier
                                    </a>
                                {% else %}
                                    <span class="text-xs text-slate-500">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endfor %}

    {% if rules|length == 0 %}
    <div class="db-card">
        <div class="db-card-body text-center py-12">
            <i class="bi bi-funnel fa-2x text-slate-600 mb-3"></i>
            <p class="text-slate-400">Aucune règle de configuration trouvée.</p>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
let _ruleTimer;
function filterRules(q) {
    clearTimeout(_ruleTimer);
    _ruleTimer = setTimeout(() => {
        const term = q.toLowerCase().trim();
        document.querySelectorAll('.gei-table tbody tr').forEach(row => {
            const text = (row.dataset.key || '') + ' ' + (row.dataset.desc || '') + ' ' + (row.dataset.cat || '');
            row.style.display = !term || text.includes(term) ? '' : 'none';
        });
        document.querySelectorAll('.db-card').forEach(card => {
            const rows = card.querySelectorAll('.gei-table tbody tr');
            const visible = Array.from(rows).some(r => r.style.display !== 'none');
            card.style.display = visible ? '' : 'none';
        });
    }, 200);
}
</script>
{% endblock %}
