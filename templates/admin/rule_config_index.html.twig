{% extends 'base.html.twig' %}
{% block title %}Règles de Scoring — Administration GEI{% endblock %}
{% block header_title %}Règles de Scoring{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# En-tête page #}
    <div class="page-header-row">
        <div>
            <p class="page-eyebrow">
                <i class="fa-solid fa-screwdriver-wrench me-1.5 text-amber-400"></i>Administration
            </p>
            <h2 class="page-title">Règles de scoring & seuils</h2>
            <p class="page-subtitle">
                Configurez les seuils de priorité GEI (Annexe C). Toute modification est immédiatement prise en compte
                sans redéploiement. Les valeurs par défaut sont issues de l'Annexe C officielle.
            </p>
        </div>
        <a href="{{ path('app_dashboard_superadmin') }}" class="db-btn db-btn-ghost">
            <i class="fa-solid fa-arrow-left me-1.5"></i>Retour Admin
        </a>
    </div>

    {# Rappel formule #}
    <div class="rule-formula-card">
        <div class="rule-formula-icon">
            <i class="fa-solid fa-function"></i>
        </div>
        <div class="rule-formula-body">
            <p class="rule-formula-label">Formule officielle Annexe C — non modifiable</p>
            <p class="rule-formula-text">
                Score GEI = <strong>(Fiabilité × Crédibilité)</strong> + Urgence + Impact + Exploitabilité
            </p>
            <div class="rule-formula-legend">
                <span>Fiabilité : A=4, B=3, C=2, D=1</span>
                <span class="rule-sep">·</span>
                <span>Crédibilité : 1→4, 2→3, 3→2, 4→1 (inversée)</span>
                <span class="rule-sep">·</span>
                <span>Urgence : Immédiat=3, 72h=2, Routine=1</span>
                <span class="rule-sep">·</span>
                <span>Impact : Élevé=3, Moyen=2, Faible=1</span>
                <span class="rule-sep">·</span>
                <span>Exploitabilité : Actionnable=3, À compléter=2, Archivage=1</span>
            </div>
        </div>
    </div>

    {# Grille de règles groupées par catégorie #}
    {% set categories = {} %}
    {% for rule in rules %}
        {% set cat = rule.categorie ?? 'general' %}
        {% if categories[cat] is not defined %}
            {% set categories = categories|merge({(cat): []}) %}
        {% endif %}
        {% set categories = categories|merge({(cat): categories[cat]|merge([rule])}) %}
    {% endfor %}

    {% for categorie, catRules in categories %}
    <div class="rule-section">
        <div class="rule-section-header">
            <span class="rule-section-icon">
                {% if categorie == 'scoring' %}
                    <i class="fa-solid fa-star-half-stroke text-amber-400"></i>
                {% elseif categorie == 'sla' %}
                    <i class="fa-solid fa-stopwatch text-blue-400"></i>
                {% else %}
                    <i class="fa-solid fa-sliders text-slate-400"></i>
                {% endif %}
            </span>
            <span class="rule-section-title">
                {{ categorie|capitalize }} — {{ catRules|length }} règle{{ catRules|length > 1 ? 's' : '' }}
            </span>
        </div>

        <div class="rule-cards-grid">
            {% for rule in catRules %}
            <div class="rule-card {% if not rule.actif %}rule-card-inactive{% endif %}">
                <div class="rule-card-top">
                    <div class="rule-card-key">
                        <i class="fa-solid fa-key fa-xs me-1.5 opacity-50"></i>
                        <code>{{ rule.cle }}</code>
                    </div>
                    <div class="rule-card-badges">
                        {% if rule.modifiable %}
                            <span class="rule-badge rule-badge-green">
                                <i class="fa-solid fa-pen fa-xs me-1"></i>Modifiable
                            </span>
                        {% else %}
                            <span class="rule-badge rule-badge-slate">
                                <i class="fa-solid fa-lock fa-xs me-1"></i>Fixe
                            </span>
                        {% endif %}
                        <span class="rule-badge {% if rule.actif %}rule-badge-emerald{% else %}rule-badge-red{% endif %}">
                            <i class="fa-solid fa-circle fa-xs me-1"></i>
                            {{ rule.actif ? 'Actif' : 'Inactif' }}
                        </span>
                    </div>
                </div>

                <div class="rule-card-value-row">
                    <span class="rule-card-value">{{ rule.valeur }}</span>
                    {% if categorie == 'scoring' %}
                        <span class="rule-card-unit">points</span>
                    {% elseif categorie == 'sla' %}
                        <span class="rule-card-unit">heures</span>
                    {% endif %}
                </div>

                <p class="rule-card-desc">{{ rule.description }}</p>

                {# Visualisation barre pour seuils scoring #}
                {% if categorie == 'scoring' %}
                <div class="rule-card-bar-wrap">
                    <div class="rule-card-bar-track">
                        <div class="rule-card-bar-fill"
                             style="width: {{ (rule.valeur / 25 * 100)|round > 100 ? 100 : (rule.valeur / 25 * 100)|round }}%"></div>
                    </div>
                    <span class="rule-card-bar-max">/25</span>
                </div>
                {% endif %}

                {% if rule.modifiable %}
                <div class="rule-card-footer">
                    <a href="{{ path('app_admin_rule_edit', {id: rule.id}) }}" class="rule-edit-btn">
                        <i class="fa-solid fa-pen-to-square me-1.5"></i>Modifier
                    </a>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    {% endfor %}

    {% if rules|length == 0 %}
    <div class="db-empty-state">
        <i class="fa-solid fa-sliders fa-2x text-slate-600 mb-3"></i>
        <p>Aucune règle de configuration trouvée.</p>
        <p class="text-xs mt-2 text-slate-600">Exécutez la migration <code>Version20260817120100</code> pour initialiser les seuils.</p>
    </div>
    {% endif %}

</div>

<style>
.page-header-row { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
.page-eyebrow { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.12em; color:var(--amber); margin-bottom:6px; }
.page-title { font-size:22px; font-weight:800; color:#fff; margin-bottom:6px; }
.page-subtitle { font-size:12.5px; color:var(--text-muted); max-width:600px; line-height:1.6; }

.rule-formula-card { display:flex; gap:16px; align-items:flex-start; background:var(--navy-900); border:1px solid var(--border); border-left:3px solid var(--amber); border-radius:var(--radius); padding:18px; }
.rule-formula-icon { width:40px; height:40px; background:var(--amber-dim); border-radius:10px; display:grid; place-items:center; color:var(--amber); font-size:18px; flex-shrink:0; }
.rule-formula-label { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-muted); margin-bottom:6px; }
.rule-formula-text { font-size:14px; font-weight:600; color:#fff; margin-bottom:8px; }
.rule-formula-legend { display:flex; flex-wrap:wrap; gap:6px; font-size:11px; color:var(--text-muted); }
.rule-sep { color:var(--border-strong); }

.rule-section { display:flex; flex-direction:column; gap:14px; }
.rule-section-header { display:flex; align-items:center; gap:10px; padding-bottom:8px; border-bottom:1px solid var(--border); }
.rule-section-icon { font-size:16px; }
.rule-section-title { font-size:13px; font-weight:700; color:#fff; }

.rule-cards-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:14px; }
.rule-card { background:var(--navy-900); border:1px solid var(--border); border-radius:var(--radius); padding:18px; transition:border-color .2s; }
.rule-card:hover { border-color:var(--border-strong); }
.rule-card-inactive { opacity:.5; }

.rule-card-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
.rule-card-key { display:flex; align-items:center; font-size:11px; color:var(--text-muted); }
.rule-card-key code { font-family:'JetBrains Mono','Fira Code',monospace; font-size:11px; color:var(--amber); }
.rule-card-badges { display:flex; gap:6px; }
.rule-badge { font-size:9.5px; font-weight:700; padding:2px 7px; border-radius:99px; }
.rule-badge-green   { background:rgba(251,191,36,.1); color:var(--amber); border:1px solid var(--amber-border); }
.rule-badge-slate   { background:var(--navy-800); color:var(--text-muted); border:1px solid var(--border); }
.rule-badge-emerald { background:rgba(52,211,153,.1); color:#34d399; border:1px solid rgba(52,211,153,.2); }
.rule-badge-red     { background:rgba(239,68,68,.1); color:#f87171; border:1px solid rgba(239,68,68,.2); }

.rule-card-value-row { display:flex; align-items:baseline; gap:6px; margin-bottom:8px; }
.rule-card-value { font-size:42px; font-weight:900; color:#fff; line-height:1; }
.rule-card-unit  { font-size:13px; color:var(--text-muted); font-weight:500; }
.rule-card-desc  { font-size:11.5px; color:var(--text-muted); line-height:1.6; margin-bottom:12px; }

.rule-card-bar-wrap { display:flex; align-items:center; gap:8px; margin-bottom:14px; }
.rule-card-bar-track { flex:1; height:5px; background:var(--navy-800); border-radius:99px; overflow:hidden; }
.rule-card-bar-fill  { height:100%; background:linear-gradient(90deg,var(--amber),#f97316); border-radius:99px; }
.rule-card-bar-max   { font-size:10.5px; color:var(--text-muted); white-space:nowrap; }

.rule-card-footer { border-top:1px solid var(--border); padding-top:12px; }
.rule-edit-btn { display:inline-flex; align-items:center; font-size:12px; font-weight:600; color:var(--amber); transition:opacity .2s; }
.rule-edit-btn:hover { opacity:.75; }
</style>
{% endblock %}

