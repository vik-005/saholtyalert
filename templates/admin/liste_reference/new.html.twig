{% extends 'base.html.twig' %}
{% block title %}Ajouter une valeur — Listes de référence{% endblock %}
{% block header_title %}Ajouter une valeur{% endblock %}

{% block body %}
<div class="db-wrapper">

    <div class="page-header-row">
        <div class="text-center" style="flex:1">
            <p class="page-eyebrow">
                <i class="bi bi-list-check me-1.5 text-amber-400"></i>
                Administration · Listes de référence
            </p>
            <h2 class="page-title">Ajouter une valeur</h2>
            <p class="page-subtitle mx-auto" style="max-width:500px">
                Cette valeur apparaîtra dans le menu déroulant correspondant du formulaire Agent.
            </p>
        </div>
    </div>

    <div class="db-card mx-auto" style="max-width: 600px;">
        <div class="db-card-body">
            <form method="post" action="{{ path('app_admin_liste_reference_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('lrv_new') }}">
                <div class="form-field mb-4">
                    <label class="form-label text-center" for="lr_type">Type de liste <span class="text-red-400">*</span></label>
                    <select name="type_liste" id="lr_type" class="form-select" required onchange="toggleLocalityFields(this.value)">
                        <option value="">Sélectionnez un type…</option>
                        <option value="categorie">Catégorie de produit / marchandise</option>
                        <option value="type_source">Type de source d'information</option>
                        <option value="localite">Localité stratégique (Port, Corridor, Aéroport, Ville)</option>
                        <option value="institution_transmission">Institution de transition / transmission</option>
                    </select>
                </div>

                <div class="form-field mb-4" id="field_nature_localite" style="display:none;">
                    <label class="form-label text-center" for="lr_nature">Type de localité / infrastructure</label>
                    <select name="nature_localite" id="lr_nature" class="form-select">
                        <option value="Port">Port maritime / fluvial</option>
                        <option value="Corridor">Corridor de transit</option>
                        <option value="Aéroport">Aéroport international</option>
                        <option value="Frontière">Poste frontalier</option>
                        <option value="Ville">Ville / Centre logistique</option>
                    </select>
                    <p class="form-help text-center">Permet de classifier automatiquement la localité (ex: [Port] Port Autonome de Cotonou).</p>
                </div>

                <div class="form-field mb-4">
                    <label class="form-label text-center" for="lr_libelle">Nom / Libellé <span class="text-red-400">*</span></label>
                    <input type="text" name="libelle" id="lr_libelle" class="form-input" required
                           placeholder="ex. Port de Cotonou, Corridor Abidjan-Ouaga, Source terrain…" maxlength="150">
                    <p class="form-help text-center" id="libelle_help">Le texte exact qui apparaîtra dans les menus déroulants et sélections.</p>
                </div>

                <div class="form-field mb-4">
                    <label class="form-label text-center" for="lr_ordre">Ordre d'affichage</label>
                    <input type="number" name="ordre_affichage" id="lr_ordre" class="form-input"
                           value="0" min="0" max="999">
                    <p class="form-help text-center">Plus le numéro est petit, plus la valeur apparaît en haut (0 = auto).</p>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <a href="{{ path('app_admin_liste_reference_index') }}" class="db-btn db-btn-ghost">Annuler</a>
                    <button type="submit" class="db-btn db-btn-amber">
                        <i class="bi bi-plus me-1.5"></i>Ajouter
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
<script>
function toggleLocalityFields(val) {
    const natField = document.getElementById('field_nature_localite');
    const libelleHelp = document.getElementById('libelle_help');
    if (val === 'localite') {
        natField.style.display = 'block';
        libelleHelp.textContent = 'Nom de l\'infrastructure ou de la ville (ex: Port Autonome de Cotonou). Le type sélectionné ci-dessus sera préfixé automatiquement si nécessaire.';
    } else if (val === 'institution_transmission') {
        natField.style.display = 'none';
        libelleHelp.textContent = 'Nom complet ou sigle de l\'institution de transition/transmission (ex: INTERPOL NCB, DOUANES CI).';
    } else {
        natField.style.display = 'none';
        libelleHelp.textContent = 'Le texte exact qui apparaîtra dans les menus déroulants.';
    }
}
</script>
{% endblock %}
