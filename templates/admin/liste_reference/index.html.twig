{% extends 'base.html.twig' %}
{% block title %}Listes de référence — Admin{% endblock %}
{% block header_title %}Listes de référence{% endblock %}

{% block body %}
<div class="db-wrapper">

    {# ── En-tête centré ── #}
    <div class="page-header-row">
        <div class="text-center" style="flex:1">
            <p class="page-eyebrow">
                <i class="bi bi-list-check me-1.5 text-amber-400"></i>
                Administration · Paramètres système
            </p>
            <h2 class="page-title">Listes de référence</h2>
            <p class="page-subtitle mx-auto" style="max-width:700px">
                Gérez les valeurs des menus déroulants <strong class="text-white">Catégorie</strong> et
                <strong class="text-white">Type de source</strong> utilisés dans le formulaire Agent.
                Les valeurs désactivées n'apparaissent plus pour les nouvelles alertes mais restent visibles sur l'historique.
            </p>
        </div>
        <a href="{{ path('app_admin_liste_reference_new') }}" class="db-btn db-btn-amber">
            <i class="bi bi-plus me-1.5"></i>Ajouter une valeur
        </a>
    </div>

    {# ── KPIs centrés ── #}
    <div class="kpi-row mb-4">
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-tags text-amber-400"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ categories|length }}</p>
                <p class="kpi-card-label">Catégories</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-check-circle text-emerald-400"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ categories|filter(c => c.actif)|length }}</p>
                <p class="kpi-card-label">Catégories actives</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-eye-slash text-slate-500"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ categories|filter(c => not c.actif)|length }}</p>
                <p class="kpi-card-label">Catégories désactivées</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-icon"><i class="bi bi-collection text-blue-400"></i></div>
            <div class="kpi-card-body">
                <p class="kpi-card-val">{{ typeSources|length }}</p>
                <p class="kpi-card-label">Types de source</p>
            </div>
        </div>
    </div>

    {# ── Tableau Catégories ── #}
    <div class="db-card mb-4">
        <div class="db-card-header">
            <p class="db-card-eyebrow">
                <i class="bi bi-tags me-1.5"></i>Catégories d'alerte
            </p>
            <span class="text-xs text-slate-500">{{ categories|length }} valeur{{ categories|length > 1 ? 's' : '' }}</span>
        </div>
        <div class="db-card-body p-0">
            <div class="table-scroll">
                <table class="gei-table">
                    <thead>
                        <tr>
                            <th class="text-center">Libellé</th>
                            <th class="text-center">Ordre</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Créé le</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for item in categories %}
                        <tr class="{% if not item.actif %}opacity-50{% endif %}">
                            <td class="text-center">
                                <span class="font-semibold text-white">{{ item.libelle }}</span>
                            </td>
                            <td class="text-slate-400 text-sm text-center">{{ item.ordreAffichage }}</td>
                            <td class="text-center">
                                {% if item.actif %}
                                    <span class="status-pill status-active mx-auto">
                                        <span class="status-dot"></span>Actif
                                    </span>
                                {% else %}
                                    <span class="status-pill status-closed mx-auto">
                                        <span class="status-dot"></span>Désactivé
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-xs text-slate-500 text-center">{{ item.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a href="{{ path('app_admin_liste_reference_edit', {id: item.id}) }}"
                                       class="db-btn db-btn-ghost db-btn-sm">
                                        <i class="bi bi-pen me-1"></i>Modifier
                                    </a>
                                    <form method="post" action="{{ path('app_admin_liste_reference_toggle', {id: item.id}) }}" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-lrv-' ~ item.id) }}">
                                        <button type="submit" class="db-btn db-btn-sm db-btn-ghost">
                                            {% if item.actif %}
                                                <i class="bi bi-eye-slash me-1"></i>Désactiver
                                            {% else %}
                                                <i class="bi bi-eye me-1"></i>Activer
                                            {% endif %}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-slate-500 py-8">
                                Aucune catégorie enregistrée.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Tableau Types de source ── #}
    <div class="db-card mb-4">
        <div class="db-card-header">
            <p class="db-card-eyebrow">
                <i class="bi bi-collection me-1.5"></i>Types de source (champ 11)
            </p>
            <span class="text-xs text-slate-500">{{ typeSources|length }} valeur{{ typeSources|length > 1 ? 's' : '' }}</span>
        </div>
        <div class="db-card-body p-0">
            <div class="table-scroll">
                <table class="gei-table">
                    <thead>
                        <tr>
                            <th class="text-center">Libellé</th>
                            <th class="text-center">Ordre</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Créé le</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for item in typeSources %}
                        <tr class="{% if not item.actif %}opacity-50{% endif %}">
                            <td class="text-center">
                                <span class="font-semibold text-white">{{ item.libelle }}</span>
                            </td>
                            <td class="text-slate-400 text-sm text-center">{{ item.ordreAffichage }}</td>
                            <td class="text-center">
                                {% if item.actif %}
                                    <span class="status-pill status-active mx-auto">
                                        <span class="status-dot"></span>Actif
                                    </span>
                                {% else %}
                                    <span class="status-pill status-closed mx-auto">
                                        <span class="status-dot"></span>Désactivé
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-xs text-slate-500 text-center">{{ item.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a href="{{ path('app_admin_liste_reference_edit', {id: item.id}) }}"
                                       class="db-btn db-btn-ghost db-btn-sm">
                                        <i class="bi bi-pen me-1"></i>Modifier
                                    </a>
                                    <form method="post" action="{{ path('app_admin_liste_reference_toggle', {id: item.id}) }}" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-lrv-' ~ item.id) }}">
                                        <button type="submit" class="db-btn db-btn-sm db-btn-ghost">
                                            {% if item.actif %}
                                                <i class="bi bi-eye-slash me-1"></i>Désactiver
                                            {% else %}
                                                <i class="bi bi-eye me-1"></i>Activer
                                            {% endif %}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-slate-500 py-8">
                                Aucun type de source enregistré.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Note comportement #}
    <div class="workflow-banner workflow-banner-amber mt-4 text-center">
        <i class="bi bi-info-circle text-amber-400 flex-shrink-0"></i>
        <div>
            <p class="workflow-banner-title">Comportement des listes</p>
            <p class="workflow-banner-sub">
                Une valeur <strong>désactivée</strong> n'apparaît plus dans le formulaire de saisie pour les nouvelles alertes,
                mais reste affichée normalement sur les alertes existantes qui l'utilisent déjà.
                <strong>Jamais de suppression physique</strong> pour préserver l'intégrité des données historiques.
            </p>
        </div>
    </div>

</div>
{% endblock %}
