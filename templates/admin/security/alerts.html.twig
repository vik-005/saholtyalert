{% extends 'base.html.twig' %}

{% block title %}Alertes de Sécurité - Security Center{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bi bi-exclamation-triangle me-2"></i>Alertes de Sécurité
        </h1>
        <a href="{{ path('app_security_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>

    {# Summary Cards #}
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-danger">
                <div class="card-body text-center">
                    <div class="h2 text-danger">{{ criticalCount }}</div>
                    <div class="text-muted">Critiques</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <div class="h2 text-warning">{{ unacknowledgedCount }}</div>
                    <div class="text-muted">Non reconnues</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <div class="h2">{{ alerts|length }}</div>
                    <div class="text-muted">Total</div>
                </div>
            </div>
        </div>
    </div>

    {# Alerts Table #}
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Titre</th>
                            <th>IP</th>
                            <th>Sévérité</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for alert in alerts %}
                            <tr class="{{ alert.severity == 'critical' ? 'table-danger' : (alert.severity == 'high' ? 'table-warning' : '') }}">
                                <td class="small">{{ alert.detectedAt|date('d/m/Y H:i') }}</td>
                                <td class="small">{{ alert.alertType|replace({'_': ' '}) }}</td>
                                <td class="small">{{ alert.title }}</td>
                                <td class="font-monospace small">{{ alert.ipAddress ?? '-' }}</td>
                                <td>
                                    {% if alert.severity == 'critical' %}
                                        <span class="badge bg-danger">Critical</span>
                                    {% elseif alert.severity == 'high' %}
                                        <span class="badge bg-warning">High</span>
                                    {% elseif alert.severity == 'medium' %}
                                        <span class="badge bg-info">Medium</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Low</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if alert.status == 'new' %}
                                        <span class="badge bg-danger">Nouveau</span>
                                    {% elseif alert.status == 'acknowledged' %}
                                        <span class="badge bg-warning">Reconnu</span>
                                    {% elseif alert.status == 'investigating' %}
                                        <span class="badge bg-info">En cours</span>
                                    {% elseif alert.status == 'resolved' %}
                                        <span class="badge bg-success">Résolu</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ alert.status }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#alertModal{{ alert.id }}">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    {% if alert.status == 'new' %}
                                        <form method="post" action="{{ path('app_security_alert_acknowledge', {id: alert.id}) }}" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-check"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                            
                            {# Alert Modal #}
                            <div class="modal fade" id="alertModal{{ alert.id }}" tabindex="-1">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">{{ alert.title }}</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="row mb-3">
                                                <div class="col-md-6">
                                                    <p><strong>Type:</strong> {{ alert.alertType }}</p>
                                                    <p><strong>Date:</strong> {{ alert.detectedAt|date('Y-m-d H:i:s') }}</p>
                                                    <p><strong>IP:</strong> {{ alert.ipAddress ?? 'N/A' }}</p>
                                                    <p><strong>Utilisateur:</strong> {{ alert.user ? alert.user.email : 'N/A' }}</p>
                                                </div>
                                                <div class="col-md-6">
                                                    <p><strong>Sévérité:</strong> {{ alert.severity }}</p>
                                                    <p><strong>Statut:</strong> {{ alert.status }}</p>
                                                    <p><strong>Confiance:</strong> {{ alert.confidenceScore }}%</p>
                                                    <p><strong>Événements:</strong> {{ alert.eventCount }}</p>
                                                </div>
                                            </div>
                                            <hr>
                                            <h6>Description</h6>
                                            <p>{{ alert.description }}</p>
                                            {% if alert.recommendedActions %}
                                                <hr>
                                                <h6>Actions recommandées</h6>
                                                <ul>
                                                    {% for action in alert.recommendedActions %}
                                                        <li>{{ action }}</li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                            {% if alert.details %}
                                                <hr>
                                                <h6>Détails</h6>
                                                <pre class="small">{{ alert.details|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Aucune alerte
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}