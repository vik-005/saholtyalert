{% extends 'base.html.twig' %}

{% block title %}Surveillance des Routes - Security Center{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bi bi-signpost-split me-2"></i>Route Monitoring
        </h1>
        <a href="{{ path('app_security_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Statistiques des routes (7 derniers jours)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Route</th>
                            <th class="text-center">Requêtes</th>
                            <th class="text-center">Erreurs (4xx/5xx)</th>
                            <th class="text-center">Refus (403)</th>
                            <th class="text-center">Risque moyen</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for route, stats in routes %}
                            <tr class="{{ stats.errors > 0 ? 'table-warning' : '' }}">
                                <td class="font-monospace small">{{ route }}</td>
                                <td class="text-center">
                                    <span class="badge bg-primary">{{ stats.total }}</span>
                                </td>
                                <td class="text-center">
                                    {% if stats.errors > 0 %}
                                        <span class="badge bg-danger">{{ stats.errors }}</span>
                                    {% else %}
                                        <span class="text-muted">0</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if stats.forbidden > 0 %}
                                        <span class="badge bg-warning">{{ stats.forbidden }}</span>
                                    {% else %}
                                        <span class="text-muted">0</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if stats.avgRisk >= 60 %}
                                        <span class="badge bg-danger">{{ stats.avgRisk|number_format(1) }}</span>
                                    {% elseif stats.avgRisk >= 30 %}
                                        <span class="badge bg-warning">{{ stats.avgRisk|number_format(1) }}</span>
                                    {% else %}
                                        <span class="badge bg-success">{{ stats.avgRisk|number_format(1) }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('app_security_audit') }}?route={{ route }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-search"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Aucune donnée disponible
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Route Categories Summary #}
    <div class="row mt-4 g-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-danger bg-opacity-10">
                    <h6 class="mb-0">Routes avec erreurs</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {% for route, stats in errorRoutes %}
                            <li class="list-group-item d-flex justify-content-between px-3 py-2">
                                <span class="small font-monospace text-truncate me-2" style="max-width:70%;">{{ route }}</span>
                                <span class="badge bg-danger">{{ stats.errors }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted small">Aucune</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-warning bg-opacity-10">
                    <h6 class="mb-0">Routes avec refus</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {% for route, stats in forbiddenRoutes %}
                            <li class="list-group-item d-flex justify-content-between px-3 py-2">
                                <span class="small font-monospace text-truncate me-2" style="max-width:70%;">{{ route }}</span>
                                <span class="badge bg-warning text-dark">{{ stats.forbidden }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted small">Aucune</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-dark bg-opacity-10">
                    <h6 class="mb-0">Routes les plus consultées</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {% for route, stats in topRoutes %}
                            <li class="list-group-item d-flex justify-content-between px-3 py-2">
                                <span class="small font-monospace text-truncate me-2" style="max-width:70%;">{{ route }}</span>
                                <span class="badge bg-primary">{{ stats.total }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted small">Aucune</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}