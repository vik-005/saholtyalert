<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche d'Alerte {{ alert.codeGei }}</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; font-size: 11px; color: #1e293b; line-height: 1.4; margin: 0; padding: 20px; }
        .header { border-bottom: 2px solid #0f172a; padding-bottom: 10px; margin-bottom: 20px; }
        .header table { w-full; width: 100%; }
        .title { font-size: 18px; font-weight: bold; color: #0f172a; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 10px; }
        .badge-critique { background-color: #fee2e2; color: #991b1b; }
        .badge-eleve { background-color: #ffedd5; color: #9a3412; }
        .badge-modere { background-color: #fef3c7; color: #92400e; }
        .badge-faible { background-color: #d1fae5; color: #065f46; }
        .section { margin-bottom: 15px; }
        .section-title { font-size: 12px; font-weight: bold; background-color: #f1f5f9; padding: 6px 10px; border-left: 4px solid #0f172a; margin-bottom: 8px; }
        .box { border: 1px solid #cbd5e1; padding: 10px; border-radius: 4px; background-color: #fafafa; min-height: 50px; }
        .grid { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
        .grid td, .grid th { border: 1px solid #cbd5e1; padding: 6px 8px; font-size: 10px; text-align: left; }
        .grid th { background-color: #f8fafc; font-weight: bold; }
        .footer { position: fixed; bottom: 0; left: 0; right: 0; font-size: 9px; color: #64748b; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 5px; }
    </style>
</head>
<body>
    <div class="header">
        <table>
            <tr>
                <td>
                    <div class="title">FICHE D'ALERTE GEI</div>
                    <div style="color: #64748b; font-size: 10px;">GROUPE D'ÉCHANGE D'INFORMATIONS</div>
                </td>
                <td style="text-align: right;">
                    <div style="font-family: monospace; font-size: 14px; font-weight: bold;">{{ alert.codeGei ?? 'BROUILLON' }}</div>
                    <div style="font-size: 9px; color: #64748b;">Date : {{ alert.dateCreation|date('d/m/Y') }}</div>
                </td>
            </tr>
        </table>
    </div>

    <table class="grid">
        <tr>
            <th>Zone / Pays</th>
            <td>{{ alert.market.nom }} ({{ alert.market.codeIso3 }})</td>
            <th>Port / Corridor</th>
            <td>{{ alert.portCorridor ?? '-' }}</td>
        </tr>
        <tr>
            <th>Catégorie</th>
            <td>{{ alert.categorie ? alert.categorie.label : '-' }}</td>
            <th>Type de Source</th>
            <td>{{ alert.typeSource ? alert.typeSource.label : '-' }}</td>
        </tr>
        <tr>
            <th>Score GEI</th>
            <td style="font-weight: bold; font-size: 12px; color: #d97706;">{{ alert.effectiveScore ?? '-' }}</td>
            <th>Niveau Priorité</th>
            <td>
                {% set p = alert.effectiveNiveauPriorite %}
                {% if p %}
                    <span class="badge badge-{{ p.value }}">{{ p.label }}</span>
                {% else %}-{% endif %}
            </td>
        </tr>
    </table>

    <div class="section">
        <div class="section-title">1. RÉSUMÉ EXÉCUTIF</div>
        <div class="box">{{ alert.resumeExecutif }}</div>
    </div>

    <div class="section">
        <div class="section-title">2. ÉLÉMENTS FACTUELS (FAITS VÉRIFIÉS)</div>
        <div class="box">{{ alert.elementsFactuels ?: 'Aucun élément factuel renseigné.' }}</div>
    </div>

    <div class="section">
        <div class="section-title">3. HYPOTHÈSES ANALYTIQUES & PROSPECTIVE</div>
        <div class="box">{{ alert.hypothesesAnalytiques ?: 'Aucune hypothèse analytique renseignée.' }}</div>
    </div>

    <div class="section">
        <div class="section-title">4. RECOMMANDATIONS & ACTIONS EN COURS</div>
        <table class="grid">
            <tr>
                <th style="width: 30%;">Recommandation</th>
                <td>{{ alert.recommandation ? alert.recommandation.label : '-' }}</td>
            </tr>
            <tr>
                <th>Actions en cours</th>
                <td>{{ alert.actionsEnCours ?: '-' }}</td>
            </tr>
        </table>
    </div>

    <div class="footer">
        DOCUMENT CONFIDENTIEL — DISPOSITIF GEI/AIT — Imprimé le {{ date_impression|date('d/m/Y H:i') }}
    </div>
</body>
</html>
