<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche d'Alerte {{ alert.codeGei }}</title>
    <style>
        @page {
            margin: 0;
            @bottom-center {
                content: "{{ platform_name }} — {{ platform_full }} | Document non contrôlé — Imprimé le {{ date_impression|date('d/m/Y H:i') }} | Page " counter(page) " / " counter(pages);
                font-family: Helvetica, Arial, sans-serif;
                font-size: 7.5px;
                color: #64748b;
                padding-bottom: 8mm;
            }
        }

        * { box-sizing: border-box; }

        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 9.5px;
            color: #1e293b;
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }

        /* ═══════════════════════════════════════════════
           HEADER OFFICIEL — Bandeau vert institutionnel GEI
           ═══════════════════════════════════════════════ */
        .doc-header {
            background: linear-gradient(135deg, #0d5f4a 0%, #16856b 60%, #1ca882 100%);
            color: #ffffff;
            padding: 0;
            position: relative;
        }
        .header-inner {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            gap: 16px;
        }
        .header-logo {
            width: 48px;
            height: 48px;
            background: rgba(255,255,255,0.15);
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 900;
            color: #ffffff;
            flex-shrink: 0;
            letter-spacing: -1px;
        }
        .header-text {
            flex: 1;
        }
        .header-platform {
            font-size: 7.5px;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            color: rgba(255,255,255,0.75);
            margin-bottom: 3px;
            font-weight: 600;
        }
        .header-platform-name {
            font-size: 12px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }
        .header-title {
            font-size: 17px;
            font-weight: 900;
            margin: 0;
            letter-spacing: 1px;
            color: #ffffff;
        }
        .header-subtitle {
            font-size: 9px;
            color: rgba(255,255,255,0.65);
            margin-top: 3px;
        }
        .header-meta {
            text-align: right;
            flex-shrink: 0;
        }
        .header-ref {
            font-family: monospace;
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 1.5px;
            color: #c9f0e3;
        }
        .header-date {
            font-size: 8px;
            color: rgba(255,255,255,0.65);
            margin-top: 3px;
        }
        .header-classification {
            display: inline-block;
            background: rgba(0,0,0,0.25);
            color: #fff;
            font-size: 7px;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 3px;
            letter-spacing: 2px;
            margin-top: 6px;
            border: 1px solid rgba(255,255,255,0.2);
        }
        /* Ligne de séparation décorative sous le header */
        .header-accent-bar {
            height: 3px;
            background: linear-gradient(90deg, #c9f0e3 0%, #45e3b8 50%, rgba(255,255,255,0.2) 100%);
        }

        /* ═══════════════════════════════════════════════
           BARRE DE MÉTADONNÉES
           ═══════════════════════════════════════════════ */
        .meta-bar {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 6px 18px;
            display: flex;
            gap: 0;
            font-size: 8px;
            color: #475569;
        }
        .meta-item {
            padding: 0 14px;
            border-right: 1px solid #e2e8f0;
        }
        .meta-item:last-child { border-right: none; }
        .meta-label {
            font-weight: bold;
            color: #0f172a;
            margin-right: 4px;
        }

        /* ═══════════════════════════════════════════════
           CONTENU PRINCIPAL
           ═══════════════════════════════════════════════ */
        .doc-body {
            padding: 16px 18px;
        }

        /* ═══════════════════════════════════════════════
           KPI STRIP — Barre horizontale des indicateurs clés
           ═══════════════════════════════════════════════ */
        .kpi-strip {
            display: flex;
            gap: 0;
            margin-bottom: 16px;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            overflow: hidden;
        }
        .kpi-cell {
            flex: 1;
            padding: 10px 14px;
            border-right: 1px solid #e2e8f0;
            text-align: center;
        }
        .kpi-cell:last-child { border-right: none; }
        .kpi-label {
            font-size: 7px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            margin-bottom: 4px;
            font-weight: 600;
        }
        .kpi-value {
            font-size: 15px;
            font-weight: bold;
            color: #0f172a;
        }
        .kpi-value.critique { color: #dc2626; }
        .kpi-value.eleve { color: #ea580c; }
        .kpi-value.modere { color: #d97706; }
        .kpi-value.faible { color: #059669; }
        .kpi-sub {
            font-size: 7px;
            color: #94a3b8;
            margin-top: 2px;
        }

        /* ═══════════════════════════════════════════════
           SECTIONS — Cartes avec en-tête vert GEI
           ═══════════════════════════════════════════════ */
        .section {
            margin-bottom: 12px;
            border: 1px solid #d1e8e0;
            border-radius: 4px;
            overflow: hidden;
        }
        .section-header {
            background: #16856b;
            color: #ffffff;
            padding: 7px 12px;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            background: rgba(255,255,255,0.2);
            color: #fff;
            border-radius: 3px;
            font-size: 9px;
            font-weight: 900;
        }
        .section-body {
            padding: 10px 12px;
            background: #ffffff;
            font-size: 9.5px;
        }
        .section-body.empty {
            color: #94a3b8;
            font-style: italic;
        }

        /* ═══════════════════════════════════════════════
           GRILLES — Tableaux de données
           ═══════════════════════════════════════════════ */
        .grid {
            width: 100%;
            border-collapse: collapse;
            font-size: 9.5px;
        }
        .grid td, .grid th {
            border: 1px solid #e2e8f0;
            padding: 5px 10px;
            text-align: left;
            vertical-align: top;
        }
        .grid th {
            background: #e8f5f0;
            font-weight: 700;
            width: 28%;
            color: #0d5f4a;
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border-color: #c9e8de;
        }
        .grid td { color: #1e293b; }

        /* ═══════════════════════════════════════════════
           BADGES — Indicateurs visuels de priorité
           ═══════════════════════════════════════════════ */
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 3px;
            font-weight: bold;
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }
        .badge-critique { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
        .badge-eleve { background: #ffedd5; color: #9a3412; border: 1px solid #fed7aa; }
        .badge-modere { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
        .badge-faible { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }

        /* ═══════════════════════════════════════════════
           PIED DE PAGE — Zone tampon pour @page
           ═══════════════════════════════════════════════ */
        .footer-spacer { height: 18px; }
    </style>
</head>
<body>

    <!-- ═══════════════════════════════════════════════
         HEADER OFFICIEL
         ═══════════════════════════════════════════════ -->
    <div class="doc-header">
        <div class="header-inner">
            <div class="header-logo">GEI</div>
            <div class="header-text">
                <div class="header-platform">{{ platform_full }}</div>
                <div class="header-platform-name">{{ platform_name }}</div>
                <div class="header-title">FICHE D'ALERTE</div>
                <div class="header-subtitle">{{ dispositif }} — Renseignement Opérationnel</div>
            </div>
            <div class="header-meta">
                <div class="header-ref">{{ alert.codeGei ?? 'BROUILLON' }}</div>
                <div class="header-date">{{ alert.dateCreation|date('d/m/Y') }}</div>
                {% if alert.market %}
                <div class="header-date">{{ alert.market.nom }} ({{ alert.market.codeIso3 }})</div>
                {% endif %}
                <div class="header-classification">CONFIDENTIEL</div>
            </div>
        </div>
        <div class="header-accent-bar"></div>
    </div>

    <!-- ═══════════════════════════════════════════════
         BARRE DE MÉTADONNÉES
         ═══════════════════════════════════════════════ -->
    <div class="meta-bar">
        <div class="meta-item">
            <span class="meta-label">Réf:</span>{{ document_ref }}
        </div>
        <div class="meta-item">
            <span class="meta-label">Imprimé:</span>{{ date_impression|date('d/m/Y H:i') }}
        </div>
        <div class="meta-item">
            <span class="meta-label">Classification:</span>Confidentiel
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         CONTENU PRINCIPAL
         ═══════════════════════════════════════════════ -->
    <div class="doc-body">

        <!-- KPI Strip -->
        <div class="kpi-strip">
            <div class="kpi-cell">
                <div class="kpi-label">Score GEI</div>
                <div class="kpi-value {% if alert.effectiveScore >= 18 %}critique{% elseif alert.effectiveScore >= 14 %}eleve{% elseif alert.effectiveScore >= 10 %}modere{% else %}faible{% endif %}">
                    {{ alert.effectiveScore ?? '—' }}<span style="font-size:9px;color:#94a3b8;">/25</span>
                </div>
                <div class="kpi-sub">Annexe C</div>
            </div>
            <div class="kpi-cell">
                <div class="kpi-label">Priorité</div>
                <div class="kpi-value" style="font-size: 12px;">
                    {% set p = alert.effectiveNiveauPriorite %}
                    {% if p %}
                        <span class="badge badge-{{ p.value }}">{{ p.label() }}</span>
                    {% else %}<span style="color:#94a3b8;">—</span>{% endif %}
                </div>
            </div>
            <div class="kpi-cell">
                <div class="kpi-label">Statut</div>
                <div class="kpi-value" style="font-size: 12px;">{{ alert.statut ? alert.statut.label() : '—' }}</div>
            </div>
            <div class="kpi-cell">
                <div class="kpi-label">Catégorie</div>
                <div class="kpi-value" style="font-size: 12px;">{{ alert.categorie ?: '—' }}</div>
            </div>
        </div>

        <!-- Section 1 : Identification -->
        <div class="section">
            <div class="section-header">
                <span class="section-num">1</span>
                Identification & Localisation
            </div>
            <table class="grid">
                <tr>
                    <th>Zone / Pays</th>
                    <td>{{ alert.market.nom }} ({{ alert.market.codeIso3 }})</td>
                    <th>Port / Corridor</th>
                    <td>{{ alert.portCorridor ?? '-' }}</td>
                </tr>
                <tr>
                    <th>Catégorie</th>
                    <td>{{ alert.categorie ?: '-' }}</td>
                    <th>Type d'Alerte</th>
                    <td>{{ alert.typeAlerte ? alert.typeAlerte.label() : '-' }}</td>
                </tr>
                <tr>
                    <th>Type de Source</th>
                    <td>{{ alert.typeSource ?: '-' }}</td>
                    <th>Anonymisation</th>
                    <td>{{ alert.anonymisation ?: '-' }}</td>
                </tr>
                <tr>
                    <th>Fiabilité Source</th>
                    <td>
                        {% if alert.fiabiliteSource %}
                            <span style="font-weight: bold; color: #0f172a;">{{ alert.fiabiliteSource.value }}</span> — {{ alert.fiabiliteSource.label() }}
                        {% else %}-{% endif %}
                    </td>
                    <th>Crédibilité</th>
                    <td>{{ alert.credibiliteContenu ? alert.credibiliteContenu ~ '/4' : '-' }}</td>
                </tr>
            </table>
        </div>

        <!-- Section 2 : Qualification -->
        <div class="section">
            <div class="section-header">
                <span class="section-num">2</span>
                Qualification GEI — Annexe C
            </div>
            <table class="grid">
                <tr>
                    <th>Urgence</th>
                    <td>{{ alert.urgence ? alert.urgence.label() : '-' }}</td>
                    <th>Impact</th>
                    <td>{{ alert.impact ? alert.impact.label() : '-' }}</td>
                </tr>
                <tr>
                    <th>Exploitabilité</th>
                    <td>{{ alert.exploitabilite ? alert.exploitabilite.label() : '-' }}</td>
                    <th>Recommandation</th>
                    <td>{{ alert.recommandation ? alert.recommandation.label() : '-' }}</td>
                </tr>
            </table>
        </div>

        <!-- Section 3 : Résumé -->
        <div class="section">
            <div class="section-header">
                <span class="section-num">3</span>
                Résumé Exécutif
            </div>
            <div class="section-body {{ alert.resumeExecutif ? '' : 'empty' }}">
                {{ alert.resumeExecutif ?: 'Aucun résumé exécutif renseigné.' }}
            </div>
        </div>

        <!-- Section 4 : Éléments factuels -->
        <div class="section">
            <div class="section-header">
                <span class="section-num">4</span>
                Éléments Factuels
            </div>
            <div class="section-body {{ alert.elementsFactuels ? '' : 'empty' }}">
                {{ alert.elementsFactuels ?: 'Aucun élément factuel renseigné.' }}
            </div>
        </div>

        <!-- Section 5 : Hypothèses -->
        <div class="section">
            <div class="section-header">
                <span class="section-num">5</span>
                Hypothèses Analytiques & Prospective
            </div>
            <div class="section-body {{ alert.hypothesesAnalytiques ? '' : 'empty' }}">
                {{ alert.hypothesesAnalytiques ?: 'Aucune hypothèse analytique renseignée.' }}
            </div>
        </div>

        <!-- Section 6 : Actions -->
        <div class="section">
            <div class="section-header">
                <span class="section-num">6</span>
                Actions en Cours & Responsable
            </div>
            <table class="grid">
                <tr>
                    <th style="width: 22%;">Actions en cours</th>
                    <td>{{ alert.actionsEnCours ?: '-' }}</td>
                </tr>
                <tr>
                    <th>Responsable suivi</th>
                    <td>{{ alert.responsableSuivi ? alert.responsableSuivi.nomComplet : '-' }}</td>
                </tr>
                <tr>
                    <th>Commentaires</th>
                    <td>{{ alert.commentaires ?: '-' }}</td>
                </tr>
            </table>
        </div>

        <!-- Section 7 : Transmission -->
        {% if alert.transmission and alert.transmission.value != 'non' %}
        <div class="section">
            <div class="section-header">
                <span class="section-num">7</span>
                Transmission & Diffusion
            </div>
            <table class="grid">
                <tr>
                    <th style="width: 22%;">Statut transmission</th>
                    <td>{{ alert.transmission.label() }}</td>
                </tr>
            </table>
        </div>
        {% endif %}

    </div>

    <div class="footer-spacer"></div>

</body>
</html>
