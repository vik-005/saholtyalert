<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport d'Audit GEI</title>
    <style>
        @page {
            margin: 0;
            @bottom-center {
                content: "{{ platform_name }} — {{ platform_full }} | Document non contrôlé — {{ date_impression|date('d/m/Y H:i') }} | Page " counter(page) " / " counter(pages);
                font-family: Helvetica, Arial, sans-serif;
                font-size: 7px;
                color: #64748b;
                padding-bottom: 8mm;
            }
        }

        * { box-sizing: border-box; }

        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 8.5px;
            color: #1e293b;
            margin: 0;
            padding: 0;
        }

        /* ═══════════════════════════════════════════════
           HEADER OFFICIEL
           ═══════════════════════════════════════════════ */
        .doc-header {
            background: #0f172a;
            color: #ffffff;
            padding: 0;
        }
        .header-inner {
            display: flex;
            align-items: center;
            padding: 10px 14px;
            gap: 12px;
        }
        .header-logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #16856b 0%, #45e3b8 100%);
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: bold;
            color: #0f172a;
            flex-shrink: 0;
        }
        .header-text {
            flex: 1;
        }
        .header-platform {
            font-size: 7px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            opacity: 0.7;
            margin-bottom: 2px;
        }
        .header-title {
            font-size: 13px;
            font-weight: bold;
            margin: 0;
        }
        .header-meta {
            text-align: right;
            flex-shrink: 0;
            font-size: 8px;
            opacity: 0.7;
        }

        /* ═══════════════════════════════════════════════
           META BAR
           ═══════════════════════════════════════════════ */
        .meta-bar {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 5px 14px;
            font-size: 7.5px;
            color: #475569;
        }
        .meta-label {
            font-weight: bold;
            color: #0f172a;
            margin-right: 4px;
        }

        /* ═══════════════════════════════════════════════
           FILTRES
           ═══════════════════════════════════════════════ */
        .filters-box {
            background: #f8fafc;
            border-left: 4px solid #16856b;
            padding: 8px 12px;
            margin: 10px 14px;
            font-size: 8px;
            color: #475569;
            border-right: 1px solid #e2e8f0;
            border-top: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
        }
        .filters-box strong {
            color: #0f172a;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-size: 8px;
        }

        /* ═══════════════════════════════════════════════
           KPI GRID
           ═══════════════════════════════════════════════ */
        .kpi-grid {
            display: flex;
            gap: 0;
            margin: 10px 14px;
        }
        .kpi-box {
            flex: 1;
            background: #0f172a;
            color: #ffffff;
            padding: 10px;
            text-align: center;
            border-right: 1px solid rgba(255,255,255,0.1);
        }
        .kpi-box:last-child { border-right: none; }
        .kpi-value {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 2px;
        }
        .kpi-label {
            font-size: 7px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            opacity: 0.75;
        }

        /* ═══════════════════════════════════════════════
           TABLEAU RÉSULTATS
           ═══════════════════════════════════════════════ */
        .doc-body {
            padding: 0 14px 14px;
        }
        .section-title {
            font-size: 10px;
            font-weight: bold;
            color: #0f172a;
            margin: 0 14px 8px;
            padding-bottom: 4px;
            border-bottom: 2px solid #0f172a;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        table.audit {
            width: 100%;
            border-collapse: collapse;
            font-size: 8px;
            margin: 0 14px;
        }
        table.audit thead th {
            background: #0f172a;
            color: #ffffff;
            padding: 5px 6px;
            text-align: left;
            font-size: 7.5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: bold;
            border-bottom: 2px solid #1e3a5f;
        }
        table.audit tbody td {
            padding: 4px 6px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
        }
        table.audit tbody tr:nth-child(even) {
            background: #f8fafc;
        }
        .row-critique { background: #fef2f2 !important; }
        .row-eleve { background: #fff7ed !important; }
        .row-modere { background: #fffbeb !important; }
        .row-faible { background: #f0fdf4 !important; }

        .badge {
            display: inline-block;
            padding: 2px 5px;
            border-radius: 2px;
            font-weight: bold;
            font-size: 7px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .badge-critique { background: #fee2e2; color: #991b1b; }
        .badge-eleve { background: #ffedd5; color: #9a3412; }
        .badge-modere { background: #fef3c7; color: #92400e; }
        .badge-faible { background: #d1fae5; color: #065f46; }

        .score-val {
            font-weight: bold;
            font-size: 9px;
        }
        .score-critique { color: #dc2626; }
        .score-eleve { color: #ea580c; }
        .score-modere { color: #d97706; }
        .score-faible { color: #059669; }

        .code-gei {
            font-family: monospace;
            font-weight: bold;
            color: #0f172a;
            font-size: 9px;
        }

        .empty-state {
            text-align: center;
            padding: 20px;
            color: #94a3b8;
            font-style: italic;
        }
    </style>
</head>
<body>

    <!-- ═══════════════════════════════════════════════
         HEADER OFFICIEL
         ═══════════════════════════════════════════════ -->
    <div class="doc-header">
        <div class="header-inner">
            <div class="header-logo">GEI</div>
            <div class="header-text">
                <div class="header-platform">Plateforme GEI — Groupe d'Échange d'Informations</div>
                <div class="header-title">RAPPORT D'AUDIT</div>
            </div>
            <div class="header-meta">
                <div style="font-weight: bold; font-size: 14px; color: #45e3b8;">{{ stats.total ?? 0 }}</div>
                <div>alertes</div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         META BAR
         ═══════════════════════════════════════════════ -->
    <div class="meta-bar">
        <span class="meta-label">Document:</span>Rapport d'audit
        <span style="margin-left: 16px;"><span class="meta-label">Imprimé:</span>{{ date_impression|date('d/m/Y H:i') }}</span>
        <span style="margin-left: 16px;"><span class="meta-label">Classification:</span>Confidentiel</span>
    </div>

    <!-- ═══════════════════════════════════════════════
         FILTRES APPLIQUÉS
         ═══════════════════════════════════════════════ -->
    {% if dto.hasActiveFilters() %}
    <div class="filters-box">
        <strong>Filtres appliqués :</strong>
        {% if dto.dateFrom %}Du {{ dto.dateFrom|date('d/m/Y') }}{% endif %}
        {% if dto.dateTo %}au {{ dto.dateTo|date('d/m/Y') }}{% endif %}
        {% if dto.operateur %} | Opérateur : {{ dto.operateur }}{% endif %}
        {% if dto.marque %} | Marque : {{ dto.marque }}{% endif %}
        {% if dto.texteLibre %} | Recherche : "{{ dto.texteLibre }}"{% endif %}
        {% if dto.categories|length > 0 %} | {{ dto.categories|length }} catégorie(s){% endif %}
        {% if dto.statuts|length > 0 %} | {{ dto.statuts|length }} statut(s){% endif %}
        {% if dto.niveauxPriorite|length > 0 %} | {{ dto.niveauxPriorite|length }} niveau(x){% endif %}
    </div>
    {% endif %}

    <!-- ═══════════════════════════════════════════════
         KPI GRID
         ═══════════════════════════════════════════════ -->
    <div class="kpi-grid">
        <div class="kpi-box">
            <div class="kpi-value">{{ stats.total ?? 0 }}</div>
            <div class="kpi-label">Alertes</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">{{ stats.scoreMoyen ?? '—' }}</div>
            <div class="kpi-label">Score moyen</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">{{ stats.critiques ?? 0 }}</div>
            <div class="kpi-label">Critiques</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">{{ stats.tauxTransmission ?? '—' }}%</div>
            <div class="kpi-label">Taux transmission</div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         RÉSULTATS DÉTAILLÉS
         ═══════════════════════════════════════════════ -->
    <div class="section-title">Résultats détaillés</div>

    <table class="audit">
        <thead>
            <tr>
                <th style="width: 8%;">Code GEI</th>
                <th style="width: 8%;">Pays</th>
                <th style="width: 10%;">Corridor</th>
                <th style="width: 7%;">Date</th>
                <th style="width: 10%;">Catégorie</th>
                <th style="width: 8%;">Priorité</th>
                <th style="width: 5%; text-align: center;">Score</th>
                <th style="width: 10%;">Statut</th>
                <th style="width: 34%;">Résumé</th>
            </tr>
        </thead>
        <tbody>
            {% for row in results %}
                {% set p = row.niveau_priorite ?? '' %}
                {% set scoreClass = '' %}
                {% if p == 'critique' %}{% set scoreClass = 'row-critique' %}
                {% elseif p == 'eleve' %}{% set scoreClass = 'row-eleve' %}
                {% elseif p == 'modere' %}{% set scoreClass = 'row-modere' %}
                {% elseif p == 'faible' %}{% set scoreClass = 'row-faible' %}{% endif %}
                <tr class="{{ scoreClass }}">
                    <td><span class="code-gei">{{ row.codeGei ?? 'BROUILLON' }}</span></td>
                    <td>{{ row.pays ?? '' }}</td>
                    <td>{{ row.portCorridor ?? '' }}</td>
                    <td>{{ row.dateCreation ?? '' }}</td>
                    <td>{{ row.categorie ?? '—' }}</td>
                    <td>
                        {% if p %}
                            <span class="badge badge-{{ p }}">{{ p|upper }}</span>
                        {% else %}-{% endif %}
                    </td>
                    <td style="text-align: center;">
                        <span class="score-val
                            {% if row.score >= 18 %}score-critique
                            {% elseif row.score >= 14 %}score-eleve
                            {% elseif row.score >= 10 %}score-modere
                            {% else %}score-faible{% endif %}">
                            {{ row.score ?? '-' }}
                        </span>
                    </td>
                    <td>{{ row.statut ?? '—' }}</td>
                    <td>{{ row.resumeExecutif|slice(0, 100) }}{% if row.resumeExecutif|length > 100 %}…{% endif %}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="empty-state">Aucun résultat ne correspond aux critères de recherche.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

</body>
</html>
