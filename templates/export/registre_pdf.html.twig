<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Registre Consolidé GEI</title>
    <style>
        @page {
            margin: 0;
            @bottom-center {
                content: "{{ platform_name }} — {{ platform_full }} | Document non contrôlé — {{ date_impression|date('d/m/Y H:i') }} | Page " counter(page) " / " counter(pages);
                font-family: Helvetica, Arial, sans-serif;
                font-size: 7px;
                color: #64748b;
                padding-bottom: 8mm;
            }
        }

        * { box-sizing: border-box; }

        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 8px;
            color: #1e293b;
            margin: 0;
            padding: 0;
        }

        /* ═══════════════════════════════════════════════
           HEADER OFFICIEL
           ═══════════════════════════════════════════════ */
        .doc-header {
            background: #0f172a;
            color: #ffffff;
            padding: 0;
        }
        .header-inner {
            display: flex;
            align-items: center;
            padding: 10px 14px;
            gap: 12px;
        }
        .header-logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #16856b 0%, #45e3b8 100%);
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: bold;
            color: #0f172a;
            flex-shrink: 0;
        }
        .header-text {
            flex: 1;
        }
        .header-platform {
            font-size: 7px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            opacity: 0.7;
            margin-bottom: 2px;
        }
        .header-title {
            font-size: 13px;
            font-weight: bold;
            margin: 0;
        }
        .header-meta {
            text-align: right;
            flex-shrink: 0;
            font-size: 8px;
            opacity: 0.7;
        }
        .header-count {
            font-size: 16px;
            font-weight: bold;
            color: #45e3b8;
        }

        /* ═══════════════════════════════════════════════
           META BAR
           ═══════════════════════════════════════════════ */
        .meta-bar {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 5px 14px;
            font-size: 7.5px;
            color: #475569;
        }
        .meta-label {
            font-weight: bold;
            color: #0f172a;
            margin-right: 4px;
        }

        /* ═══════════════════════════════════════════════
           TABLEAU REGISTRE
           ═══════════════════════════════════════════════ */
        .doc-body {
            padding: 10px 14px;
        }
        table.registre {
            width: 100%;
            border-collapse: collapse;
            font-size: 8px;
        }
        table.registre thead th {
            background: #0f172a;
            color: #ffffff;
            padding: 6px 8px;
            text-align: left;
            font-size: 7.5px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: bold;
            border-bottom: 2px solid #1e3a5f;
        }
        table.registre tbody td {
            padding: 5px 8px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
        }
        table.registre tbody tr:nth-child(even) {
            background: #f8fafc;
        }
        .row-critique { background: #fef2f2 !important; }
        .row-eleve { background: #fff7ed !important; }
        .row-modere { background: #fffbeb !important; }
        .row-faible { background: #f0fdf4 !important; }

        .badge {
            display: inline-block;
            padding: 2px 5px;
            border-radius: 2px;
            font-weight: bold;
            font-size: 7px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .badge-critique { background: #fee2e2; color: #991b1b; }
        .badge-eleve { background: #ffedd5; color: #9a3412; }
        .badge-modere { background: #fef3c7; color: #92400e; }
        .badge-faible { background: #d1fae5; color: #065f46; }

        .score-val {
            font-weight: bold;
            font-size: 9px;
        }
        .score-critique { color: #dc2626; }
        .score-eleve { color: #ea580c; }
        .score-modere { color: #d97706; }
        .score-faible { color: #059669; }

        .code-gei {
            font-family: monospace;
            font-weight: bold;
            color: #0f172a;
            font-size: 9px;
        }

        .empty-state {
            text-align: center;
            padding: 20px;
            color: #94a3b8;
            font-style: italic;
        }
    </style>
</head>
<body>

    <!-- ═══════════════════════════════════════════════
         HEADER OFFICIEL
         ═══════════════════════════════════════════════ -->
    <div class="doc-header">
        <div class="header-inner">
            <div class="header-logo">GEI</div>
            <div class="header-text">
                <div class="header-platform">Plateforme GEI — Groupe d'Échange d'Informations</div>
                <div class="header-title">REGISTRE CONSOLIDÉ D'ALERTES</div>
            </div>
            <div class="header-meta">
                <div class="header-count">{{ alerts|length }}</div>
                <div>alertes</div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         META BAR
         ═══════════════════════════════════════════════ -->
    <div class="meta-bar">
        <span class="meta-label">Document:</span>Registre consolidé
        <span style="margin-left: 16px;"><span class="meta-label">Imprimé:</span>{{ date_impression|date('d/m/Y H:i') }}</span>
        <span style="margin-left: 16px;"><span class="meta-label">Classification:</span>Confidentiel</span>
    </div>

    <!-- ═══════════════════════════════════════════════
         TABLEAU
         ═══════════════════════════════════════════════ -->
    <div class="doc-body">
        <table class="registre">
            <thead>
                <tr>
                    <th style="width: 8%;">Code GEI</th>
                    <th style="width: 7%;">Date</th>
                    <th style="width: 10%;">Zone</th>
                    <th style="width: 12%;">Corridor</th>
                    <th style="width: 13%;">Catégorie</th>
                    <th style="width: 22%;">Résumé Exécutif</th>
                    <th style="width: 5%; text-align: center;">Score</th>
                    <th style="width: 7%;">Priorité</th>
                    <th style="width: 12%;">Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for alert in alerts %}
                    {% set p = alert.effectiveNiveauPriorite %}
                    {% set scoreClass = '' %}
                    {% if p %}
                        {% set scoreClass = 'row-' ~ p.value %}
                    {% endif %}
                    <tr class="{{ scoreClass }}">
                        <td><span class="code-gei">{{ alert.codeGei ?? 'BROUILLON' }}</span></td>
                        <td>{{ alert.dateCreation|date('d/m/Y') }}</td>
                        <td>{{ alert.market.nom }}</td>
                        <td>{{ alert.portCorridor ?: '-' }}</td>
                        <td>{{ alert.categorie ?: '-' }}</td>
                        <td style="max-width: 280px;">{{ alert.resumeExecutif|slice(0, 110) }}{% if alert.resumeExecutif|length > 110 %}…{% endif %}</td>
                        <td style="text-align: center;">
                            <span class="score-val
                                {% if alert.effectiveScore >= 18 %}score-critique
                                {% elseif alert.effectiveScore >= 14 %}score-eleve
                                {% elseif alert.effectiveScore >= 10 %}score-modere
                                {% else %}score-faible{% endif %}">
                                {{ alert.effectiveScore ?? '-' }}
                            </span>
                        </td>
                        <td>
                            {% if p %}
                                <span class="badge badge-{{ p.value }}">{{ p.label() }}</span>
                            {% else %}-{% endif %}
                        </td>
                        <td>{{ alert.statut ? alert.statut.label() : '-' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="empty-state">Aucune alerte enregistrée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</body>
</html>
