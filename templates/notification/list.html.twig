{% extends 'base.html.twig' %}
{% block title %}Notifications — GEI{% endblock %}
{% block header_title %}Notifications{% endblock %}

{% block body %}
<div class="db-wrapper">

    <div class="page-header-row">
        <div>
            <p class="page-eyebrow"><i class="bi bi-bell me-1.5 text-amber-400"></i>Centre de notifications</p>
            <h2 class="page-title">Mes notifications</h2>
            <p class="page-subtitle">
                {{ unread_count }} non lue{{ unread_count > 1 ? 's' : '' }} sur {{ notifications|length }} au total
            </p>
        </div>
        {% if unread_count > 0 %}
        <form method="post" action="{{ path('app_notification_read_all') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('read_all') }}">
            <button type="submit" class="db-btn db-btn-ghost">
                <i class="bi bi-check-double me-1.5"></i>Tout marquer comme lu
            </button>
        </form>
        {% endif %}
    </div>

    <div class="notif-list-card">
        {% for notif in notifications %}
        {% set typeIcon = {
            'urgence':      'broadcast',
            'sla_proche':   'stopwatch',
            'validation':   'clipboard-check',
            'tache':        'list-check',
            'statut_change':'arrow-repeat',
            'info':         'info-circle',
            'warning':      'triangle-alert',
            'escalade':     'arrow-up-right',
        }[notif.type] ?? 'bell' %}
        {% if notif.type == 'sla_proche' or (notif.alert and notif.alert.urgence and notif.alert.urgence.value == '72h') %}
            {% set typeIcon = 'clock-history' %}
        {% endif %}
        {% set typeColor = {
            'urgence':      'activity-icon-red',
            'sla_proche':   'activity-icon-amber',
            'validation':   'activity-icon-amber',
            'tache':        'activity-icon-amber',
            'statut_change':'activity-icon-blue',
            'escalade':     'activity-icon-red',
            'info':         'activity-icon-slate',
            'warning':      'activity-icon-amber',
        }[notif.type] ?? 'activity-icon-slate' %}
        {% if notif.type == 'sla_proche' or (notif.alert and notif.alert.urgence and notif.alert.urgence.value == '72h') %}
            {% set typeColor = 'activity-icon-amber' %}
        {% endif %}

        <a href="{{ path('app_notification_read', {id: notif.id}) }}"
           class="notif-list-item {% if not notif.lu %}notif-list-item-unread{% endif %} {% if notif.priorite > 0 and notif.type != 'sla_proche' %}notif-list-item-urgent{% endif %} {% if notif.type == 'sla_proche' or (notif.alert and notif.alert.urgence and notif.alert.urgence.value == '72h') %}notif-list-item-72h{% endif %}">
            <div class="activity-icon-wrap {{ typeColor }} flex-shrink-0">
                <i class="bi bi-{{ typeIcon }} fa-xs"></i>
            </div>
            <div class="notif-list-body">
                {% if notif.type == 'sla_proche' or (notif.alert and notif.alert.urgence and notif.alert.urgence.value == '72h') %}
                    <span class="notif-list-category notif-category-72h">Urgence 72 h</span>
                {% elseif notif.priorite > 0 %}
                    <span class="notif-list-category notif-category-urgent">Prioritaire</span>
                {% else %}
                    <span class="notif-list-category notif-category-info">Information</span>
                {% endif %}
                <p class="notif-list-text">{{ notif.contenu }}</p>
                <div class="notif-list-meta">
                    {% if notif.alert %}
                        <span class="notif-list-code">
                            <i class="bi bi-hash fa-xs me-1 opacity-50"></i>
                            {{ notif.alert.codeGei ?? 'Alerte #' ~ notif.alert.id }}
                        </span>
                        <span class="mx-1 text-slate-700">·</span>
                    {% endif %}
                    <span>{{ notif.createdAt|date('d/m/Y à H:i') }}</span>
                    {% if not notif.lu %}
                        <span class="notif-list-new-badge">Nouveau</span>
                    {% endif %}
                </div>
            </div>
            <i class="bi bi-chevron-right text-slate-700 fa-xs flex-shrink-0"></i>
        </a>
        {% else %}
        <div class="db-empty-state">
            <i class="bi bi-bell-slash fa-2x text-slate-600 mb-3"></i>
            <p>Aucune notification</p>
        </div>
        {% endfor %}
    </div>

</div>

<style>
.notif-list-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}
.notif-list-item {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: background .2s;
}
.notif-list-item:last-child { border-bottom: none; }
.notif-list-item:hover { background: var(--card2); }
.notif-list-item-unread { background: var(--amber-bg); }
.notif-list-item-unread .notif-list-text { color: var(--text); }
.notif-list-body { flex: 1; min-width: 0; }
.notif-list-text { font-size: 13px; color: var(--text); line-height: 1.5; margin-bottom: 6px; }
.notif-list-meta { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted); flex-wrap: wrap; }
.notif-list-code { font-family: monospace; color: var(--amber); font-weight: 700; }
.notif-list-category {
    display: inline-flex; margin-bottom: 5px; padding: 2px 7px; border-radius: 99px;
    font-size: 9px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase;
}
.notif-category-urgent { background: rgba(220,61,72,.12); color: #c92e3d; }
.notif-category-72h { background: rgba(216,147,18,.14); color: #98630a; }
.notif-category-info { background: rgba(22,133,107,.1); color: #16856b; }
body.dark .notif-category-urgent { color: #ff8a92; }
body.dark .notif-category-72h { color: #ffd36a; }
body.dark .notif-category-info { color: #62d8b2; }
@media(max-width:640px) {
    .notif-list-item { padding: 14px 12px; gap: 10px; }
    .notif-list-text { font-size: 12px; }
    .notif-list-item > .bi-chevron-right { display: none; }
}
.notif-list-new-badge {
    font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 99px;
    background: var(--amber-dim); color: var(--amber); border: 1px solid var(--amber-border);
}
</style>
{% endblock %}
