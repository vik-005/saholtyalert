{% extends 'layout/auth_layout.html.twig' %}
{% block title %}Nouveau mot de passe — Plateforme GEI{% endblock %}

{% block auth_form %}
<div class="auth-form-header">
    <h1 class="auth-title">Choisir un nouveau mot de passe</h1>
    <p class="auth-subtitle">Le nouveau mot de passe remplacera immédiatement l’ancien.</p>
</div>

{% if error %}
<div class="auth-error" role="alert">
    <i class="bi bi-x-circle auth-error-icon"></i>
    <div><p class="auth-error-title">Réinitialisation impossible</p><p class="auth-error-msg">{{ error }}</p></div>
</div>
{% endif %}

<form method="post" class="auth-fields">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
    <div class="auth-field-wrap">
        <label class="auth-label" for="password">Nouveau mot de passe</label>
        <input class="auth-input" type="password" id="password" name="password" autocomplete="new-password" minlength="12" required>
    </div>
    <div class="auth-field-wrap">
        <label class="auth-label" for="password_confirm">Confirmer le mot de passe</label>
        <input class="auth-input" type="password" id="password_confirm" name="password_confirm" autocomplete="new-password" minlength="12" required>
    </div>
    <button type="submit" class="auth-submit-btn">Enregistrer le nouveau mot de passe</button>
</form>
{% endblock %}