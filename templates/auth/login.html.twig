{% extends 'layout/auth_layout.html.twig' %}
{% block title %}Connexion — Plateforme GEI{% endblock %}

{% block auth_form %}
{# ── En-tête ── #}
<div class="auth-form-header">
    <h1 class="auth-title">Connexion</h1>
    <p class="auth-subtitle">
        Pas encore de compte ?
        <a href="{{ path('app_register') }}" class="auth-link">Créer un accès</a>
    </p>
</div>

{# ── Erreur ── #}
{% if error %}
<div class="auth-error">
    <i class="bi-x-circle auth-error-icon"></i>
    <div>
        <p class="auth-error-title">Connexion échouée</p>
        <p class="auth-error-msg">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    </div>
</div>
{% endif %}

{# ── Formulaire ── #}
<form method="post" action="{{ path('app_login') }}" class="auth-fields" novalidate>

    {# Email #}
    <div class="auth-field-wrap">
        <label class="auth-label" for="username">
            <i class="bi-envelope me-1.5 opacity-60"></i>Adresse email
        </label>
        <div class="auth-input-wrap">
            <input
                type="email"
                id="username"
                name="_username"
                value="{{ last_username ?? '' }}"
                placeholder="nom@gei.org"
                class="auth-input"
                autocomplete="email"
                required
            >
        </div>
    </div>

    {# Mot de passe #}
    <div class="auth-field-wrap">
        <div class="auth-label-row">
            <label class="auth-label" for="password">
                <i class="bi-lock me-1.5 opacity-60"></i>Mot de passe
            </label>
            {# <a href="#" class="auth-forgot">Mot de passe oublié ?</a> #}
        </div>
        <div class="auth-input-wrap auth-input-icon-right">
            <input
                type="password"
                id="password"
                name="_password"
                placeholder="Votre mot de passe"
                class="auth-input"
                autocomplete="current-password"
                required
            >
            <button type="button" class="auth-input-btn" id="togglePasswordBtn"
                    onclick="togglePassword('password', 'togglePasswordBtn')" tabindex="-1">
                <i class="bi-eye"></i>
            </button>
        </div>
    </div>

    {# Se souvenir #}
    <div class="auth-checkbox-row">
        <label class="auth-checkbox-label">
            <input type="checkbox" name="_remember_me" class="auth-checkbox">
            <span class="auth-checkbox-custom"></span>
            <span>Se souvenir de moi</span>
        </label>
    </div>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    {# Champs GPS — remplis automatiquement par JS si l'utilisateur donne son accord #}
    <input type="hidden" name="_geo_lat" id="geoLat" value="">
    <input type="hidden" name="_geo_lng" id="geoLng" value="">

    {# Bouton principal #}
    <button type="submit" class="auth-submit-btn">
        <i class="bi-box-arrow-in-right me-2"></i>
        Se connecter
    </button>

</form>

{# ── Séparateur ── #}
<div class="auth-divider">
    <span class="auth-divider-line"></span>
    <span class="auth-divider-text">Accès sécurisé GEI</span>
    <span class="auth-divider-line"></span>
</div>

{# ── Info sécurité ── #}
<div class="auth-security-note">
    <div class="auth-security-item">
        <i class="bi-shield-lock text-amber-400"></i>
        <span>Connexion chiffrée TLS</span>
    </div>
    <div class="auth-security-item">
        <i class="bi-clock-history text-amber-400"></i>
        <span>Session 8h maximum</span>
    </div>
    <div class="auth-security-item">
        <i class="bi-eye-slash text-amber-400"></i>
        <span>Données confidentielles</span>
    </div>
</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
    if (!('geolocation' in navigator)) return;
    const form  = document.querySelector('form[action*="login"]');
    const latEl = document.getElementById('geoLat');
    const lngEl = document.getElementById('geoLng');
    if (!form || !latEl || !lngEl) return;

    function capturePosition() {
        navigator.geolocation.getCurrentPosition(
            pos => {
                latEl.value = pos.coords.latitude.toFixed(6);
                lngEl.value = pos.coords.longitude.toFixed(6);
                document.cookie = 'geo_consent=granted; max-age=31536000; path=/; SameSite=Lax; Secure';
            },
            () => { document.cookie = 'geo_consent=denied; max-age=86400; path=/; SameSite=Lax; Secure'; },
            { timeout: 5000, maximumAge: 60000 }
        );
    }

    const consent = document.cookie.split('; ').find(r => r.startsWith('geo_consent='));
    if (consent && consent.includes('granted')) {
        capturePosition();
    } else if (!consent) {
        form.addEventListener('submit', capturePosition, { once: true });
    }
});
</script>
{% endblock %}
