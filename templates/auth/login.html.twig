{% extends 'layout/auth_layout.html.twig' %}
{% block title %}Connexion — SAHOTLY ALERT SYSTEM{% endblock %}

{% block auth_form %}
{# ── En-tête du formulaire ── #}
<div class="login-header">
    <div class="login-branding">
        <div class="login-logo">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h1 class="login-title">Bienvenue sur SAHOTLY ALERT SYSTEM</h1>
        <p class="login-subtitle">Plateforme de gestion opérationnelle des alertes</p>
    </div>
</div>

{# ── Affichage d'erreur ── #}
{% if error %}
<div class="login-alert login-alert-error" role="alert">
    <div class="login-alert-header">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span class="login-alert-title">Connexion échouée</span>
    </div>
    <p class="login-alert-message">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
</div>
{% endif %}

{# ── Formulaire de connexion ── #}
<form method="post" action="{{ path('app_login') }}" class="login-form" novalidate>
    
    {# Champ Email #}
    <div class="login-field">
        <label for="username" class="login-field-label">
            <span>Adresse email</span>
            <span class="login-required">*</span>
        </label>
        <div class="login-field-wrapper">
            <i class="login-field-icon bi bi-envelope"></i>
            <input
                type="email"
                id="username"
                name="_username"
                value="{{ last_username ?? '' }}"
                placeholder="votre@email.com"
                class="login-field-input"
                autocomplete="email"
                required
                aria-describedby="username-error"
            >
        </div>
    </div>
    
    {# Champ Mot de passe #}
    <div class="login-field">
        <div class="login-field-header">
            <label for="password" class="login-field-label">
                <span>Mot de passe</span>
                <span class="login-required">*</span>
            </label>
            <a href="{{ path('app_forgot_password') }}" class="login-forgot-link">
                Oublié ?
            </a>
        </div>
        <div class="login-field-wrapper login-field-password">
            <i class="login-field-icon bi bi-lock"></i>
            <input
                type="password"
                id="password"
                name="_password"
                placeholder="Votre mot de passe"
                class="login-field-input"
                autocomplete="current-password"
                required
                aria-describedby="password-error"
            >
            <button
                type="button"
                class="login-field-toggle"
                id="togglePasswordBtn"
                onclick="togglePassword('password', 'togglePasswordBtn')"
                aria-label="Afficher le mot de passe"
                aria-pressed="false"
                tabindex="0"
            >
                <i class="bi bi-eye"></i>
            </button>
        </div>
    </div>

    {# ── Connexion par empreinte digitale (WebAuthn) ── #}
    <div class="login-divider"><span>ou</span></div>
    <button
        type="button"
        id="webauthnLoginBtn"
        class="login-button login-button-secondary"
        disabled
        data-webauthn-options-url="{{ path('app_login_webauthn_options') }}"
        data-webauthn-check-url="{{ path('app_login_webauthn_check') }}"
    >
        <i class="bi bi-fingerprint me-2"></i>
        <span class="login-button-text">Se connecter avec l’empreinte digitale</span>
    </button>

    {# Token CSRF #}
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    
    {# Bouton de connexion #}
    <button type="submit" class="login-button">
        <span class="login-button-text">Se connecter</span>
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </button>
    
</form>

{# ── Information de sécurité ── #}
<div class="login-security">
    <p class="login-security-title">Sécurité</p>
    <ul class="login-security-list">
        <li>
            <i class="bi bi-shield-check"></i>
            <span>Accès réservé aux comptes habilités</span>
        </li>
        <li>
            <i class="bi bi-clock-history"></i>
            <span>Authentification sécurisée avec historique</span>
        </li>
        <li>
            <i class="bi bi-key"></i>
            <span>Authentification multi-facteurs disponible</span>
        </li>
    </ul>
</div>

{# ── Pied de page légal ── #}
<div class="login-footer">
    <span class="login-footer-copy">© {{ 'now'|date('Y') }} · SAHOTLY ALERT SYSTEM</span>
    <nav class="login-footer-nav" aria-label="Informations légales">
        <a href="{{ path('app_privacy_policy') }}">Confidentialité</a>
        <a href="{{ path('app_terms_of_use') }}">Conditions d'utilisation</a>
    </nav>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    const btn = document.getElementById('webauthnLoginBtn');
    if (!btn) return;

    const optionsUrl = btn.dataset.webauthnOptionsUrl;
    const checkUrl = btn.dataset.webauthnCheckUrl;
    const buttonLabel = 'Se connecter avec l’empreinte digitale';

    if (!window.isSecureContext) {
        btn.querySelector('.login-button-text').textContent = 'Connexion biométrique disponible uniquement en HTTPS.';
        return;
    }

    if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.get) {
        btn.querySelector('.login-button-text').textContent = 'La connexion biométrique n’est pas prise en charge par ce navigateur.';
        return;
    }

    const platformAuthenticator = window.PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable;
    if (typeof platformAuthenticator === 'function') {
        platformAuthenticator.call(window.PublicKeyCredential)
            .then(available => {
                if (available) {
                    btn.disabled = false;
                    return;
                }
                btn.querySelector('.login-button-text').textContent = 'Aucun authentificateur biométrique disponible sur cet appareil.';
            })
            .catch(error => {
                console.error('Vérification de la disponibilité WebAuthn impossible.', error);
                btn.querySelector('.login-button-text').textContent = 'Impossible de vérifier la disponibilité biométrique.';
            });
    } else {
        btn.disabled = false;
    }

    function base64urlToBytes(str) {
        str = str.replace(/-/g, '+').replace(/_/g, '/');
        const pad = str.length % 4;
        if (pad) {
            str += '='.repeat(4 - pad);
        }
        const bin = atob(str);
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) {
            bytes[i] = bin.charCodeAt(i);
        }
        return bytes;
    }

    function bytesToBase64url(bytes) {
        let bin = '';
        for (const b of bytes) {
            bin += String.fromCharCode(b);
        }
        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.querySelector('.login-button-text').textContent = 'Vérification de l’empreinte…';

        try {
            const res = await fetch(optionsUrl, { credentials: 'same-origin' });
            if (!res.ok) throw new Error('Impossible de générer le défi d’authentification.');
            const options = await res.json();

            const publicKey = { ...options };
            publicKey.challenge = base64urlToBytes(publicKey.challenge);
            if (Array.isArray(publicKey.allowCredentials)) {
                publicKey.allowCredentials = publicKey.allowCredentials.map(function (c) {
                    return { ...c, id: base64urlToBytes(c.id) };
                });
            }

            const credential = await navigator.credentials.get({ publicKey });

            if (!(credential instanceof PublicKeyCredential)) {
                throw new Error('Aucun credential renvoyé par le navigateur.');
            }

            const response = credential.response;
            const body = {
                id: credential.id,
                rawId: bytesToBase64url(new Uint8Array(credential.rawId)),
                type: credential.type,
                response: {
                    authenticatorData: bytesToBase64url(new Uint8Array(response.authenticatorData)),
                    clientDataJSON: bytesToBase64url(new Uint8Array(response.clientDataJSON)),
                    signature: bytesToBase64url(new Uint8Array(response.signature)),
                    userHandle: response.userHandle
                        ? bytesToBase64url(new Uint8Array(response.userHandle))
                        : null,
                },
            };

            const check = await fetch(checkUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(body),
            });

            const result = await check.json().catch(() => ({}));

            if (check.ok && result.success) {
                window.location.href = result.redirect || '/operationnel';
            } else {
                throw new Error(result.message || 'Échec de l’authentification par empreinte.');
            }
        } catch (error) {
            btn.disabled = false;
            btn.querySelector('.login-button-text').textContent = buttonLabel;
            let alertBox = document.querySelector('.login-alert-error');
            if (!alertBox) {
                alertBox = document.createElement('div');
                alertBox.className = 'login-alert login-alert-error';
                alertBox.setAttribute('role', 'alert');
                const message = document.createElement('p');
                message.className = 'login-alert-message';
                alertBox.appendChild(message);
                btn.insertAdjacentElement('afterend', alertBox);
            }
            const message = alertBox.querySelector('.login-alert-message');
            message.textContent = error.name === 'NotAllowedError'
                ? 'La demande a été annulée ou a expiré. Réessayez, ou connectez-vous avec votre mot de passe.'
                : (error.message || 'La connexion biométrique a échoué. Réessayez ou utilisez votre mot de passe.');
            alertBox.style.display = '';
        }
    });
})();
</script>
{% endblock %}
