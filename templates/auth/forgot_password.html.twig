{% extends 'layout/auth_layout.html.twig' %}
{% block title %}Mot de passe oublié — Plateforme GEI{% endblock %}

{% block auth_form %}
<div class="auth-form-header">
    <h1 class="auth-title">Récupération d’accès</h1>
    <p class="auth-subtitle">
        Assistance pour la réinitialisation de votre mot de passe opérationnel.
    </p>
</div>

{% if error %}
<div class="auth-error">
    <i class="bi bi-x-circle auth-error-icon"></i>
    <div>
        <p class="auth-error-title">Erreur</p>
        <p class="auth-error-msg">{{ error }}</p>
    </div>
</div>
{% endif %}

{% if submitted %}
<div class="auth-success-box" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
    <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
        <i class="bi bi-check-circle-fill text-emerald-400" style="font-size: 1.25rem; margin-top: 0.1rem;"></i>
        <div>
            <p style="font-weight: 600; color: #10b981; margin-bottom: 0.25rem;">Demande enregistrée</p>
            <p style="font-size: 0.9rem; color: #cbd5e1; line-height: 1.5; margin: 0;">
                Si cette adresse email est rattachée à un compte actif du réseau GEI, votre demande de réinitialisation a été transmise à votre <strong>Point Focal Technique (Manager PFT)</strong>.
            </p>
        </div>
    </div>
</div>

<div class="auth-info-note" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: var(--radius); padding: 1rem; margin-bottom: 1.5rem; font-size: 0.85rem; color: #94a3b8; line-height: 1.5;">
    <p style="margin: 0 0 0.5rem 0;">
        <i class="bi bi-shield-check text-amber-400 me-1"></i>
        <strong>Procédure de sécurité GEI :</strong>
    </p>
    <p style="margin: 0;">
        Pour garantir la confidentialité des données et prévenir tout détournement d'accès, votre Manager réinitialisera votre mot de passe temporaire directement depuis son espace de gestion des utilisateurs.
    </p>
</div>

<div class="auth-actions" style="margin-top: 1.5rem;">
    <a href="{{ path('app_login') }}" class="auth-submit-btn" style="text-align: center; text-decoration: none; display: flex; align-items: center; justify-content: center;">
        <i class="bi bi-arrow-left me-2"></i>
        Retourner à la page de connexion
    </a>
</div>

{% else %}

<form method="post" action="{{ path('app_forgot_password') }}" class="auth-fields" novalidate>
    <div class="auth-field-wrap">
        <label class="auth-label" for="email">
            <i class="bi bi-envelope me-1.5 opacity-60"></i>Adresse email professionnelle
        </label>
        <div class="auth-input-wrap">
            <input
                type="email"
                id="email"
                name="email"
                placeholder="nom@gei.org"
                class="auth-input"
                autocomplete="email"
                required
                autofocus
            >
        </div>
        <p class="form-help" style="font-size: 0.8rem; color: #94a3b8; margin-top: 0.4rem;">
            Indiquez l’adresse email attribuée lors de la création de votre compte par votre Manager.
        </p>
    </div>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

    <button type="submit" class="auth-submit-btn">
        <i class="bi bi-send me-2"></i>
        Transmettre ma demande
    </button>
</form>

<div class="auth-actions" style="margin-top: 1.25rem; text-align: center;">
    <a href="{{ path('app_login') }}" style="color: #94a3b8; font-size: 0.9rem; text-decoration: none;">
        <i class="bi bi-arrow-left me-1"></i>
        Retour à la connexion
    </a>
</div>

{% endif %}

<div class="auth-divider" style="margin-top: 2rem;">
    <span class="auth-divider-line"></span>
    <span class="auth-divider-text">Réseau Opérationnel GEI</span>
    <span class="auth-divider-line"></span>
</div>
{% endblock %}
