{
  "name": "Plateforme GEI",
  "short_name": "GEI",
  "description": "Renseignement opérationnel et suivi des alertes GEI.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#ffffff",
